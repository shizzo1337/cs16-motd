+// ---------------------------------------------------------------------------------------------------------------------
+
+// Change Game, as resource/ChangeGameDialog.res of Half-Life (the same numbers are built in): the window 400 x 340, made
+// bigger by its edges; the list of the other games (one column, Game) at (20, 40) 360 x 206 growing with the window,
+// "Changing games will cause the engine to restart." (dull) at (20, 250) 360 x 40, Change game (the default) at
+// (190, 295) 104 x 24 and Cancel at (310, 294) 72 x 24, keeping to the bottom right corner. The games are those of the
+// Custom Game menu of mainui; the game running is not in the list, as in the Steam version
+class CSteamChangeGameDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamChangeGameDialog() : BaseClass( "CSteamChangeGameDialog", 400, 340 ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		m_list.saves.RemoveAll();
+		for( int i = 0; ; i++ )
+		{
+			gameinfo2_t *gi = EngFuncs::GetModInfo( i );
+			if( !gi )
+				break;
+			if( !stricmp( gi->gamefolder, gMenu.m_gameinfo.gamefolder ))
+				continue;
+			SteamSave s;
+			memset( &s, 0, sizeof( s ));
+			Q_strncpy( s.name, gi->gamefolder, sizeof( s.name ));
+			Q_strncpy( s.title, gi->title, sizeof( s.title ));
+			m_list.saves.AddToTail( s );
+		}
+		m_list.Reset();
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ))
+		{
+			Change();
+			return true;
+		}
+		if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+			return m_list.KeyDown( key );
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		m_change.SetGrayed( m_list.selected < 0 );
+		BaseClass::Draw();
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( "#GameUI_ChangeGame" );
+		SetSizeable( true, 400, 340 );
+
+		m_list.numCols = 1;
+		m_list.titles[0] = "#GameUI_Game";
+		m_list.onActivate = VoidCb( &CSteamChangeGameDialog::Change );
+		m_note.dull = true;
+		m_note.wrap = true;
+		m_note.iFlags |= QMF_INACTIVE;
+		Q_strncpy( m_note.text, "#GameUI_ForceGameRestart", sizeof( m_note.text ));
+		Q_strncpy( m_change.text, "#GameUI_ChangeGame", sizeof( m_change.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_change.isDefault = true;
+		m_change.onReleased = VoidCb( &CSteamChangeGameDialog::Change );
+		m_cancel.onReleased = VoidCb( &CSteamChangeGameDialog::Hide );
+		AddItem( m_list );
+		AddItem( m_note );
+		AddItem( m_change );
+		AddItem( m_cancel );
+		OnResized();
+	}
+
+	void OnResized() override
+	{
+		const int dw = Wide() - 400, dh = Tall() - 340;
+		m_list.SetBounds( 20, 40, 360 + dw, 206 + dh );
+		m_note.SetBounds( 20, 250 + dh, 360 + dw, 40 );
+		m_change.SetBounds( 190 + dw, 295 + dh, 104, 24 );
+		m_cancel.SetBounds( 310 + dw, 294 + dh, 72, 24 );
+	}
+
+	void Change()
+	{
+		if( m_list.selected < 0 || m_list.selected >= m_list.saves.Count( ))
+			return;
+		char cmd[128];
+		snprintf( cmd, sizeof( cmd ), "game %s\n", m_list.saves[m_list.selected].name );
+		Hide();
+		EngFuncs::ClientCmd( false, cmd );
