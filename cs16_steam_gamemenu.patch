+bool CMenuMain::InitSteamMenu()
+{
+	if( !SteamGameMenu::Load( steamEntries ))
+		return false;
+
+	// "Default" of TrackerScheme.res: Tahoma, tall 16 (the cell of the letters: 1.207 of their height), weight 0,
+	// without antialiasing
+	steamFont = CClientWindow::CreateSteamFont( "Tahoma", 13, 1.207f, 0, false );
+	if( steamFont <= 0 )
+		return false;
+
+	numSteamItems = 0;
+
+	for( int i = 0; i < steamEntries.Count() && numSteamItems < MAX_STEAM_ITEMS; i++ )
+	{
+		const SteamGameMenu::Entry &e = steamEntries[i];
+		CSteamGameMenuItem &item = steamItems[numSteamItems];
+		bool &supported = steamSupported[numSteamItems];
+
+		item.textFont = steamFont;
+		item.capHeight = 9;
+		item.spacer = !e.label[0];
+
+		if( item.spacer )
+		{
+			item.label[0] = 0;
+			item.iFlags |= QMF_INACTIVE;
+			supported = true;
+		}
+		else
+		{
+			Q_strncpy( item.label, L( e.label ), sizeof( item.label ));
+			item.iFlags |= QMF_NOTIFY;
+			supported = SetSteamCommand( item, e );
+		}
+
+		AddItem( item );
+		numSteamItems++;
+	}
+
+	if( steamLogo.Load( ))
+		AddItem( steamLogo );
+
+	dialog.Link( this );
+	return numSteamItems > 0;
+}
