+// A RadioButton of VGUI2; the window keeps one of a group chosen
+class CSteamRadioButton : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	char text[128] = "";
+	bool selected = false;
+	CEventCallback onChosen;
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsLeftMouse( key ) && Hovered( ) && !( iFlags & QMF_GRAYED ))
+		{
+			if( onChosen )
+				onChosen( this );
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		const int x = m_scPos.x, y = m_scPos.y, h = m_scSize.h;
+		const bool grayed = ( iFlags & QMF_GRAYED ) != 0;
+
+		// the circle: 14 pixels, its upper left half dark, the lower right one bright (sunk in)
+		const int cx = x + 3, cy = y + ( h - 14 ) / 2;
+		for( int py = 0; py < 14; py++ )
+			for( int px = 0; px < 14; px++ )
+			{
+				const float dx = px - 6.5f, dy = py - 6.5f;
+				const float d = sqrtf( dx * dx + dy * dy );
+				if( d >= 5.5f && d < 7.0f )
+					Fill( cx + px, cy + py, 1, 1, dx + dy < 0.0f ? BorderDark : BorderBright );
+			}
+
+		// the dot of the chosen one
+		if( selected )
+		{
+			for( int py = 0; py < 7; py++ )
+				for( int px = 0; px < 7; px++ )
+				{
+					const float dx = px - 3.0f, dy = py - 3.0f;
+					if( dx * dx + dy * dy <= 10.5f )
+						Fill( cx + 4 + px, cy + 4 + py, 1, 1, grayed ? DisabledText1 : BrightBaseText );
+				}
+
+			// the dotted frame of the button that has the focus (the chosen one, as the Steam version shows it)
+			const int fx = x + 3, fy = y + 3, fw = m_scSize.w - 7, fh = 19;
+			for( int i = 0; i < fw; i += 2 )
+			{
+				Fill( fx + i, fy, 1, 1, BorderDark );
+				Fill( fx + i, fy + fh - 1, 1, 1, BorderDark );
+			}
+			for( int i = 0; i < fh; i += 2 )
+			{
+				Fill( fx, fy + i, 1, 1, BorderDark );
+				Fill( fx + fw - 1, fy + i, 1, 1, BorderDark );
+			}
+		}
+
+		const unsigned int c = grayed ? DisabledText1 : ( selected ? BrightControlText : ControlText );
+		TextInBox( FONT_DEFAULT, x + 26, y, m_scSize.w - 26, h, Localize( text ), c );
+	}
+};
