+CSteamButton::CSteamButton() : BaseClass()
+{
+	iFlags |= QMF_DISABLESCAILING;
+	bDrawStroke = false;
+	SetText( "" );
+}
+
+void CSteamButton::SetBounds( int x, int y, int w, int h )
+{
+	pos = Point( x, y );
+	size = Size( w, h );
+}
+
+void CSteamButton::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	const bool grayed = ( iFlags & QMF_GRAYED ) != 0;
+	const bool armed = !grayed && UI_CursorInRect( m_scPos, m_scSize );
+	const bool depressed = armed && m_bPressed;
+
+	Fill( x, y, w, h, ControlBG );
+
+	if( depressed )
+		InsetBorder( x, y, w, h );
+	else
+		RaisedBorder( x, y, w, h );
+
+	if( isDefault )
+		UI_DrawRectangleExt( x - 1, y - 1, w + 2, h + 2, BorderSelection, 1 );
+
+	const char *t = Localize( text );
+	unsigned int c = grayed ? DisabledText1 : ( armed ? BrightBaseText : ControlText );
+	if( grayed )
+		TextInBox( FONT_DEFAULT, x + 7, y + 1, w - 7, h, t, DisabledText2 ); // the inset look of VGUI2
+	TextInBox( FONT_DEFAULT, x + 6 + ( depressed ? 1 : 0 ), y + ( depressed ? 1 : 0 ), w - 7, h, t, c );
+}
