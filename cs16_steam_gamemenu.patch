+
+static CUtlVector<CSteamFrame *> s_frames;        // all the windows of the Steam version
+static CUtlVector<CSteamFrame *> s_framesToRestore; // those open when the menu was closed
+
+CSteamFrame::CSteamFrame( const char *name, int wide, int tall ) : BaseClass( name )
+{
+	s_frames.AddToTail( this );
+	iFlags |= QMF_DISABLESCAILING;
+	m_iWide = wide;
+	m_iTall = tall;
+	m_szTitle[0] = 0;
+	bAllowDrag = false; // the window is moved by its title only (below)
+}
+
+void CSteamFrame::SetTitle( const char *title )
+{
+	Q_strncpy( m_szTitle, title ? title : "", sizeof( m_szTitle ));
+}
+
+void CSteamFrame::Show()
+{
+	BaseClass::Show();
+	EnableTransition( ANIM_NO ); // the windows of GameUI just appear
+	DisableTransition();
+}
+
+void CSteamFrame::_VidInit()
+{
+	// in the middle of the screen, in pixels, the first time; then where it was left, as in the Steam version (again
+	// in the middle when the resolution is another one)
+	m_bPlacedNow = !m_bPlaced || m_iScreenWide != gpGlobals->scrWidth || m_iScreenTall != gpGlobals->scrHeight;
+	if( m_bPlacedNow )
+	{
+		pos = Point(( gpGlobals->scrWidth - m_iWide ) / 2, ( gpGlobals->scrHeight - m_iTall ) / 2 );
+		m_bPlaced = true;
+		m_iScreenWide = gpGlobals->scrWidth;
+		m_iScreenTall = gpGlobals->scrHeight;
+	}
+	size = Size( m_iWide, m_iTall );
+	m_bDragging = false;
+	m_pOpenList = nullptr;
+}
+
+int CSteamFrame::AddPage( const char *title )
+{
+	Page *p = new Page;
+	Q_strncpy( p->title, title, sizeof( p->title ));
+	const int i = m_pages.AddToTail( p );
+	if( m_iActivePage < 0 )
+		m_iActivePage = 0;
+	return i;
+}
+
+void CSteamFrame::AddToPage( int page, CMenuBaseItem &item )
+{
+	if( page < 0 || page >= m_pages.Count( ))
+		return;
+
+	// counted from the corner of the page
+	item.pos.x += PageOrigin().x;
+	item.pos.y += PageOrigin().y;
+	m_pages[page]->items.AddToTail( &item );
+	AddItem( item );
+
+	if( page != m_iActivePage )
+		item.Hide();
+}
+
+void CSteamFrame::SetActivePage( int page )
+{
+	if( page < 0 || page >= m_pages.Count( ))
+		return;
+
+	for( int p = 0; p < m_pages.Count(); p++ )
+		for( int i = 0; i < m_pages[p]->items.Count(); i++ )
+			m_pages[p]->items[i]->SetVisibility( p == page );
+
+	m_iActivePage = page;
+	m_pOpenList = nullptr;
+	OnPageChanged( page );
+}
+
+void CSteamFrame::TabRect( int page, int &x, int &y, int &w, int &h ) const
+{
+	x = m_scPos.x + m_pageInset[0];
+	for( int i = 0; i < page; i++ )
+	{
+		int tw = TextWidth( FONT_DEFAULT, Localize( m_pages[i]->title )) + 16;
+		x += ( tw < m_iTabMinWide ? m_iTabMinWide : tw ) + 1;
+	}
+	w = TextWidth( FONT_DEFAULT, Localize( m_pages[page]->title )) + 16;
+	if( w < m_iTabMinWide )
+		w = m_iTabMinWide;
+
+	if( page == m_iActivePage )
+	{
+		y = m_scPos.y + m_pageInset[1] - 26;
+		h = 27;
+	}
+	else
+	{
+		y = m_scPos.y + m_pageInset[1] - 24;
+		h = 24;
+	}
+}
+
+int CSteamFrame::TabAt( int cx, int cy ) const
+{
+	if( !m_bSheetShown )
+		return -1;
+	for( int i = 0; i < m_pages.Count(); i++ )
+	{
+		int x, y, w, h;
+		TabRect( i, x, y, w, h );
+		if( cx >= x && cx < x + w && cy >= y && cy < y + h )
+			return i;
+	}
+	return -1;
+}
+
+bool CSteamFrame::OnClose( int cx, int cy ) const
+{
+	if( !m_bCloseButton )
+		return false;
+	const int x = m_scPos.x + m_iWide - 25, y = m_scPos.y + 8;
+	return cx >= x && cx < x + 18 && cy >= y && cy < y + 18;
+}
+
+int CSteamFrame::ResizeEdgesAt( int cx, int cy ) const
+{
+	if( !m_bSizeable )
+		return 0;
+
+	const int x = m_scPos.x, y = m_scPos.y, w = m_iWide, h = m_iTall;
+	if( cx < x || cx >= x + w || cy < y || cy >= y + h )
+		return 0;
+
+	// the grip of the bottom right corner, then 4 pixels along every edge (as the frames of VGUI2)
+	if( cx >= x + w - 16 && cy >= y + h - 16 )
+		return 2 | 8;
+
+	int edges = 0;
+	if( cx < x + 4 ) edges |= 1;
+	if( cx >= x + w - 4 ) edges |= 2;
+	if( cy < y + 4 ) edges |= 4;
+	if( cy >= y + h - 4 ) edges |= 8;
+	return edges;
+}
+
+bool CSteamFrame::CursorInside() const
+{
+	const int cx = uiStatic.cursorX, cy = uiStatic.cursorY;
+	return cx >= m_scPos.x && cx < m_scPos.x + m_iWide && cy >= m_scPos.y && cy < m_scPos.y + m_iTall;
+}
+
+static bool IsMouseButton( int key )
+{
+	return key == K_MOUSE1 || key == K_MOUSE2 || key == K_MOUSE3 || key == K_MOUSE4 || key == K_MOUSE5;
+}
+
+bool CSteamFrame::MouseMove( int x, int y )
+{
+	if( m_pOpenList )
+		return true; // the open list has the mouse
+
+	// the windows of the Steam version are not modal: what is under the cursor outside the window (the main menu)
+	// is lit as usual
+	if( !CursorInside() && !m_bDragging && !m_iResizeEdges )
+	{
+		if( CMenuBaseWindow *under = m_pStack->WindowAt( x, y, this ))
+		{
+			under->MouseMove( x, y );
+			m_pLitUnder = under;
+		}
+	}
+	else if( m_pLitUnder )
+	{
+		// back over the window: nothing under it stays lit
+		m_pLitUnder->MouseMove( -10000, -10000 );
+		m_pLitUnder = nullptr;
+	}
+
+	return BaseClass::MouseMove( x, y );
+}
+
+bool CSteamFrame::KeyDown( int key )
+{
+	if( m_pOpenList )
+	{
+		if( m_pOpenList->ListKey( key ))
+		{
+			if( !m_pOpenList->open )
+				m_pOpenList = nullptr;
+			return true;
+		}
+		if( UI::Key::IsLeftMouse( key ))
+			return true;
+	}
+
+	if( UI::Key::IsEscape( key ) && !m_bEscapeCloses )
+	{
+		// the main menu under the windows (a point nowhere: no window but the root has it)
+		CMenuBaseWindow *root = m_pStack ? m_pStack->WindowAt( -100000, -100000, this ) : nullptr;
+		if( root && root->IsRoot( ))
+			return root->KeyDown( key );
+		return true;
+	}
+
+	// a click outside the window goes to the window under it: another window of the Steam version comes to the top,
+	// the main menu works under the windows, as in the Steam version
+	if( IsMouseButton( key ) && !CursorInside( ))
+	{
+		CMenuBaseWindow *under = m_pStack->WindowAt( uiStatic.cursorX, uiStatic.cursorY, this );
+		if( under )
+		{
+			if( !under->IsRoot( ))
+				m_pStack->Add( under ); // to the top; it gets the rest of the click itself
+			else
+				m_pForward = under;   // the main menu stays under: the release of the button goes to it too
+			under->MouseMove( uiStatic.cursorX, uiStatic.cursorY );
+			return under->KeyDown( key );
+		}
+	}
+
+	if( UI::Key::IsLeftMouse( key ))
+	{
+		const int cx = uiStatic.cursorX, cy = uiStatic.cursorY;
+
+		if( OnClose( cx, cy ))
+		{
+			m_bClosePressed = true;
+			return true;
+		}
+
+		const int edges = ResizeEdgesAt( cx, cy );
+		if( edges )
+		{
+			m_iResizeEdges = edges;
+			m_resizeStart = Point( cx, cy );
+			m_iStartX = m_scPos.x;
+			m_iStartY = m_scPos.y;
+			m_iStartW = m_iWide;
+			m_iStartH = m_iTall;
+			return true;
+		}
+
+		const int tab = TabAt( cx, cy );
+		if( tab >= 0 )
+		{
+			if( tab != m_iActivePage )
+				SetActivePage( tab );
+			return true;
+		}
+
+		// the title moves the window
+		if( cx >= m_scPos.x && cx < m_scPos.x + m_iWide && cy >= m_scPos.y && cy < m_scPos.y + 28 )
+		{
+			m_bDragging = true;
+			m_dragOffset = Point( cx - m_scPos.x, cy - m_scPos.y );
+			return true;
+		}
+	}
+
+	return BaseClass::KeyDown( key );
+}
+
+bool CSteamFrame::KeyUp( int key )
+{
+	if( m_pForward && IsMouseButton( key ))
+	{
+		CMenuBaseWindow *w = m_pForward;
+		m_pForward = nullptr;
+		return w->KeyUp( key );
+	}
+
+	if( UI::Key::IsLeftMouse( key ))
+	{
+		if( m_bClosePressed )
+		{
+			m_bClosePressed = false;
+			if( OnClose( uiStatic.cursorX, uiStatic.cursorY ))
+				Hide();
+			return true;
+		}
+		if( m_bDragging )
+		{
+			m_bDragging = false;
+			return true;
+		}
+		if( m_iResizeEdges )
+		{
+			m_iResizeEdges = 0;
+			return true;
+		}
+	}
+
+	return BaseClass::KeyUp( key );
+}
+
+void CSteamFrame::Draw()
+{
+	if( m_bDragging )
+	{
+		m_scPos.x = uiStatic.cursorX - m_dragOffset.x;
+		m_scPos.y = uiStatic.cursorY - m_dragOffset.y;
+		pos = m_scPos; // kept when the window is shown again
+		CalcItemsPositions();
+	}
+
+	if( m_iResizeEdges )
+	{
+		const int dx = uiStatic.cursorX - m_resizeStart.x, dy = uiStatic.cursorY - m_resizeStart.y;
+		int x = m_iStartX, y = m_iStartY, w = m_iStartW, h = m_iStartH;
+
+		if( m_iResizeEdges & 2 ) w = m_iStartW + dx;
+		if( m_iResizeEdges & 8 ) h = m_iStartH + dy;
+		if( m_iResizeEdges & 1 ) { w = m_iStartW - dx; if( w < m_iMinWide ) w = m_iMinWide; x = m_iStartX + m_iStartW - w; }
+		if( m_iResizeEdges & 4 ) { h = m_iStartH - dy; if( h < m_iMinTall ) h = m_iMinTall; y = m_iStartY + m_iStartH - h; }
+		if( w < m_iMinWide ) w = m_iMinWide;
+		if( h < m_iMinTall ) h = m_iMinTall;
+
+		if( x != m_scPos.x || y != m_scPos.y || w != m_iWide || h != m_iTall )
+		{
+			pos = m_scPos = Point( x, y );
+			m_iWide = w;
+			m_iTall = h;
+			size = m_scSize = Size( w, h );
+			OnResized();
+			CalcItemsPositions();
+			CalcItemsSizes();
+		}
+	}
+
+	const int x = m_scPos.x, y = m_scPos.y, w = m_iWide, h = m_iTall;
+
+	// the frame
+	Fill( x, y, w, h, ControlBG );
+	RaisedBorder( x, y, w, h );
+
+	// the title (without the icon of Steam)
+	Text( FONT_DEFAULT, x + 21, y + 8, Localize( m_szTitle ), TitleText, w - 60 );
+
+	// the close button: an "x" in a raised box
+	if( m_bCloseButton )
+	{
+		const int bx = x + w - 25, by = y + 8;
+		const bool pressed = m_bClosePressed && OnClose( uiStatic.cursorX, uiStatic.cursorY );
+		if( pressed )
+			InsetBorder( bx, by, 18, 18 );
+		else
+			RaisedBorder( bx, by, 18, 18 );
+
+		const unsigned int c = OnClose( uiStatic.cursorX, uiStatic.cursorY ) ? BrightBaseText : PackRGBA( 191, 192, 184, 255 );
+		for( int i = 0; i < 8; i++ )
+		{
+			Fill( bx + 5 + i, by + 5 + i, 2, 1, c );
+			Fill( bx + 11 - i, by + 5 + i, 2, 1, c );
+		}
+	}
+
+	// the tabs and the page
+	if( m_pages.Count() && m_bSheetShown )
+	{
+		int px, py, pw, ph;
+		PageRect( px, py, pw, ph );
+		RaisedBorder( px, py, pw, ph );
+
+		for( int i = 0; i < m_pages.Count(); i++ )
+		{
+			int tx, ty, tw, th;
+			TabRect( i, tx, ty, tw, th );
+			const bool active = i == m_iActivePage;
+
+			Fill( tx, ty, tw, th, ControlBG );
+			Fill( tx, ty, tw - 1, 1, BorderBright );
+			Fill( tx, ty, 1, th - ( active ? 0 : 1 ), BorderBright );
+			Fill( tx + tw - 1, ty, 1, th - ( active ? 0 : 1 ), BorderDark );
+
+			const char *t = Localize( m_pages[i]->title );
+			Text( FONT_DEFAULT, tx + 6, ty + ( active ? 5 : 4 ), t, active ? BrightControlText : BrightBaseText, tw - 8 );
+		}
+	}
+
+	// the grip of a window that can be resized: a triangle of dots in the bottom right corner, as VGUI2 draws it
+	if( m_bSizeable )
+	{
+		for( int row = 0; row < 3; row++ )
+		{
+			const int dy = y + h - 13 + row * 4;
+			for( int col = 0; col <= row; col++ )
+			{
+				const int dx = x + w - 6 - col * 4;
+				Fill( dx, dy, 2, 2, BorderBright );
+				Fill( dx + 1, dy + 1, 1, 1, BorderDark );
+			}
+		}
+	}
+
+	CMenuItemsHolder::Draw();
+
+	// an open list above everything
+	if( m_pOpenList )
+	{
+		if( !m_pOpenList->open || !m_pOpenList->IsVisible( ))
+			m_pOpenList = nullptr;
+		else
+			m_pOpenList->DrawList();
+	}
+}
