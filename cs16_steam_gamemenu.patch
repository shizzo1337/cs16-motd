+
+private:
+	void _Init() override;
+
+	// the controls of a page from its .res file; returns the number of controls made
+	int BuildPage( int page, const char *res );
+
+	void Load();  // the settings into the controls
+	void Apply(); // the controls into the settings
+
+	void ApplyLogo();
+	void UpdatePreviews();
+	void ResetKeys();
+	void ClearKey();
+	void StartGrab();
+	void UnbindCommand( const char *command );
+	void ToggleMicTest();
+	void UpdateContentLockLabel();
+
+	// Apply is grayed until something is changed, as in the Steam version: the values of the controls are compared
+	// with those after Load or Apply; a key bound, cleared or the keys reset are a change too
+	unsigned int ControlsHash() const;
+	void SetUnchanged() { m_iHash = ControlsHash(); m_bChanged = false; }
+	unsigned int m_iHash = 0;
+	bool m_bChanged = false;
+
