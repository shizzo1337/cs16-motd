+static void SetCheck( CSteamCheckButton *b, bool on ) { if( b ) b->checked = on; }
+
+void CSteamOptionsDialog::Load()
+{
+	// Multiplayer
+	if( m_name )
+		m_name->SetBuffer( EngFuncs::GetCvarString( "name" ));
+	if( m_logo )
+	{
+		int i = -1;
+		for( int k = 0; k < m_logo->items.Count(); k++ )
+			if( !stricmp( m_logo->items[k].text, EngFuncs::GetCvarString( "cl_logofile" ))) { i = k; break; }
+		m_logo->Select( i >= 0 ? i : ( m_logo->items.Count() ? 0 : -1 ));
+	}
+	if( m_logoColor )
+	{
+		const int i = m_logoColor->FindData( EngFuncs::GetCvarString( "cl_logocolor" ));
+		m_logoColor->Select( i >= 0 ? i : 0 );
+	}
+	if( m_xhairSize )
+	{
+		const int i = m_xhairSize->FindData( EngFuncs::GetCvarString( "cl_crosshair_size" ));
+		m_xhairSize->Select( i >= 0 ? i : 0 );
+	}
+	if( m_xhairColor )
+	{
+		const int i = m_xhairColor->FindData( EngFuncs::GetCvarString( "cl_crosshair_color" ));
+		m_xhairColor->Select( i >= 0 ? i : 0 );
+	}
+	SetCheck( m_xhairTranslucent, EngFuncs::GetCvarFloat( "cl_crosshair_translucent" ) != 0.0f );
+	UpdatePreviews();
+
+	// Keyboard
+	if( m_keys )
+	{
+		m_keys->grabbing = false;
+		m_keys->Refresh();
+	}
+
+	// Mouse
+	SetCheck( m_reverseMouse, EngFuncs::GetCvarFloat( "m_pitch" ) < 0.0f );
+	SetCheck( m_mouseLook, EngFuncs::GetCvarFloat( "ui_steam_mouselook" ) != 0.0f );
+	SetCheck( m_mouseFilter, EngFuncs::GetCvarFloat( "m_filter" ) != 0.0f );
+	SetCheck( m_joystick, EngFuncs::GetCvarFloat( "joy_enable" ) != 0.0f );
+	SetCheck( m_joystickLook, EngFuncs::GetCvarFloat( "joy_lookspring" ) == 0.0f );
+	SetCheck( m_autoAim, EngFuncs::GetCvarFloat( "sv_aim" ) != 0.0f );
+	SetCheck( m_rawInput, EngFuncs::GetCvarFloat( "m_rawinput" ) != 0.0f );
+	if( m_sensitivity )
+	{
+		m_sensitivity->value = EngFuncs::GetCvarFloat( "sensitivity" );
+		m_sensitivity->onChanged( m_sensitivity );
+	}
+
+	// Audio
+	if( m_sfx ) m_sfx->value = EngFuncs::GetCvarFloat( "volume" );
+	if( m_mp3 ) m_mp3->value = EngFuncs::GetCvarFloat( "MP3Volume" );
+	if( m_suit ) m_suit->value = EngFuncs::GetCvarFloat( "suitvolume" );
+	if( m_soundQuality )
+		m_soundQuality->Select( (int)EngFuncs::GetCvarFloat( "ui_steam_soundquality" ) >= 0 ? (int)EngFuncs::GetCvarFloat( "ui_steam_soundquality" ) : 2 );
+
+	// Video
+	if( m_renderer )
+	{
+		const int i = m_renderer->FindData( EngFuncs::GetCvarString( "r_refdll_loaded" ));
+		m_renderer->Select( i );
+	}
+	if( m_aspect )
+	{
+		const bool wide = gpGlobals->scrWidth * 3 > gpGlobals->scrHeight * 4 + gpGlobals->scrHeight / 2;
+		m_aspect->Select( wide ? 1 : 0 );
+	}
+	if( m_resolution )
+	{
+		m_resolution->RemoveAll();
+		FillResolutions();
+	}
+	SetCheck( m_windowed, EngFuncs::GetCvarFloat( "fullscreen" ) == 0.0f );
+	SetCheck( m_vsync, EngFuncs::GetCvarFloat( "gl_vsync" ) != 0.0f );
+	SetCheck( m_hdModels, EngFuncs::GetCvarFloat( "fs_mount_hd" ) != 0.0f );
+	SetCheck( m_addons, EngFuncs::GetCvarFloat( "fs_mount_addon" ) != 0.0f );
+	SetCheck( m_lowVideo, EngFuncs::GetCvarFloat( "ui_steam_lowvideo" ) != 0.0f );
+	SetCheck( m_detailTextures, EngFuncs::GetCvarFloat( "r_detailtextures" ) != 0.0f );
+	if( m_brightness ) m_brightness->value = EngFuncs::GetCvarFloat( "brightness" );
+	if( m_gamma ) m_gamma->value = EngFuncs::GetCvarFloat( "gamma" );
+
+	// Voice
+	SetCheck( m_voiceEnable, EngFuncs::GetCvarFloat( "voice_modenable" ) != 0.0f );
+	SetCheck( m_micBoost, EngFuncs::GetCvarFloat( "ui_steam_micboost" ) != 0.0f );
+	if( m_voiceTransmit ) m_voiceTransmit->value = EngFuncs::GetCvarFloat( "voice_transmit_scale" );
+	if( m_voiceReceive ) m_voiceReceive->value = EngFuncs::GetCvarFloat( "voice_scale" );
+
+	// Lock
+	UpdateContentLockLabel();
+}
