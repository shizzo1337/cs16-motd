+
+void CSteamServerBrowser::Connect( const SteamServer &s )
+{
+	if( s.password )
+	{
+		m_pendingConnect = s;
+		m_passwordDialog.Ask( s.name, this, &CSteamServerBrowser::PasswordEntered );
+		return;
+	}
+
+	EngFuncs::CvarSetString( "password", "" );
+
+	const char *sadr = EngFuncs::NET_AdrToString( s.adr );
+	if( FindInList( m_history, sadr ) < 0 )
+	{
+		ListEntry e;
+		Q_strncpy( e.adr, sadr, sizeof( e.adr ));
+		Q_strncpy( e.prot, s.Protocol(), sizeof( e.prot ));
+		if( m_history.Count() >= 20 )
+			m_history.Remove( 0 );
+		m_history.AddToTail( e );
+		WriteList( "history_servers.lst", m_history );
+	}
+
+	EngFuncs::ClientCmdF( false, "connect \"%s\" \"%s\"\n", sadr, s.Protocol());
+	UI_ConnectionProgress_Connect( "" );
+}
+
+void CSteamServerBrowser::PasswordEntered()
+{
+	EngFuncs::CvarSetString( "password", m_passwordDialog.Text());
+
+	SteamServer s = m_pendingConnect;
+	s.password = false; // asked already
+	const char *pw = m_passwordDialog.Text();
+	char keep[128];
+	Q_strncpy( keep, pw, sizeof( keep ));
+	Connect( s );
+	EngFuncs::CvarSetString( "password", keep );
+}
