+GNU General Public License for more details.
+*/
+
+// The same file is in the engine (engine/steamui_int.h) and in the menu (3rdparty/mainui_cpp/steamui_int.h).
+//
+// A menu that draws the console and the loading window itself, as GameUI of the Steam version, exports
+// "GetSteamUIAPI". The engine finds it after GetMenuAPI and GetExtAPI; without it (any other menu, or this menu
+// with another engine) everything stays as before. The structures are only added to at their ends, with a new version.
+
+#ifndef STEAMUI_INT_H
+#define STEAMUI_INT_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define STEAMUI_API_VERSION 1
+#define STEAMUI_EXPORT_NAME "GetSteamUIAPI"
+
+// what the menu does itself
+#define STEAMUI_FEATURE_CONSOLE   ( 1 << 0 ) // the console window: the engine doesn't draw its console
+#define STEAMUI_FEATURE_LOADING   ( 1 << 1 ) // the loading window: the menu stays open while connecting and loading
+#define STEAMUI_FEATURE_WORLD     ( 1 << 2 ) // the game is drawn under the menu while in it (ui_renderworld or not)
+
+// the engine for the menu
+typedef struct steamui_enginefuncs_s
+{
+	// the text to the clipboard of the system
+	void  (*pfnSetClipboardText)( const char *text );
+
+	// the commands and the variables beginning with "partial", for the list under the field of the console:
+	// "name\tvalue\n" for a variable, "name\n" for a command, sorted, at most "max" of them; returns their number
+	int   (*pfnCompleteCommand)( const char *partial, char *out, int outsize, int max );
+
+	// a line typed in the console window: printed as "] line", kept in the history of the commands and executed
+	void  (*pfnConsoleCommand)( const char *line );
+
+	// the test of the microphone of the Voice page: the voice is played back and its level (0..1) is known
+	int   (*pfnVoiceTest)( int start ); // 1 if the microphone is open
+	float (*pfnVoiceLevel)( void );     // the last level of the microphone, 0..1
+
+	// a game is running (connected, loaded, not under the loading window): the menu shows the game under it then,
+	// in a game of one player too (where the engine tells the menu "not in game" while the menu is open)
+	int   (*pfnClientActive)( void );
+} steamui_enginefuncs_t;
+
+// the menu for the engine
+typedef struct steamui_functions_s
+{
+	// STEAMUI_FEATURE_*: what the menu does now (the menu of the Steam version can be turned off while the game runs)
+	int  (*pfnGetFeatures)( void );
+
+	// the console window: shown or hidden (the menu is active when it is shown), and whether it is shown now
+	void (*pfnConsoleShow)( int show );
+	int  (*pfnConsoleVisible)( void );
+
+	// a text printed to the console: one or more lines, may end without a line end (the line goes on then);
+	// the colours of the engine ("^1" and so on) are left in
+	void (*pfnConsolePrint)( const char *text );
+	void (*pfnConsoleClear)( void );
+} steamui_functions_t;
+
+typedef int (*STEAMUIAPI)( int version, steamui_functions_t *pFunctionTable, const steamui_enginefuncs_t *pEngfuncs );
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // STEAMUI_INT_H
