+// ---------------------------------------------------------------------------------------------------------------------
+
+bool CSteamFrame::ReadRes( const char *path, CUtlVector<Placed> &out )
+{
+	out.RemoveAll();
+
+	ResNode *root = LoadRes( path );
+	if( !root )
+		return false;
+
+	for( int i = 0; i < root->children.Count(); i++ )
+	{
+		const ResNode *n = root->children[i];
+		if( !n->children.Count( ))
+			continue;
+
+		Placed p;
+		memset( &p, 0, sizeof( p ));
+		Q_strncpy( p.name, n->name, sizeof( p.name ));
+		Q_strncpy( p.control, n->GetString( "ControlName" ), sizeof( p.control ));
+		p.x = n->GetInt( "xpos" );
+		p.y = n->GetInt( "ypos" );
+		p.w = n->GetInt( "wide" );
+		p.h = n->GetInt( "tall" );
+		Q_strncpy( p.label, n->GetString( "labelText" ), sizeof( p.label ));
+		p.visible = n->GetInt( "visible", 1 ) != 0;
+		p.dull = n->GetInt( "dulltext", 0 ) != 0;
+		p.wrap = n->GetInt( "wrap", 0 ) != 0;
+		p.autoResize = n->GetInt( "autoResize", 0 );
+		p.pinCorner = n->GetInt( "pinCorner", 0 );
+		Q_strncpy( p.leftText, n->GetString( "leftText" ), sizeof( p.leftText ));
+		Q_strncpy( p.rightText, n->GetString( "rightText" ), sizeof( p.rightText ));
+		out.AddToTail( p );
+	}
+
+	delete root;
+	return out.Count() > 0;
+}
+
+const CSteamFrame::Placed *CSteamFrame::FindPlaced( const CUtlVector<Placed> &list, const char *name )
+{
+	for( int i = 0; i < list.Count(); i++ )
+		if( !stricmp( list[i].name, name ))
+			return &list[i];
+	return nullptr;
+}
