+
+// The engine draws no console when the menu has this one (steamui_int.h: the engine of cs16-client with its patch):
+// the key of the console opens the menu with this window over it, as GameUI does. Measured at 1920x1080: the window
+// 560 x 400 at (40, 40) the first time, resized by its edges; the text (a scroll bar on the right) from (8, 35) to
+// 8 pixels from the right and 41 from the bottom, on "ListBG", in "Default", rows of 17 pixels in "BaseText" (the
+// colours of the engine, "^1" and so on, kept); the field from (8, tall - 33), 24 tall, up to 8 pixels before
+// "Submit" (64 x 24, 8 pixels from the right). While a command is typed the commands and the variables that begin
+// so are listed under the field (rows of 22 pixels, as the list of a combo box, "name value", at most 6 and "...");
+// the arrows choose one, Tab too, a click takes it. The arrows go through the commands typed before otherwise.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "Utils.h"
