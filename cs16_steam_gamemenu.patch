+
+void CSteamComboBox::ListRect( int &x, int &y, int &w, int &h, int &rowH, int &first, int &count ) const
+{
+	rowH = 22; // the items of a menu of VGUI2 (DEFAULT_MENU_ITEM_HEIGHT), as the Steam version at 1920x1080
+	count = items.Count() < numLines ? items.Count() : numLines;
+	first = m_iListTop;
+	if( first + count > items.Count( ))
+		first = items.Count() - count;
+	if( first < 0 )
+		first = 0;
+
+	x = m_scPos.x;
+	y = m_scPos.y + m_scSize.h;
+	w = m_scSize.w;
+	h = count * rowH + 4;
+
+	// above the box if there is no room under it
+	if( y + h > gpGlobals->scrHeight )
+		y = m_scPos.y - h;
+}
+
+void CSteamComboBox::PlaceScrollBar()
+{
+	int x, y, w, h, rowH, first, count;
+	ListRect( x, y, w, h, rowH, first, count );
+	m_sb.x = x + w - 19;
+	m_sb.y = y + 1;
+	m_sb.w = 18;
+	m_sb.h = h - 2;
+	m_sb.total = items.Count();
+	m_sb.visible = count;
+	m_sb.top = first;
+}
+
+void CSteamComboBox::DrawList()
+{
+	const bool scroll = items.Count() > numLines;
+	if( scroll )
+	{
+		PlaceScrollBar();
+		m_sb.Clamp(); // a window made bigger shows more rows: the first one may have to go up
+		m_sb.Think();
+		m_iListTop = m_sb.top;
+	}
+
+	int x, y, w, h, rowH, first, count;
+	ListRect( x, y, w, h, rowH, first, count );
+	const int rowsW = scroll ? w - 20 : w - 2;
+
+	Fill( x, y, w, h, ControlBG );
+	RaisedBorder( x, y, w, h );
+
+	for( int i = 0; i < count; i++ )
+	{
+		const int idx = first + i;
+		const int ry = y + 2 + i * rowH;
+		const bool armed = UI_CursorInRect( x + 1, ry, rowsW, rowH );
+		if( armed )
+			Fill( x + 1, ry, rowsW, rowH, SelectionBG );
+		TextInBox( FONT_DEFAULT, x + 6, ry, rowsW - 10, rowH, items[idx].text, armed ? BrightBaseText : DimBaseText );
+	}
+
+	if( scroll )
+	{
+		PlaceScrollBar();
+		m_sb.Draw();
+	}
+}
+
+bool CSteamComboBox::ListKey( int key )
+{
+	int x, y, w, h, rowH, first, count;
+	ListRect( x, y, w, h, rowH, first, count );
+
+	if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+	{
+		m_iListTop += key == K_MWHEELUP ? -1 : 1;
+		if( m_iListTop < 0 )
+			m_iListTop = 0;
+		if( m_iListTop > items.Count() - count )
+			m_iListTop = items.Count() - count;
+		return true;
+	}
+
+	if( UI::Key::IsLeftMouse( key ))
+	{
+		// the scroll bar of a long list: the list stays open
+		if( items.Count() > numLines )
+		{
+			PlaceScrollBar();
+			if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+			{
+				m_iListTop = m_sb.top;
+				return true;
+			}
+		}
+
+		if( UI_CursorInRect( x, y, w, h ))
+		{
+			const int i = ( uiStatic.cursorY - y - 2 ) / rowH;
+			if( i >= 0 && i < count )
+			{
+				Select( first + i );
+				if( onChanged )
+					onChanged( this );
+			}
+		}
+		open = false;
+		return true;
+	}
+
+	if( UI::Key::IsEscape( key ))
+	{
+		open = false;
+		return true;
+	}
+
+	return false;
+}
+
+void CSteamComboBox::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	const bool grayed = ( iFlags & QMF_GRAYED ) != 0;
+
+	Fill( x, y, w, h, WindowBG );
+	InsetBorder( x, y, w, h );
+
+	// the chosen item: on "SelectionBG" while the box has the keyboard (as the Steam version shows "OpenGL")
+	const char *t = SelectedText();
+	const bool focus = ( iFlags & QMF_HASKEYBOARDFOCUS ) != 0;
+	if( focus && t[0] )
+		Fill( x + 3, y + 4, TextWidth( FONT_DEFAULT, t ) + 2, h - 8, SelectionBG );
+	TextInBox( FONT_DEFAULT, x + 4, y, w - 24, h, t, grayed ? DimBaseText : ControlText ); // as the game filter of the Steam version
+
+	// the button of the list: an arrow down
+	const bool armed = Hovered() && !grayed;
+	DrawArrow( x + w - 14, y + h / 2 - 1, true, armed ? BrightBaseText : DimBaseText );
+}
