+bool CMenuMain::SetSteamCommand( CSteamGameMenuItem &item, const SteamGameMenu::Entry &e )
+{
+	const char *cmd = e.command;
+
+	// the commands of GameUI of the Steam version, done by the menus of mainui
+	if( !stricmp( cmd, "ResumeGame" ))
+		item.onReleased = UI_CloseMenu;
+	else if( !stricmp( cmd, "Disconnect" ))
+		item.onReleased = VoidCb( &CMenuMain::DisconnectCb ); // at once, as in the Steam version
+	else if( !stricmp( cmd, "Quit" ))
+		item.onReleased = VoidCb( &CMenuMain::QuitDialogCb );
+	else if( !stricmp( cmd, "OpenOptionsDialog" ))
+		item.onReleased = UI_SteamOptions_Menu; // the Options window of the Steam version (SteamOptions.cpp)
+	else if( !stricmp( cmd, "OpenServerBrowser" ))
+		item.onReleased = UI_InternetGames_Menu;
+	else if( !stricmp( cmd, "OpenCreateMultiplayerGameDialog" ))
+		item.onReleased = UI_CreateGame_Menu;
+	else if( !stricmp( cmd, "OpenNewGameDialog" ))
+		item.onReleased = UI_NewGame_Menu;
+	else if( !stricmp( cmd, "OpenLoadGameDialog" ))
+		item.onReleased = UI_LoadGame_Menu;
+	else if( !stricmp( cmd, "OpenSaveGameDialog" ))
+		item.onReleased = UI_SaveGame_Menu;
+	else if( !stricmp( cmd, "OpenChangeGameDialog" ))
+		item.onReleased = UI_CustomGame_Menu;
+	else if( !strnicmp( cmd, "engine ", 7 ))
+		item.onReleased.SetCommand( false, cmd + 7 ); // "engine <console command>" as in GameUI
+	else
+		return false; // OpenPlayerListDialog and the like: no such menu here, the item is not shown
+
+	return true;
+}
+
+bool CMenuMain::InitSteamMenu()
+{
+	if( !SteamGameMenu::Load( steamEntries ))
+		return false;
+
+	// "Default" of TrackerScheme.res: Tahoma, tall 16 (the cell of the letters: 1.207 of their height), weight 0,
+	// without antialiasing
+	steamFont = CClientWindow::CreateSteamFont( "Tahoma", 13, 1.207f, 0, false );
+	if( steamFont <= 0 )
+		return false;
+
+	numSteamItems = 0;
+
+	for( int i = 0; i < steamEntries.Count() && numSteamItems < MAX_STEAM_ITEMS; i++ )
+	{
+		const SteamGameMenu::Entry &e = steamEntries[i];
+		CSteamGameMenuItem &item = steamItems[numSteamItems];
+		bool &supported = steamSupported[numSteamItems];
+
+		item.textFont = steamFont;
+		item.capHeight = 9;
+		item.spacer = !e.label[0];
+
+		if( item.spacer )
+		{
+			item.label[0] = 0;
+			item.iFlags |= QMF_INACTIVE;
+			supported = true;
+		}
+		else
+		{
+			Q_strncpy( item.label, L( e.label ), sizeof( item.label ));
+			item.iFlags |= QMF_NOTIFY;
+			supported = SetSteamCommand( item, e );
+		}
+
+		AddItem( item );
+		numSteamItems++;
+	}
+
+	if( steamLogo.Load( ))
+		AddItem( steamLogo );
+
+	dialog.Link( this );
+	return numSteamItems > 0;
+}
+
+void CMenuMain::VidInitSteamMenu( bool connected )
+{
+	// GameUI: "OnlyInGame" only while connected; in a game "notsingle" are hidden in a game of one player and "notmulti"
+	// in a game of many; "notsteam" only where a game may be changed (host_allow_changegame)
+	const bool single = gpGlobals->maxClients < 2;
+	bool shown[MAX_STEAM_ITEMS];
+	int count = 0;
+
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		const SteamGameMenu::Entry &e = steamEntries[i];
+		bool show = steamSupported[i];
+
+		if( e.onlyInGame && !connected )
+			show = false;
+		if( connected && e.notSingle && single )
+			show = false;
+		if( connected && e.notMulti && !single )
+			show = false;
+		if( e.notSteam && !bCustomGame )
+			show = false;
+		shown[i] = show;
+	}
+
+	// no empty line at the top, at the bottom or after another one (a hidden item between them)
+	bool lastWasSpacer = true;
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		if( !shown[i] )
+			continue;
+		if( steamItems[i].spacer && lastWasSpacer )
+			shown[i] = false;
+		else
+			lastWasSpacer = steamItems[i].spacer;
+	}
+	for( int i = numSteamItems - 1; i >= 0; i-- )
+	{
+		if( !shown[i] )
+			continue;
+		if( !steamItems[i].spacer )
+			break;
+		shown[i] = false;
+	}
+
+	for( int i = 0; i < numSteamItems; i++ )
+		if( shown[i] )
+			count++;
+
+	// the width of the menu: its widest item (all the items react on the whole width, as the buttons of GameUI)
+	int menuWide = 0;
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		if( shown[i] && !steamItems[i].spacer )
+		{
+			const int w = g_FontMgr->GetTextWideScaled( steamFont, steamItems[i].label, g_FontMgr->GetFontTall( steamFont ));
+			if( w > menuWide )
+				menuWide = w;
+		}
+	}
+	menuWide += 4;
+
+	// from the bottom: the capitals of the last item 82 pixels above the bottom of the screen, 28 pixels a line
+	int line = 0;
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		CSteamGameMenuItem &item = steamItems[i];
+
+		if( !shown[i] )
+		{
+			item.Hide();
+			continue;
+		}
+
+		item.Show();
+		item.capTop = gpGlobals->scrHeight - SteamGameMenu::LAST_CAP_FROM_BOTTOM - ( count - 1 - line ) * SteamGameMenu::ITEM_HEIGHT;
+		item.pixelPos = Point( SteamGameMenu::INSET, item.capTop - ( SteamGameMenu::ITEM_HEIGHT - item.capHeight ) / 2 );
+		item.pixelSize = Size( menuWide, SteamGameMenu::ITEM_HEIGHT );
+		line++;
+	}
+}
+
