+/*
+SteamGameMenu.h - the main menu as in the Steam version of Half-Life and its mods (GameUI of VGUI2)
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+#pragma once
+
+// The items come from resource/GameMenu.res of the game, as in the Steam version: "label" (a key of the
+// translations, "#GameUI_GameMenu_FindServers"), "command" (what GameUI does: "OpenServerBrowser"...) and the
+// conditions "OnlyInGame", "notsingle", "notmulti", "notsteam". An item with an empty label is a gap of one line.
+//
+// The look is "InGameDesktop" of platform/resource/TrackerScheme.res of the Steam version:
+//   "MenuColor" 200 200 200, "ArmedMenuColor" 255 255 255 (under the mouse), "DepressedMenuColor" 192 186 80
+//   (pressed), "MenuItemHeight" 28, "GameMenuInset" 32, "MenuItemVisibilityRate" 0.03 (the items appear one after
+//   another, 0.03 s apart, when the menu is opened)
+// and its font is "Default" of the same file: Tahoma, tall 16, weight 0, without antialiasing. The sizes are pixels,
+// they don't depend on the resolution (as in the Steam version). Measured at 1920x1080: the text from x 32, the
+// capitals of the last item 998..1006 (9 pixels high, 82 pixels above the bottom), the items 28 pixels apart, the
+// logo of the game (resource/game_menu.tga, resource/game_menu_mouseover.tga under the mouse) at (32, 1034).
+
+#include "Action.h"
+#include "utlvector.h"
+
+namespace SteamGameMenu {
+
+// the colours of "InGameDesktop"
+const unsigned int MENU_COLOR      = PackRGBA( 200, 200, 200, 255 );
+const unsigned int ARMED_COLOR     = PackRGBA( 255, 255, 255, 255 );
+const unsigned int DEPRESSED_COLOR = PackRGBA( 192, 186, 80, 255 );
+
+const int ITEM_HEIGHT = 28;    // "MenuItemHeight"
+const int INSET = 32;          // "GameMenuInset"
+const float ITEM_RATE = 0.03f; // "MenuItemVisibilityRate"
+
+const int LAST_CAP_FROM_BOTTOM = 82; // the top of the capitals of the last item, from the bottom of the screen
+const int LOGO_FROM_BOTTOM = 46;     // the top of resource/game_menu.tga, from the bottom of the screen
+
+struct Entry
+{
+	char label[128];
+	char command[64];
+	bool onlyInGame;
+	bool notSingle;
+	bool notMulti;
+	bool notSteam;
+};
+
+// resource/GameMenu.res of the game (the mod first, then the base game); false if there is none
+bool Load( CUtlVector<Entry> &entries );
+
+} // namespace SteamGameMenu
+
+// One item of the menu: its text in "Default", drawn in the colours of "InGameDesktop"
+class CSteamGameMenuItem : public CMenuAction
+{
+public:
+	typedef CMenuAction BaseClass;
+
+	CSteamGameMenuItem();
