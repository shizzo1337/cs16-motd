+CSteamComboBox::CSteamComboBox() : BaseClass()
+{
+}
+
+int CSteamComboBox::AddItem( const char *text, const char *data )
+{
+	Item it;
+	Q_strncpy( it.text, text ? text : "", sizeof( it.text ));
+	Q_strncpy( it.data, data ? data : "", sizeof( it.data ));
+	return items.AddToTail( it );
+}
+
+void CSteamComboBox::Select( int index )
+{
+	if( index < -1 || index >= items.Count( ))
+		return;
+	selected = index;
+}
+
+const char *CSteamComboBox::SelectedText() const
+{
+	return selected >= 0 && selected < items.Count() ? items[selected].text : "";
+}
+
+const char *CSteamComboBox::SelectedData() const
+{
+	return selected >= 0 && selected < items.Count() ? items[selected].data : "";
+}
+
+int CSteamComboBox::FindData( const char *data ) const
+{
+	for( int i = 0; i < items.Count(); i++ )
+		if( !stricmp( items[i].data, data ))
+			return i;
+	return -1;
+}
+
+bool CSteamComboBox::KeyDown( int key )
+{
+	if( UI::Key::IsLeftMouse( key ) && Hovered( ) && !( iFlags & QMF_GRAYED ))
+	{
+		open = !open;
+		// the controls of the windows of SteamUI.h are in a CSteamFrame
+		CSteamFrame *frame = static_cast<CSteamFrame *>( m_pParent );
+		if( frame )
+			frame->OpenList( open ? this : nullptr );
+
+		// the list starts at the chosen item
+		m_iListTop = selected > 0 ? selected : 0;
+		return true;
+	}
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamComboBox::ListRect( int &x, int &y, int &w, int &h, int &rowH, int &first, int &count ) const
+{
+	rowH = FontTall( FONT_DEFAULT ) + 4;
+	count = items.Count() < 12 ? items.Count() : 12;
+	first = m_iListTop;
+	if( first + count > items.Count( ))
+		first = items.Count() - count;
+	if( first < 0 )
+		first = 0;
+
+	x = m_scPos.x;
+	y = m_scPos.y + m_scSize.h;
+	w = m_scSize.w;
+	h = count * rowH + 2;
+
+	// above the box if there is no room under it
+	if( y + h > gpGlobals->scrHeight )
+		y = m_scPos.y - h;
+}
+
+void CSteamComboBox::DrawList()
+{
+	int x, y, w, h, rowH, first, count;
+	ListRect( x, y, w, h, rowH, first, count );
+
+	Fill( x, y, w, h, ControlBG );
+	RaisedBorder( x, y, w, h );
+
+	for( int i = 0; i < count; i++ )
+	{
+		const int idx = first + i;
+		const int ry = y + 1 + i * rowH;
+		const bool armed = UI_CursorInRect( x + 1, ry, w - 2, rowH );
+		if( armed )
+			Fill( x + 1, ry, w - 2, rowH, SelectionBG );
+		TextInBox( FONT_DEFAULT, x + 6, ry, w - 12, rowH, items[idx].text, armed ? BrightBaseText : DimBaseText );
+	}
+}
+
+bool CSteamComboBox::ListKey( int key )
+{
+	int x, y, w, h, rowH, first, count;
+	ListRect( x, y, w, h, rowH, first, count );
+
+	if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+	{
+		m_iListTop += key == K_MWHEELUP ? -1 : 1;
+		if( m_iListTop < 0 )
+			m_iListTop = 0;
+		if( m_iListTop > items.Count() - count )
+			m_iListTop = items.Count() - count;
+		return true;
+	}
+
+	if( UI::Key::IsLeftMouse( key ))
+	{
+		if( UI_CursorInRect( x, y, w, h ))
+		{
+			const int i = ( uiStatic.cursorY - y - 1 ) / rowH;
+			if( i >= 0 && i < count )
+			{
+				Select( first + i );
+				onChanged( this );
+			}
+		}
+		open = false;
+		return true;
+	}
+
+	if( UI::Key::IsEscape( key ))
+	{
+		open = false;
+		return true;
+	}
+
+	return false;
+}
+
+void CSteamComboBox::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	const bool grayed = ( iFlags & QMF_GRAYED ) != 0;
+
+	Fill( x, y, w, h, WindowBG );
+	InsetBorder( x, y, w, h );
+
+	// the chosen item: on "SelectionBG" while the box has the keyboard (as the Steam version shows "OpenGL")
+	const char *t = SelectedText();
+	const bool focus = ( iFlags & QMF_HASKEYBOARDFOCUS ) != 0;
+	if( focus && t[0] )
+		Fill( x + 3, y + 4, TextWidth( FONT_DEFAULT, t ) + 2, h - 8, SelectionBG );
+	TextInBox( FONT_DEFAULT, x + 4, y, w - 24, h, t, grayed ? DisabledText1 : ControlText );
+
+	// the button of the list: an arrow down
+	const bool armed = Hovered() && !grayed;
+	DrawArrow( x + w - 14, y + h / 2 - 1, true, armed ? BrightBaseText : DimBaseText );
+}
