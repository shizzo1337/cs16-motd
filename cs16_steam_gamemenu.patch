+// Measured on screenshots of the Steam version at 1920x1080 (a window of 960 x 569):
+//   the tabs from (8, 48) (the chosen one from 46), at least 72 pixels wide; the page under them a raised border from
+//   (8, 72) to (wide - 9, tall - 34); the status line under it from (11, tall - 28)
+//   the list of the servers: from the page (0, 8), a header of 18 pixels (raised cells, "DefaultSmall"), rows of 14
+//   pixels in "DefaultSmall"; the columns: the lock 16, the shield 16, Players 55, Servers (the rest), Game 112,
+//   Map 90, Latency 56, the scroll bar 17
+// The places of the list, the buttons and the filters come from platform/servers/InternetGamesPage.res and
+// InternetGamesPage_Filters.res of the Steam version (copied into resource/ of the game or found in servers/), with the
+// same numbers built in when the game has no such files. "AutoResize" and "PinCorner" of the files make the controls
+// follow the window when it is made bigger or smaller by its edges, as in the Steam version.
+//
+// The servers come from the engine (UI_AddServerToList), as for the server browser of mainui: the Internet and the
+// Spectate tabs ask the master servers ("internetservers"), Lan the local network ("localservers"), Favorites and
+// History ask every server of their lists ("ui_queryserver"). The lists are the files of mainui: favorite_servers.lst and
+// history_servers.lst. There is no Friends tab: it needs Steam.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "SteamUI.h"
+#include "SteamGameMenu.h"
+#include "net_api.h"
+
+using namespace SteamUI;
+
+namespace {
+
+enum ETab { TAB_INTERNET = 0, TAB_FAVORITES, TAB_HISTORY, TAB_SPECTATE, TAB_LAN, TAB_COUNT };
+
+// a translation of the server browser, or the English text of the Steam version when the game has no
+// resource/serverbrowser_<language>.txt
+const char *SB( const char *key, const char *english )
+{
+	const char *t = L( key );
+	return t != key && strcmp( t, key ) ? t : english;
+}
+
+struct SteamServer
+{
+	netadr_t adr;
+	char name[128];
+	char map[64];
+	char game[64];
+	int numcl = 0, maxcl = 0;
+	bool password = false;
+	bool goldsrc = false;
+	bool pending = true; // no answer yet (a server of the favorites or the history)
+	float ping = 0.0f;   // seconds
+	double queried = 0.0; // when it was asked (0: with the list of its tab)
+
+	const char *Protocol() const { return goldsrc ? "gs" : "49"; }
+};
+
+struct ListEntry
+{
+	char adr[128];
+	char prot[16];
+};
+
+void ReadList( const char *file, CUtlVector<ListEntry> &list )
+{
+	list.RemoveAll();
+	char *afile = (char *)EngFuncs::COM_LoadFile( file );
+	if( !afile )
+		return;
+
+	char *p = afile;
+	while( true )
+	{
+		ListEntry e;
+		p = EngFuncs::COM_ParseFile( p, e.adr, sizeof( e.adr ));
+		if( !p )
+			break;
+		p = EngFuncs::COM_ParseFile( p, e.prot, sizeof( e.prot ));
+		if( !p )
+			break;
+		if( !strcmp( e.prot, "48" ))
+			continue; // the old protocol, as mainui
+		list.AddToTail( e );
+	}
+	EngFuncs::COM_FreeFile( afile );
+}
+
+void WriteList( const char *file, const CUtlVector<ListEntry> &list )
+{
+	if( !list.Count( ))
+	{
+		EngFuncs::DeleteFile( file );
+		return;
+	}
+
+	CUtlString s;
+	for( int i = 0; i < list.Count(); i++ )
+		s.AppendFormat( "%s %s\n", list[i].adr, list[i].prot );
+	EngFuncs::COM_SaveFile( file, s.Get(), s.Length());
+}
+
+int FindInList( const CUtlVector<ListEntry> &list, const char *adr )
+{
+	for( int i = 0; i < list.Count(); i++ )
+		if( !strcmp( list[i].adr, adr ))
+			return i;
+	return -1;
+}
+
+// a lock, as the icon of the password column (7 x 9)
+void DrawLock( int x, int y, unsigned int c )
+{
+	Fill( x + 1, y, 5, 1, c );
+	Fill( x + 1, y, 1, 4, c );
+	Fill( x + 5, y, 1, 4, c );
+	Fill( x, y + 4, 7, 5, c );
+}
+
+// a shield, as the icon of the anti-cheat column (7 x 8)
+void DrawShield( int x, int y, unsigned int c )
+{
+	Fill( x, y, 7, 4, c );
+	Fill( x + 1, y + 4, 5, 2, c );
+	Fill( x + 2, y + 6, 3, 1, c );
+	Fill( x + 3, y + 7, 1, 1, c );
+}
