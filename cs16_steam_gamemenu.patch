+#pragma once
+
+// The items come from resource/GameMenu.res of the game, as in the Steam version: "label" (a key of the
+// translations, "#GameUI_GameMenu_FindServers"), "command" (what GameUI does: "OpenServerBrowser"...) and the
+// conditions "OnlyInGame", "notsingle", "notmulti", "notsteam". An item with an empty label is a gap of one line.
+//
+// The look is "InGameDesktop" of platform/resource/TrackerScheme.res of the Steam version:
+//   "MenuColor" 200 200 200, "ArmedMenuColor" 255 255 255 (under the mouse), "DepressedMenuColor" 192 186 80
+//   (pressed), "MenuItemHeight" 28, "GameMenuInset" 32, "MenuItemVisibilityRate" 0.03 (the items appear one after
