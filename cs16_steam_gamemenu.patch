+// ---------------------------------------------------------------------------------------------------------------------
+
+// The Player List of the main menu in a game on a server (CPlayerListDialog of GameUI), as resource/PlayerListDialog.res
+// of Half-Life (the same numbers are built in): the window 467 x 388, made bigger by its edges, its title "Current
+// players - <the server>"; the players at (28, 38) 410 x 279 (it grows with the window): Player name 128 pixels and
+// Properties ("Muted" when the voice of the player is off, as the Steam version writes it); "Mute in-game voice" (or
+// "Unmute in-game voice", the default) at (173, 326) 144 x 24 keeping to the bottom left corner and Close at (352, 352)
+// 86 x 24 keeping to the bottom right one. The players and their voices come from our client (IClientPlayerList and
+// IGameClientExports): with another client the menu doesn't show the item
+
+#include "cl_dll/IClientPlayerList.h"
+extern IClientPlayerList *g_pClientPlayers;
+
+class CSteamPlayerListDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamPlayerListDialog() : BaseClass( "CSteamPlayerListDialog", 467, 388 ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		Refresh();
+		m_list.Reset();
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+			return m_list.KeyDown( key );
+		if( UI::Key::IsEnter( key ))
+		{
+			ToggleMute();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		// the players come and go: the list follows them twice a second, the chosen player stays chosen
+		if( uiStatic.realTime > m_iNextRefresh )
+			Refresh();
+
+		const int player = Chosen();
+		const bool muted = player > 0 && g_pClient && g_pClient->IsPlayerGameVoiceMuted( player );
+		Q_strncpy( m_mute.text, muted ? "#GameUI_UnmuteIngameVoice" : "#GameUI_MuteIngameVoice", sizeof( m_mute.text ));
+		m_mute.SetGrayed( player <= 0 || !g_pClient );
+
+		// "Current players - <the server>"
+		const char *server = g_pClient ? g_pClient->GetServerHostName() : "";
+		char title[256];
+		Q_strncpy( title, Localize( "#GameUI_PlayerListDialogTitle" ), sizeof( title ));
+		char *arg = strstr( title, "%s1" );
+		if( arg )
+		{
+			char rest[256];
+			Q_strncpy( rest, arg + 3, sizeof( rest ));
+			snprintf( arg, sizeof( title ) - ( arg - title ), "%s%s", server ? server : "", rest );
+		}
+		SetTitle( title );
+
+		BaseClass::Draw();
+	}
+
+private:
+	void _Init() override
+	{
+		SetSizeable( true, 467, 388 );
+		m_list.numCols = 2;
+		m_list.widths[0] = 128;
+		m_list.titles[0] = "#GameUI_PlayerName";
+		m_list.titles[1] = "#GameUI_Properties";
+		m_list.onActivate = VoidCb( &CSteamPlayerListDialog::ToggleMute );
+		Q_strncpy( m_close.text, "#GameUI_Close", sizeof( m_close.text ));
+		m_mute.isDefault = true;
+		m_mute.onReleased = VoidCb( &CSteamPlayerListDialog::ToggleMute );
+		m_close.onReleased = VoidCb( &CSteamPlayerListDialog::Hide );
+		AddItem( m_list );
+		AddItem( m_mute );
+		AddItem( m_close );
+		OnResized();
+	}
+
+	void OnResized() override
+	{
+		const int dw = Wide() - 467, dh = Tall() - 388;
+		m_list.SetBounds( 28, 38, 410 + dw, 279 + dh );
+		m_mute.SetBounds( 173, 326 + dh, 144, 24 );
+		m_close.SetBounds( 352 + dw, 352 + dh, 86, 24 );
+	}
+
+	// the player (its slot) of the chosen row, 0 for none
+	int Chosen() const
+	{
+		if( m_list.selected < 0 || m_list.selected >= m_list.saves.Count( ))
+			return 0;
+		return atoi( m_list.saves[m_list.selected].name );
+	}
+
+	void Refresh()
+	{
+		m_iNextRefresh = uiStatic.realTime + 500;
+		const int keep = Chosen();
+		m_list.saves.RemoveAll();
+		m_list.selected = -1;
+		if( !g_pClientPlayers )
+			return;
+
+		const int max = g_pClientPlayers->GetMaxClients();
+		for( int i = 1; i <= max; i++ )
+		{
+			const char *name = g_pClientPlayers->GetPlayerName( i );
+			if( !name || g_pClientPlayers->IsLocalPlayer( i ))
+				continue; // the others only: the voice of the player is not his to mute
+			SteamSave s;
+			memset( &s, 0, sizeof( s ));
+			snprintf( s.name, sizeof( s.name ), "%d", i );
+			Q_strncpy( s.title, name, sizeof( s.title ));
+			if( g_pClient && g_pClient->IsPlayerGameVoiceMuted( i ))
+				Q_strncpy( s.type, "Muted", sizeof( s.type ));
+			if( i == keep )
+				m_list.selected = m_list.saves.Count();
+			m_list.saves.AddToTail( s );
+		}
+		if( m_list.selected < 0 && m_list.saves.Count( ))
+			m_list.selected = 0;
+	}
+
+	void ToggleMute()
+	{
+		const int player = Chosen();
+		if( player <= 0 || !g_pClient )
+			return;
+		if( g_pClient->IsPlayerGameVoiceMuted( player ))
+			g_pClient->UnmutePlayerGameVoice( player );
+		else
+			g_pClient->MutePlayerGameVoice( player );
+		Refresh();
+	}
+
+	CSteamSavesList m_list;
+	CSteamButton m_mute, m_close;
+	int m_iNextRefresh = 0;
+};
+
+static CSteamPlayerListDialog *s_playerList = nullptr;
+
+bool UI_SteamPlayerList_Available( void )
+{
+	return g_pClientPlayers != nullptr && g_pClient != nullptr;
+}
+
+void UI_SteamPlayerList_Menu( void )
+{
+	if( !UI_SteamPlayerList_Available( ))
+		return;
+	if( !s_playerList )
+		s_playerList = new CSteamPlayerListDialog;
+	s_playerList->Show();
+}
