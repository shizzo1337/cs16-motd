+void CSteamServerBrowser::AddToFavorites( const char *sadr, const char *prot )
+{
+	if( FindInList( m_favorites, sadr ) < 0 )
+	{
+		ListEntry e;
+		Q_strncpy( e.adr, sadr, sizeof( e.adr ));
+		Q_strncpy( e.prot, prot, sizeof( e.prot ));
+		m_favorites.AddToTail( e );
+		WriteList( "favorite_servers.lst", m_favorites );
+	}
+
+	if( ActivePage() == TAB_FAVORITES )
+		Refresh( false );
+}
