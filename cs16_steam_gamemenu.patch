+const unsigned int BaseText          = PackRGBA( 216, 222, 211, 255 );
+const unsigned int BrightBaseText    = PackRGBA( 255, 255, 255, 255 );
+const unsigned int DimBaseText       = PackRGBA( 160, 170, 149, 255 );
+const unsigned int ControlText       = PackRGBA( 216, 222, 211, 255 );
+const unsigned int BrightControlText = PackRGBA( 196, 181, 80, 255 );
+const unsigned int DisabledText1     = PackRGBA( 117, 128, 111, 255 );
+const unsigned int DisabledText2     = PackRGBA( 40, 46, 34, 255 );
