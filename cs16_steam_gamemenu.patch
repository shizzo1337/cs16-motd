+enum { MENU_CONNECT = 0, MENU_INFO, MENU_REFRESH, MENU_FAVORITE, MENU_ADD_BY_IP };
+
+void CSteamServerBrowser::OpenContextMenu()
+{
+	SteamServer *s = SelectedServer();
+	if( !s )
+		return;
+
+	// as the Steam version: Connect to server, View server info, Refresh server, then Add server to favorites (or,
+	// on the Favorites tab, Remove server from favorites and Add server by IP address)
+	m_menu.RemoveAll();
+	auto add = [this]( const char *text, int action )
+	{
+		MenuItem m;
+		Q_strncpy( m.text, text, sizeof( m.text ));
+		m.action = action;
+		m_menu.AddToTail( m );
+	};
+
+	add( SB( "ServerBrowser_ConnectToServer", "Connect to server" ), MENU_CONNECT );
+	add( SB( "ServerBrowser_ViewServerInfo", "View server info" ), MENU_INFO );
+	add( SB( "ServerBrowser_RefreshServer", "Refresh server" ), MENU_REFRESH );
+
+	if( ActivePage() == TAB_FAVORITES )
+	{
+		add( SB( "ServerBrowser_RemoveServerFromFavorites", "Remove server from favorites" ), MENU_FAVORITE );
+		add( SB( "ServerBrowser_AddServerByIP", "Add server by IP address" ), MENU_ADD_BY_IP );
+	}
+	else if( FindInList( m_favorites, EngFuncs::NET_AdrToString( s->adr )) < 0 )
+		add( SB( "ServerBrowser_AddServerToFavorites", "Add server to favorites" ), MENU_FAVORITE );
+
+	m_iMenuX = uiStatic.cursorX;
+	m_iMenuY = uiStatic.cursorY;
+	m_bMenu = true;
+}
+
+void CSteamServerBrowser::DrawMenu()
+{
+	int w = 0;
+	for( int i = 0; i < m_menu.Count(); i++ )
+	{
+		const int tw = TextWidth( FONT_DEFAULT, m_menu[i].text );
+		if( tw > w ) w = tw;
+	}
+	w += 6 * 2 + 2;
+	const int rowH = 22; // the items of the menus of VGUI2 (measured at 1920x1080)
+	const int h = m_menu.Count() * rowH + 2;
+	if( m_iMenuX + w > gpGlobals->scrWidth ) m_iMenuX = gpGlobals->scrWidth - w;
+	if( m_iMenuY + h > gpGlobals->scrHeight ) m_iMenuY = gpGlobals->scrHeight - h;
+
+	Fill( m_iMenuX, m_iMenuY, w, h, ControlBG );
+	RaisedBorder( m_iMenuX, m_iMenuY, w, h );
+	for( int i = 0; i < m_menu.Count(); i++ )
+	{
+		const int ry = m_iMenuY + 1 + i * rowH;
+		const bool armed = UI_CursorInRect( m_iMenuX + 1, ry, w - 2, rowH );
+		if( armed )
+			Fill( m_iMenuX + 1, ry, w - 2, rowH, SelectionBG );
+		TextInBox( FONT_DEFAULT, m_iMenuX + 7, ry, w - 12, rowH, m_menu[i].text, armed ? BrightBaseText : DimBaseText );
+	}
+}
+
+bool CSteamServerBrowser::MenuKey( int key )
+{
+	if( !UI::Key::IsLeftMouse( key ) && key != K_MOUSE2 && !UI::Key::IsEscape( key ))
+		return false;
+
+	m_bMenu = false;
+	if( !UI::Key::IsLeftMouse( key ))
+		return true;
+
+	const int rowH = 22; // the items of the menus of VGUI2 (measured at 1920x1080)
+	const int i = ( uiStatic.cursorY - m_iMenuY - 1 ) / rowH;
+	if( uiStatic.cursorX < m_iMenuX || uiStatic.cursorY < m_iMenuY || i < 0 || i >= m_menu.Count( ))
+		return true;
+
+	SteamServer *s = SelectedServer();
+	if( !s )
+		return true;
+
+	switch( m_menu[i].action )
+	{
+	case MENU_CONNECT: Connect( *s ); break;
+	case MENU_INFO: ShowGameInfo( *s ); break;
+	case MENU_FAVORITE: ToggleFavorite( *s ); break;
+	case MENU_ADD_BY_IP: AskAddServer(); break;
+	case MENU_REFRESH:
+	{
+		m_iRefreshTab = ActivePage();
+		s->pending = true;
+		s->queried = EngFuncs::DoubleTime(); // its own latency, the others' stay
+		EngFuncs::ClientCmdF( false, "ui_queryserver \"%s\" \"%s\"\n", EngFuncs::NET_AdrToString( s->adr ), s->Protocol());
+		break;
+	}
+	}
+	return true;
+}
+
+bool CSteamServerBrowser::KeyDown( int key )
+{
+	if( m_bMenu && MenuKey( key ))
+		return true;
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamServerBrowser::Draw()
+{
+	BaseClass::Draw();
+	if( m_bMenu )
+		DrawMenu();
+}
+
+void UI_SteamServerBrowser_Menu( void )
+{
+	if( !s_browser )
+	{
+		EngFuncs::CvarRegister( "ui_steam_serverbrowser_size", "", FCVAR_ARCHIVE );
+		EngFuncs::CvarRegister( "ui_steam_serverbrowser_columns", "", FCVAR_ARCHIVE );
+		s_browser = new CSteamServerBrowser;
+	}
+	s_browser->Show();
+}
