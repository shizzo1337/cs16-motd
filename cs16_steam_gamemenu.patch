+CMenuBaseWindow *CWindowStack::WindowAt( int x, int y, const CMenuBaseWindow *except ) const
+{
+	FOR_EACH_LL_BACK( stack, i )
+	{
+		CMenuBaseWindow *w = stack[i];
+
+		if( w == except || FBitSet( w->iFlags, QMF_CLOSING | QMF_HIDDEN ))
+			continue;
+
+		if( w->IsRoot( ))
+			return w;
+
+		const Point p = w->GetRenderPosition();
+		const Size s = w->GetRenderSize();
+		if( x >= p.x && x < p.x + s.w && y >= p.y && y < p.y + s.h )
+			return w;
+	}
+
+	return NULL;
+}
