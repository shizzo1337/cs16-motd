+void CSteamServerBrowser::Place( CMenuBaseItem *item, const char *name, const CUtlVector<Placed> &normal,
+	const CUtlVector<Placed> &filters, const Placed &builtin, const Placed *builtinFilters )
+{
+	Control c;
+	memset( &c, 0, sizeof( c ));
+	c.item = item;
+
+	const Placed *n = FindPlaced( normal, name );
+	const Placed *f = FindPlaced( filters, name );
+	c.normal = n ? *n : builtin;
+	c.inNormal = n ? n->visible : builtin.visible;
+	if( f )
+	{
+		c.filters = *f;
+		c.inFilters = f->visible;
+	}
+	else if( !filters.Count() && builtinFilters )
+	{
+		// no InternetGamesPage_Filters.res in the game: the same numbers as in the file of the Steam version
+		c.filters = *builtinFilters;
+		c.inFilters = builtinFilters->visible;
+	}
+	else
+	{
+		c.filters = c.normal;
+		c.inFilters = c.inNormal;
+	}
+	m_controls.AddToTail( c );
+	AddItem( *item );
+}
+
+// a control of the filters: hidden without them, shown with them at the same place
+void CSteamServerBrowser::PlaceFilter( CMenuBaseItem *item, const char *name, const CUtlVector<Placed> &normal,
+	const CUtlVector<Placed> &filters, const Placed &builtin )
+{
+	Placed shown = builtin;
+	shown.visible = true;
+	Place( item, name, normal, filters, builtin, &shown );
+}
