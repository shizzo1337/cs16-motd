+		SetTitle( "#GameUI_MultiplayerAdvanced" );
+
+		m_rows.SetBounds( 16, 56, 442, 274 );
+		AddItem( m_rows );
+
+		m_ok.SetBounds( 472 - 13 - 72 * 2 - 8, 338, 72, 24 );
+		m_cancel.SetBounds( 472 - 13 - 72, 338, 72, 24 );
+		Q_strncpy( m_ok.text, "#GameUI_OK", sizeof( m_ok.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_ok.isDefault = true;
