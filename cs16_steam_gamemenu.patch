+// The window of the password of a server, as servers/DialogServerPassword.res of the Steam version: 290 x 176, the name
+// of the server (dull) at (20, 42), "This server requires a password to join." at (20, 68), "Password" (east) at
+// (20, 95) 66 x 24 and its entry at (86, 96) 186 x 24, Connect at (116, 136) and Cancel at (198, 136), 74 x 24
+class CSteamPasswordDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+	typedef void ( CSteamFrame::*Done_t )();
+
+	CSteamPasswordDialog() : BaseClass( "CSteamPasswordDialog", 290, 176 )
+	{
+		m_bEscapeCloses = true; // a question: Escape is Cancel
+		m_bCloseButton = false;
+	}
+
+	template<class T> void Ask( const char *server, T *target, void ( T::*done )())
+	{
+		m_pTarget = target;
+		m_pfnDone = static_cast<Done_t>( done );
+		Show();
+		Q_strncpy( m_game.text, server, sizeof( m_game.text ));
+		m_entry.SetBuffer( "" );
+		SetCursorToItem( m_entry );
+	}
+
+	const char *Text() { return m_entry.GetBuffer(); }
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ))
+		{
+			Done();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( SB( "ServerBrowser_ServerRequiresPasswordTitle", "Server Requires Password" ));
+		m_game.SetBounds( 20, 42, 252, 24 );
+		m_game.dull = true;
+		m_info.SetBounds( 20, 68, 252, 24 );
+		Q_strncpy( m_info.text, SB( "ServerBrowser_PasswordRequired", "This server requires a password to join." ), sizeof( m_info.text ));
+		m_label.SetBounds( 20, 95, 66, 24 );
+		m_label.east = true;
+		Q_strncpy( m_label.text, SB( "ServerBrowser_PasswordLabel", "Password" ), sizeof( m_label.text ));
+		m_game.iFlags |= QMF_INACTIVE;
+		m_info.iFlags |= QMF_INACTIVE;
+		m_label.iFlags |= QMF_INACTIVE;
+		m_entry.SetBounds( 86, 96, 186, 24 );
+		m_entry.iMaxLength = 127;
+		m_entry.bHideInput = true;
+		m_connect.SetBounds( 116, 136, 74, 24 );
+		m_cancel.SetBounds( 198, 136, 74, 24 );
+		Q_strncpy( m_connect.text, SB( "ServerBrowser_Connect", "Connect" ), sizeof( m_connect.text ));
+		Q_strncpy( m_cancel.text, SB( "ServerBrowser_Cancel", "Cancel" ), sizeof( m_cancel.text ));
+		m_connect.isDefault = true;
+		m_connect.onReleased = VoidCb( &CSteamPasswordDialog::Done );
+		m_cancel.onReleased = VoidCb( &CSteamPasswordDialog::Hide );
+		AddItem( m_game );
+		AddItem( m_info );
+		AddItem( m_label );
+		AddItem( m_entry );
+		AddItem( m_connect );
+		AddItem( m_cancel );
+	}
+
+	void Done()
+	{
+		Hide();
+		if( m_pTarget && m_pfnDone )
+			( m_pTarget->*m_pfnDone )();
+	}
+
+	CSteamLabel m_game, m_info, m_label;
+	CSteamTextEntry m_entry;
+	CSteamButton m_connect, m_cancel;
+	CSteamFrame *m_pTarget = nullptr;
+	Done_t m_pfnDone = nullptr;
+};
