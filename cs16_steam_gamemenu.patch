 {
+	if( bSteamMenu )
+	{
+		// the menu was opened (it thinks only while it is shown): the items appear one after another, from the top
+		if( uiStatic.realTime - steamLastThink > 250.0f )
+		{
+			int line = 0;
+			for( int i = 0; i < numSteamItems; i++ )
+			{
+				if( !steamItems[i].IsVisible( ))
+					continue;
+				steamItems[i].appearTime = uiStatic.realTime + line * SteamGameMenu::ITEM_RATE * 1000.0f;
+				line++;
+			}
+		}
+		steamLastThink = uiStatic.realTime;
+
+		CMenuFramework::Think();
+		return;
+	}
+
 	if( gpGlobals->developer )
 	{
 		if( !console.IsVisible( ))
