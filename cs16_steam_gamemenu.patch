+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// Load Game and Save Game, as resource/LoadGameDialog.res and SaveGameDialog.res of Half-Life (the same numbers are
+// built in): the window 508 x 414, made bigger by its edges; the help (dull) at (20, 30) 470 x 50, the list at (16, 82)
+// 478 x 286 (it grows with the window), Load or Save (the default) at (282, 378) and Cancel at (394, 378), 102 x 24,
+// keeping to the bottom right corner.
+// Measured on a screenshot of the Steam version at 1920x1080: the header 18 pixels ("DefaultSmall", raised cells), the
+// columns Saved Game 175, Type 100, Elapsed Time 75 and Time Stamp (the rest), the scroll bar 17; rows of 16 pixels in
+// "Default", the text 6 pixels into its cell, the chosen row on "SelectionBG". The newest saved game comes first and is
+// chosen. The saved games are those of the Load Game menu of mainui (save/*.sav and their comments)
+
+struct SteamSave
+{
+	char name[64];     // the file, without .sav ("new": a new one)
+	char title[128];
+	char type[64];     // [autosave], [quick]
+	char elapsed[32];
+	char stamp[64];
+};
+
+// "COM_CompareSaves" of mainui: the newest first
+static int SteamCompareSaves( const void *a, const void *b )
+{
+	const char *file1 = *((const char **)a);
+	const char *file2 = *((const char **)b);
+	int result = 0;
+	EngFuncs::CompareFileTime( file2, file1, &result );
+	return result;
+}
+
+class CSteamSavesList : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	CUtlVector<SteamSave> saves; // the rows: title, type, elapsed, stamp are the columns
+	int selected = -1;
+	// the columns: their number, the widths of all but the last (it takes the rest), their titles
+	int numCols = 4;
+	int widths[3] = { 175, 100, 75 };
+	const char *titles[4] = { "#GameUI_SavedGame", "#GameUI_Type", "#GameUI_ElapsedTime", "#GameUI_TimeStamp" };
+	CEventCallback onActivate; // a double click
+
+	void Reset() { m_iTop = 0; selected = saves.Count() ? 0 : -1; }
+
+	bool KeyDown( int key ) override
+	{
+		const bool inside = UI_CursorInRect( m_scPos, m_scSize );
+		if(( key == K_MWHEELUP || key == K_MWHEELDOWN ) && inside )
+		{
+			m_iTop += key == K_MWHEELUP ? -3 : 3;
+			Clamp();
+			return true;
+		}
+		if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+		{
+			if( saves.Count( ))
+			{
+				selected += UI::Key::IsUpArrow( key ) ? -1 : 1;
+				if( selected < 0 ) selected = 0;
+				if( selected >= saves.Count( )) selected = saves.Count() - 1;
+				if( selected < m_iTop ) m_iTop = selected;
+				if( selected >= m_iTop + Visible( )) m_iTop = selected - Visible() + 1;
+			}
+			return true;
+		}
+		if( UI::Key::IsLeftMouse( key ) && inside )
+		{
+			Place();
+			if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+			{
+				m_iTop = m_sb.top;
+				return true;
+			}
+			// the header: the line at the right edge of a column (but the last one) makes it wider or narrower
+			if( uiStatic.cursorY < RowsTop( ))
+			{
+				const int edge = EdgeAt( uiStatic.cursorX );
+				if( edge >= 0 )
+				{
+					m_iDragEdge = edge;
+					m_iDragStartX = uiStatic.cursorX;
+					m_iDragStartW = widths[edge];
+				}
+				return true;
+			}
+			const int row = ( uiStatic.cursorY - RowsTop( )) / ROW;
+			if( uiStatic.cursorY >= RowsTop() && row >= 0 && m_iTop + row < saves.Count( ))
+			{
+				const int i = m_iTop + row;
+				const bool dbl = i == selected && uiStatic.realTime - m_iLastClick < 400;
+				selected = i;
+				m_iLastClick = uiStatic.realTime;
+				if( dbl && onActivate )
+					onActivate( this );
+			}
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		Place();
+		m_sb.Clamp();
+		m_sb.Think();
+		m_iTop = m_sb.top;
+		DragEdge();
+		if( m_iDragEdge >= 0 )
+			WantCursor( this, dc_sizewe, true );
+		else if( UI_CursorInRect( m_scPos, m_scSize ) && uiStatic.cursorY < RowsTop() && EdgeAt( uiStatic.cursorX ) >= 0 )
+			WantCursor( this, dc_sizewe );
+
+		const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+		Fill( x, y, w, h, ListBG );
+		InsetBorder( x, y, w, h );
+
+		// the header
+		int cols[5];
+		Columns( cols );
+		for( int c = 0; c < numCols; c++ )
+		{
+			Fill( cols[c], y + 1, cols[c + 1] - cols[c], 18, ControlBG );
+			RaisedBorder( cols[c], y + 1, cols[c + 1] - cols[c], 18 );
+			TextInBox( FONT_DEFAULT_SMALL, cols[c] + 5, y + 1, cols[c + 1] - cols[c] - 7, 18, Localize( titles[c] ), ControlText );
+		}
+
+		// the rows
+		for( int r = 0; r < Visible() && m_iTop + r < saves.Count(); r++ )
+		{
+			const int i = m_iTop + r;
+			const SteamSave &s = saves[i];
+			const int ry = RowsTop() + r * ROW;
+			const bool sel = i == selected;
+			if( sel )
+				Fill( x + 3, ry + 1, cols[numCols] - x - 4, ROW - 1, SelectionBG );
+			const unsigned int c = sel ? BrightBaseText : BaseText;
+			const char *texts[4] = { s.title, s.type, s.elapsed, s.stamp };
+			for( int k = 0; k < numCols; k++ )
+				TextInBox( FONT_DEFAULT, cols[k] + 6, ry, cols[k + 1] - cols[k] - 7, ROW, Localize( texts[k] ), c );
+		}
+
+		Place();
+		m_sb.Draw();
+	}
+
+private:
+	static const int ROW = 16;
+	int RowsTop() const { return m_scPos.y + 1 + 18 + 1; }
+	int Visible() const { return ( m_scSize.h - 2 - 18 - 1 ) / ROW; }
+	void Columns( int cols[5] ) const
+	{
+		// Saved Game 175, Type 100, Elapsed Time 75, Time Stamp up to the scroll bar
+		cols[0] = m_scPos.x + 1;
+		for( int c = 1; c < numCols; c++ )
+			cols[c] = cols[c - 1] + widths[c - 1];
+		cols[numCols] = m_scPos.x + m_scSize.w - 1 - 17;
+		if( cols[numCols] < cols[numCols - 1] + 20 )
+			cols[numCols] = cols[numCols - 1] + 20;
+	}
+	// the edge (the column left of it) under x in the header, -1 when none: 3 pixels on each side of the line
+	int EdgeAt( int cx ) const
+	{
+		int cols[5];
+		Columns( cols );
+		for( int c = 1; c < numCols; c++ )
+			if( cx >= cols[c] - 3 && cx <= cols[c] + 3 )
+				return c - 1;
+		return -1;
+	}
+	// a column made wider or narrower while the button is held: at least 20 pixels for it and for the last one
+	void DragEdge()
+	{
+		if( m_iDragEdge < 0 )
+			return;
+		if( !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+		{
+			m_iDragEdge = -1;
+			return;
+		}
+		int others = 0;
+		for( int c = 0; c < numCols - 1; c++ )
+			if( c != m_iDragEdge )
+				others += widths[c];
+		const int maxW = m_scSize.w - 2 - 17 - others - 20;
+		int nw = m_iDragStartW + uiStatic.cursorX - m_iDragStartX;
+		if( nw > maxW ) nw = maxW;
+		if( nw < 20 ) nw = 20;
+		widths[m_iDragEdge] = nw;
+	}
+	void Clamp()
+	{
+		const int maxTop = saves.Count() - Visible();
+		if( m_iTop > maxTop ) m_iTop = maxTop;
+		if( m_iTop < 0 ) m_iTop = 0;
+	}
+	void Place()
+	{
+		m_sb.w = 17;
+		m_sb.x = m_scPos.x + m_scSize.w - 1 - 17;
+		m_sb.y = m_scPos.y + 1;
+		m_sb.h = m_scSize.h - 2;
+		m_sb.total = saves.Count();
+		m_sb.visible = Visible();
+		m_sb.top = m_iTop;
+	}
+
+	int m_iTop = 0;
+	int m_iLastClick = 0;
+	int m_iDragEdge = -1, m_iDragStartX = 0, m_iDragStartW = 0;
+	ScrollBar m_sb;
+};
+
+class CSteamSaveLoadDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamSaveLoadDialog( bool save ) : BaseClass( save ? "CSteamSaveGameDialog" : "CSteamLoadGameDialog", 508, 414 ),
+		m_bSave( save ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		FillSaves();
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ))
+		{
+			Done();
+			return true;
+		}
+		if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+			return m_list.KeyDown( key );
