+void CSteamServerBrowser::OnPageChanged( int page )
+{
+	m_bMenu = false;
+	m_list.ClearSelection();
+	m_list.SetServers( &m_servers[page] );
+
+	switch( page )
+	{
+	case TAB_FAVORITES: m_list.emptyText = SB( "ServerBrowser_NoFavoriteServers", "You currently have no favorite servers selected." ); break;
+	case TAB_HISTORY: m_list.emptyText = SB( "ServerBrowser_NoServersPlayed", "No servers have been played recently." ); break;
+	case TAB_LAN: m_list.emptyText = SB( "ServerBrowser_NoLanServers", "There are no servers running on your local network." ); break;
+	default: m_list.emptyText = SB( "ServerBrowser_NoInternetGames", "There are no internet games visible that pass your filter settings." ); break;
+	}
+
+	Layout();
+
+	// a tab seen for the first time asks for its servers
+	if( !m_servers[page].Count( ))
+		Refresh( true );
