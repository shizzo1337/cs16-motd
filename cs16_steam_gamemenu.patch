+static const CMenuItemsHolder *s_cursorWindow = nullptr; // the window of the Steam version under the cursor
+static int s_cursorShape = -1;
+
+void SteamUI::WantCursor( const CMenuBaseItem *item, int shape, bool always )
+{
+	if( always || ( item && s_cursorWindow && item->Parent() == s_cursorWindow ))
+		s_cursorShape = shape;
+}
+
+int SteamUI_TakeCursor( bool &steamWindow )
+{
+	const int shape = s_cursorShape;
+	steamWindow = s_cursorWindow != nullptr;
+	s_cursorShape = -1;
+	s_cursorWindow = nullptr;
+	return shape;
+}
+
+// the arrows of the edges of a window: 1 left, 2 right, 4 top, 8 bottom
+static int EdgesCursor( int edges )
+{
+	const bool h = ( edges & 3 ) != 0, v = ( edges & 12 ) != 0;
+	if( h && v )
+		return (( edges & 2 ) != 0 ) == (( edges & 8 ) != 0 ) ? dc_sizenwse : dc_sizenesw;
+	return h ? dc_sizewe : dc_sizens;
+}
