+	}
+
+	void Draw() override
+	{
+		m_ok.SetGrayed( m_list.selected < 0 || ( m_bSave && !CL_IsActive( )));
+		BaseClass::Draw();
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( m_bSave ? "#GameUI_SaveGame" : "#GameUI_LoadGame" );
+		SetSizeable( true, 508, 414 );
+
+		int hx = 20, hy = 30, hw = 470, hh = 50, lx = 16, ly = 82, lw = 478, lh = 286, bx = 282, cx = 394, by = 378;
+		if( ResNode *res = LoadRes( m_bSave ? "resource/SaveGameDialog.res" : "resource/LoadGameDialog.res" ))
+		{
+			if( const ResNode *n = res->Find( "HelpText" ))
+			{
+				hx = n->GetInt( "xpos", hx ); hy = n->GetInt( "ypos", hy ); hw = n->GetInt( "wide", hw ); hh = n->GetInt( "tall", hh );
+			}
+			if( const ResNode *n = res->Find( "listpanel_loadgame" ))
+			{
+				lx = n->GetInt( "xpos", lx ); ly = n->GetInt( "ypos", ly ); lw = n->GetInt( "wide", lw ); lh = n->GetInt( "tall", lh );
+			}
+			if( const ResNode *n = res->Find( m_bSave ? "Save" : "Load" ))
+			{
+				bx = n->GetInt( "xpos", bx ); by = n->GetInt( "ypos", by );
+			}
+			if( const ResNode *n = res->Find( "Cancel" ))
+				cx = n->GetInt( "xpos", cx );
+			delete res;
+		}
+		m_help0 = Rect{ hx, hy, hw, hh };
+		m_list0 = Rect{ lx, ly, lw, lh };
+		m_ok0 = Rect{ bx, by, 102, 24 };
+		m_cancel0 = Rect{ cx, by, 102, 24 };
+
+		Q_strncpy( m_help.text, m_bSave ? "#GameUI_SaveGameHelp" : "#GameUI_LoadGameHelp", sizeof( m_help.text ));
+		m_help.dull = true;
+		m_help.wrap = true;
+		m_help.iFlags |= QMF_INACTIVE;
+		AddItem( m_help );
+
+		m_list.onActivate = VoidCb( &CSteamSaveLoadDialog::Done );
+		AddItem( m_list );
+
+		Q_strncpy( m_ok.text, m_bSave ? "#GameUI_Save" : "#GameUI_Load", sizeof( m_ok.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_ok.isDefault = true;
+		m_ok.onReleased = VoidCb( &CSteamSaveLoadDialog::Done );
+		m_cancel.onReleased = VoidCb( &CSteamSaveLoadDialog::Hide );
+		AddItem( m_ok );
+		AddItem( m_cancel );
+		OnResized();
+	}
+
+	// the help grows to the right, the list to the right and down, the buttons keep to the bottom right corner
+	void OnResized() override
+	{
+		const int dw = Wide() - 508, dh = Tall() - 414;
+		m_help.SetBounds( m_help0.x, m_help0.y, m_help0.w + dw, m_help0.h );
+		m_list.SetBounds( m_list0.x, m_list0.y, m_list0.w + dw, m_list0.h + dh );
+		m_ok.SetBounds( m_ok0.x + dw, m_ok0.y + dh, m_ok0.w, m_ok0.h );
+		m_cancel.SetBounds( m_cancel0.x + dw, m_cancel0.y + dh, m_cancel0.w, m_cancel0.h );
+	}
+
+	// the saved games as the Load Game menu of mainui reads them
+	void FillSaves()
+	{
+		m_list.saves.RemoveAll();
+
+		if( m_bSave && CL_IsActive( ))
+		{
+			SteamSave s;
+			memset( &s, 0, sizeof( s ));
+			Q_strncpy( s.name, "new", sizeof( s.name )); // made by the engine (SV_Save_f)
+			Q_strncpy( s.title, "#GameUI_SaveGame_NewSavedGame", sizeof( s.title ));
+			Q_strncpy( s.elapsed, "#GameUI_SaveGame_New", sizeof( s.elapsed ));
+			Q_strncpy( s.stamp, "#GameUI_SaveGame_Current", sizeof( s.stamp ));
+			m_list.saves.AddToTail( s );
+		}
+
+		int numFiles = 0;
+		char **files = EngFuncs::GetFilesList( "save/*.sav", &numFiles, true );
+		if( files && numFiles > 1 )
+			qsort( files, numFiles, sizeof( *files ), SteamCompareSaves );
+
+		for( int i = 0; files && i < numFiles; i++ )
+		{
+			SteamSave s;
+			memset( &s, 0, sizeof( s ));
+			COM_FileBase( files[i], s.name, sizeof( s.name ));
+
+			char comment[256];
+			if( !EngFuncs::GetSaveComment( files[i], comment ))
+			{
+				// <CORRUPTED>, <OLD VERSION>...: shown, as the menu of mainui shows them
+				if( comment[0] )
+				{
+					Q_strncpy( s.title, comment, sizeof( s.title ));
+					m_list.saves.AddToTail( s );
+				}
+				continue;
+			}
+
+			// the comment: the title (CS_SIZE), the time, the date (CS_TIME each), the time in the game
+			char time[CS_TIME + 1], date[CS_TIME + 1];
+			Q_strncpy( time, comment + CS_SIZE, sizeof( time ));
+			Q_strncpy( date, comment + CS_SIZE + CS_TIME, sizeof( date ));
+			snprintf( s.stamp, sizeof( s.stamp ), "%s %s", date, time );
+			Q_strncpy( s.elapsed, comment + CS_SIZE + CS_TIME * 2, sizeof( s.elapsed ));
+
+			// "[autosave]#TITLE" or "#TITLE": the type in its own column, as in the Steam version
+			comment[CS_SIZE - 1] = 0;
+			char *title = comment;
+			if( comment[0] == '[' )
+			{
+				char *end = strchr( comment, ']' );
+				if( end )
+				{
+					*end = 0;
+					const char *type = comment + 1;
+					if( !stricmp( type, "autosave" ))
+						Q_strncpy( s.type, "#GameUI_AutoSave", sizeof( s.type ));
+					else if( !stricmp( type, "quick" ))
+						Q_strncpy( s.type, "#GameUI_QuickSave", sizeof( s.type ));
+					else
+						snprintf( s.type, sizeof( s.type ), "[%s]", type );
+					title = end + 1;
+				}
+			}
+			// a title to translate ends at the first space
+			if( title[0] == '#' )
+			{
+				char *sp = strchr( title, ' ' );
+				if( sp )
+					*sp = 0;
+			}
+			for( int k = (int)strlen( title ) - 1; k >= 0 && isspace( (unsigned char)title[k] ); k-- )
+				title[k] = 0;
+			Q_strncpy( s.title, title, sizeof( s.title ));
+			m_list.saves.AddToTail( s );
+		}
+
+		m_list.Reset();
+	}
+
+	void Done()
+	{
+		if( m_list.selected < 0 || m_list.selected >= m_list.saves.Count( ))
+			return;
+		const char *name = m_list.saves[m_list.selected].name;
+		char cmd[160];
+
+		if( m_bSave )
+		{
+			if( !CL_IsActive( ))
+				return;
+			snprintf( cmd, sizeof( cmd ), "save/%s.bmp", name );
+			EngFuncs::PIC_Free( cmd ); // the new picture of the save
+			snprintf( cmd, sizeof( cmd ), "save \"%s\"\n", name );
+			EngFuncs::ClientCmd( false, cmd );
+		}
+		else
+		{
+			snprintf( cmd, sizeof( cmd ), "load \"%s\"\n", name );
+			EngFuncs::StopBackgroundTrack();
+			EngFuncs::ClientCmd( false, cmd );
+		}
+		Hide();
+		UI_CloseMenu(); // back to the game, as the Steam version
+	}
+
+	struct Rect { int x, y, w, h; };
+	Rect m_help0, m_list0, m_ok0, m_cancel0;
+	bool m_bSave;
+	CSteamLabel m_help;
+	CSteamSavesList m_list;
+	CSteamButton m_ok, m_cancel;
+};
+
