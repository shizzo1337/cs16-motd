+CSteamMessageBox::CSteamMessageBox() : BaseClass( "CSteamMessageBox", 296, 114 )
+{
+	m_bCloseButton = false;
+	m_bEscapeCloses = true;
+}
+
+void CSteamMessageBox::_Init()
+{
+	m_message.iFlags |= QMF_INACTIVE;
+	m_ok.isDefault = true;
+	m_ok.onReleased = VoidCb( &CSteamMessageBox::Ok );
+	m_cancel.onReleased = VoidCb( &CSteamMessageBox::Hide );
+	AddItem( m_message );
+	AddItem( m_ok );
+	AddItem( m_cancel );
+}
+
+void CSteamMessageBox::Ask( const char *title, const char *message, const char *okText, const char *cancelText, CEventCallback onOk )
+{
+	SetTitle( title );
+	Q_strncpy( m_message.text, message, sizeof( m_message.text ));
+	Q_strncpy( m_ok.text, okText, sizeof( m_ok.text ));
+	Q_strncpy( m_cancel.text, cancelText, sizeof( m_cancel.text ));
+	m_onOk = onOk;
+	Show();
+}
+
+void CSteamMessageBox::_VidInit()
+{
+	// the buttons as wide as their texts, the window as wide as what it holds
+	int okW = TextWidth( FONT_DEFAULT, Localize( m_ok.text )) + 16;
+	int cancelW = TextWidth( FONT_DEFAULT, Localize( m_cancel.text )) + 16;
+	if( okW < 72 ) okW = 72;
+	if( cancelW < 72 ) cancelW = 72;
+	const int group = okW + 18 + cancelW;
+	const int msgW = TextWidth( FONT_DEFAULT, Localize( m_message.text ));
+
+	int w = 296;
+	if( msgW + 110 > w ) w = msgW + 110;
+	if( group + 110 > w ) w = group + 110;
+	m_iWide = w;
+
+	BaseClass::_VidInit();
+
+	// as the Steam version places it: 26 pixels right of the middle (for the window of 296)
+	pos = Point( gpGlobals->scrWidth / 2 - 122 - ( w - 296 ) / 2, gpGlobals->scrHeight / 2 - 57 );
+
+	m_message.SetBounds( 0, 41, w, FontTall( FONT_DEFAULT ));
+	m_message.center = true;
+
+	const int bx = ( w - group ) / 2;
+	m_ok.SetBounds( bx, 70, okW, 24 );
+	m_cancel.SetBounds( bx + okW + 18, 70, cancelW, 24 );
+}
+
+void CSteamMessageBox::Ok()
+{
+	Hide();
+	if( m_onOk )
+		m_onOk( this );
+}
+
+bool CSteamMessageBox::KeyDown( int key )
+{
+	if( UI::Key::IsEnter( key ))
+	{
+		Ok();
+		return true;
+	}
+	return BaseClass::KeyDown( key );
+}
