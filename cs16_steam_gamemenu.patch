+
+void CSteamServerBrowser::Layout()
+{
+	// the page of the .res files is 624 x 278; it grows with the window
+	const int pageW = m_iWide - 8 - 9, pageH = m_iTall - 72 - 34;
+	const int dw = pageW - 624, dh = pageH - 278;
+	const int tab = ActivePage();
+
+	for( int i = 0; i < m_controls.Count(); i++ )
+	{
+		Control &c = m_controls[i];
+		const Placed &p = m_bFilters ? c.filters : c.normal;
+		bool visible = m_bFilters ? c.inFilters : c.inNormal;
+
+		// the buttons of the tabs: Favorites adds servers, the others refresh quickly
+		if( c.item == &m_addServer || c.item == &m_addCurrent )
+			visible = tab == TAB_FAVORITES;
+		else if( c.item == &m_refreshQuick )
+			visible = tab != TAB_FAVORITES;
+
+		int x = p.x, y = p.y, w = p.w, h = p.h;
+		if( p.autoResize & 1 ) w += dw;
+		if( p.autoResize & 2 ) h += dh;
+		if( p.pinCorner == 1 || p.pinCorner == 3 ) x += dw;
+		if( p.pinCorner == 2 || p.pinCorner == 3 ) y += dh;
+
+		c.item->pos = Point( PageOrigin().x + x, PageOrigin().y + y );
+		c.item->size = Size( w, h );
+		c.item->SetVisibility( visible );
+	}
+
+	m_status.pos = Point( 11, m_iTall - 28 );
+	m_status.size = Size( m_iWide - 11 - 80, 24 );
+
+	CalcItemsPositions();
+	CalcItemsSizes();
+}
