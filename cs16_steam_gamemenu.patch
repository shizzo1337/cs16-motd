+*/
+
+#pragma once
+
+// The colours and the fonts are those of platform/resource/TrackerScheme.res of the Steam version, the places of the
+// controls of a page come from its .res file (resource/OptionsSubMouse.res...: xpos, ypos, wide, tall of every
+// control, in pixels from the corner of the page). The windows don't depend on the resolution, as in the Steam
+// version. Measured on screenshots of the Steam version at 1920x1080:
+//
+//   a window: a raised border of 1 pixel ("BorderBright" 136 145 128 left and top, "BorderDark" 40 46 34 right and
+//   bottom) around "ControlBG" (76 88 68); its title from (21, 8) in "Default" (Tahoma 16, white), the close button
+//   18 x 18 at (wide - 25, 8)
+//   the tabs (a property sheet): from (5, 31), 24 pixels high (the chosen one 2 pixels higher and joined to the page),
+//   as wide as their text + 16 but at least 64, 1 pixel apart; the text of the chosen one "BrightControlText"
+//   (196 181 80), of the others white; the page under them: a raised border at (5, 55), wide - 10 x tall - 92
+//   the buttons OK, Cancel, Apply: 72 x 24, 8 pixels apart, the last one 14 pixels from the right, 9 from the bottom
+//   a check button: a box of 14 x 14 at (3, (tall - 14) / 2 - 1) with an inset border on "ListBG" (62 70 55), the
+//   text from x 27, white when not checked and "BrightControlText" when checked
+//   a slider: the track 3 pixels of "SliderTrackColor" (31 31 31) and a bright line under it, 8 pixels from the
+//   top, as wide as the control minus 8; the nob 8 x 16 raised from y 2; 11 ticks of 4 pixels from y 23
+//   a text entry: an inset border on "WindowBG" (62 70 55), the text from x 4
+
+#include "BaseWindow.h"
+#include "Action.h"
+#include "Field.h"
+#include "utlvector.h"
+
+namespace SteamUI {
+
+// the colours of TrackerScheme.res
+extern const unsigned int BaseText, BrightBaseText, DimBaseText, ControlText, BrightControlText, DisabledText1,
+	DisabledText2, ControlBG, ControlDarkBG, WindowBG, SelectionBG, ListBG, TitleText, BorderBright, BorderDark,
+	BorderSelection, SliderTickColor, SliderTrackColor;
+
+// the fonts of TrackerScheme.res (made when first asked for)
+enum EFont
+{
+	FONT_DEFAULT = 0,     // "Default": Tahoma, tall 16
+	FONT_DEFAULT_SMALL,   // "DefaultSmall": Tahoma, tall 13
+	FONT_DEFAULT_VERYSMALL, // "DefaultVerySmall": Tahoma, tall 12
+	FONT_COUNT
+};
+HFont Font( EFont font );
+int FontTall( EFont font );
+int TextWidth( EFont font, const char *text );
+
+// drawing, in pixels of the screen
+void Fill( int x, int y, int w, int h, unsigned int color );
+void RaisedBorder( int x, int y, int w, int h );
+void InsetBorder( int x, int y, int w, int h );
+// a line of text: y is the top of the cell of the font
+void Text( EFont font, int x, int y, const char *text, unsigned int color, int maxWidth = 4096 );
+// a text in the box (x, y, w, h): "west" or "east", the cell in the middle of the height
+void TextInBox( EFont font, int x, int y, int w, int h, const char *text, unsigned int color, bool east = false );
+// a text broken into lines at the spaces to fit the width; returns the number of lines
+int WrappedText( EFont font, int x, int y, int w, int h, const char *text, unsigned int color );
+void DrawCheck( int x, int y, unsigned int color );            // the mark of a check button in a box of 14 x 14
+void DrawArrow( int x, int y, bool down, unsigned int color ); // a small triangle (7 x 4) from (x, y)
+
+// "#GameUI_..." through the translations, anything else as it is
+const char *Localize( const char *text );
+
+// A .res file of VGUI2: "name" { "key" "value" ... "child" { ... } }
+struct ResNode
+{
+	char name[64];
+	char value[256];
+	CUtlVector<ResNode *> children;
+
+	ResNode() { name[0] = value[0] = 0; }
+	~ResNode();
+
+	const ResNode *Find( const char *key ) const;
+	const char *GetString( const char *key, const char *def = "" ) const;
+	int GetInt( const char *key, int def = 0 ) const;
+};
+ResNode *LoadRes( const char *path ); // NULL if there is no such file
+
+} // namespace SteamUI
+
+// The base of the controls: placed in pixels from the corner of their page or window
+class CSteamControl : public CMenuBaseItem
