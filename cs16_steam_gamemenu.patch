+class CSteamNewGameDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamNewGameDialog() : BaseClass( "CSteamNewGameDialog", 372, 260 ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		// no training map in the game: no Training Room
+		const bool training = gMenu.m_gameinfo.trainmap[0] != 0;
+		m_choice[0].SetVisibility( training );
+		if( !training && m_iChosen == 0 )
+			Choose( 1 );
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ))
+		{
+			Play();
+			return true;
+		}
+		if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+		{
+			int i = m_iChosen + ( UI::Key::IsUpArrow( key ) ? -1 : 1 );
+			if( i < ( m_choice[0].IsVisible() ? 0 : 1 )) i = 3;
+			if( i > 3 ) i = m_choice[0].IsVisible() ? 0 : 1;
+			Choose( i );
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( "#GameUI_NewGame" );
+
+		struct { const char *name, *text; int x, y, w, h; } places[] = {
+			{ "Training", "#GameUI_TrainingRoom", 40, 94, 220, 24 }, { "Easy", "#GameUI_Easy", 40, 118, 220, 24 },
+			{ "Medium", "#GameUI_Medium", 40, 142, 220, 24 }, { "Hard", "#GameUI_Hard", 40, 166, 220, 24 },
+		};
+		int hx = 44, hy = 48, hw = 292, hh = 40, px = 204, py = 222, cx = 286, cy = 222;
+
+		// the places of the .res of the game, if it has one
+		if( ResNode *res = LoadRes( "resource/NewGameDialog.res" ))
+		{
+			for( auto &p : places )
+				if( const ResNode *n = res->Find( p.name ))
+				{
+					p.x = n->GetInt( "xpos", p.x ); p.y = n->GetInt( "ypos", p.y );
+					p.w = n->GetInt( "wide", p.w ); p.h = n->GetInt( "tall", p.h );
+				}
+			if( const ResNode *n = res->Find( "HelpText" ))
+			{
+				hx = n->GetInt( "xpos", hx ); hy = n->GetInt( "ypos", hy );
+				hw = n->GetInt( "wide", hw ); hh = n->GetInt( "tall", hh );
+			}
+			if( const ResNode *n = res->Find( "Play" ))
+			{
+				px = n->GetInt( "xpos", px ); py = n->GetInt( "ypos", py );
+			}
+			if( const ResNode *n = res->Find( "Cancel" ))
+			{
+				cx = n->GetInt( "xpos", cx ); cy = n->GetInt( "ypos", cy );
+			}
+			delete res;
+		}
+
+		m_help.SetBounds( hx, hy, hw, hh );
+		Q_strncpy( m_help.text, "#GameUI_NewGameHelpText", sizeof( m_help.text ));
+		m_help.dull = true;
+		m_help.wrap = true;
+		m_help.iFlags |= QMF_INACTIVE;
+		AddItem( m_help );
+
+		for( int i = 0; i < 4; i++ )
+		{
+			m_choice[i].SetBounds( places[i].x, places[i].y, places[i].w, places[i].h );
+			Q_strncpy( m_choice[i].text, places[i].text, sizeof( m_choice[i].text ));
+			m_choice[i].onChosen = MenuCb( &CSteamNewGameDialog::Chosen );
+			m_choice[i].onChosen.pExtra = (void *)(intptr_t)i;
+			AddItem( m_choice[i] );
+		}
+
+		m_play.SetBounds( px, py, 72, 24 );
+		m_cancel.SetBounds( cx, cy, 72, 24 );
+		Q_strncpy( m_play.text, "#GameUI_Play", sizeof( m_play.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_play.isDefault = true;
+		m_play.onReleased = VoidCb( &CSteamNewGameDialog::Play );
+		m_cancel.onReleased = VoidCb( &CSteamNewGameDialog::Hide );
+		AddItem( m_play );
+		AddItem( m_cancel );
+
+		Choose( 0 ); // the Training Room, as the Steam version opens it
+	}
+
+	void Chosen( void *extra )
+	{
+		Choose( (int)(intptr_t)extra );
+	}
+
+	void Choose( int i )
+	{
+		m_iChosen = i;
+		for( int k = 0; k < 4; k++ )
+			m_choice[k].selected = k == i;
+	}
+
+	void Play()
+	{
+		Hide();
+
+		if( EngFuncs::GetCvarFloat( "host_serverstate" ) && EngFuncs::GetCvarFloat( "maxplayers" ) > 1 )
+			EngFuncs::HostEndGame( "end of the game" );
+
+		EngFuncs::CvarSetValue( "skill", m_iChosen == 0 ? 1.0f : (float)m_iChosen );
+		EngFuncs::CvarSetValue( "deathmatch", 0.0f );
+		EngFuncs::CvarSetValue( "teamplay", 0.0f );
+		EngFuncs::CvarSetValue( "pausable", 1.0f ); // a game of one player can be paused
+		EngFuncs::CvarSetValue( "maxplayers", 1.0f );
+		EngFuncs::CvarSetValue( "coop", 0.0f );
+
+		EngFuncs::PlayBackgroundTrack( NULL, NULL );
+
+		if( m_iChosen == 0 )
+			EngFuncs::ClientCmd( false, "hazardcourse\n" );
+		else
+			EngFuncs::ClientCmd( false, "newgame\n" );
+	}
+
+	CSteamLabel m_help;
+	CSteamRadioButton m_choice[4];
+	CSteamButton m_play, m_cancel;
+	int m_iChosen = 0;
+};
