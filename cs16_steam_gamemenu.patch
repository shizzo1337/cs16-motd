+void CMenuConnectionProgress::SteamDraw()
+{
+	using namespace SteamUI;
+	int x, y, w, h;
+	SteamDialogRect( x, y, w, h );
+
+	Fill( x, y, w, h, ControlBG );
+	RaisedBorder( x, y, w, h );
+	Text( FONT_DEFAULT, x + 21, y + 8, Localize( "#GameUI_Loading" ), TitleText, w - 30 );
+
+	// the text: the step of GameUI, or the text mainui has (a stufftext of the server, the level changing...)
+	const char *info = sCommonString;
+	if( m_iState == STATE_DOWNLOAD )
+		info = Localize( "#GameUI_VerifyingAndDownloading" );
+	else if( m_iSteamText == STEAM_TEXT_CONNECTING )
+		info = Localize( "#GameUI_EstablishingConnection" );
+	else if( m_iSteamText == STEAM_TEXT_STARTING )
+		info = Localize( "#GameUI_StartingServer" );
+	else if( m_iSteamText == STEAM_TEXT_PRECACHE )
+		info = Localize( "#GameUI_PrecachingResources" );
+	TextInBox( FONT_DEFAULT, x + 20, y + 34, 340, 24, info, DimBaseText );
+
+	const float loading = m_bStuffProgress ? m_flStuffProgress : EngFuncs::GetCvarFloat( "scr_loading" ) / 100.0f;
+
+	if( m_iState == STATE_DOWNLOAD )
+	{
+		const float file = EngFuncs::GetCvarFloat( "scr_download" ) / 100.0f;
+		const float all = m_iDlTotal > 0 ? ( m_iDlCurrent + ( file > 0.0f ? file : 0.0f )) / m_iDlTotal : 0.0f;
+		SteamProgressBar( x + 20, y + 58, 260, 24, all );
+		TextInBox( FONT_DEFAULT, x + 20, y + 90, 340, 24, m_szDlFile, DimBaseText );
+
+		// the time left of the file, from how fast it comes
+		const double t = EngFuncs::DoubleTime() - m_flDlStart;
+		const float done = file * 100.0f - m_flDlStartPercent;
+		if( t > 0.5 && done > 0.0f )
+		{
+			int left = (int)(( 100.0f - file * 100.0f ) / ( done / t ) + 0.5f );
+			if( left < 1 ) left = 1;
+			char buf[64];
+			if( left >= 60 )
+				snprintf( buf, sizeof( buf ), SteamRussian() ?
+					// "Осталось %d мин %d сек" (the bytes of UTF-8: the compilers read the source in different code pages)
+					"\xd0\x9e\xd1\x81\xd1\x82\xd0\xb0\xd0\xbb\xd0\xbe\xd1\x81\xd1\x8c %d \xd0\xbc\xd0\xb8\xd0\xbd %d \xd1\x81\xd0\xb5\xd0\xba" :
+					"%d min %d sec remaining", left / 60, left % 60 );
+			else
+				snprintf( buf, sizeof( buf ), SteamRussian() ?
+					// "Осталось %d сек"
+					"\xd0\x9e\xd1\x81\xd1\x82\xd0\xb0\xd0\xbb\xd0\xbe\xd1\x81\xd1\x8c %d \xd1\x81\xd0\xb5\xd0\xba" :
+					"%d sec remaining", left );
+			TextInBox( FONT_DEFAULT, x + 20, y + 108, 260, 24, buf, DimBaseText );
+		}
+		SteamProgressBar( x + 20, y + 132, 260, 24, file );
+	}
+	else
+		SteamProgressBar( x + 20, y + 64, 260, 24, loading );
+
+	// Cancel, as the buttons of the Steam windows
+	int bx, by, bw, bh;
+	SteamCancelRect( bx, by, bw, bh );
+	const bool armed = UI_CursorInRect( bx, by, bw, bh );
+	const bool down = armed && m_bCancelPressed;
+	Fill( bx, by, bw, bh, ControlBG );
+	if( down )
+		InsetBorder( bx, by, bw, bh );
+	else
+		RaisedBorder( bx, by, bw, bh );
+	TextInBox( FONT_DEFAULT, bx + 6 + ( down ? 1 : 0 ), by + ( down ? 1 : 0 ), bw - 7, bh, Localize( "#GameUI_Cancel" ),
+		armed ? BrightBaseText : ControlText );
+}
