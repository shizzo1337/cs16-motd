+void CSteamServerBrowser::UpdateFilterString()
+{
+	// as the Steam version: the game, then the filters that are on, each followed by ";"
+	char s[256];
+	snprintf( s, sizeof( s ), "%s;", m_gameFilter.SelectedText());
+	if( m_mapFilter.GetBuffer()[0] )
+		snprintf( s + strlen( s ), sizeof( s ) - strlen( s ), " %s;", m_mapFilter.GetBuffer());
+	if( m_pingFilter.Selected() > 0 )
+		snprintf( s + strlen( s ), sizeof( s ) - strlen( s ), " %s;", m_pingFilter.SelectedText());
+	if( m_notFull.checked )
+		snprintf( s + strlen( s ), sizeof( s ) - strlen( s ), " %s;", SB( "ServerBrowser_ServerNotFull", "Server not full" ));
+	if( m_notEmpty.checked )
+		snprintf( s + strlen( s ), sizeof( s ) - strlen( s ), " %s;", SB( "ServerBrowser_HasUsersPlaying", "Has users playing" ));
+	if( m_noPassword.checked )
+		snprintf( s + strlen( s ), sizeof( s ) - strlen( s ), " %s;", SB( "ServerBrowser_IsNotPasswordProtected", "Is not password protected" ));
+	Q_strncpy( m_filterString.text, s, sizeof( m_filterString.text ));
+}
