+private:
+	void ListRect( int &x, int &y, int &w, int &h, int &rowH, int &first, int &count ) const;
+	int selected = -1;
+	int m_iListTop = 0;
+	SteamUI::ScrollBar m_sb; // when the list has more items than it shows
+	void PlaceScrollBar();
+};
+
+// A window of GameUI: the frame, its title and close button, the tabs (if it has pages) and the buttons
+class CSteamFrame : public CMenuBaseWindow
+{
+public:
+	typedef CMenuBaseWindow BaseClass;
+
+	CSteamFrame( const char *name, int wide, int tall );
+
+	void Draw() override;
+	bool KeyDown( int key ) override;
+	bool KeyUp( int key ) override;
+	bool MouseMove( int x, int y ) override;
+	void Show() override;
+
+	void SetTitle( const char *title );
+	bool EscapeCloses() const { return m_bEscapeCloses; }
+
+	// a window that can be made bigger and smaller by its edges and corners, as the Server Browser and the Console
+	// of the Steam version (the grip of dots in the bottom right corner); OnResized() places the controls again
+	void SetSizeable( bool sizeable, int minWide = 0, int minTall = 0 )
+	{
+		m_bSizeable = sizeable;
+		m_iMinWide = minWide > 0 ? minWide : m_iWide;
+		m_iMinTall = minTall > 0 ? minTall : m_iTall;
+	}
+	int Wide() const { return m_iWide; }
+	int Tall() const { return m_iTall; }
+
+	// pages (property sheet): their controls are added to the window and shown with their tab
+	int AddPage( const char *title );
+	void AddToPage( int page, CMenuBaseItem &item );
+	void SetActivePage( int page );
+	int ActivePage() const { return m_iActivePage; }
+	Point PageOrigin() const { return Point( m_pageInset[0], m_pageInset[1] ); } // where the controls of a page are counted from
+
+	// the place of the property sheet: the border of the page from (left, top) to (wide - right, tall - bottom), the
+	// tabs over it; and the least width of a tab. The Options window: 5, 55, 5, 37 and 64; the Server Browser:
+	// 8, 72, 9, 34 and 72 (measured at 1920x1080)
+	void SetSheet( int left, int top, int right, int bottom, int tabMinWide )
+	{
+		m_pageInset[0] = left; m_pageInset[1] = top; m_pageInset[2] = right; m_pageInset[3] = bottom;
+		m_iTabMinWide = tabMinWide;
+	}
+	void PageRect( int &x, int &y, int &w, int &h ) const
+	{
+		x = m_scPos.x + m_pageInset[0];
+		y = m_scPos.y + m_pageInset[1];
+		w = m_iWide - m_pageInset[0] - m_pageInset[2];
+		h = m_iTall - m_pageInset[1] - m_pageInset[3];
+	}
+
+	// a combo box opens its list above everything; only one at a time
+	void OpenList( CSteamComboBox *box ) { m_pOpenList = box; }
+
+	// controls made from a .res file (the places of a page of the Steam version)
+	struct Placed
+	{
+		char name[64];
+		char control[48];
+		int x, y, w, h;
+		char label[256];
+		bool visible, dull, wrap;
+		int autoResize, pinCorner; // VGUI2: 1 the right edge follows the window, 2 the bottom, 3 both;
+		                           // the corner it keeps its place to: 0 top left, 1 top right, 2 bottom left, 3 bottom right
+		char leftText[64], rightText[64];
+	};
+	static bool ReadRes( const char *path, CUtlVector<Placed> &out );
+	static const Placed *FindPlaced( const CUtlVector<Placed> &list, const char *name );
+
+protected:
+	void _VidInit() override;
+	virtual void OnPageChanged( int page ) {}
+	virtual void OnResized() {}
+
+	// Escape doesn't close a window of the Steam version: it goes to the main menu under it (back to the game when one
+	// is running). Only a message box (the question before quitting) closes with it, as in the Steam version
+	bool m_bEscapeCloses = false;
+	bool m_bSheetShown = true; // the tabs and the page are drawn (a window that grows to show them)
+
+	// placed in the middle of the screen (the first time, or another resolution) by the last VidInit
+	bool m_bPlacedNow = false;
+	int m_iFirstX = -1, m_iFirstY = -1; // the first place, when not the middle (the console: 40, 40)
+private:
+	bool m_bPlaced = false;
+	int m_iScreenWide = 0, m_iScreenTall = 0;
+protected:
+
+	char m_szTitle[128];
+	int m_iWide, m_iTall;
+	int m_iActivePage = -1;
+	int m_pageInset[4] = { 5, 55, 5, 37 };
+	int m_iTabMinWide = 64;
+	bool m_bCloseButton = true; // the message boxes have none
+	CSteamComboBox *m_pOpenList = nullptr;
+
+	struct Page
+	{
+		char title[64];
+		CUtlVector<CMenuBaseItem *> items;
+	};
+	CUtlVector<Page *> m_pages;
+
+private:
+	int TabAt( int x, int y ) const;
+	void TabRect( int page, int &x, int &y, int &w, int &h ) const;
+	bool OnClose( int x, int y ) const;
+
+	int ResizeEdgesAt( int x, int y ) const; // the edges under the cursor: 1 left, 2 right, 4 top, 8 bottom
+	bool CursorInside() const;
+	CMenuBaseWindow *m_pForward = nullptr; // the window under this one that got the press of a mouse button
+	CMenuBaseWindow *m_pLitUnder = nullptr; // the window under this one that the cursor lights
+
+	bool m_bDragging = false;
+	Point m_dragOffset;
+	bool m_bSizeable = false;
+	int m_iMinWide = 0, m_iMinTall = 0;
+	int m_iResizeEdges = 0;          // the edges being moved
+	Point m_resizeStart;             // the cursor when the resizing began
+	int m_iStartX = 0, m_iStartY = 0, m_iStartW = 0, m_iStartH = 0;
+	bool m_bClosePressed = false;
+};
+
+// A message box of VGUI2 with two buttons (QueryBox), as the window "Quit game" of the Steam version. Measured at
+// 1920x1080: 296 x 114 pixels, its left edge at the middle of the screen - 122, its top at the middle - 57; the message
+// in the middle from y 41; the buttons 24 pixels high at y 70, as wide as their text + 16 but at least 72, 18 pixels
+// apart, together in the middle; the first one is the default one (a black frame); no close button
+class CSteamMessageBox : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamMessageBox();
+
+	// the texts may be "#keys" of the translations
+	void Ask( const char *title, const char *message, const char *okText, const char *cancelText, CEventCallback onOk );
+	bool KeyDown( int key ) override;
+
+private:
+	void _Init() override;
+	void _VidInit() override;
+	void Ok();
+
+	CSteamLabel m_message;
+	CSteamButton m_ok, m_cancel;
+	CEventCallback m_onOk;
+};
