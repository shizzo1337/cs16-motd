+// The window Add Server, as servers/DialogAddServer.res of the Steam version: 572 wide, as tall as the top of its tabs
+// (205) until "Find games at this address" is pressed, then 471 (the tabs at (20, 205) 526 x 216 plus 50) with the
+// servers found and "Add selected game server to favorites" (210 x 24, 26 pixels from the right edge, 11 from the
+// bottom). The address at (20, 74) 330 x 24 under "Enter the IP address..." (22, 46), the examples (dull) at (22, 106),
+// "Add address to favorites" at (356, 74) and "Find games at this address" at (356, 102), 190 x 24, Cancel at
+// (482, 131) 64 x 24. Not in the Steam version: the protocol of the server (GoldSource 48 or Xash3D 49) left of Cancel
+class CSteamAddServerDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+	typedef void ( CSteamFrame::*Done_t )();
+
+	enum { COLLAPSED = 205, EXPANDED = 471 };
+
+	CSteamAddServerDialog() : BaseClass( "CSteamAddServerDialog", 572, COLLAPSED )
+	{
+		m_bEscapeCloses = true;
+	}
+
+	// done: the address (Address(), Protocol()) to the favorites; added: a server found (Found())
+	template<class T> void Ask( T *target, void ( T::*done )(), void ( T::*added )())
+	{
+		m_pTarget = target;
+		m_pfnDone = static_cast<Done_t>( done );
+		m_pfnAdded = static_cast<Done_t>( added );
+		Show();
+		Collapse();
+		m_entry.SetBuffer( "" );
+		SetCursorToItem( m_entry );
+	}
+
+	const char *Address() { return m_entry.GetBuffer(); }
+	const char *Protocol() const { return m_protocol.Selected() == 1 ? "49" : "gs"; }
+	const SteamServer *Found() const
+	{
+		const int i = m_list.Selected();
+		return i >= 0 && i < m_found.Count() ? &m_found[i] : nullptr;
+	}
+
+	// an answer of a server while the window looks for them
+	void ServerAnswered( netadr_t adr, const char *info )
+	{
+		if( !m_bSearching || !IsVisible( ))
+			return;
+		for( int i = 0; i < m_found.Count(); i++ )
+			if( !EngFuncs::NET_CompareAdr( &m_found[i].adr, &adr ))
+				return;
+		SteamServer s;
+		ServerFromInfo( s, adr, info );
+		s.ping = (float)( EngFuncs::DoubleTime() - m_searchStart );
+		m_found.AddToTail( s );
+		m_list.Resort();
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ) && !m_pOpenList )
+		{
+			if( Address()[0] )
+				Done();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		// as the Steam version: the buttons wait for an address, "Add selected" for a server chosen
+		const bool any = Address()[0] != 0;
+		m_add.SetGrayed( !any );
+		m_find.SetGrayed( !any );
+		m_addSelected.SetGrayed( m_list.Selected() < 0 );
+		BaseClass::Draw();
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( SB( "ServerBrowser_AddServersTitle", "Add Server - Servers" ));
+
+		m_info.SetBounds( 22, 46, 330, 20 );
+		Q_strncpy( m_info.text, SB( "ServerBrowser_EnterIPofServerToAdd", "Enter the IP address of the server you wish to add." ), sizeof( m_info.text ));
+		m_entry.SetBounds( 20, 74, 330, 24 );
+		m_entry.iMaxLength = 127;
+		m_examples.SetBounds( 22, 106, 308, 74 );
+		m_examples.dull = true;
+		m_examples.wrap = true;
+		Q_strncpy( m_examples.text, SB( "ServerBrowser_Examples",
+			"Examples:\ntfc.valvesoftware.com\ncounterstrike.speakeasy.net:27016\n205.158.143.200:27015" ), sizeof( m_examples.text ));
+		// the English file of the Steam version writes the line ends as "\n"
+		for( char *c = m_examples.text; *c; c++ )
+			if( c[0] == '\\' && c[1] == 'n' )
+			{
+				c[0] = '\n';
+				memmove( c + 1, c + 2, strlen( c + 2 ) + 1 );
+			}
+		m_info.iFlags |= QMF_INACTIVE;
+		m_examples.iFlags |= QMF_INACTIVE;
+
+		m_add.SetBounds( 356, 74, 190, 24 );
+		m_find.SetBounds( 356, 102, 190, 24 );
+		m_cancel.SetBounds( 482, 131, 64, 24 );
+		m_protocol.SetBounds( 356, 131, 120, 24 );
+		Q_strncpy( m_add.text, SB( "ServerBrowser_AddAddressToFavorites", "Add address to favorites" ), sizeof( m_add.text ));
+		Q_strncpy( m_find.text, SB( "ServerBrowser_FindGames", "Find games at this address..." ), sizeof( m_find.text ));
+		Q_strncpy( m_cancel.text, SB( "ServerBrowser_Cancel", "Cancel" ), sizeof( m_cancel.text ));
+		m_add.isDefault = true;
+		m_add.onReleased = VoidCb( &CSteamAddServerDialog::Done );
+		m_find.onReleased = VoidCb( &CSteamAddServerDialog::Find );
+		m_cancel.onReleased = VoidCb( &CSteamAddServerDialog::Hide );
+		m_protocol.AddItem( "GoldSource 48", "gs" );
+		m_protocol.AddItem( "Xash3D 49", "49" );
+		m_protocol.Select( 0 ); // most CS 1.6 servers are GoldSource ones
+
+		AddItem( m_info );
+		AddItem( m_entry );
+		AddItem( m_examples );
+		AddItem( m_add );
+		AddItem( m_find );
+		AddItem( m_protocol );
+		AddItem( m_cancel );
+
+		// the tabs of the servers found: the page as the property sheets of the Steam version (the tabs 28 above it)
+		AddPage( SB( "ServerBrowser_Servers", "Servers" ));
+		SetSheet( 20, 205 + 28, 572 - 20 - 526, EXPANDED - 205 - 216, 72 );
+		// the page is 526 x 188 (the window is not that tall yet); the list 8 pixels in, as AddServerGamesPage.res
+		m_list.SetBounds( 8, 8, 526 - 16, EXPANDED - 205 - 28 - ( EXPANDED - 205 - 216 ) - 16 );
+		m_list.SetServers( &m_found );
+		m_list.onActivate = VoidCb( &CSteamAddServerDialog::AddSelected );
+		AddToPage( 0, m_list );
+
+		m_addSelected.SetBounds( 572 - 26 - 210, EXPANDED - 11 - 24, 210, 24 );
+		Q_strncpy( m_addSelected.text, SB( "ServerBrowser_AddSelectedToFavorites", "Add selected game server to favorites" ), sizeof( m_addSelected.text ));
+		m_addSelected.onReleased = VoidCb( &CSteamAddServerDialog::AddSelected );
+		AddItem( m_addSelected );
+
+		Collapse();
+	}
+
+	void SetTall( int tall )
+	{
+		m_iTall = tall;
+		size = Size( m_iWide, m_iTall );
+		m_scSize = size;
+	}
+
+	void Collapse()
+	{
+		m_bSearching = false;
+		m_found.RemoveAll();
+		m_list.ClearSelection();
+		m_list.Resort();
+		SetTall( COLLAPSED );
+		m_bSheetShown = false;
+		m_list.Hide();
+		m_addSelected.Hide();
+	}
+
+	// "Find games at this address": the window grows, the address is asked as the favorites are
+	void Find()
+	{
+		netadr_t adr;
+		if( !Address()[0] || !EngFuncs::textfuncs.pNetAPI->StringToAdr( (char *)Address(), &adr ))
+		{
+			Hide();
+			UI_ShowMessageBox( SB( "ServerBrowser_AddServerError", "The server IP address you entered is invalid." ));
+			return;
+		}
+
+		m_found.RemoveAll();
+		m_list.ClearSelection();
+		m_list.Resort();
+		SetTall( EXPANDED );
+		m_bSheetShown = true;
+		m_list.Show();
+		m_addSelected.Show();
+		m_bSearching = true;
+		m_searchStart = EngFuncs::DoubleTime();
+		EngFuncs::ClientCmdF( false, "ui_queryserver \"%s\" \"%s\"\n", EngFuncs::NET_AdrToString( adr ), Protocol());
+	}
+
+	void Done()
+	{
+		Hide();
+		if( m_pTarget && m_pfnDone )
+			( m_pTarget->*m_pfnDone )();
+	}
+
+	void AddSelected()
+	{
+		if( !Found( ))
+			return;
+		if( m_pTarget && m_pfnAdded )
+			( m_pTarget->*m_pfnAdded )();
+		Hide();
+	}
+
+	CSteamLabel m_info, m_examples;
+	CSteamTextEntry m_entry;
+	CSteamButton m_add, m_find, m_cancel, m_addSelected;
+	CSteamComboBox m_protocol;
+	CSteamServerList m_list;
+	CUtlVector<SteamServer> m_found;
+	bool m_bSearching = false;
+	double m_searchStart = 0.0;
+
+	CSteamFrame *m_pTarget = nullptr;
+	Done_t m_pfnDone = nullptr, m_pfnAdded = nullptr;
+};
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// The players of a server in the window Game Info: Player Name, Score, Time. Measured at 1920x1080: a header of 17
+// pixels ("DefaultSmall"), rows of 16 pixels in "Default", the columns 156 and 64 pixels and the rest, the scroll bar
+// 18 pixels wide
+class CSteamPlayerList : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	struct Player { char name[64]; int frags; float time; };
+	CUtlVector<Player> players;
+
+	bool KeyDown( int key ) override
+	{
+		if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+		{
+			m_iTop += key == K_MWHEELUP ? -3 : 3;
+			Clamp();
+			return true;
+		}
+		if( UI::Key::IsLeftMouse( key ) && Hovered( ))
+		{
+			Place();
+			if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+				m_iTop = m_sb.top;
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		Place();
+		m_sb.Clamp(); // a window made bigger shows more rows: the first one may have to go up
+		m_sb.Think();
+		m_iTop = m_sb.top;
+
+		const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+		Fill( x, y, w, h, ListBG );
+		InsetBorder( x, y, w, h );
+
+		const int sbX = x + w - 19;
+		const int cols[3] = { x + 1, x + 157, x + 221 };
+		const int ends[3] = { x + 157, x + 221, sbX };
+		const char *titles[3] = { SB( "ServerBrowser_PlayerName", "Player Name" ), SB( "ServerBrowser_Score", "Score" ),
+			SB( "ServerBrowser_Time", "Time" ) };
+		for( int c = 0; c < 3; c++ )
+		{
+			Fill( cols[c], y + 1, ends[c] - cols[c], 17, ControlBG );
+			RaisedBorder( cols[c], y + 1, ends[c] - cols[c], 17 );
+			TextInBox( FONT_DEFAULT_SMALL, cols[c] + 4, y + 1, ends[c] - cols[c] - 6, 17, titles[c], ControlText );
+		}
+
+		for( int i = 0; i < Visible() && m_iTop + i < players.Count(); i++ )
+		{
+			const Player &p = players[m_iTop + i];
+			const int ry = y + 20 + i * 16;
+			char buf[32];
+
+			TextInBox( FONT_DEFAULT, cols[0] + 5, ry, ends[0] - cols[0] - 6, 16, p.name, ControlText );
+			snprintf( buf, sizeof( buf ), "%d", p.frags );
+			TextInBox( FONT_DEFAULT, cols[1] + 4, ry, ends[1] - cols[1] - 6, 16, buf, ControlText );
+
+			// as the Steam version: "13m 27s", "1h 2m"
+			const int t = (int)p.time;
+			if( t >= 3600 )
+				snprintf( buf, sizeof( buf ), "%dh %dm", t / 3600, ( t / 60 ) % 60 );
+			else
+				snprintf( buf, sizeof( buf ), "%dm %ds", t / 60, t % 60 );
+			TextInBox( FONT_DEFAULT, cols[2] + 4, ry, ends[2] - cols[2] - 6, 16, buf, ControlText );
+		}
+
+		Place();
+		m_sb.Draw();
+	}
+
+private:
+	int Visible() const { return ( m_scSize.h - 21 ) / 16; }
+	void Clamp()
+	{
+		const int maxTop = players.Count() - Visible();
+		if( m_iTop > maxTop ) m_iTop = maxTop;
+		if( m_iTop < 0 ) m_iTop = 0;
+	}
+	void Place()
+	{
+		m_sb.x = m_scPos.x + m_scSize.w - 19;
+		m_sb.y = m_scPos.y + 1;
+		m_sb.w = 18;
+		m_sb.h = m_scSize.h - 2;
+		m_sb.total = players.Count();
+		m_sb.visible = Visible();
+		m_sb.top = m_iTop;
+	}
+
+	int m_iTop = 0;
+	SteamUI::ScrollBar m_sb;
+};
+
+// The window Game Info of the Steam version (platform/servers/DialogGameInfo.res: 416 x 440, the places below are
+// the same): the name, the address, the game, the map, the players, the anti-cheat and the latency of a server, its
+// players, the buttons Join Game, Refresh, Close. The engine is asked for them by NetAPI, as the server info of mainui
+// joins a server through the window Servers (defined after it); file scope and static: SteamServer is in an
+// anonymous namespace, and MSVC doesn't link a block scope extern declaration of a function that takes it
+static void SteamServerBrowser_Connect( const SteamServer &s );
+
+class CSteamGameInfo : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamGameInfo() : BaseClass( "CSteamGameInfo", 416, 440 ) {}
+
+	void Open( const SteamServer &s )
+	{
+		m_server = s;
+		Show();
+		Fill();
+		Request();
+	}
+
+	void Hide() override
+	{
+		Cancel();
+		BaseClass::Hide();
+	}
+
+	static void PingCb( net_response_t *r );
+	static void PlayersCb( net_response_t *r );
+	static void DetailsCb( net_response_t *r );
+
+private:
+	void _Init() override
+	{
+		SetTitle( SB( "ServerBrowser_GameInfoTitle", "Game Info" ));
+		SetSizeable( true, 416, 440 );
+
+		static const struct { const char *key, *english; int y; } labels[] = {
+			{ "ServerBrowser_ServerName", "Name:", 42 }, { "ServerBrowser_IPAddressLabel", "IP Address:", 66 },
+			{ "ServerBrowser_GameLabel", "Game:", 90 }, { "ServerBrowser_MapLabel", "Map:", 114 },
+			{ "ServerBrowser_PlayersLabel", "Players:", 138 }, { "ServerBrowser_ValveAntiCheat", "Valve Anti-Cheat:", 162 },
+			{ "ServerBrowser_LatencyLabel", "Latency:", 186 },
+		};
+		for( int i = 0; i < 7; i++ )
+		{
+			m_label[i].SetBounds( 16, labels[i].y, 108, 20 );
+			Q_strncpy( m_label[i].text, SB( labels[i].key, labels[i].english ), sizeof( m_label[i].text ));
+			m_label[i].dull = true;
+			m_label[i].east = true;
+			m_label[i].iFlags |= QMF_INACTIVE;
+			AddItem( m_label[i] );
+
+			if( i == 1 )
+				continue; // the address is a text entry
+			m_value[i].SetBounds( 128, labels[i].y, 260, 20 );
+			m_value[i].iFlags |= QMF_INACTIVE;
+			AddItem( m_value[i] );
+		}
+
+		// the address can be copied, not changed
+		m_address.SetBounds( 128, 64, 260, 24 );
+		m_address.SetGrayed( true );
+		AddItem( m_address );
+
+		m_players.SetBounds( 24, 228, 368, 140 );
+		AddItem( m_players );
+
+		Q_strncpy( m_join.text, SB( "ServerBrowser_JoinGame", "Join Game" ), sizeof( m_join.text ));
+		Q_strncpy( m_refresh.text, SB( "ServerBrowser_Refresh", "Refresh" ), sizeof( m_refresh.text ));
+		Q_strncpy( m_close.text, SB( "ServerBrowser_Close", "Close" ), sizeof( m_close.text ));
+		m_join.isDefault = true;
+		m_join.onReleased = VoidCb( &CSteamGameInfo::Join );
+		m_refresh.onReleased = VoidCb( &CSteamGameInfo::Request );
+		m_close.onReleased = VoidCb( &CSteamGameInfo::Hide );
+		AddItem( m_join );
+		AddItem( m_refresh );
+		AddItem( m_close );
+		OnResized();
+	}
+
+	void OnResized() override
+	{
+		// the list grows with the window, the buttons keep to the bottom right corner
+		const int dw = m_iWide - 416, dh = m_iTall - 440;
+		m_players.SetBounds( 24, 228, 368 + dw, 140 + dh );
+		m_join.SetBounds( 122 + dw, 400 + dh, 80, 24 );
+		m_refresh.SetBounds( 218 + dw, 400 + dh, 80, 24 );
+		m_close.SetBounds( 312 + dw, 400 + dh, 80, 24 );
+	}
+
+	void Fill()
+	{
+		char buf[64];
+		Q_strncpy( m_value[0].text, m_server.name, sizeof( m_value[0].text ));
+		m_address.SetBuffer( EngFuncs::NET_AdrToString( m_server.adr ));
+		Q_strncpy( m_value[2].text, m_server.game, sizeof( m_value[2].text ));
+		Q_strncpy( m_value[3].text, m_server.map, sizeof( m_value[3].text ));
+		snprintf( buf, sizeof( buf ), "%d / %d", m_server.numcl, m_server.maxcl );
+		Q_strncpy( m_value[4].text, m_server.pending ? "" : buf, sizeof( m_value[4].text ));
+		Q_strncpy( m_value[5].text, "-", sizeof( m_value[5].text )); // the engine doesn't tell
+		snprintf( buf, sizeof( buf ), "%d", (int)( m_server.ping * 1000.0f + 0.5f ));
+		Q_strncpy( m_value[6].text, m_server.pending ? "" : buf, sizeof( m_value[6].text ));
+	}
+
+	void Cancel()
+	{
+		for( int i = 0; i < 3; i++ )
+			if( m_context[i] >= 0 )
+			{
+				EngFuncs::textfuncs.pNetAPI->CancelRequest( m_context[i] );
+				m_context[i] = -1;
+			}
+	}
+
+	void Request()
+	{
+		Cancel();
+		m_players.players.RemoveAll();
+
+		static const int types[3] = { NETAPI_REQUEST_PING, NETAPI_REQUEST_PLAYERS, NETAPI_REQUEST_DETAILS };
+		static net_api_response_func_t const funcs[3] = { PingCb, PlayersCb, DetailsCb };
+		for( int i = 0; i < 3; i++ )
+		{
+			m_context[i] = EngFuncs::RandomLong( 0, 0x7fffffff );
+			EngFuncs::textfuncs.pNetAPI->SendRequest( m_context[i], types[i], 0, 10.0, &m_server.adr, funcs[i] );
+		}
+	}
+
+	void Join()
+	{
+		Hide();
+		SteamServerBrowser_Connect( m_server );
+	}
+
+	friend void SteamGameInfo_Response( int kind, net_response_t *r );
+
+	SteamServer m_server;
+	CSteamLabel m_label[7], m_value[7];
+	CSteamTextEntry m_address;
+	CSteamPlayerList m_players;
+	CSteamButton m_join, m_refresh, m_close;
+	int m_context[3] = { -1, -1, -1 };
+};
+
+static CSteamGameInfo *s_gameInfo = nullptr;
+
+void SteamGameInfo_Response( int kind, net_response_t *r )
+{
+	CSteamGameInfo *g = s_gameInfo;
+	if( !g || !r || r->context != g->m_context[kind] || r->error != NET_SUCCESS )
+		return;
+	if( kind != 0 && !r->response )
+		return; // the engine gives no text for a ping
+
+	const char *s = (const char *)r->response;
+	char buf[64];
+
+	if( kind == 0 )
+	{
+		g->m_server.ping = (float)r->ping;
+		snprintf( buf, sizeof( buf ), "%d", (int)( r->ping * 1000.0 + 0.5 ));
+		Q_strncpy( g->m_value[6].text, buf, sizeof( g->m_value[6].text ));
+	}
+	else if( kind == 1 )
+	{
+		g->m_players.players.RemoveAll();
+		const int count = atoi( Info_ValueForKey( s, "players" ));
+		for( int i = 0; i < count; i++ )
+		{
+			CSteamPlayerList::Player p;
+			char key[32];
+			snprintf( key, sizeof( key ), "p%ifrags", i );
+			p.frags = atoi( Info_ValueForKey( s, key ));
+			snprintf( key, sizeof( key ), "p%itime", i );
+			p.time = (float)atof( Info_ValueForKey( s, key ));
+			snprintf( key, sizeof( key ), "p%iname", i );
+			Q_strncpy( p.name, Info_ValueForKey( s, key ), sizeof( p.name ));
+			g->m_players.players.AddToTail( p );
+		}
+	}
+	else
+	{
+		const char *host = Info_ValueForKey( s, "hostname" );
+		if( host[0] )
+			Q_strncpy( g->m_value[0].text, host, sizeof( g->m_value[0].text ));
+		const char *map = Info_ValueForKey( s, "map" );
+		if( map[0] )
+			Q_strncpy( g->m_value[3].text, map, sizeof( g->m_value[3].text ));
+		const char *cur = Info_ValueForKey( s, "current" ), *max = Info_ValueForKey( s, "max" );
+		if( cur[0] && max[0] )
+		{
+			snprintf( buf, sizeof( buf ), "%s / %s", cur, max );
+			Q_strncpy( g->m_value[4].text, buf, sizeof( g->m_value[4].text ));
+		}
+	}
+}
