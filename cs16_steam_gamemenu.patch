+int CSteamOptionsDialog::BuildPage( int page, const char *res )
+{
+	CUtlVector<Placed> placed;
+	if( !ReadRes( res, placed ))
+	{
+		Con_Printf( "Options: %s not found, the page is empty\n", res );
+		return 0;
+	}
+
+	m_iBuildPage = page;
+	int made = 0;
+
+	for( int i = 0; i < placed.Count(); i++ )
+	{
+		const Placed &p = placed[i];
+		if( !p.visible )
+			continue;
+
+		// the buttons of the window are the window's own (OptionsSubMultiplayer.res of CS has copies of them)
+		if( !stricmp( p.name, "ok" ) || !stricmp( p.name, "Cancel" ) || !stricmp( p.name, "Apply" ))
+			continue;
+
+		CMenuBaseItem *item = nullptr;
+		int kind = K_LABEL;
+		const char *c = p.control;
+
+		if( !stricmp( c, "Label" ) || !stricmp( c, "URLLabel" ))
+		{
+			CSteamLabel *l = new CSteamLabel;
+			kind = K_LABEL;
+			Q_strncpy( l->text, p.label, sizeof( l->text ));
+			l->dull = p.dull;
+			l->wrap = p.wrap || p.h > 30;
+			l->iFlags |= QMF_INACTIVE;
+			l->SetBounds( p.x, p.y, p.w, p.h );
+			item = l;
+		}
+		else if( !stricmp( c, "CheckButton" ) || !stricmp( c, "CCvarToggleCheckButton" ))
+		{
+			CSteamCheckButton *b = new CSteamCheckButton;
+			kind = K_CHECK;
+			Q_strncpy( b->text, p.label, sizeof( b->text ));
+			b->wrap = p.wrap;
+			b->SetBounds( p.x, p.y, p.w, p.h );
+			item = b;
+		}
+		else if( !stricmp( c, "CCvarSlider" ) || !stricmp( c, "Slider" ))
+		{
+			CSteamSlider *s = new CSteamSlider;
+			kind = K_SLIDER;
+			Q_strncpy( s->leftText, p.leftText, sizeof( s->leftText ));
+			Q_strncpy( s->rightText, p.rightText, sizeof( s->rightText ));
+			s->SetBounds( p.x, p.y, p.w, p.h );
+			item = s;
+		}
+		else if( !stricmp( c, "TextEntry" ) || !stricmp( c, "CCvarTextEntry" ))
+		{
+			CSteamTextEntry *t = new CSteamTextEntry;
+			kind = K_TEXT;
+			t->SetBounds( p.x, p.y, p.w, p.h );
+			t->iMaxLength = 63;
+			item = t;
+		}
+		else if( !stricmp( c, "ComboBox" ) || !stricmp( c, "CLabeledCommandComboBox" ))
+		{
+			CSteamComboBox *cb = new CSteamComboBox;
+			kind = K_COMBO;
+			cb->SetBounds( p.x, p.y, p.w, p.h );
+			item = cb;
+		}
+		else if( !stricmp( c, "Button" ))
+		{
+			CSteamButton *b = new CSteamButton;
+			kind = K_BUTTON;
+			Q_strncpy( b->text, p.label, sizeof( b->text ));
+			b->SetBounds( p.x, p.y, p.w, p.h );
+			item = b;
+		}
+		else if( !stricmp( c, "ListPanel" ))
+		{
+			CSteamKeyList *l = new CSteamKeyList;
+			kind = K_KEYLIST;
+			l->SetBounds( p.x, p.y, p.w, p.h );
+			item = l;
+		}
+		else if( !stricmp( c, "ImagePanel" ) || !stricmp( c, "Panel" ))
+		{
+			// the pictures by their names; a panel that only holds a place gets a slider (the microphone volume)
+			if( !stricmp( p.name, "LogoImage" ) || !stricmp( p.name, "CrosshairImage" ) || !stricmp( p.name, "MicMeter" ))
+			{
+				CSteamPreview *pv = new CSteamPreview;
+			kind = K_PREVIEW;
+				pv->iFlags |= QMF_INACTIVE;
+				pv->SetBounds( p.x, p.y, p.w, p.h );
+				item = pv;
+			}
+			else if( !stricmp( p.name, "#GameUI_MicrophoneVolume" ))
+			{
+				CSteamSlider *s = new CSteamSlider;
+				kind = K_SLIDER;
+				s->SetBounds( p.x, p.y, p.w, 42 );
+				item = s;
+			}
+		}
+
+		if( !item )
+			continue;
+
+		Built b;
+		Q_strncpy( b.name, p.name, sizeof( b.name ));
+		b.item = item;
+		b.page = page;
+		b.kind = kind;
+		m_built.AddToTail( b );
+		m_owned.AddToTail( item );
+		AddToPage( page, *item );
+		made++;
+	}
+
+	return made;
+}
+
+void CSteamOptionsDialog::FillResolutions()
+{
+	if( !m_resolution )
+		return;
+
+	// the modes of the video backend; "Widescreen" shows the wide ones (more than 4:3 and 5:4), "Normal" the rest
+	const bool wide = m_aspect && m_aspect->Selected() == 1;
+	const char *current = m_resolution->SelectedData();
+	char keep[64];
+	Q_strncpy( keep, current, sizeof( keep ));
+
+	m_resolution->RemoveAll();
+
+	for( int i = 0; ; i++ )
+	{
+		const char *mode = EngFuncs::GetModeString( i );
+		if( !mode )
+			break;
+
+		int w = 0, h = 0;
+		if( sscanf( mode, "%dx%d", &w, &h ) != 2 || h <= 0 )
+			continue;
+
+		const bool isWide = w * 3 > h * 4 + h / 2;
+		if( m_aspect && isWide != wide )
+			continue;
+
+		char text[64], data[16];
+		snprintf( text, sizeof( text ), "%d x %d", w, h );
+		snprintf( data, sizeof( data ), "%d", i );
+		m_resolution->AddItem( text, data );
+	}
+
+	int sel = m_resolution->FindData( keep );
+	if( sel < 0 )
+	{
+		char cur[16];
+		snprintf( cur, sizeof( cur ), "%d", (int)EngFuncs::GetCvarFloat( "vid_mode" ));
+		sel = m_resolution->FindData( cur );
+	}
+	m_resolution->Select( sel >= 0 ? sel : ( m_resolution->items.Count() ? 0 : -1 ));
+}
