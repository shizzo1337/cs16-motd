+
+	enum EKind { K_LABEL, K_CHECK, K_SLIDER, K_TEXT, K_COMBO, K_BUTTON, K_KEYLIST, K_PREVIEW };
+	struct Built { char name[64]; CMenuBaseItem *item; int page; int kind; };
+	template <class T> T *Get( const char *name, int kind )
+	{
+		for( int i = 0; i < m_built.Count(); i++ )
+			if( m_built[i].page == m_iBuildPage && m_built[i].kind == kind && !stricmp( m_built[i].name, name ))
+				return static_cast<T *>( m_built[i].item );
+		return nullptr;
+	}
+	CUtlVector<Built> m_built;
+	CUtlVector<CMenuBaseItem *> m_owned;
+	int m_iBuildPage = -1;
+
+	// the controls with a meaning (NULL when the .res of the game has no such control)
