+GNU General Public License for more details.
+*/
+
+// Measured on a screenshot of the Steam version at 1920x1080: the window 348 x 460, the tabs Server and Game, the
+// buttons Start and Cancel (72 x 24, 13 pixels from the right edge, 9 from the bottom, 8 between them).
+// The Server page is resource/CreateMultiplayerGameServerPage.res of the game (CS: the label Map at (28, 28) 38 x 24,
+// the list of the maps at (66, 28) 174 x 24 with "< Random Map >" first, a divider at (28, 70) 280 x 2; the bots
+// controls are hidden in it). The Game page is a list of the server settings of settings.scr of the game (as
+// CreateMultiplayerGameGameplayPage.res: a list at (10, 10) 320 x 325): rows of 28 pixels, a prompt on the left half
+// and its control on the right (a text entry for STRING and NUMBER, a combo box for LIST), a check button across the
+// row for BOOL, as GameUI does it.
+//
+// The rows show the values of settings.scr; Start writes the settings into settings.scr and their cvars, then starts the listen server as the Create Game menu
+// of mainui does it.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "CFGScript.h"
+#include "SteamUI.h"
+#include "SteamGameMenu.h"
+#include "Scissor.h"
+
+using namespace SteamUI;
+
+namespace
+{
+
+// "Divider" of VGUI2: a dark line over a bright one
+class CSteamDivider : public CSteamControl
+{
+public:
+	void Draw() override
+	{
+		Fill( m_scPos.x, m_scPos.y, m_scSize.w, 1, BorderDark );
+		Fill( m_scPos.x, m_scPos.y + 1, m_scSize.w, 1, BorderBright );
+	}
+};
+
+// the text of a key of a dictionary, or the English text when the game has no such string
+const char *Text( const char *key, const char *english )
+{
+	const char *s = Localize( key );
+	return ( !s[0] || !strcmp( s, key ) || ( key[0] == '#' && !strcmp( s, key + 1 ))) ? english : s;
+}
+
+} // namespace
+
+// The list of the Game page (CPanelListPanel of GameUI): an inset border, the rows 10 pixels in from its left edge and
+// 8 from the scroll bar, scrolled by pixels. The slider of the scroll bar is as big as the part of the rows the list
+// shows (GameUI makes it small whatever the rows). The rows are the controls of the window: those out
+// of the list are hidden, those partly in it are clipped by a scissor from the list (CSteamOptionRowsEnd ends it)
+class CSteamOptionRows : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	static const int ROW_TALL = 28;
+	static const int INSET = 4;   // above and under the control of a row
+	static const int LEFT = 10;   // the rows from the left edge of the list
+	static const int RIGHT = 8;   // and from the scroll bar
+	static const int SB_WIDE = 17;
+
+	struct Row
+	{
+		CMenuBaseItem *prompt; // NULL for a check button
+		CMenuBaseItem *control;
+	};
+	CUtlVector<Row> rows;
+	bool shown = false; // its page is the active one
+	bool clipping = false; // the scissor of the list is on
+
+	bool KeyDown( int key ) override
+	{
+		const bool inside = UI_CursorInRect( m_scPos, m_scSize );
+		if(( key == K_MWHEELUP || key == K_MWHEELDOWN ) && inside )
+		{
+			m_iTop += key == K_MWHEELUP ? -ROW_TALL : ROW_TALL;
+			Layout();
+			return true;
+		}
+		if( UI::Key::IsLeftMouse( key ) && inside )
+		{
+			PlaceScrollBar();
+			if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+			{
+				m_iTop = m_sb.top;
+				Layout();
+				return true;
+			}
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		PlaceScrollBar();
+		m_sb.Clamp();
+		m_sb.Think();
+		if( m_sb.top != m_iTop )
+		{
+			m_iTop = m_sb.top;
+			Layout();
+		}
+
+		InsetBorder( m_scPos.x, m_scPos.y, m_scSize.w, m_scSize.h );
+		PlaceScrollBar();
+		m_sb.Draw();
+
+	}
+
+	// the rows are clipped by the list: from CSteamOptionRowsClip before them to the one after them
+	void BeginClip()
+	{
+		if( !shown || !IsVisible( ))
+			return;
+		UI::Scissor::PushScissor( m_scPos.x + 1, m_scPos.y + 1, m_scSize.w - 2 - SB_WIDE, m_scSize.h - 2 );
+		SetFillClip( m_scPos.x + 1, m_scPos.y + 1, m_scSize.w - 2 - SB_WIDE, m_scSize.h - 2 );
+		clipping = true;
+	}
+	void EndClip()
+	{
+		if( clipping )
+		{
+			UI::Scissor::PopScissor();
+			ClearFillClip();
+		}
+		clipping = false;
+	}
+
+	// the rows to their places, those wholly out of the list hidden
+	void Layout()
+	{
+		const int maxTop = MaxTop();
+		if( m_iTop > maxTop ) m_iTop = maxTop;
+		if( m_iTop < 0 ) m_iTop = 0;
+
+		const int rowWide = size.w - LEFT - SB_WIDE - 1 - RIGHT;
+		const int half = rowWide / 2;
+		const int innerTop = pos.y + 1, innerBottom = pos.y + size.h - 1;
+		for( int i = 0; i < rows.Count(); i++ )
+		{
+			const Row &r = rows[i];
+			const int rowY = innerTop + i * ROW_TALL - m_iTop;
+			const int y = rowY + INSET;
+			const bool in = shown && rowY + ROW_TALL > innerTop && rowY < innerBottom;
+			const int x = pos.x + LEFT;
+
+			if( r.prompt )
+			{
+				r.prompt->pos = Point( x + 5, y ); // the text 5 pixels in, as GameUI
+				r.prompt->size = Size( half + 20 - 5, ROW_TALL - INSET * 2 );
+				r.control->pos = Point( x + half + 20, y );
+				r.control->size = Size( rowWide - half - 20, ROW_TALL - INSET * 2 );
+				r.prompt->SetVisibility( in );
+				r.prompt->CalcPosition();
+				r.prompt->CalcSizes();
+			}
+			else
+			{
+				r.control->pos = Point( x, y );
+				r.control->size = Size( rowWide, ROW_TALL - INSET * 2 );
+			}
+			r.control->SetVisibility( in );
+			r.control->CalcPosition();
+			r.control->CalcSizes();
+		}
+	}
+
+private:
+	int Needed() const { return rows.Count() * ROW_TALL; }
+	int MaxTop() const { const int m = Needed() - ( size.h - 2 ); return m > 0 ? m : 0; }
+	void PlaceScrollBar()
+	{
+		m_sb.w = SB_WIDE;
+		m_sb.x = m_scPos.x + m_scSize.w - 1 - m_sb.w;
+		m_sb.y = m_scPos.y + 1;
+		m_sb.h = m_scSize.h - 2;
+		// the slider as big as the part of the rows the list shows
+		m_sb.visible = size.h - 2;
+		m_sb.total = Needed() > m_sb.visible ? Needed() : m_sb.visible;
+		m_sb.step = ROW_TALL;
+		m_sb.top = m_iTop;
+	}
+
+	int m_iTop = 0; // in pixels
+	ScrollBar m_sb;
+};
+
+// before the first row and after the last one: the scissor of the list on and off
+class CSteamOptionRowsClip : public CSteamControl
+{
+public:
+	CSteamOptionRows *list = nullptr;
+	bool begin = false;
+	void Draw() override
+	{
+		if( list )
+			begin ? list->BeginClip() : list->EndClip();
+	}
+};
+
+// A window with a list of the cvars of a script of the game (settings.scr, user.scr), as CInfoDescription and
+// CPanelListPanel of GameUI
+class CSteamScriptFrame : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamScriptFrame( const char *name, int wide, int tall ) : BaseClass( name, wide, tall ) {}
+	~CSteamScriptFrame() override
+	{
+		FreeRows();
+		if( m_pVars )
+			CSCR_FreeList( m_pVars );
+	}
+
+protected:
+	virtual bool RowsShown() const { return true; } // the list is on the active page
+
+	void FreeRows()
+	{
+		m_pOpenList = nullptr; // the list of a combo box of a row may be open
+		for( int i = 0; i < m_owned.Count(); i++ )
+		{
+			RemoveItem( *m_owned[i] );
+			delete m_owned[i];
+		}
+		m_owned.RemoveAll();
+		m_rows.rows.RemoveAll();
+		if( m_bClipItems )
+		{
+			RemoveItem( m_clipBegin );
+			RemoveItem( m_clipEnd );
+			m_bClipItems = false;
+		}
+	}
+
+	// the rows from a script of the game (settings.scr, user.scr) with the values of the file or of their cvars
+	void LoadRows( const char *script, bool cvarValues )
+	{
+		FreeRows();
+		if( m_pVars )
+			CSCR_FreeList( m_pVars );
+		int count = 0;
+		m_pVars = CSCR_LoadDefaultCVars( script, &count );
+
+		m_clipBegin.list = m_clipEnd.list = &m_rows;
+		m_clipBegin.begin = true;
+		m_clipBegin.iFlags |= QMF_INACTIVE;
+		m_clipEnd.iFlags |= QMF_INACTIVE;
+		AddItem( m_clipBegin );
+
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+		{
+			const char *value = var->value;
+			if( cvarValues )
+			{
+				const char *v = EngFuncs::GetCvarString( var->name );
+				if( v && v[0] )
+					value = v;
+			}
+
+			CSteamOptionRows::Row row = { nullptr, nullptr };
+
+			if( var->type == T_BOOL )
+			{
+				CSteamCheckButton *b = new CSteamCheckButton;
+				Q_strncpy( b->text, var->desc, sizeof( b->text ));
+				b->checked = atof( value ) != 0.0f;
+				row.control = b;
+			}
+			else if( var->type == T_LIST )
+			{
+				CSteamComboBox *c = new CSteamComboBox;
+				int sel = 0, i = 0;
+				for( scrvarlistentry_t *e = var->list.pEntries; e; e = e->next, i++ )
+				{
+					char data[32];
+					snprintf( data, sizeof( data ), "%g", e->flValue );
+					c->AddItem( Localize( e->szName ), data );
+					if( e->flValue == (float)atof( value ))
+						sel = i;
+				}
+				c->Select( c->items.Count() ? sel : -1 );
+				row.control = c;
+			}
+			else if( var->type == T_STRING || var->type == T_NUMBER )
+			{
+				CSteamTextEntry *t = new CSteamTextEntry;
+				t->iMaxLength = 63;
+				if( var->type == T_NUMBER && !cvarValues ) // the cvar as the engine has it ("600.000000"), as GameUI
+				{
+					char buf[32];
+					snprintf( buf, sizeof( buf ), "%g", atof( value ));
+					t->SetBuffer( buf );
+				}
+				else t->SetBuffer( value );
+				row.control = t;
+			}
+			else continue;
+
+			if( var->type != T_BOOL )
+			{
+				CSteamLabel *l = new CSteamLabel;
+				snprintf( l->text, sizeof( l->text ), "%s", var->desc );
+				l->iFlags |= QMF_INACTIVE;
+				row.prompt = l;
+				m_owned.AddToTail( l );
+				AddItem( *l );
+			}
+			m_owned.AddToTail( row.control );
+			AddItem( *row.control );
+			m_rows.rows.AddToTail( row );
+		}
+		AddItem( m_clipEnd );
+		m_bClipItems = true;
+
+		// the controls are placed in pixels, as the other controls of the window; made after the window was, so
+		// their fonts and places are made here
+		for( int i = 0; i < m_owned.Count(); i++ )
+		{
+			m_owned[i]->iFlags |= QMF_DISABLESCAILING;
+			m_owned[i]->VidInit();
+		}
+
+		m_rows.shown = RowsShown();
+		m_rows.Layout();
+	}
+
+	// the values of the rows into the list of the script (its cvars in the same order)
+	void CollectRows()
+	{
+		int r = 0;
+		for( scrvardef_t *var = m_pVars; var && r < m_rows.rows.Count(); var = var->next )
+		{
+			if( var->type != T_BOOL && var->type != T_LIST && var->type != T_STRING && var->type != T_NUMBER )
+				continue;
+			RowValue( var, m_rows.rows[r++].control, var->value, sizeof( var->value ));
+		}
+	}
+
+	// the value of a row for its cvar and settings.scr
+	static void RowValue( const scrvardef_t *var, CMenuBaseItem *control, char *out, size_t len )
+	{
+		if( var->type == T_BOOL )
+			snprintf( out, len, "%d", static_cast<CSteamCheckButton *>( control )->checked ? 1 : 0 );
+		else if( var->type == T_LIST )
+			snprintf( out, len, "%s", static_cast<CSteamComboBox *>( control )->SelectedData());
+		else if( var->type == T_NUMBER )
+		{
+			float v = (float)atof( static_cast<CSteamTextEntry *>( control )->GetBuffer());
+			if( var->number.fMin != -1.0f && v < var->number.fMin ) v = var->number.fMin;
+			if( var->number.fMax != -1.0f && var->number.fMax > var->number.fMin && v > var->number.fMax ) v = var->number.fMax;
+			snprintf( out, len, "%g", v );
+		}
+		else
+			snprintf( out, len, "%s", static_cast<CSteamTextEntry *>( control )->GetBuffer());
+	}
+
+	CSteamOptionRows m_rows;
+	CSteamOptionRowsClip m_clipBegin, m_clipEnd;
+	bool m_bClipItems = false;
+	scrvardef_t *m_pVars = nullptr;
+	CUtlVector<CMenuBaseItem *> m_owned;
+};
+
+class CSteamCreateServer : public CSteamScriptFrame
+{
+public:
+	typedef CSteamScriptFrame BaseClass;
+
+	CSteamCreateServer() : BaseClass( "CSteamCreateServer", 348, 460 ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		FillMaps();
+		LoadRows( "settings.scr", false ); // the values of the file, as GameUI (maxplayers is 1 after a single player game)
+	}
+
+private:
+	bool RowsShown() const override { return ActivePage() == m_iGamePage; }
+
+	void _Init() override
+	{
+		SetTitle( "#GameUI_CreateServer" );
+		m_iServerPage = AddPage( "#GameUI_Server" );
+		m_iGamePage = AddPage( "#GameUI_Game" );
+
+		// the Server page from its .res, as in the Steam version (the bots controls are hidden there)
+		int lx = 28, ly = 28, lw = 38, lh = 24, mx = 66, my = 28, mw = 174, mh = 24, dx = 28, dy = 70, dw = 280;
+		bool divider = true;
+		if( ResNode *res = LoadRes( "resource/CreateMultiplayerGameServerPage.res" ))
+		{
+			if( const ResNode *n = res->Find( "Label1" ))
+			{
+				lx = n->GetInt( "xpos", lx ); ly = n->GetInt( "ypos", ly ); lw = n->GetInt( "wide", lw ); lh = n->GetInt( "tall", lh );
+				Q_strncpy( m_mapLabel.text, n->GetString( "labelText", "" ), sizeof( m_mapLabel.text ));
+			}
+			if( const ResNode *n = res->Find( "MapList" ))
+			{
+				mx = n->GetInt( "xpos", mx ); my = n->GetInt( "ypos", my ); mw = n->GetInt( "wide", mw ); mh = n->GetInt( "tall", mh );
+			}
+			const ResNode *n = res->Find( "Divider1" );
+			if( n )
+			{
+				dx = n->GetInt( "xpos", dx ); dy = n->GetInt( "ypos", dy ); dw = n->GetInt( "wide", dw );
+				divider = n->GetInt( "visible", 1 ) != 0;
+			}
+			delete res;
+		}
+
+		// "#Cstrike_Listen_MapName" is "Map" in English; the Russian file of CS has no such string, the Steam version
+		// shows "Map" too
+		const char *label = m_mapLabel.text[0] ? m_mapLabel.text : "#Cstrike_Listen_MapName";
+		Q_strncpy( m_mapLabel.text, Text( label, "Map" ), sizeof( m_mapLabel.text ));
+		m_mapLabel.iFlags |= QMF_INACTIVE;
+		m_mapLabel.SetBounds( lx, ly, lw, lh );
+		m_maps.SetBounds( mx, my, mw, mh );
+		m_divider.iFlags |= QMF_INACTIVE;
+		m_divider.SetBounds( dx, dy, dw, 2 );
+		AddToPage( m_iServerPage, m_mapLabel );
+		AddToPage( m_iServerPage, m_maps );
+		if( divider )
+			AddToPage( m_iServerPage, m_divider );
+
+		// the Game page: the list; its rows are made by LoadSettings
+		int gx = 10, gy = 10, gw = 320, gh = 325;
+		if( ResNode *res = LoadRes( "resource/CreateMultiplayerGameGameplayPage.res" ))
+		{
+			if( const ResNode *n = res->Find( "Resource/CreateMultiplayerGameGameplayPage.res" ))
+			{
+				gx = n->GetInt( "xpos", gx ); gy = n->GetInt( "ypos", gy ); gw = n->GetInt( "wide", gw ); gh = n->GetInt( "tall", gh );
+			}
+			delete res;
+		}
+		m_rows.SetBounds( gx, gy, gw, gh );
+		AddToPage( m_iGamePage, m_rows );
+
+		// the buttons of the window
+		const int by = 460 - 9 - 24;
+		m_start.SetBounds( 348 - 13 - 72 * 2 - 8, by, 72, 24 );
+		m_cancel.SetBounds( 348 - 13 - 72, by, 72, 24 );
+		Q_strncpy( m_start.text, "#GameUI_Start", sizeof( m_start.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_start.isDefault = true;
+		m_start.onReleased = VoidCb( &CSteamCreateServer::Start );
+		m_cancel.onReleased = VoidCb( &CSteamCreateServer::Hide );
+		AddItem( m_start );
+		AddItem( m_cancel );
+	}
+
+	void OnPageChanged( int page ) override
+	{
+		m_rows.shown = page == m_iGamePage;
+		m_rows.Layout();
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ) && !m_pOpenList )
+		{
+			Start();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void FillMaps()
+	{
+		char keep[64];
+		Q_strncpy( keep, m_maps.SelectedData(), sizeof( keep ));
+
+		m_maps.RemoveAll();
+		m_maps.AddItem( Text( "#GameUI_RandomMap", "< Random Map >" ), "" );
+
+		char *afile = nullptr;
+		if( EngFuncs::CreateMapsList( 1 ))
+			afile = (char *)EngFuncs::COM_LoadFile( "maps.lst", NULL );
+		if( afile )
+		{
+			char *pfile = afile;
+			char token[1024];
+			while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))) != NULL )
+			{
+				char name[64];
+				Q_strncpy( name, token, sizeof( name ));
+				pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token )); // the title of the map
+				if( strnicmp( name, "tr_", 3 )) // the training maps, as the Create Game menu of mainui
+					m_maps.AddItem( name, name );
+				if( !pfile )
+					break;
+			}
+			EngFuncs::COM_FreeFile( afile );
+		}
+
+		const int i = keep[0] ? m_maps.FindData( keep ) : -1;
+		m_maps.Select( i >= 0 ? i : 0 );
+		m_start.SetGrayed( m_maps.items.Count() <= 1 );
+	}
+
+	void Start()
+	{
+		if( m_maps.items.Count() <= 1 )
+			return;
+
+		int item = m_maps.Selected();
+		if( item <= 0 )
+			item = EngFuncs::RandomLong( 1, m_maps.items.Count() - 1 );
+		char mapName[64];
+		Q_strncpy( mapName, m_maps.items[item].data, sizeof( mapName ));
+		if( !EngFuncs::IsMapValid( mapName ))
+			return;
+
+		// the values of the rows (the rows and the cvars of settings.scr are in the same order)
+		int maxPlayers = (int)EngFuncs::GetCvarFloat( "maxplayers" );
+		CollectRows();
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+			if( !stricmp( var->name, "maxplayers" ))
+				maxPlayers = atoi( var->value );
+		if( maxPlayers < 1 ) maxPlayers = 1;
+		if( maxPlayers > MAX_CLIENTS ) maxPlayers = MAX_CLIENTS;
+
+		if( m_pVars )
+			CSCR_SaveToFile( "settings.scr", "SERVER_OPTIONS", m_pVars );
+
+		if( EngFuncs::GetCvarFloat( "host_serverstate" ))
+		{
+			if( EngFuncs::GetCvarFloat( "maxplayers" ) == 1.0f )
+				EngFuncs::HostEndGame( "end of the game" );
+			else
+				EngFuncs::HostEndGame( "starting new server" );
+		}
+
+		EngFuncs::CvarSetValue( "deathmatch", 1.0f );
+		EngFuncs::PlayBackgroundTrack( NULL, NULL );
+
+		// listenserver.cfg first: the settings of the window are set after it, as in the Steam version
+		char cmd[1024];
+		snprintf( cmd, sizeof( cmd ), "exec %s\n", EngFuncs::GetCvarString( "lservercfgfile" ));
+		EngFuncs::ClientCmd( true, cmd );
+
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+			if( stricmp( var->name, "maxplayers" ))
+				EngFuncs::CvarSetString( var->name, var->value );
+
+		Hide();
+
+		// as the Create Game menu of mainui: three frames for the old server to shut down, then maxplayers and the map
+		char escaped[256];
+		Com_EscapeCommand( escaped, mapName, sizeof( escaped ));
+		snprintf( cmd, sizeof( cmd ), "disconnect;menu_connectionprogress localserver;wait;wait;wait;maxplayers %i;latch;map %s\n",
+			maxPlayers, escaped );
+		EngFuncs::ClientCmd( false, cmd );
+	}
+
+	int m_iServerPage = 0, m_iGamePage = 1;
+	CSteamLabel m_mapLabel;
+	CSteamComboBox m_maps;
+	CSteamDivider m_divider;
+	CSteamButton m_start, m_cancel;
+};
+
+static CSteamCreateServer *s_createServer = nullptr;
+
+void UI_SteamCreateServer_Menu( void )
+{
+	if( !s_createServer )
+		s_createServer = new CSteamCreateServer;
+	s_createServer->Show();
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// The window Advanced of the Multiplayer page of Options (CMultiplayerAdvancedDialog of GameUI): the cvars of user.scr
+// of the game in a list, OK and Cancel. Measured on a screenshot of the Steam version at 1920x1080: the window 472 x 376,
+// the list at (16, 56) 442 x 274, the buttons 72 x 24 at y 338, Cancel 13 pixels from the right edge, OK 8 left of it.
+// The rows show the values of the cvars; OK sets them and writes user.scr
+class CSteamMultiplayerAdvanced : public CSteamScriptFrame
+{
+public:
+	typedef CSteamScriptFrame BaseClass;
+
+	CSteamMultiplayerAdvanced() : BaseClass( "CSteamMultiplayerAdvanced", 472, 376 ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		LoadRows( "user.scr", true );
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( "#GameUI_MultiplayerAdvanced" );
+
+		m_rows.SetBounds( 16, 56, 442, 274 );
+		AddItem( m_rows );
+
+		m_ok.SetBounds( 472 - 13 - 72 * 2 - 8, 338, 72, 24 );
+		m_cancel.SetBounds( 472 - 13 - 72, 338, 72, 24 );
+		Q_strncpy( m_ok.text, "#GameUI_OK", sizeof( m_ok.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_ok.isDefault = true;
+		m_ok.onReleased = VoidCb( &CSteamMultiplayerAdvanced::Ok );
+		m_cancel.onReleased = VoidCb( &CSteamMultiplayerAdvanced::Hide );
+		AddItem( m_ok );
+		AddItem( m_cancel );
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ) && !m_pOpenList )
+		{
+			Ok();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Ok()
+	{
+		CollectRows();
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+			EngFuncs::CvarSetString( var->name, var->value );
+		if( m_pVars )
+			CSCR_SaveToFile( "user.scr", "INFO_OPTIONS", m_pVars );
+		Hide();
+	}
+
+	CSteamButton m_ok, m_cancel;
+};
+
+static CSteamMultiplayerAdvanced *s_advanced = nullptr;
+
+void UI_SteamMultiplayerAdvanced_Menu( void )
+{
+	if( !s_advanced )
+		s_advanced = new CSteamMultiplayerAdvanced;
+	s_advanced->Show();
+}
diff --git a/3rdparty/mainui_cpp/menus/SteamGameMenu.cpp b/3rdparty/mainui_cpp/menus/SteamGameMenu.cpp
new file mode 100644
index 0000000..db43811
--- /dev/null
+++ b/3rdparty/mainui_cpp/menus/SteamGameMenu.cpp
@@ -0,0 +1,182 @@
+/*
+SteamGameMenu.cpp - the main menu as in the Steam version of Half-Life and its mods (see SteamGameMenu.h)
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+#include <string.h>
+#include <stdlib.h>
+
+#include "BaseMenu.h"
+#include "SteamGameMenu.h"
+#include "client/ClientWindow.h"
+
+namespace SteamGameMenu {
+
+bool g_bActive = false;
+
+static bool IsTrue( const char *value )
+{
+	return atoi( value ) != 0;
+}
+
+bool Load( CUtlVector<Entry> &entries )
+{
+	entries.RemoveAll();
+
+	char *afile = (char *)EngFuncs::COM_LoadFile( "resource/GameMenu.res" );
+	if( !afile )
+		return false;
+
+	char token[1024];
+	char *pfile = EngFuncs::COM_ParseFile( afile, token, sizeof( token ));
+
+	// "GameMenu" { "1" { "label" "..." "command" "..." ... } ... }
+	if( pfile )
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+
+	if( !pfile || strcmp( token, "{" ))
+	{
+		EngFuncs::COM_FreeFile( afile );
+		return false;
+	}
+
+	while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))))
+	{
+		if( !strcmp( token, "}" ))
+			break; // the end of "GameMenu"
+
+		// the name of the item ("1", "2"...), then its block
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+		if( !pfile || strcmp( token, "{" ))
+			break;
+
+		Entry e;
+		memset( &e, 0, sizeof( e ));
+
+		while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))))
+		{
+			if( !strcmp( token, "}" ))
+				break;
+
+			char key[64];
+			Q_strncpy( key, token, sizeof( key ));
+
+			pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+			if( !pfile )
+				break;
+
+			if( !stricmp( key, "label" ))
+				Q_strncpy( e.label, token, sizeof( e.label ));
+			else if( !stricmp( key, "command" ))
+				Q_strncpy( e.command, token, sizeof( e.command ));
+			else if( !stricmp( key, "OnlyInGame" ))
+				e.onlyInGame = IsTrue( token );
+			else if( !stricmp( key, "notsingle" ))
+				e.notSingle = IsTrue( token );
+			else if( !stricmp( key, "notmulti" ))
+				e.notMulti = IsTrue( token );
+			else if( !stricmp( key, "notsteam" ))
+				e.notSteam = IsTrue( token );
+		}
+
+		if( !pfile )
+			break;
+
+		entries.AddToTail( e );
+	}
+
+	EngFuncs::COM_FreeFile( afile );
+	return entries.Count() > 0;
+}
+
+} // namespace SteamGameMenu
+
+CSteamGameMenuItem::CSteamGameMenuItem() : BaseClass()
+{
+	label[0] = 0;
+	bDrawStroke = false;
+	SetText( "" );
+}
+
+void CSteamGameMenuItem::VidInit( void )
+{
+	BaseClass::VidInit();
+	m_scPos = pixelPos;
+	m_scSize = pixelSize;
+}
+
+void CSteamGameMenuItem::Draw( void )
+{
+	if( spacer || !label[0] )
+		return;
+
+	if( uiStatic.realTime < appearTime )
+		return;
+
+	unsigned int color = SteamGameMenu::MENU_COLOR;
+
+	if( iFlags & QMF_GRAYED )
+		color = PackRGBA( 117, 128, 111, 255 ); // "DisabledText1"
+	else if( m_bPressed )
+		color = SteamGameMenu::DEPRESSED_COLOR;
+	else if( iFlags & ( QMF_HASMOUSEFOCUS | QMF_HASKEYBOARDFOCUS ))
+		color = SteamGameMenu::ARMED_COLOR;
+
+#if defined( _WIN32 )
+	// the capitals of Tahoma from Windows came out a pixel higher than in the Steam version (compared on screenshots
+	// at 1920x1080: 997 instead of 998 for the last item)
+	const int fix = 1;
+#else
+	const int fix = 0;
+#endif
+	CClientWindow::DrawSteamText( textFont, m_scPos.x, capTop + fix, capHeight, gpGlobals->scrWidth - m_scPos.x, label, color );
+}
+
+CSteamGameMenuLogo::CSteamGameMenuLogo() : BaseClass()
+{
+	iFlags |= QMF_INACTIVE; // not a button: only lit under the mouse, as in the Steam version
+}
+
+bool CSteamGameMenuLogo::Load( void )
+{
+	if( !EngFuncs::FileExists( "resource/game_menu.tga" ))
+		return false;
+
+	m_hLogo = EngFuncs::PIC_Load( "resource/game_menu.tga", PIC_NOFLIP_TGA );
+	if( EngFuncs::FileExists( "resource/game_menu_mouseover.tga" ))
+		m_hLogoOver = EngFuncs::PIC_Load( "resource/game_menu_mouseover.tga", PIC_NOFLIP_TGA );
+
+	return m_hLogo != 0;
+}
+
+void CSteamGameMenuLogo::VidInit( void )
+{
+	BaseClass::VidInit();
+
+	if( !m_hLogo )
+		return;
+
+	// pixels, like the Steam version (not scaled with the screen)
+	m_scSize = Size( EngFuncs::PIC_Width( m_hLogo ), EngFuncs::PIC_Height( m_hLogo ));
+	m_scPos = Point( SteamGameMenu::INSET, gpGlobals->scrHeight - SteamGameMenu::LOGO_FROM_BOTTOM );
+}
+
+void CSteamGameMenuLogo::Draw( void )
+{
+	if( !m_hLogo )
+		return;
+
+	const bool over = m_hLogoOver && UI_CursorInRect( m_scPos, m_scSize );
+
+	EngFuncs::PIC_Set( over ? m_hLogoOver : m_hLogo, 255, 255, 255, 255 );
+	EngFuncs::PIC_DrawTrans( m_scPos, m_scSize );
+}
diff --git a/3rdparty/mainui_cpp/menus/SteamGameMenu.h b/3rdparty/mainui_cpp/menus/SteamGameMenu.h
new file mode 100644
index 0000000..fd7dc3c
--- /dev/null
+++ b/3rdparty/mainui_cpp/menus/SteamGameMenu.h
@@ -0,0 +1,109 @@
+/*
+SteamGameMenu.h - the main menu as in the Steam version of Half-Life and its mods (GameUI of VGUI2)
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+#pragma once
+
+// The items come from resource/GameMenu.res of the game, as in the Steam version: "label" (a key of the
+// translations, "#GameUI_GameMenu_FindServers"), "command" (what GameUI does: "OpenServerBrowser"...) and the
+// conditions "OnlyInGame", "notsingle", "notmulti", "notsteam". An item with an empty label is a gap of one line.
+//
+// The look is "InGameDesktop" of platform/resource/TrackerScheme.res of the Steam version:
+//   "MenuColor" 200 200 200, "ArmedMenuColor" 255 255 255 (under the mouse), "DepressedMenuColor" 192 186 80
+//   (pressed), "MenuItemHeight" 28, "GameMenuInset" 32, "MenuItemVisibilityRate" 0.03 (the items appear one after
+//   another, 0.03 s apart, when the menu is opened)
+// and its font is "Default" of the same file: Tahoma, tall 16, weight 0, without antialiasing. The sizes are pixels,
+// they don't depend on the resolution (as in the Steam version). Measured at 1920x1080: the text from x 32, the
+// capitals of the last item 998..1006 (9 pixels high, 82 pixels above the bottom), the items 28 pixels apart, the
+// logo of the game (resource/game_menu.tga, resource/game_menu_mouseover.tga under the mouse) at (32, 1034).
+
+#include "Action.h"
+#include "utlvector.h"
+
+namespace SteamGameMenu {
+
+// the main menu of the Steam version is shown (set by the main menu when it is made). Then, as in the Steam version,
+// the background is stretched to the whole screen (the 800 x 600 layout of resource/BackgroundLayout.txt: 2.4 x 1.8
+// at 1920x1080) and no version is printed under it
+extern bool g_bActive;
+
+// the colours of "InGameDesktop"
+const unsigned int MENU_COLOR      = PackRGBA( 200, 200, 200, 255 );
+const unsigned int ARMED_COLOR     = PackRGBA( 255, 255, 255, 255 );
+const unsigned int DEPRESSED_COLOR = PackRGBA( 192, 186, 80, 255 );
+
+const int ITEM_HEIGHT = 28;    // "MenuItemHeight"
+const int INSET = 32;          // "GameMenuInset"
+const float ITEM_RATE = 0.03f; // "MenuItemVisibilityRate"
+
+const int LAST_CAP_FROM_BOTTOM = 82; // the top of the capitals of the last item, from the bottom of the screen
+const int LOGO_FROM_BOTTOM = 46;     // the top of resource/game_menu.tga, from the bottom of the screen
+
+struct Entry
+{
+	char label[128];
+	char command[64];
+	bool onlyInGame;
+	bool notSingle;
+	bool notMulti;
+	bool notSteam;
+};
+
+// resource/GameMenu.res of the game (the mod first, then the base game); false if there is none
+bool Load( CUtlVector<Entry> &entries );
+
+} // namespace SteamGameMenu
+
+// the windows of the Steam version (SteamOptions.cpp...)
+void UI_SteamOptions_Menu( void );
+void UI_SteamServerBrowser_Menu( void );
+void UI_SteamCreateServer_Menu( void );
+void UI_SteamMultiplayerAdvanced_Menu( void );
+void SteamServerBrowser_AddServer( netadr_t adr, const char *info ); // the answers of the servers (UI_AddServerToList)
+
+// One item of the menu: its text in "Default", drawn in the colours of "InGameDesktop"
+class CSteamGameMenuItem : public CMenuAction
+{
+public:
+	typedef CMenuAction BaseClass;
+
+	CSteamGameMenuItem();
+
+	void VidInit( void ) override;
+	void Draw( void ) override;
+
+	char label[128];
+	bool spacer = false;   // an empty line
+	HFont textFont = 0;
+	int capHeight = 9;
+	int capTop = 0;         // the top of the capitals on the screen
+	float appearTime = 0.0f; // when the item is shown after the menu was opened (uiStatic.realTime)
+	Point pixelPos;           // the place on the screen in pixels (not scaled, as in the Steam version)
+	Size pixelSize;
+};
+
+// The logo of the game under the items: resource/game_menu.tga, resource/game_menu_mouseover.tga under the mouse
+class CSteamGameMenuLogo : public CMenuBaseItem
+{
+public:
+	typedef CMenuBaseItem BaseClass;
+
+	CSteamGameMenuLogo();
+
+	bool Load( void ); // false if the game has no logo
+	void VidInit( void ) override;
+	void Draw( void ) override;
+
+private:
+	HIMAGE m_hLogo = 0, m_hLogoOver = 0;
+};
diff --git a/3rdparty/mainui_cpp/menus/SteamOptions.cpp b/3rdparty/mainui_cpp/menus/SteamOptions.cpp
new file mode 100644
index 0000000..fda7be0
--- /dev/null
+++ b/3rdparty/mainui_cpp/menus/SteamOptions.cpp
@@ -0,0 +1,1292 @@
+/*
+SteamOptions.cpp - the Options window of the Steam version (GameUI of VGUI2): Multiplayer, Keyboard, Mouse, Audio,
+Video, Voice, Lock
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+// The window is 512 x 406 pixels in the middle of the screen, as in the Steam version. The places of the controls of
+// every page come from its .res file in the game (resource/OptionsSubMultiplayer.res, OptionsSubKeyboard.res,
+// OptionsSubMouse.res, OptionsSubAudio.res, OptionsSubVideo.res, OptionsSubVoice.res, OptionsSubAdvanced.res) and
+// the texts from the translations of GameUI, so the window looks as in the Steam version in any language.
+//
+// The settings are those of Xash3D: they are read when the window opens and written by OK and Apply (Cancel leaves
+// them as they were). The keys are set at once, as in the Steam version.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <math.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "SteamUI.h"
+#include "SteamGameMenu.h"
+#include "BMPUtils.h"
+#include "KbActListModel.h"
+
+using namespace SteamUI;
+
+namespace {
+
+// the colours of the spraypaint and of the crosshair, as in GameUI
+struct NamedColor { const char *name; const char *rgb; };
+
+const NamedColor g_logoColors[] = {
+	{ "#Valve_Orange", "255 120 24" },
+	{ "#Valve_Yellow", "225 180 24" },
+	{ "#Valve_Blue", "0 60 255" },
+	{ "#Valve_Ltblue", "0 167 255" },
+	{ "#Valve_Green", "0 167 0" },
+	{ "#Valve_Red", "255 43 0" },
+	{ "#Valve_Brown", "123 73 0" },
+	{ "#Valve_Ltgray", "100 100 100" },
+	{ "#Valve_Dkgray", "36 36 36" },
+};
+
+const NamedColor g_crosshairColors[] = {
+	{ "#Valve_Green", "50 250 50" },
+	{ "#Valve_Red", "250 50 50" },
+	{ "#Valve_Blue", "50 50 250" },
+	{ "#Valve_Yellow", "250 250 50" },
+	{ "#Valve_Ltblue", "50 250 250" },
+};
+
+const NamedColor g_crosshairSizes[] = {
+	{ "#GameUI_Auto", "auto" },
+	{ "#GameUI_Small", "small" },
+	{ "#GameUI_Medium", "medium" },
+	{ "#GameUI_Large", "large" },
+};
+
+// a text without the colour codes of the engine ("^1"...)
+void StripColors( const char *in, char *out, size_t size )
+{
+	size_t n = 0;
+	for( const char *p = in; *p && n + 1 < size; p++ )
+	{
+		if( p[0] == '^' && p[1] >= '0' && p[1] <= '9' )
+		{
+			p++;
+			continue;
+		}
+		out[n++] = *p;
+	}
+	out[n] = 0;
+}
+
+void ParseRGB( const char *s, int &r, int &g, int &b )
+{
+	r = g = b = 255;
+	sscanf( s, "%d %d %d", &r, &g, &b );
+}
+
+} // namespace
+
+// The list of the keys (the page Keyboard): the actions of gfx/shell/kb_act.lst in sections, each section with its
+// title and the titles of the columns ("KEY/BUTTON", "ALTERNATE"), as the SectionedListPanel of the Steam version.
+// Measured at 1920x1080: the rows 20 pixels from 25 pixels under the top of the list, the columns from 13, 231
+// and 361 pixels, the chosen row on "SelectionBG" from x 7 to the scroll bar, the scroll bar 18 pixels wide.
+class CSteamKeyList : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	CSteamKeyList() : model( CMenuKbActListModel::VIEW_BINDINGS ) {}
+
+	void Refresh();
+	bool KeyDown( int key ) override;
+	void Draw() override;
+
+	int SelectedEntry() const { return selected >= 0 && selected < rows.Count() ? rows[selected].entry : -1; }
+	const char *SelectedBind() const;
+	bool grabbing = false;
+	CEventCallback onActivate;
+
+	CMenuKbActListModel model;
+
+private:
+	struct Row { int entry; bool header; };
+	CUtlVector<Row> rows;
+	int selected = -1;
+	int top = 0;
+	int m_iLastClickTime = 0;
+	int m_iLastClickRow = -1;
+	SteamUI::ScrollBar m_sb;
+	void PlaceScrollBar();
+
+	int RowHeight() const { return 20; }
+	int VisibleRows() const { return ( m_scSize.h - 4 ) / RowHeight(); }
+	void ClampTop();
+};
+
+void CSteamKeyList::Refresh()
+{
+	model.Update();
+	rows.RemoveAll();
+
+	for( int i = 0; i < model.entries.Count(); i++ )
+	{
+		const CMenuKbActListModel::entry_t &e = model.entries[i];
+		char text[96];
+		StripColors( e.display, text, sizeof( text ));
+
+		if( !e.bind[0] )
+		{
+			// "==========": the frame of a title in the file, not shown
+			if( text[0] == '=' || !text[0] )
+				continue;
+		}
+
+		Row r;
+		r.entry = i;
+		r.header = !e.bind[0];
+		rows.AddToTail( r );
+	}
+
+	if( selected < 0 || selected >= rows.Count() || rows[selected].header )
+	{
+		selected = -1;
+		for( int i = 0; i < rows.Count(); i++ )
+			if( !rows[i].header ) { selected = i; break; }
+	}
+	ClampTop();
+}
+
+const char *CSteamKeyList::SelectedBind() const
+{
+	const int e = SelectedEntry();
+	return e >= 0 ? model.entries[e].bind : "";
+}
+
+void CSteamKeyList::PlaceScrollBar()
+{
+	m_sb.x = m_scPos.x + m_scSize.w - 19;
+	m_sb.y = m_scPos.y + 1;
+	m_sb.w = 18;
+	m_sb.h = m_scSize.h - 2;
+	m_sb.total = rows.Count();
+	m_sb.visible = VisibleRows();
+	m_sb.top = top;
+}
+
+void CSteamKeyList::ClampTop()
+{
+	const int maxTop = rows.Count() - VisibleRows();
+	if( top > maxTop ) top = maxTop;
+	if( top < 0 ) top = 0;
+}
+
+bool CSteamKeyList::KeyDown( int key )
+{
+	if( grabbing )
+		return false;
+
+	if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+	{
+		top += key == K_MWHEELUP ? -3 : 3;
+		ClampTop();
+		return true;
+	}
+
+	if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+	{
+		const int dir = UI::Key::IsUpArrow( key ) ? -1 : 1;
+		for( int i = selected + dir; i >= 0 && i < rows.Count(); i += dir )
+		{
+			if( rows[i].header )
+				continue;
+			selected = i;
+			if( selected < top ) top = selected - 1;
+			if( selected >= top + VisibleRows( )) top = selected - VisibleRows() + 1;
+			ClampTop();
+			break;
+		}
+		return true;
+	}
+
+	if( UI::Key::IsEnter( key ))
+	{
+		if( onActivate )
+			onActivate( this );
+		return true;
+	}
+
+	if( UI::Key::IsLeftMouse( key ) && Hovered( ))
+	{
+		// the scroll bar: its buttons, its slider (held by the mouse), a page up / down
+		PlaceScrollBar();
+		if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+		{
+			top = m_sb.top;
+			return true;
+		}
+
+		const int r = top + ( uiStatic.cursorY - m_scPos.y - 2 ) / RowHeight();
+		if( r >= 0 && r < rows.Count() && !rows[r].header )
+		{
+			const bool dbl = r == m_iLastClickRow && uiStatic.realTime - m_iLastClickTime < 400;
+			selected = r;
+			m_iLastClickRow = r;
+			m_iLastClickTime = uiStatic.realTime;
+			if( dbl && onActivate )
+				onActivate( this );
+		}
+		return true;
+	}
+
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamKeyList::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	const int rowH = RowHeight();
+	const int sbX = x + w - 19;
+
+	// the slider held by the mouse moves the rows
+	PlaceScrollBar();
+	m_sb.Clamp(); // a window made bigger shows more rows: the first one may have to go up
+	m_sb.Think();
+	top = m_sb.top;
+
+	Fill( x, y, w, h, ListBG );
+	InsetBorder( x, y, w, h );
+
+	const int col0 = x + 13, col1 = x + 231, col2 = x + 361;
+	const int visible = VisibleRows();
+
+	for( int i = 0; i < visible && top + i < rows.Count(); i++ )
+	{
+		const Row &row = rows[top + i];
+		const CMenuKbActListModel::entry_t &e = model.entries[row.entry];
+		const int ry = y + 2 + i * rowH;
+		char text[96];
+		StripColors( e.display, text, sizeof( text ));
+
+		if( row.header )
+		{
+			// the title of the section and of the columns: "DefaultSmall", "BrightControlText", on the bottom of the row
+			const int ty = ry + rowH - FontTall( FONT_DEFAULT_SMALL ) - 1;
+			Text( FONT_DEFAULT_SMALL, x + 7, ty, text, BrightControlText, col1 - x - 12 );
+			Text( FONT_DEFAULT_SMALL, col1 - 2, ty, L( "GameUI_KeyButton" ), BrightControlText, col2 - col1 );
+			Text( FONT_DEFAULT_SMALL, col2 - 2, ty, L( "GameUI_Alternate" ), BrightControlText, sbX - col2 );
+			continue;
+		}
+
+		const bool sel = top + i == selected;
+		if( sel )
+			Fill( x + 7, ry, sbX - x - 10, rowH, SelectionBG );
+
+		const unsigned int c = sel ? BrightBaseText : ControlText;
+		TextInBox( FONT_DEFAULT, col0, ry, col1 - col0 - 4, rowH, text, c );
+
+		if( sel && grabbing )
+			continue; // waiting for the key
+
+		TextInBox( FONT_DEFAULT, col1, ry, col2 - col1 - 4, rowH, e.first, c );
+		TextInBox( FONT_DEFAULT, col2, ry, sbX - col2 - 4, rowH, e.second, c );
+	}
+
+	// the scroll bar
+	PlaceScrollBar();
+	m_sb.Draw();
+}
