+// the answers of the servers, from UI_AddServerToList of mainui
+void SteamServerBrowser_AddServer( netadr_t adr, const char *info )
+{
+	if( s_browser && s_browser->WasInit() && s_browser->IsVisible( ))
+		s_browser->AddServer( adr, info );
+	if( s_browser )
+		s_browser->AddServerDialogAnswer( adr, info );
+}
