+		Q_strncpy( m_message.text, Russian() ?
+			// "Введите имя игрока. Под этим именем вас будут видеть на серверах." (the bytes of UTF-8: the compilers read the source in different code pages)
+			"\xd0\x92\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5 \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xb0. \xd0\x9f\xd0\xbe\xd0\xb4 \xd1\x8d\xd1\x82\xd0\xb8\xd0\xbc \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbc \xd0\xb2\xd0\xb0\xd1\x81 \xd0\xb1\xd1\x83\xd0\xb4\xd1\x83\xd1\x82 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb0\xd1\x85." :
+			"Enter your player name. Other players will see you on servers by this name.", sizeof( m_message.text ));
+		m_bWarning = false;
+		const char *name = EngFuncs::GetCvarString( "name" );
+		m_entry.SetBuffer( UI::Names::CheckIsNameValid( name ) ? name : EngFuncs::GetCvarString( "ui_username" ));
+		SetCursorToItem( m_entry );
+	}
+
+	void Hide() override
+	{
+		BaseClass::Hide();
+		// closed without a name: the window that needs one closes too
+		if( caller && !UI::Names::CheckIsNameValid( EngFuncs::GetCvarString( "name" )))
+			caller->Hide();
+		caller = nullptr;
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ))
+		{
+			Ok();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+private:
+	static bool Russian() { return !stricmp( EngFuncs::GetCvarString( "ui_language" ), "russian" ); }
+
+	void _Init() override
+	{
+		SetTitle( "#GameUI_PlayerName" );
+		m_message.SetBounds( 20, 38, 280, 48 );
+		m_message.wrap = true;
+		m_message.iFlags |= QMF_INACTIVE;
+		m_entry.SetBounds( 20, 92, 280, 24 );
+		m_entry.iMaxLength = MAX_SCOREBOARDNAME;
+		m_entry.bAllowColorstrings = true;
+		m_ok.SetBounds( 320 - 13 - 72 * 2 - 8, 168 - 14 - 24, 72, 24 );
+		m_cancel.SetBounds( 320 - 13 - 72, 168 - 14 - 24, 72, 24 );
+		Q_strncpy( m_ok.text, "#GameUI_OK", sizeof( m_ok.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_ok.isDefault = true;
+		m_ok.onReleased = VoidCb( &CSteamPlayerNameDialog::Ok );
+		m_cancel.onReleased = VoidCb( &CSteamPlayerNameDialog::Hide );
+		AddItem( m_message );
+		AddItem( m_entry );
+		AddItem( m_ok );
+		AddItem( m_cancel );
+	}
+
+	void Draw() override
+	{
+		// the warning in "BrightControlText", as the Steam version marks what needs the eye
+		m_message.color = m_bWarning ? BrightControlText : 0;
+		m_ok.SetGrayed( !m_entry.GetBuffer()[0] );
+		BaseClass::Draw();
+	}
+
+	void Ok()
+	{
+		const char *name = m_entry.GetBuffer();
+		if( !UI::Names::CheckIsNameValid( name ))
+		{
+			Q_strncpy( m_message.text, Russian() ?
+				// "Это имя использовать нельзя, введите другое." (the bytes of UTF-8: the compilers read the source in different code pages)
+				"\xd0\xad\xd1\x82\xd0\xbe \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f, \xd0\xb2\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5 \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd0\xbe\xd0\xb5." :
+				"This name can't be used, please choose another one.", sizeof( m_message.text ));
+			m_bWarning = true;
+			return;
+		}
+		EngFuncs::CvarSetString( "name", name );
+		BaseClass::Hide();
+		caller = nullptr;
+	}
+
+	CSteamLabel m_message;
+	CSteamTextEntry m_entry;
+	CSteamButton m_ok, m_cancel;
+	bool m_bWarning = false;
+};
