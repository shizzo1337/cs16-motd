+
+// The players of a server in the window Game Info: Player Name, Score, Time. Measured at 1920x1080: a header of 17
+// pixels ("DefaultSmall"), rows of 16 pixels in "Default", the columns 156 and 64 pixels and the rest, the scroll bar
+// 18 pixels wide
+class CSteamPlayerList : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	struct Player { char name[64]; int frags; float time; };
+	CUtlVector<Player> players;
+
+	void Clear() { players.RemoveAll(); m_iTop = 0; } // another server
+
+	bool KeyDown( int key ) override
+	{
+		if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+		{
+			m_iTop += key == K_MWHEELUP ? -3 : 3;
+			Clamp();
+			return true;
+		}
+		if( UI::Key::IsLeftMouse( key ) && Hovered( ))
+		{
+			Place();
+			if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+				m_iTop = m_sb.top;
+			else if( uiStatic.cursorY < m_scPos.y + 19 )
+			{
+				// the header: the line at the right edge of Player Name or Score makes the column wider or narrower
+				int cols[3], ends[3];
+				Columns( cols, ends );
+				for( int c = 0; c < 2; c++ )
+				{
+					if( uiStatic.cursorX >= ends[c] - 3 && uiStatic.cursorX <= ends[c] + 3 )
+					{
+						m_iDragEdge = c;
+						m_iDragStartX = uiStatic.cursorX;
+						m_iDragStartW = m_width[c];
+						break;
+					}
+				}
+			}
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		Place();
+		m_sb.Clamp(); // a window made bigger shows more rows: the first one may have to go up
+		m_sb.Think();
+		m_iTop = m_sb.top;
+		DragEdge();
+		if( m_iDragEdge >= 0 )
+			WantCursor( this, dc_sizewe, true );
+		else if( Hovered() && uiStatic.cursorY < m_scPos.y + 19 )
+		{
+			int cols[3], ends[3];
+			Columns( cols, ends );
+			for( int c = 0; c < 2; c++ )
+				if( uiStatic.cursorX >= ends[c] - 3 && uiStatic.cursorX <= ends[c] + 3 )
+					WantCursor( this, dc_sizewe );
+		}
+
+		const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+		Fill( x, y, w, h, ListBG );
+		InsetBorder( x, y, w, h );
+
+		int cols[3], ends[3];
+		Columns( cols, ends );
+		const char *titles[3] = { SB( "ServerBrowser_PlayerName", "Player Name" ), SB( "ServerBrowser_Score", "Score" ),
+			SB( "ServerBrowser_Time", "Time" ) };
+		for( int c = 0; c < 3; c++ )
+		{
+			Fill( cols[c], y + 1, ends[c] - cols[c], 17, ControlBG );
+			RaisedBorder( cols[c], y + 1, ends[c] - cols[c], 17 );
+			TextInBox( FONT_DEFAULT_SMALL, cols[c] + 4, y + 1, ends[c] - cols[c] - 6, 17, titles[c], ControlText );
+		}
+
+		for( int i = 0; i < Visible() && m_iTop + i < players.Count(); i++ )
+		{
+			const Player &p = players[m_iTop + i];
+			const int ry = y + 20 + i * 16;
+			char buf[32];
+
+			TextInBox( FONT_DEFAULT, cols[0] + 5, ry, ends[0] - cols[0] - 6, 16, p.name, ControlText );
+			snprintf( buf, sizeof( buf ), "%d", p.frags );
+			TextInBox( FONT_DEFAULT, cols[1] + 4, ry, ends[1] - cols[1] - 6, 16, buf, ControlText );
+
+			// as the Steam version: "13m 27s", "1h 2m"
+			const int t = (int)p.time;
+			if( t >= 3600 )
+				snprintf( buf, sizeof( buf ), "%dh %dm", t / 3600, ( t / 60 ) % 60 );
+			else
+				snprintf( buf, sizeof( buf ), "%dm %ds", t / 60, t % 60 );
+			TextInBox( FONT_DEFAULT, cols[2] + 4, ry, ends[2] - cols[2] - 6, 16, buf, ControlText );
+		}
+
+		Place();
+		m_sb.Draw();
+	}
+
+private:
+	// Player Name and Score by their widths (156 and 64 at first, as in the Steam version), Time up to the scroll bar
+	void Columns( int cols[3], int ends[3] ) const
+	{
+		const int x = m_scPos.x, sbX = x + m_scSize.w - 19;
+		cols[0] = x + 1;
+		ends[0] = cols[1] = cols[0] + m_width[0];
+		ends[1] = cols[2] = cols[1] + m_width[1];
+		ends[2] = sbX > cols[2] + 20 ? sbX : cols[2] + 20;
+	}
+	// a column made wider or narrower while the button is held: at least 20 pixels for every column
+	void DragEdge()
+	{
+		if( m_iDragEdge < 0 )
+			return;
+		if( !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+		{
+			m_iDragEdge = -1;
+			return;
+		}
+		const int maxW = m_scSize.w - 1 - 19 - m_width[1 - m_iDragEdge] - 20;
+		int nw = m_iDragStartW + uiStatic.cursorX - m_iDragStartX;
+		if( nw > maxW ) nw = maxW;
+		if( nw < 20 ) nw = 20;
+		m_width[m_iDragEdge] = nw;
+	}
+	int Visible() const { return ( m_scSize.h - 21 ) / 16; }
+	void Clamp()
+	{
+		const int maxTop = players.Count() - Visible();
+		if( m_iTop > maxTop ) m_iTop = maxTop;
+		if( m_iTop < 0 ) m_iTop = 0;
+	}
+	void Place()
+	{
+		m_sb.x = m_scPos.x + m_scSize.w - 19;
+		m_sb.y = m_scPos.y + 1;
+		m_sb.w = 18;
+		m_sb.h = m_scSize.h - 2;
+		m_sb.total = players.Count();
+		m_sb.visible = Visible();
+		m_sb.top = m_iTop;
+	}
+
+	int m_iTop = 0;
+	int m_width[2] = { 156, 64 };
+	int m_iDragEdge = -1, m_iDragStartX = 0, m_iDragStartW = 0;
+	SteamUI::ScrollBar m_sb;
+};
