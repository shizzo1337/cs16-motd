+using namespace SteamUI;
+
+const steamui_enginefuncs_t *g_pSteamUIEngine = nullptr;
+
+namespace {
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the text of the console: kept from the start of the game, the window or not
+
+const int MAX_LINES = 4096;
+
+struct ConsoleText
+{
+	CUtlVector<char *> lines; // without their line ends
+	bool lastOpen = false;    // the last line goes on (no line end came yet)
+	int serial = 0;           // changed with the text
+	int dropped = 0;          // the lines taken from the top, all in all
+};
+
+ConsoleText s_text;
+
+void AddText( const char *text )
+{
+	while( *text )
+	{
+		const char *nl = strchr( text, '\n' );
+		const int n = nl ? (int)( nl - text ) : (int)strlen( text );
+
+		if( s_text.lastOpen && s_text.lines.Count( ))
+		{
+			char *&last = s_text.lines[s_text.lines.Count() - 1];
+			const int old = (int)strlen( last );
+			char *grown = (char *)realloc( last, old + n + 1 );
+			if( grown )
+			{
+				memcpy( grown + old, text, n );
+				grown[old + n] = 0;
+				last = grown;
+			}
+		}
+		else
+		{
+			char *line = (char *)malloc( n + 1 );
+			if( !line )
+				return;
+			memcpy( line, text, n );
+			line[n] = 0;
+			s_text.lines.AddToTail( line );
+
+			while( s_text.lines.Count() > MAX_LINES )
+			{
+				free( s_text.lines[0] );
+				s_text.lines.Remove( 0 );
+				s_text.dropped++;
+			}
+		}
+
+		// no carriage returns and no other control characters but the tab
+		char *last = s_text.lines[s_text.lines.Count() - 1];
+		for( char *c = last; *c; c++ )
+			if(( unsigned char )*c < 32 && *c != '\t' )
+				*c = ' ';
+
+		s_text.lastOpen = nl == nullptr;
+		text += n;
+		if( nl )
+			text++;
+	}
+	s_text.serial++;
+}
+
+void ClearText()
+{
+	for( int i = 0; i < s_text.lines.Count(); i++ )
+		free( s_text.lines[i] );
+	s_text.dropped += s_text.lines.Count();
+	s_text.lines.RemoveAll();
+	s_text.lastOpen = false;
+	s_text.serial++;
+}
+
+// the colours of the engine in the text: "^0".."^9"
+unsigned int ColorCode( int digit )
+{
+	switch( digit )
+	{
+	case 1: return PackRGBA( 255, 96, 80, 255 );   // red
+	case 2: return PackRGBA( 96, 220, 96, 255 );   // green
+	case 3: return PackRGBA( 240, 214, 96, 255 );  // yellow
+	case 4: return PackRGBA( 96, 160, 255, 255 );  // blue
+	case 5: return PackRGBA( 80, 200, 240, 255 );  // cyan
+	case 6: return PackRGBA( 230, 110, 230, 255 ); // magenta
+	case 0: return DimBaseText;
+	default: return BaseText;
+	}
+}
+
+bool IsColorCode( const char *p )
+{
+	return p[0] == '^' && p[1] >= '0' && p[1] <= '9';
+}
+
+// the bytes of the letter at p (UTF-8)
+int CharLen( const char *p )
+{
+	const unsigned char c = *p;
+	int n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+	for( int i = 1; i < n; i++ )
+		if( !p[i] )
+			return i;
+	return n;
+}
+
+const int TAB_WIDTH = 40;
+
+// the width of a letter in "Default": the tab to the next 40 pixels
+int CharWidth( const char *p, int n, int x )
+{
+	static int ascii[128];
+	static bool known[128];
+
+	if( *p == '\t' )
+		return TAB_WIDTH - x % TAB_WIDTH;
+
+	const unsigned char c = *p;
+	if( c < 128 )
+	{
+		if( !known[c] )
+		{
+			const char s[2] = { (char)c, 0 };
+			ascii[c] = TextWidth( FONT_DEFAULT, s );
+			known[c] = true;
+		}
+		return ascii[c];
+	}
+
+	char s[8];
+	memcpy( s, p, n );
+	s[n] = 0;
+	return TextWidth( FONT_DEFAULT, s );
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the text of the window: wrapped at its width, a scroll bar, selected by the mouse and copied by Ctrl+C
+
+class CSteamConsoleHistory : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	CSteamConsoleHistory() { iFlags |= QMF_INACTIVE; } // the field keeps the keyboard; the window gives the mouse
+
+	bool MouseDown( int key ); // from the window
+	void Draw() override;
+	bool HasSelection() const { return m_selA[0] != m_selB[0] || m_selA[1] != m_selB[1]; }
+	void Copy();
+	void ScrollToEnd() { m_bStick = true; }
+
+private:
+	struct Row { int line; int start; int end; unsigned int color; };
+
+	enum { INSET = 3 };
+	int RowTall() const { return FontTall( FONT_DEFAULT ) + 1; }
+	int TextWide() const { return m_scSize.w - INSET * 2 - 17; }
+	int VisibleRows() const { return ( m_scSize.h - INSET * 2 ) / RowTall(); }
+	void Rewrap();
+	void WrapLine( int line );
+	void PlaceScrollBar();
+	bool PosAt( int cx, int cy, int &line, int &byte );
+	void Order( int a[2], int b[2] ) const;
+
+	CUtlVector<Row> m_rows;
+	int m_iWrappedWide = -1, m_iWrappedSerial = -1, m_iWrappedDropped = 0;
+	int m_iTop = 0;
+	bool m_bStick = true; // at the end: new text keeps it there
+	ScrollBar m_sb;
+
+	// the selection: (line, byte) of the anchor and of the end, the lines counted from all those ever taken away
+	int m_selA[2] = { 0, 0 }, m_selB[2] = { 0, 0 };
+	bool m_bSelecting = false;
+};
+
+void CSteamConsoleHistory::WrapLine( int line )
+{
+	const char *text = s_text.lines[line];
+	const int wide = TextWide() > 20 ? TextWide() : 20;
+	unsigned int color = BaseText;
+	int start = 0, x = 0, lastSpace = -1;
+	unsigned int startColor = color, spaceColor = color;
+
+	for( int i = 0; text[i]; )
+	{
+		if( IsColorCode( text + i ))
+		{
+			color = ColorCode( text[i + 1] - '0' );
+			i += 2;
+			continue;
+		}
+
+		const int n = CharLen( text + i );
+		const int w = CharWidth( text + i, n, x );
+		if( x + w > wide && i > start )
+		{
+			// at the last space of the row, else at this letter
+			int cut = lastSpace > start ? lastSpace + 1 : i;
+			Row r = { line, start, cut, startColor };
+			m_rows.AddToTail( r );
+			startColor = lastSpace > start ? spaceColor : color;
+			start = cut;
+			lastSpace = -1;
+
+			// the width of what goes on the next row
+			x = 0;
+			for( int k = start; k < i; )
+			{
+				if( IsColorCode( text + k )) { k += 2; continue; }
+				const int kn = CharLen( text + k );
+				x += CharWidth( text + k, kn, x );
+				k += kn;
+			}
+			continue;
+		}
+
+		if( text[i] == ' ' )
+		{
+			lastSpace = i;
+			spaceColor = color;
+		}
+		x += w;
+		i += n;
+	}
+
+	Row r = { line, start, (int)strlen( text ), startColor };
+	m_rows.AddToTail( r );
+}
+
+void CSteamConsoleHistory::Rewrap()
+{
+	const bool all = m_iWrappedWide != TextWide() || m_iWrappedDropped != s_text.dropped;
+	if( !all && m_iWrappedSerial == s_text.serial )
+		return;
+
+	int from = 0;
+	if( all )
+		m_rows.RemoveAll();
+	else
+	{
+		// the rows of the last line again (it may have grown), then the new lines
+		const int lastLine = m_rows.Count() ? m_rows[m_rows.Count() - 1].line : -1;
+		while( m_rows.Count() && m_rows[m_rows.Count() - 1].line == lastLine )
+			m_rows.Remove( m_rows.Count() - 1 );
+		from = lastLine >= 0 ? lastLine : 0;
+	}
+
+	for( int i = from; i < s_text.lines.Count(); i++ )
+		WrapLine( i );
+
+	if( m_iWrappedDropped != s_text.dropped )
+	{
+		// the lines of the selection may be gone
+		m_selA[0] = m_selA[1] = m_selB[0] = m_selB[1] = 0;
+	}
+
+	m_iWrappedWide = TextWide();
+	m_iWrappedSerial = s_text.serial;
+	m_iWrappedDropped = s_text.dropped;
+}
+
+void CSteamConsoleHistory::PlaceScrollBar()
+{
+	m_sb.w = 17;
+	m_sb.x = m_scPos.x + m_scSize.w - 1 - 17;
+	m_sb.y = m_scPos.y + 1;
+	m_sb.h = m_scSize.h - 2;
+	m_sb.total = m_rows.Count();
+	m_sb.visible = VisibleRows();
+	m_sb.top = m_iTop;
+}
+
+bool CSteamConsoleHistory::PosAt( int cx, int cy, int &line, int &byte )
+{
+	if( !m_rows.Count( ))
+		return false;
+
+	int r = m_iTop + ( cy - ( m_scPos.y + INSET )) / RowTall();
+	if( cy < m_scPos.y + INSET ) r = m_iTop - 1;
+	if( r < 0 ) { line = m_rows[0].line + s_text.dropped; byte = 0; return true; }
+	if( r >= m_rows.Count( ))
+	{
+		const Row &last = m_rows[m_rows.Count() - 1];
+		line = last.line + s_text.dropped;
+		byte = last.end;
+		return true;
+	}
+
+	const Row &row = m_rows[r];
+	const char *text = s_text.lines[row.line];
+	int x = m_scPos.x + INSET, i = row.start, px = 0;
+	byte = row.end;
+	while( i < row.end )
+	{
+		if( IsColorCode( text + i )) { i += 2; continue; }
+		const int n = CharLen( text + i );
+		const int w = CharWidth( text + i, n, px );
+		if( cx < x + px + w / 2 )
+		{
+			byte = i;
+			break;
+		}
+		px += w;
+		i += n;
+	}
+	line = row.line + s_text.dropped;
+	return true;
+}
+
+void CSteamConsoleHistory::Order( int a[2], int b[2] ) const
+{
+	const bool swap = m_selB[0] < m_selA[0] || ( m_selB[0] == m_selA[0] && m_selB[1] < m_selA[1] );
+	a[0] = swap ? m_selB[0] : m_selA[0]; a[1] = swap ? m_selB[1] : m_selA[1];
+	b[0] = swap ? m_selA[0] : m_selB[0]; b[1] = swap ? m_selA[1] : m_selB[1];
+}
+
+bool CSteamConsoleHistory::MouseDown( int key )
+{
+	if( !UI_CursorInRect( m_scPos, m_scSize ))
+		return false;
+
+	Rewrap();
+	if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+	{
+		m_iTop += key == K_MWHEELUP ? -3 : 3;
+		const int maxTop = m_rows.Count() - VisibleRows();
+		if( m_iTop > maxTop ) m_iTop = maxTop;
+		if( m_iTop < 0 ) m_iTop = 0;
+		m_bStick = m_iTop >= maxTop;
+		return true;
+	}
+
+	if( key != K_MOUSE1 )
+		return true;
+
+	PlaceScrollBar();
+	if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+	{
+		m_iTop = m_sb.top;
+		m_bStick = false;
+		return true;
+	}
+
+	int line, byte;
+	if( PosAt( uiStatic.cursorX, uiStatic.cursorY, line, byte ))
+	{
+		m_selA[0] = m_selB[0] = line;
+		m_selA[1] = m_selB[1] = byte;
+		m_bSelecting = true;
+	}
+	return true;
+}
+
+void CSteamConsoleHistory::Copy()
+{
+	if( !HasSelection() || !g_pSteamUIEngine || !g_pSteamUIEngine->pfnSetClipboardText )
+		return;
+
+	int a[2], b[2];
+	Order( a, b );
+
+	CUtlVector<char> out;
+	for( int l = a[0]; l <= b[0]; l++ )
+	{
+		const int i = l - s_text.dropped;
+		if( i < 0 || i >= s_text.lines.Count( ))
+			continue;
+		const char *text = s_text.lines[i];
+		const int len = (int)strlen( text );
+		int from = l == a[0] ? a[1] : 0, to = l == b[0] ? b[1] : len;
+		if( from > len ) from = len;
+		if( to > len ) to = len;
+		for( int k = from; k < to; k++ )
+		{
+			if( IsColorCode( text + k )) { k++; continue; }
+			out.AddToTail( text[k] );
+		}
+		if( l != b[0] )
+		{
+#ifdef _WIN32
+			out.AddToTail( '\r' );
+#endif
+			out.AddToTail( '\n' );
+		}
+	}
+	out.AddToTail( 0 );
+	g_pSteamUIEngine->pfnSetClipboardText( out.Base( ));
+}
+
+void CSteamConsoleHistory::Draw()
+{
+	Rewrap();
+
+	const int visible = VisibleRows();
+	const int maxTop = m_rows.Count() > visible ? m_rows.Count() - visible : 0;
+
+	PlaceScrollBar();
+	m_sb.Clamp();
+	m_sb.Think();
+	if( m_sb.top != m_iTop )
+	{
+		m_iTop = m_sb.top;
+		m_bStick = m_iTop >= maxTop;
+	}
+	if( m_bStick )
+		m_iTop = maxTop;
+	if( m_iTop > maxTop ) m_iTop = maxTop;
+	if( m_iTop < 0 ) m_iTop = 0;
+
+	// the selection dragged by the mouse
+	if( m_bSelecting )
+	{
+		if( !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+			m_bSelecting = false;
+		else
+		{
+			// past the top or the bottom the text scrolls
+			if( uiStatic.cursorY < m_scPos.y && m_iTop > 0 ) { m_iTop--; m_bStick = false; }
+			if( uiStatic.cursorY >= m_scPos.y + m_scSize.h && m_iTop < maxTop ) m_iTop++;
+			int line, byte;
+			if( PosAt( uiStatic.cursorX, uiStatic.cursorY, line, byte ))
+			{
+				m_selB[0] = line;
+				m_selB[1] = byte;
+			}
+		}
+	}
+
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	Fill( x, y, w, h, ListBG );
+	InsetBorder( x, y, w, h );
+
+	// the text cursor over the text, as over the RichText of VGUI2 (the arrow over its scroll bar)
+	if( m_bSelecting )
+		WantCursor( this, dc_ibeam, true );
+	else if( UI_CursorInRect( m_scPos, m_scSize ) && !m_sb.Inside( uiStatic.cursorX, uiStatic.cursorY ))
+		WantCursor( this, dc_ibeam );
+
+	int a[2], b[2];
+	Order( a, b );
+	const bool selected = HasSelection();
+	const int rowTall = RowTall();
+	const int tall = FontTall( FONT_DEFAULT );
+
+	for( int r = 0; r < visible && m_iTop + r < m_rows.Count(); r++ )
+	{
+		const Row &row = m_rows[m_iTop + r];
+		const char *text = s_text.lines[row.line];
+		const int abs = row.line + s_text.dropped;
+		const int ry = y + INSET + r * rowTall;
+		int px = 0;
+		unsigned int color = row.color;
+
+		for( int i = row.start; i < row.end; )
+		{
+			if( IsColorCode( text + i ))
+			{
+				color = ColorCode( text[i + 1] - '0' );
+				i += 2;
+				continue;
+			}
+
+			// a piece of one colour, without tabs
+			int j = i, pw = 0;
+			while( j < row.end && !IsColorCode( text + j ) && text[j] != '\t' )
+			{
+				const int n = CharLen( text + j );
+				pw += CharWidth( text + j, n, px + pw );
+				j += n;
+			}
+
+			if( j == i )
+			{
+				// a tab
+				px += CharWidth( text + i, 1, px );
+				i++;
+				continue;
+			}
+
+			// the selected part of the piece
+			const bool sel = selected && ( abs > a[0] || ( abs == a[0] && j > a[1] )) && ( abs < b[0] || ( abs == b[0] && i < b[1] ));
+			if( sel )
+			{
+				int s0 = ( abs == a[0] && a[1] > i ) ? a[1] : i;
+				int s1 = ( abs == b[0] && b[1] < j ) ? b[1] : j;
+				int sx = 0, sw = 0;
+				for( int k = i; k < s0; ) { const int n = CharLen( text + k ); sx += CharWidth( text + k, n, px + sx ); k += n; }
+				for( int k = s0; k < s1; ) { const int n = CharLen( text + k ); sw += CharWidth( text + k, n, px + sx + sw ); k += n; }
+				Fill( x + INSET + px + sx, ry, sw, rowTall, SelectionBG );
+			}
+
+			char piece[1024];
+			const int n = j - i < (int)sizeof( piece ) - 1 ? j - i : (int)sizeof( piece ) - 1;
+			memcpy( piece, text + i, n );
+			piece[n] = 0;
+			Text( FONT_DEFAULT, x + INSET + px, ry + ( rowTall - tall ) / 2, piece, color, TextWide() - px + 8 );
+			px += pw;
+			i = j;
+		}
+	}
+
+	PlaceScrollBar();
+	m_sb.Draw();
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the field: the keys of the console come from the window, the key of the console itself is not typed
