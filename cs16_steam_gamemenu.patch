+		*m_joystickLook = nullptr, *m_autoAim = nullptr, *m_rawInput = nullptr;
+	CSteamSlider *m_sensitivity = nullptr;
+	CSteamTextEntry *m_sensitivityText = nullptr;
+
+	CSteamSlider *m_sfx = nullptr, *m_mp3 = nullptr, *m_suit = nullptr;
+	CSteamComboBox *m_soundQuality = nullptr;
+
+	CSteamComboBox *m_renderer = nullptr, *m_resolution = nullptr, *m_aspect = nullptr;
+	CSteamCheckButton *m_windowed = nullptr, *m_vsync = nullptr, *m_hdModels = nullptr, *m_addons = nullptr,
+		*m_lowVideo = nullptr, *m_detailTextures = nullptr;
+	CSteamSlider *m_brightness = nullptr, *m_gamma = nullptr;
+
+	CSteamCheckButton *m_voiceEnable = nullptr, *m_micBoost = nullptr;
+	CSteamSlider *m_voiceTransmit = nullptr, *m_voiceReceive = nullptr;
+	CSteamButton *m_testMic = nullptr;
