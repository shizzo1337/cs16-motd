+// ---------------------------------------------------------------------------------------------------------------------
+
+// The windows of the Steam version stay open when the menu is closed (back to the game) and come back, where they were,
+// when it is opened again, as in the Steam version. The questions (message boxes, the password) do not.
+void SteamUI_SaveOpenWindows()
+{
+	if( !uiStatic.menu.IsActive( ))
+		return; // closed already: keep what was saved
+
+	s_framesToRestore.RemoveAll();
+	CMenuBaseWindow *stack[64];
+	const int count = uiStatic.menu.GetWindows( stack, 64 );
+	for( int i = 0; i < count; i++ )
+	{
+		CMenuBaseWindow *w = stack[i];
+		if( FBitSet( w->iFlags, QMF_HIDDEN | QMF_CLOSING ))
+			continue;
+		for( int k = 0; k < s_frames.Count(); k++ )
+			if( s_frames[k] == w && !s_frames[k]->EscapeCloses( ))
+				s_framesToRestore.AddToTail( s_frames[k] );
+	}
+}
+
+void SteamUI_RestoreOpenWindows()
+{
+	for( int i = 0; i < s_framesToRestore.Count(); i++ )
+	{
+		CSteamFrame *f = s_framesToRestore[i];
+		if( uiStatic.menu.IsVisible( f ))
+			continue;
+		f->VidInit(); // the same place unless the resolution is another one
+		uiStatic.menu.Add( f );
+	}
+	s_framesToRestore.RemoveAll();
+}
