+
+bool CSteamCheckButton::KeyUp( int key )
+{
+	const bool wasFocused = ( iFlags & QMF_HASMOUSEFOCUS ) != 0;
+	const bool handled = BaseClass::KeyUp( key );
+
+	if( handled && !( iFlags & QMF_GRAYED ) && ( UI::Key::IsEnter( key ) || ( UI::Key::IsLeftMouse( key ) && wasFocused )))
+	{
+		checked = !checked;
+		onChanged( this );
+	}
+	return handled;
+}
+
+void CSteamCheckButton::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, h = m_scSize.h;
+	const int bx = x + 3, by = y + ( h - 14 ) / 2 - 1;
+	const bool grayed = ( iFlags & QMF_GRAYED ) != 0;
+
+	Fill( bx, by, 14, 14, ListBG );
+	InsetBorder( bx, by, 14, 14 );
+
+	if( checked )
+		DrawCheck( bx, by, grayed ? DisabledText1 : BrightControlText );
+
+	const char *t = Localize( text );
+	const unsigned int c = grayed ? DisabledText1 : ( checked ? BrightControlText : ControlText );
+	if( wrap )
+		WrappedText( FONT_DEFAULT, x + 27, y + 2, m_scSize.w - 27, h - 2, t, c );
+	else
+		TextInBox( FONT_DEFAULT, x + 27, y, m_scSize.w - 27, h, t, c );
+}
