+
+	void Ok()
+	{
+		CollectRows();
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+			EngFuncs::CvarSetString( var->name, var->value );
+		if( m_pVars )
+			CSCR_SaveToFile( "user.scr", "INFO_OPTIONS", m_pVars );
