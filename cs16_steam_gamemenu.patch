diff --git a/3rdparty/mainui_cpp/menus/SteamOptions.cpp b/3rdparty/mainui_cpp/menus/SteamOptions.cpp
new file mode 100644
index 0000000..edfe423
--- /dev/null
+++ b/3rdparty/mainui_cpp/menus/SteamOptions.cpp
@@ -0,0 +1,1572 @@
+/*
+SteamOptions.cpp - the Options window of the Steam version (GameUI of VGUI2): Multiplayer, Keyboard, Mouse, Audio,
+Video, Voice, Lock
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+// The window is 512 x 406 pixels in the middle of the screen, as in the Steam version. The places of the controls of
+// every page come from its .res file in the game (resource/OptionsSubMultiplayer.res, OptionsSubKeyboard.res,
+// OptionsSubMouse.res, OptionsSubAudio.res, OptionsSubVideo.res, OptionsSubVoice.res, OptionsSubAdvanced.res) and
+// the texts from the translations of GameUI, so the window looks as in the Steam version in any language.
+//
+// The settings are those of Xash3D: they are read when the window opens and written by OK and Apply (Cancel leaves
+// them as they were). The keys are set at once, as in the Steam version.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <math.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "SteamUI.h"
+#include "SteamGameMenu.h"
+#include "steamui_int.h"
+#include "BMPUtils.h"
+#include "KbActListModel.h"
+
+using namespace SteamUI;
+
+namespace {
+
+// the colours of the spraypaint and of the crosshair, as in GameUI
+struct NamedColor { const char *name; const char *rgb; };
+
+const NamedColor g_logoColors[] = {
+	{ "#Valve_Orange", "255 120 24" },
+	{ "#Valve_Yellow", "225 180 24" },
+	{ "#Valve_Blue", "0 60 255" },
+	{ "#Valve_Ltblue", "0 167 255" },
+	{ "#Valve_Green", "0 167 0" },
+	{ "#Valve_Red", "255 43 0" },
+	{ "#Valve_Brown", "123 73 0" },
+	{ "#Valve_Ltgray", "100 100 100" },
+	{ "#Valve_Dkgray", "36 36 36" },
+};
+
+const NamedColor g_crosshairColors[] = {
+	{ "#Valve_Green", "50 250 50" },
+	{ "#Valve_Red", "250 50 50" },
+	{ "#Valve_Blue", "50 50 250" },
+	{ "#Valve_Yellow", "250 250 50" },
+	{ "#Valve_Ltblue", "50 250 250" },
+};
+
+const NamedColor g_crosshairSizes[] = {
+	{ "#GameUI_Auto", "auto" },
+	{ "#GameUI_Small", "small" },
+	{ "#GameUI_Medium", "medium" },
+	{ "#GameUI_Large", "large" },
+};
+
+// a text without the colour codes of the engine ("^1"...)
+void StripColors( const char *in, char *out, size_t size )
+{
+	size_t n = 0;
+	for( const char *p = in; *p && n + 1 < size; p++ )
+	{
+		if( p[0] == '^' && p[1] >= '0' && p[1] <= '9' )
+		{
+			p++;
+			continue;
+		}
+		out[n++] = *p;
+	}
+	out[n] = 0;
+}
+
+void ParseRGB( const char *s, int &r, int &g, int &b )
+{
+	r = g = b = 255;
+	sscanf( s, "%d %d %d", &r, &g, &b );
+}
+
+} // namespace
+
+// The list of the keys (the page Keyboard): the actions of gfx/shell/kb_act.lst in sections, each section with its
+// title and the titles of the columns ("KEY/BUTTON", "ALTERNATE"), as the SectionedListPanel of the Steam version.
+// Measured at 1920x1080: the rows 20 pixels from 25 pixels under the top of the list, the columns from 13, 231
+// and 361 pixels, the chosen row on "SelectionBG" from x 7 to the scroll bar, the scroll bar 18 pixels wide.
+class CSteamKeyList : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	CSteamKeyList() : model( CMenuKbActListModel::VIEW_BINDINGS ) {}
+
+	void Refresh();
+	bool KeyDown( int key ) override;
+	void Draw() override;
+
+	int SelectedEntry() const { return selected >= 0 && selected < rows.Count() ? rows[selected].entry : -1; }
+	const char *SelectedBind() const;
+	bool grabbing = false;
+	CEventCallback onActivate;
+
+	CMenuKbActListModel model;
+
+private:
+	struct Row { int entry; bool header; };
+	CUtlVector<Row> rows;
+	int selected = -1;
+	int top = 0;
+	int m_iLastClickTime = 0;
+	int m_iLastClickRow = -1;
+	SteamUI::ScrollBar m_sb;
+	void PlaceScrollBar();
+
+	int RowHeight() const { return 20; }
+	int VisibleRows() const { return ( m_scSize.h - 4 ) / RowHeight(); }
+	void ClampTop();
+};
+
+void CSteamKeyList::Refresh()
+{
+	model.Update();
+	rows.RemoveAll();
+
+	for( int i = 0; i < model.entries.Count(); i++ )
+	{
+		const CMenuKbActListModel::entry_t &e = model.entries[i];
+		char text[96];
+		StripColors( e.display, text, sizeof( text ));
+
+		if( !e.bind[0] )
+		{
+			// "==========": the frame of a title in the file, not shown
+			if( text[0] == '=' || !text[0] )
+				continue;
+		}
+
+		Row r;
+		r.entry = i;
+		r.header = !e.bind[0];
+		rows.AddToTail( r );
+	}
+
+	if( selected < 0 || selected >= rows.Count() || rows[selected].header )
+	{
+		selected = -1;
+		for( int i = 0; i < rows.Count(); i++ )
+			if( !rows[i].header ) { selected = i; break; }
+	}
+	ClampTop();
+}
+
+const char *CSteamKeyList::SelectedBind() const
+{
+	const int e = SelectedEntry();
+	return e >= 0 ? model.entries[e].bind : "";
+}
+
+void CSteamKeyList::PlaceScrollBar()
+{
+	m_sb.x = m_scPos.x + m_scSize.w - 19;
+	m_sb.y = m_scPos.y + 1;
+	m_sb.w = 18;
+	m_sb.h = m_scSize.h - 2;
+	m_sb.total = rows.Count();
+	m_sb.visible = VisibleRows();
+	m_sb.top = top;
+}
+
+void CSteamKeyList::ClampTop()
+{
+	const int maxTop = rows.Count() - VisibleRows();
+	if( top > maxTop ) top = maxTop;
+	if( top < 0 ) top = 0;
+}
+
+bool CSteamKeyList::KeyDown( int key )
+{
+	if( grabbing )
+		return false;
+
+	if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+	{
+		top += key == K_MWHEELUP ? -3 : 3;
+		ClampTop();
+		return true;
+	}
+
+	if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+	{
+		const int dir = UI::Key::IsUpArrow( key ) ? -1 : 1;
+		for( int i = selected + dir; i >= 0 && i < rows.Count(); i += dir )
+		{
+			if( rows[i].header )
+				continue;
+			selected = i;
+			if( selected < top ) top = selected - 1;
+			if( selected >= top + VisibleRows( )) top = selected - VisibleRows() + 1;
+			ClampTop();
+			break;
+		}
+		return true;
+	}
+
+	if( UI::Key::IsEnter( key ))
+	{
+		if( onActivate )
+			onActivate( this );
+		return true;
+	}
+
+	if( UI::Key::IsLeftMouse( key ) && Hovered( ))
+	{
+		// the scroll bar: its buttons, its slider (held by the mouse), a page up / down
+		PlaceScrollBar();
+		if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+		{
+			top = m_sb.top;
+			return true;
+		}
+
+		const int r = top + ( uiStatic.cursorY - m_scPos.y - 2 ) / RowHeight();
+		if( r >= 0 && r < rows.Count() && !rows[r].header )
+		{
+			const bool dbl = r == m_iLastClickRow && uiStatic.realTime - m_iLastClickTime < 400;
+			selected = r;
+			m_iLastClickRow = r;
+			m_iLastClickTime = uiStatic.realTime;
+			if( dbl && onActivate )
+				onActivate( this );
+		}
+		return true;
+	}
+
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamKeyList::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	const int rowH = RowHeight();
+	const int sbX = x + w - 19;
+
+	// the slider held by the mouse moves the rows
+	PlaceScrollBar();
+	m_sb.Clamp(); // a window made bigger shows more rows: the first one may have to go up
+	m_sb.Think();
+	top = m_sb.top;
+
+	Fill( x, y, w, h, ListBG );
+	InsetBorder( x, y, w, h );
+
+	const int col0 = x + 13, col1 = x + 231, col2 = x + 361;
+	const int visible = VisibleRows();
+
+	for( int i = 0; i < visible && top + i < rows.Count(); i++ )
+	{
+		const Row &row = rows[top + i];
+		const CMenuKbActListModel::entry_t &e = model.entries[row.entry];
+		const int ry = y + 2 + i * rowH;
+		char text[96];
+		StripColors( e.display, text, sizeof( text ));
+
+		if( row.header )
+		{
+			// the title of the section and of the columns: "DefaultSmall", "BrightControlText", on the bottom of the row
+			const int ty = ry + rowH - FontTall( FONT_DEFAULT_SMALL ) - 1;
+			Text( FONT_DEFAULT_SMALL, x + 7, ty, text, BrightControlText, col1 - x - 12 );
+			Text( FONT_DEFAULT_SMALL, col1 - 2, ty, L( "GameUI_KeyButton" ), BrightControlText, col2 - col1 );
+			Text( FONT_DEFAULT_SMALL, col2 - 2, ty, L( "GameUI_Alternate" ), BrightControlText, sbX - col2 );
+			continue;
+		}
+
+		const bool sel = top + i == selected;
+		if( sel )
+			Fill( x + 7, ry, sbX - x - 10, rowH, SelectionBG );
+
+		const unsigned int c = sel ? BrightBaseText : ControlText;
+		TextInBox( FONT_DEFAULT, col0, ry, col1 - col0 - 4, rowH, text, c );
+
+		if( sel && grabbing )
+			continue; // waiting for the key
+
+		TextInBox( FONT_DEFAULT, col1, ry, col2 - col1 - 4, rowH, e.first, c );
+		TextInBox( FONT_DEFAULT, col2, ry, sbX - col2 - 4, rowH, e.second, c );
+	}
+
+	// the scroll bar
+	PlaceScrollBar();
+	m_sb.Draw();
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// The pictures of a page: the spraypaint, the crosshair, the microphone meter
+class CSteamPreview : public CSteamControl
+{
+public:
+	enum EKind { LOGO, CROSSHAIR, MIC_METER, MODEL } kind = LOGO;
+
+	void Draw() override;
+
+	HIMAGE image = 0;     // the logo, or the background of the crosshair, or the dark meter
+	HIMAGE live = 0, indicator = 0; // the meter: its lit part up to the level of the microphone, the mark at the level
+	bool testing = false; // the meter: the microphone is tested (the engine gives its level)
+	int r = 255, g = 255, b = 255;
+	const char *crosshairSize = "auto";
+	bool translucent = false;
+};
+
+void CSteamPreview::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+
+	if( kind == MIC_METER )
+	{
+		if( image )
+		{
+			EngFuncs::PIC_Set( image, 255, 255, 255, 255 );
+			EngFuncs::PIC_DrawTrans( x, y, w, h );
+		}
+
+		// while the microphone is tested, as GameUI: the lit meter up to the level, the mark at it
+		float level = testing && g_pSteamUIEngine && g_pSteamUIEngine->pfnVoiceLevel ? g_pSteamUIEngine->pfnVoiceLevel() : 0.0f;
+		if( level > 1.0f ) level = 1.0f;
+		if( level > 0.0f && live )
+		{
+			const Size is = EngFuncs::PIC_Size( live );
+			wrect_t rc;
+			rc.left = 0; rc.top = 0; rc.bottom = is.h;
+			rc.right = (int)( is.w * level + 0.5f );
+			EngFuncs::PIC_Set( live, 255, 255, 255, 255 );
+			EngFuncs::PIC_DrawTrans( x, y, (int)( w * level + 0.5f ), h, &rc );
+		}
+		else if( level > 0.0f )
+			Fill( x, y + h / 4, (int)( w * level + 0.5f ), h / 2, BrightControlText );
+		if( testing && indicator )
+		{
+			const Size is = EngFuncs::PIC_Size( indicator );
+			EngFuncs::PIC_Set( indicator, 255, 255, 255, 255 );
+			EngFuncs::PIC_DrawTrans( x + (int)( w * level ) - is.w / 2, y + ( h - is.h ) / 2, is.w, is.h );
+		}
+		return;
+	}
+
+	Fill( x, y, w, h, ( kind == LOGO || kind == MODEL ) ? PackRGBA( 0, 0, 0, 255 ) : WindowBG );
+
+	if( image )
+	{
+		if( kind == LOGO )
+			EngFuncs::PIC_Set( image, r, g, b, 255 );
+		else
+			EngFuncs::PIC_Set( image, 255, 255, 255, 255 );
+		EngFuncs::PIC_DrawTrans( x, y, w, h );
+	}
+
+	if( kind == CROSSHAIR )
+	{
+		// the crosshair of the client in the middle: 4 lines, a gap in the middle
+		int len = 5, gap = 4;
+		if( !stricmp( crosshairSize, "medium" )) { len = 7; gap = 5; }
+		else if( !stricmp( crosshairSize, "large" )) { len = 9; gap = 6; }
+		const unsigned int c = PackRGBA( r, g, b, translucent ? 160 : 255 );
+		const int cx = x + w / 2, cy = y + h / 2;
+		Fill( cx - gap - len, cy, len, 1, c );
+		Fill( cx + gap + 1, cy, len, 1, c );
+		Fill( cx, cy - gap - len, 1, len, c );
+		Fill( cx, cy + gap + 1, 1, len, c );
+		InsetBorder( x, y, w, h );
+	}
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// The content lock, as in GameUI of the Steam version: the password is kept as a hash (ui_steam_contentlock, empty
+// when there is no lock); the lock turns off the blood and the gibs (violence_hblood, _ablood, _hgibs, _agibs)
+static void ContentLockHash( const char *password, char *out, size_t len )
+{
+	unsigned long long h = 14695981039346656037ull; // FNV-1a 64 of the password with a salt
+	const char *salt = "xash3d-steam-contentlock:";
+	for( const char *p = salt; *p; p++ ) { h ^= (unsigned char)*p; h *= 1099511628211ull; }
+	for( const char *p = password; *p; p++ ) { h ^= (unsigned char)*p; h *= 1099511628211ull; }
+	snprintf( out, len, "%016llx", h );
+}
+
+static bool ContentLocked()
+{
+	const char *v = EngFuncs::GetCvarString( "ui_steam_contentlock" );
+	return v && v[0];
+}
+
+static void SetViolence( bool on )
+{
+	const float v = on ? 1.0f : 0.0f;
+	EngFuncs::CvarSetValue( "violence_hblood", v );
+	EngFuncs::CvarSetValue( "violence_ablood", v );
+	EngFuncs::CvarSetValue( "violence_hgibs", v );
+	EngFuncs::CvarSetValue( "violence_agibs", v );
+}
+
+// The window Content Lock (ContentControlDialog of GameUI): 328 x 248 (measured at 1920x1080). Without a lock: the
+// password twice, with it: the password once; a wrong one is said under the fields and the window stays open
+class CSteamContentLockDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamContentLockDialog() : BaseClass( "CSteamContentLockDialog", 328, 248 )
+	{
+		m_bEscapeCloses = true; // a question: Escape is Cancel
+	}
+
+	void Show() override
+	{
+		// the texts and places first: Show places the controls on the screen
+		const bool locked = ContentLocked();
+		Q_strncpy( m_explain.text, locked ? "#GameUI_ContentStatusEnabled" : "#GameUI_ContentStatusDisabled", sizeof( m_explain.text ));
+		m_explain.SetBounds( 29, locked ? 41 : 34, 260, 30 );
+		Q_strncpy( m_label1.text, locked ? "#GameUI_PasswordDisablePrompt" : "#GameUI_PasswordPrompt", sizeof( m_label1.text ));
+		m_status.text[0] = 0;
+		m_entry1.SetBuffer( "" );
+		m_entry2.SetBuffer( "" );
+		m_label2.SetVisibility( !locked );
+		m_entry2.SetVisibility( !locked );
+		BaseClass::Show();
+		SetCursorToItem( m_entry1 );
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ))
+		{
+			Ok();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+private:
+	void _Init() override
+	{
+		SetTitle( "#GameUI_ContentLock" );
+		m_explain.wrap = true;
+		m_explain.iFlags |= QMF_INACTIVE;
+		m_label1.SetBounds( 31, 69, 260, 24 );
+		m_label1.iFlags |= QMF_INACTIVE;
+		m_entry1.SetBounds( 31, 97, 167, 24 );
+		m_entry1.iMaxLength = 63;
+		m_entry1.bHideInput = true;
+		m_label2.SetBounds( 31, 125, 260, 24 );
+		Q_strncpy( m_label2.text, "#GameUI_PasswordReentryPrompt", sizeof( m_label2.text ));
+		m_label2.iFlags |= QMF_INACTIVE;
+		m_entry2.SetBounds( 31, 153, 167, 24 );
+		m_entry2.iMaxLength = 63;
+		m_entry2.bHideInput = true;
+		m_status.SetBounds( 31, 181, 280, 24 );
+		m_status.iFlags |= QMF_INACTIVE;
+		m_ok.SetBounds( 166, 215, 72, 24 );
+		m_cancel.SetBounds( 248, 215, 72, 24 );
+		Q_strncpy( m_ok.text, "#GameUI_OK", sizeof( m_ok.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_ok.isDefault = true;
+		m_ok.onReleased = VoidCb( &CSteamContentLockDialog::Ok );
+		m_cancel.onReleased = VoidCb( &CSteamContentLockDialog::Hide );
+		AddItem( m_explain );
+		AddItem( m_label1 );
+		AddItem( m_entry1 );
+		AddItem( m_label2 );
+		AddItem( m_entry2 );
+		AddItem( m_status );
+		AddItem( m_ok );
+		AddItem( m_cancel );
+	}
+
+	void Ok()
+	{
+		const char *pw = m_entry1.GetBuffer();
+		char hash[32];
+
+		if( ContentLocked( ))
+		{
+			// the lock is taken off by its password
+			ContentLockHash( pw, hash, sizeof( hash ));
+			if( strcmp( hash, EngFuncs::GetCvarString( "ui_steam_contentlock" )))
+			{
+				Q_strncpy( m_status.text, "#GameUI_IncorrectPassword", sizeof( m_status.text ));
+				m_entry1.SetBuffer( "" );
+				SetCursorToItem( m_entry1 );
+				return;
+			}
+			EngFuncs::CvarSetString( "ui_steam_contentlock", "" );
+			SetViolence( true );
+		}
+		else
+		{
+			if( !pw[0] )
+			{
+				Q_strncpy( m_status.text, "#GameUI_MustEnterPassword", sizeof( m_status.text ));
+				SetCursorToItem( m_entry1 );
+				return;
+			}
+			if( strcmp( pw, m_entry2.GetBuffer( )))
+			{
+				Q_strncpy( m_status.text, "#GameUI_PasswordsDontMatch", sizeof( m_status.text ));
+				m_entry2.SetBuffer( "" );
+				SetCursorToItem( m_entry2 );
+				return;
+			}
+			ContentLockHash( pw, hash, sizeof( hash ));
+			EngFuncs::CvarSetString( "ui_steam_contentlock", hash );
+			SetViolence( false );
+		}
+		Hide();
+	}
+
+	CSteamLabel m_explain, m_label1, m_label2, m_status;
+	CSteamTextEntry m_entry1, m_entry2;
+	CSteamButton m_ok, m_cancel;
+};
