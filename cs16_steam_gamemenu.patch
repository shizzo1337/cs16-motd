+void CMenuMain::VidInitSteamMenu( bool connected )
+{
+	steamConnected = connected;
+	steamSingle = gpGlobals->maxClients < 2;
+
+	// GameUI: "OnlyInGame" only while connected; in a game "notsingle" are hidden in a game of one player and "notmulti"
+	// in a game of many; "notsteam" only where a game may be changed (host_allow_changegame)
+	const bool single = gpGlobals->maxClients < 2;
+	bool shown[MAX_STEAM_ITEMS];
+	int count = 0;
+
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		const SteamGameMenu::Entry &e = steamEntries[i];
+		bool show = steamSupported[i];
+
+		if( e.onlyInGame && !connected )
+			show = false;
+		if( connected && e.notSingle && single )
+			show = false;
+		if( connected && e.notMulti && !single )
+			show = false;
+		if( e.notSteam && !bCustomGame )
+			show = false;
+		// the Player List needs the players from the client: ours gives them, others don't
+		if( !stricmp( e.command, "OpenPlayerListDialog" ) && !UI_SteamPlayerList_Available( ))
+			show = false;
+		shown[i] = show;
+	}
+
+	// no empty line at the top, at the bottom or after another one (a hidden item between them)
+	bool lastWasSpacer = true;
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		if( !shown[i] )
+			continue;
+		if( steamItems[i].spacer && lastWasSpacer )
+			shown[i] = false;
+		else
+			lastWasSpacer = steamItems[i].spacer;
+	}
+	for( int i = numSteamItems - 1; i >= 0; i-- )
+	{
+		if( !shown[i] )
+			continue;
+		if( !steamItems[i].spacer )
+			break;
+		shown[i] = false;
+	}
+
+	for( int i = 0; i < numSteamItems; i++ )
+		if( shown[i] )
+			count++;
+
+	// the width of the menu: its widest item (all the items react on the whole width, as the buttons of GameUI)
+	int menuWide = 0;
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		if( shown[i] && !steamItems[i].spacer )
+		{
+			const int w = g_FontMgr->GetTextWideScaled( steamFont, steamItems[i].label, g_FontMgr->GetFontTall( steamFont ));
+			if( w > menuWide )
+				menuWide = w;
+		}
+	}
+	menuWide += 4;
+
+	// from the bottom: the capitals of the last item 82 pixels above the bottom of the screen, 28 pixels a line
+	int line = 0;
+	for( int i = 0; i < numSteamItems; i++ )
+	{
+		CSteamGameMenuItem &item = steamItems[i];
+
+		if( !shown[i] )
+		{
+			item.Hide();
+			continue;
+		}
+
+		item.Show();
+		item.capTop = gpGlobals->scrHeight - SteamGameMenu::LAST_CAP_FROM_BOTTOM - ( count - 1 - line ) * SteamGameMenu::ITEM_HEIGHT;
+		item.pixelPos = Point( SteamGameMenu::INSET, item.capTop - ( SteamGameMenu::ITEM_HEIGHT - item.capHeight ) / 2 );
+		item.pixelSize = Size( menuWide, SteamGameMenu::ITEM_HEIGHT );
+		line++;
+	}
+}
