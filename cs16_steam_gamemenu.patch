+const unsigned int ControlDarkBG     = PackRGBA( 90, 106, 80, 255 );
+const unsigned int WindowBG          = PackRGBA( 62, 70, 55, 255 );
+const unsigned int SelectionBG       = PackRGBA( 149, 136, 49, 255 );
+const unsigned int ListBG            = PackRGBA( 62, 70, 55, 255 );
+const unsigned int TitleText         = PackRGBA( 255, 255, 255, 255 );
+const unsigned int BorderBright      = PackRGBA( 136, 145, 128, 255 );
+const unsigned int BorderDark        = PackRGBA( 40, 46, 34, 255 );
+const unsigned int BorderSelection   = PackRGBA( 0, 0, 0, 255 );
+const unsigned int SliderTickColor   = PackRGBA( 127, 140, 127, 255 );
+const unsigned int SliderTrackColor  = PackRGBA( 31, 31, 31, 255 );
+
+static HFont s_fonts[FONT_COUNT];
+static int s_fontTall[FONT_COUNT];
+
+HFont Font( EFont font )
+{
+	if( font < 0 || font >= FONT_COUNT )
+		font = FONT_DEFAULT;
+
+	if( s_fonts[font] > 0 )
+		return s_fonts[font];
+
+	// "tall" of the scheme is the cell of the letters; Tahoma's cell is 1.207 of their height
+	static const int talls[FONT_COUNT] = { 16, 13, 12 };
+	const int tall = talls[font];
+	const int em = (int)( tall / 1.207f + 0.5f );
+
+	HFont f = CClientWindow::CreateSteamFont( "Tahoma", em, 1.207f, 0, false );
+	if( f <= 0 )
+		f = uiStatic.hSmallerFont;
+
+	s_fonts[font] = f;
+	s_fontTall[font] = g_FontMgr->GetFontTall( f );
+	return f;
+}
+
+int FontTall( EFont font )
+{
+	Font( font );
+	return s_fontTall[font] > 0 ? s_fontTall[font] : 16;
+}
+
+int TextWidth( EFont font, const char *text )
+{
+	if( !text || !text[0] )
+		return 0;
+	const HFont f = Font( font );
+	return g_FontMgr->GetTextWideScaled( f, text, g_FontMgr->GetFontTall( f ));
+}
+
+// the engine's scissor clips pictures and text, not FillRGBA: the fills are clipped here
+static bool s_bClip = false;
+static int s_clip[4];
+
+void SetFillClip( int x, int y, int w, int h )
+{
+	s_bClip = true;
+	s_clip[0] = x; s_clip[1] = y; s_clip[2] = x + w; s_clip[3] = y + h;
+}
+
+void ClearFillClip()
+{
+	s_bClip = false;
+}
+
+void Fill( int x, int y, int w, int h, unsigned int color )
+{
+	if( s_bClip )
+	{
+		int r = x + w, b = y + h;
+		if( x < s_clip[0] ) x = s_clip[0];
+		if( y < s_clip[1] ) y = s_clip[1];
+		if( r > s_clip[2] ) r = s_clip[2];
+		if( b > s_clip[3] ) b = s_clip[3];
+		w = r - x;
+		h = b - y;
+	}
+	if( w > 0 && h > 0 )
+		UI_FillRect( x, y, w, h, color );
+}
+
+void RaisedBorder( int x, int y, int w, int h )
+{
+	Fill( x, y, w - 1, 1, BorderBright );
+	Fill( x, y, 1, h - 1, BorderBright );
+	Fill( x, y + h - 1, w, 1, BorderDark );
+	Fill( x + w - 1, y, 1, h, BorderDark );
+}
+
+void InsetBorder( int x, int y, int w, int h )
+{
+	Fill( x, y, w - 1, 1, BorderDark );
+	Fill( x, y, 1, h - 1, BorderDark );
+	Fill( x, y + h - 1, w, 1, BorderBright );
+	Fill( x + w - 1, y, 1, h, BorderBright );
+}
+
+void Text( EFont font, int x, int y, const char *text, unsigned int color, int maxWidth )
+{
+	if( !text || !text[0] || maxWidth <= 0 )
+		return;
+
+	const HFont f = Font( font );
+	const int tall = FontTall( font );
+	UI_DrawString( f, x, y, maxWidth, tall, text, color, tall, QM_LEFT | QM_TOP, ETF_NO_WRAP | ETF_FORCECOL );
+}
+
+void TextInBox( EFont font, int x, int y, int w, int h, const char *text, unsigned int color, bool east )
+{
+	const int tall = FontTall( font );
+	const int ty = y + ( h - tall ) / 2;
+	if( east )
+		Text( font, x + w - TextWidth( font, text ), ty, text, color, w );
+	else
+		Text( font, x, ty, text, color, w );
+}
+
+int WrappedText( EFont font, int x, int y, int w, int h, const char *text, unsigned int color )
+{
+	if( !text || !text[0] )
+		return 0;
+
+	const int tall = FontTall( font );
+	char line[512];
+	int lines = 0;
+	const char *p = text;
+
+	while( *p && ( lines + 1 ) * tall <= h + tall / 2 )
+	{
+		// the longest piece up to a space (or a line end) that fits
+		int len = 0, fit = 0;
+		while( p[len] && p[len] != '\n' )
+		{
+			int end = len;
+			while( p[end] && p[end] != ' ' && p[end] != '\n' )
+				end++;
+
+			const int n = end < (int)sizeof( line ) - 1 ? end : (int)sizeof( line ) - 1;
+			memcpy( line, p, n );
+			line[n] = 0;
+
+			if( fit > 0 && TextWidth( font, line ) > w )
+				break;
+
+			fit = end;
+			len = end;
+			if( p[len] == ' ' )
+				len++;
+		}
+
+		if( fit <= 0 )
+			fit = len > 0 ? len : 1;
+
+		const int n = fit < (int)sizeof( line ) - 1 ? fit : (int)sizeof( line ) - 1;
+		memcpy( line, p, n );
+		line[n] = 0;
+		Text( font, x, y + lines * tall, line, color, w );
+		lines++;
+
+		p += fit;
+		while( *p == ' ' || *p == '\n' )
+			p++;
+	}
+
+	return lines;
+}
+
+void DrawCheck( int x, int y, unsigned int color )
+{
+	// the mark of Marlett ("a") as VGUI2 draws it at the size of the box: a short stroke down, a long one up
+	static const int rows[][2] = {
+		{ 10, 2 }, { 9, 3 }, { 8, 4 }, { 7, 5 }, { 6, 6 }, // the long stroke (x, y of its lower pixel)
+	};
+	for( int i = 0; i < 3; i++ )
+		Fill( x + 3 + i, y + 6 + i, 1, 3, color ); // the short stroke
+	for( unsigned i = 0; i < sizeof( rows ) / sizeof( rows[0] ); i++ )
+		Fill( x + rows[i][0], y + rows[i][1] + 1, 1, 3, color );
+}
+
+void DrawArrow( int x, int y, bool down, unsigned int color )
+{
+	for( int i = 0; i < 4; i++ )
+	{
+		const int row = down ? i : 3 - i;
+		Fill( x + i, y + row, 7 - i * 2, 1, color );
+	}
+}
+
+void ScrollBar::Clamp()
+{
+	const int maxTop = total - visible;
+	if( top > maxTop ) top = maxTop;
+	if( top < 0 ) top = 0;
+}
+
+void ScrollBar::NobRect( int &ny, int &nh ) const
+{
+	const int trackY = y + w, trackH = h - w * 2;
+	nh = total > 0 ? trackH * visible / total : trackH;
+	if( nh < 8 ) nh = 8;
+	if( nh > trackH ) nh = trackH;
+	const int maxTop = total - visible;
+	int t = top < maxTop ? top : maxTop; // the thumb never leaves the track
+	if( t < 0 ) t = 0;
+	ny = trackY + ( maxTop > 0 ? ( trackH - nh ) * t / maxTop : 0 );
+}
+
+void ScrollBar::Draw()
+{
+	const int b = w; // the buttons are square
+	Fill( x, y, w, h, ControlDarkBG );
+	Fill( x, y, w, b, ControlBG );
+	RaisedBorder( x, y, w, b );
+	DrawArrow( x + ( w - 7 ) / 2, y + b / 2 - 2, false, DimBaseText );
+	Fill( x, y + h - b, w, b, ControlBG );
+	RaisedBorder( x, y + h - b, w, b );
+	DrawArrow( x + ( w - 7 ) / 2, y + h - b / 2 - 2, true, DimBaseText );
+
+	if( total > visible && h > b * 2 + 8 )
+	{
+		int ny, nh;
+		NobRect( ny, nh );
+		Fill( x, ny, w, nh, ControlBG );
+		RaisedBorder( x, ny, w, nh );
+	}
+}
+
+bool ScrollBar::Press( int cx, int cy )
+{
+	if( !Inside( cx, cy ))
+		return false;
+
+	const int b = w;
+	if( cy < y + b )
+		top -= step;
+	else if( cy >= y + h - b )
+		top += step;
+	else if( total > visible )
+	{
+		int ny, nh;
+		NobRect( ny, nh );
+		if( cy >= ny && cy < ny + nh )
+		{
+			m_bDragging = true;
+			m_iGrab = cy - ny;
+		}
+		else
+			top += cy < ny ? -visible : visible;
+	}
+	Clamp();
+	return true;
+}
+
+void ScrollBar::Think()
+{
+	if( !m_bDragging )
+		return;
+
+	if( !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+	{
+		m_bDragging = false;
+		return;
+	}
+
+	int ny, nh;
+	NobRect( ny, nh );
+	const int trackY = y + w, trackH = h - w * 2;
+	const int maxTop = total - visible;
+	if( maxTop <= 0 || trackH - nh <= 0 )
+		return;
+
+	const int pos = uiStatic.cursorY - m_iGrab - trackY;
+	top = ( pos * maxTop + ( trackH - nh ) / 2 ) / ( trackH - nh );
+	Clamp();
+}
+
+const char *Localize( const char *text )
+{
+	if( !text )
+		return "";
+	if( text[0] != '#' )
+		return text;
+
+	const char *t = L( text );
+	if( t != text + 1 )
+		return t;
+
+	// not found: the .res files of the game have keys in another case ("#GameUI_LOW" is "GameUI_Low" in the
+	// translations): the word after the last "_" with only its first letter big
+	char key[128];
+	Q_strncpy( key, text + 1, sizeof( key ));
+	char *word = strrchr( key, '_' );
+	if( !word || !word[1] )
+		return t;
+	for( char *c = word + 2; *c; c++ )
+		if( *c >= 'A' && *c <= 'Z' )
+			*c += 'a' - 'A';
+
+	const char *t2 = L( key );
+	return t2 != key ? t2 : t;
+}
+
+ResNode::~ResNode()
+{
+	for( int i = 0; i < children.Count(); i++ )
+		delete children[i];
+	children.RemoveAll();
+}
+
+const ResNode *ResNode::Find( const char *key ) const
+{
+	for( int i = 0; i < children.Count(); i++ )
+		if( !stricmp( children[i]->name, key ))
+			return children[i];
+	return nullptr;
+}
+
+const char *ResNode::GetString( const char *key, const char *def ) const
+{
+	const ResNode *n = Find( key );
+	return n ? n->value : def;
+}
+
+int ResNode::GetInt( const char *key, int def ) const
+{
+	const ResNode *n = Find( key );
+	return n && n->value[0] ? atoi( n->value ) : def;
+}
+
+static char *ParseBlock( char *pfile, ResNode *parent, int depth )
+{
+	char token[1024];
+
+	while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))))
+	{
+		if( !strcmp( token, "}" ))
+			return pfile;
+
+		ResNode *node = new ResNode;
+		Q_strncpy( node->name, token, sizeof( node->name ));
+		parent->children.AddToTail( node );
+
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+		if( !pfile )
+			return nullptr;
+
+		if( !strcmp( token, "{" ))
+		{
+			if( depth > 16 )
+				return nullptr;
+			pfile = ParseBlock( pfile, node, depth + 1 );
+			if( !pfile )
+				return nullptr;
+		}
+		else
+		{
+			Q_strncpy( node->value, token, sizeof( node->value ));
+		}
+	}
+
+	return pfile;
+}
+
+ResNode *LoadRes( const char *path )
+{
+	char *afile = (char *)EngFuncs::COM_LoadFile( path );
+	if( !afile )
+		return nullptr;
+
+	ResNode *root = new ResNode;
+	char token[1024];
+	char *pfile = EngFuncs::COM_ParseFile( afile, token, sizeof( token )); // the name of the file
+
+	if( pfile )
+	{
+		Q_strncpy( root->name, token, sizeof( root->name ));
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+		if( pfile && !strcmp( token, "{" ))
+			ParseBlock( pfile, root, 0 );
+	}
+
+	EngFuncs::COM_FreeFile( afile );
+	return root;
+}
