+void CSteamServerBrowser::AddServerEntered()
+{
+	const char *text = m_addDialog.Address();
+	netadr_t adr;
+	if( !text[0] || !EngFuncs::textfuncs.pNetAPI->StringToAdr( (char *)text, &adr ))
+	{
+		UI_ShowMessageBox( SB( "ServerBrowser_AddServerError", "The server IP address you entered is invalid." ));
+		return;
+	}
+	AddToFavorites( EngFuncs::NET_AdrToString( adr ), m_addDialog.Protocol());
+}
+
+void CSteamServerBrowser::AddCurrentServer()
+{
+	const char *server = EngFuncs::GetCvarString( "cl_serveraddress" ); // not every engine has it
+	if( !server[0] )
+		return;
+	netadr_t adr;
+	if( !EngFuncs::textfuncs.pNetAPI->StringToAdr( (char *)server, &adr ))
+		return;
+
+	const char *sadr = EngFuncs::NET_AdrToString( adr );
+	if( FindInList( m_favorites, sadr ) >= 0 )
+		return;
+
+	ListEntry e;
+	Q_strncpy( e.adr, sadr, sizeof( e.adr ));
+	Q_strncpy( e.prot, "gs", sizeof( e.prot ));
+	m_favorites.AddToTail( e );
+	WriteList( "favorite_servers.lst", m_favorites );
+	Refresh( false );
+}
+
+void CSteamServerBrowser::ToggleFavorite( const SteamServer &s )
+{
+	const char *sadr = EngFuncs::NET_AdrToString( s.adr );
+	const int i = FindInList( m_favorites, sadr );
+	if( i >= 0 )
+	{
+		m_favorites.Remove( i );
+		for( int k = 0; k < m_servers[TAB_FAVORITES].Count(); k++ )
+			if( !EngFuncs::NET_CompareAdr( &m_servers[TAB_FAVORITES][k].adr, &s.adr ))
+			{
+				m_servers[TAB_FAVORITES].Remove( k );
+				break;
+			}
+		if( ActivePage() == TAB_FAVORITES )
+			m_list.SetServers( &m_servers[TAB_FAVORITES] );
+	}
+	else
+	{
+		ListEntry e;
+		Q_strncpy( e.adr, sadr, sizeof( e.adr ));
+		Q_strncpy( e.prot, s.Protocol(), sizeof( e.prot ));
+		m_favorites.AddToTail( e );
+		m_servers[TAB_FAVORITES].AddToTail( s );
+	}
+	WriteList( "favorite_servers.lst", m_favorites );
+}
