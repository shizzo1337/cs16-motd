+{
+	BaseClass::Draw();
+	if( m_bMenu )
+		DrawMenu();
+}
+
+void UI_SteamServerBrowser_Menu( void )
+{
+	if( !s_browser )
+	{
+		EngFuncs::CvarRegister( "ui_steam_serverbrowser_size", "", FCVAR_ARCHIVE );
+		EngFuncs::CvarRegister( "ui_steam_serverbrowser_columns", "", FCVAR_ARCHIVE );
+		s_browser = new CSteamServerBrowser;
+	}
+	s_browser->Show();
+
+	// a game on a server needs a name: asked first if the player has none yet (SteamCreateServer.cpp)
+	SteamUI_AskPlayerName( s_browser );
+}
+
+bool SteamServerBrowser_IsOpen( void )
+{
+	return s_browser && uiStatic.menu.IsVisible( s_browser );
+}
+
+// the answers of the servers, from UI_AddServerToList of mainui
