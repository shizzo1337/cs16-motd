+// the server of an answer of the engine (UI_AddServerToList)
+static void ServerFromInfo( SteamServer &s, netadr_t adr, const char *info )
+{
+	s.adr = adr;
+	Q_strncpy( s.name, Info_ValueForKey( info, "host" ), sizeof( s.name ));
+	Q_strncpy( s.map, Info_ValueForKey( info, "map" ), sizeof( s.map ));
+	// the description of the game the server gives ("Counter-Strike"), from the engine of cs16-client; another engine
+	// doesn't pass it: the title of the game
+	const char *desc = Info_ValueForKey( info, "desc" );
+	Q_strncpy( s.game, desc[0] ? desc : gMenu.m_gameinfo.title, sizeof( s.game ));
+	const char *secure = Info_ValueForKey( info, "secure" );
+	s.secureKnown = secure[0] != 0;
+	s.secure = !strcmp( secure, "1" );
+	s.numcl = atoi( Info_ValueForKey( info, "numcl" ));
+	s.maxcl = atoi( Info_ValueForKey( info, "maxcl" ));
+	s.password = !strcmp( Info_ValueForKey( info, "password" ), "1" );
+	s.goldsrc = !strcmp( Info_ValueForKey( info, "gs" ), "1" );
+	s.pending = false;
+}
