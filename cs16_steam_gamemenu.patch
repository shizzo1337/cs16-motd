+void CSteamServerBrowser::_VidInit()
+{
+	BaseClass::_VidInit();
+
+	// the size the window had the last time
+	int w = 0, h = 0;
+	if( m_bPlacedNow && sscanf( EngFuncs::GetCvarString( "ui_steam_serverbrowser_size" ), "%d %d", &w, &h ) == 2 && w >= 641 && h >= 384 )
+	{
+		if( w > gpGlobals->scrWidth ) w = gpGlobals->scrWidth;
+		if( h > gpGlobals->scrHeight ) h = gpGlobals->scrHeight;
+		m_iWide = w;
+		m_iTall = h;
