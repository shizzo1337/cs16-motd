+bool CMenuMain::SetSteamCommand( CSteamGameMenuItem &item, const SteamGameMenu::Entry &e )
+{
+	const char *cmd = e.command;
+
+	// the commands of GameUI of the Steam version, done by the menus of mainui
+	if( !stricmp( cmd, "ResumeGame" ))
+		item.onReleased = UI_CloseMenu;
+	else if( !stricmp( cmd, "Disconnect" ))
+		item.onReleased = VoidCb( &CMenuMain::DisconnectCb ); // at once, as in the Steam version
+	else if( !stricmp( cmd, "Quit" ))
+		item.onReleased = VoidCb( &CMenuMain::QuitDialogCb );
+	else if( !stricmp( cmd, "OpenOptionsDialog" ))
+		item.onReleased = UI_SteamOptions_Menu; // the Options window of the Steam version (SteamOptions.cpp)
+	else if( !stricmp( cmd, "OpenServerBrowser" ))
+		item.onReleased = UI_SteamServerBrowser_Menu; // the Servers window of the Steam version (SteamServerBrowser.cpp)
+	else if( !stricmp( cmd, "OpenCreateMultiplayerGameDialog" ))
+		item.onReleased = UI_SteamCreateServer_Menu; // the Create Server window of the Steam version (SteamCreateServer.cpp)
+	else if( !stricmp( cmd, "OpenNewGameDialog" ))
+		item.onReleased = UI_SteamNewGame_Menu; // the New Game window of the Steam version (SteamSinglePlayer.cpp)
+	else if( !stricmp( cmd, "OpenLoadGameDialog" ))
+		item.onReleased = UI_SteamLoadGame_Menu; // the Load Game window of the Steam version (SteamSinglePlayer.cpp)
+	else if( !stricmp( cmd, "OpenSaveGameDialog" ))
+		item.onReleased = UI_SteamSaveGame_Menu; // the Save Game window of the Steam version (SteamSinglePlayer.cpp)
+	else if( !stricmp( cmd, "OpenChangeGameDialog" ))
+		item.onReleased = UI_SteamChangeGame_Menu; // the Change Game window of the Steam version (SteamSinglePlayer.cpp)
+	else if( !stricmp( cmd, "OpenPlayerListDialog" ))
+		item.onReleased = UI_SteamPlayerList_Menu; // the Player List of the Steam version (SteamSinglePlayer.cpp)
+	else if( !strnicmp( cmd, "engine ", 7 ))
+		item.onReleased.SetCommand( false, cmd + 7 ); // "engine <console command>" as in GameUI
+	else
+		return false; // a command with no such menu here: the item is not shown
+
+	return true;
+}
