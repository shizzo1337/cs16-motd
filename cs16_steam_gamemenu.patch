+	PlaceFilter( &m_mapLabel, "MapFilterLabel", normal, filters, P( 12, 180, 44, 24, 0, 2, false ) );
+	PlaceFilter( &m_pingLabel, "PingFilterLabel", normal, filters, P( 234, 150, 72, 24, 0, 2, false ) );
+
+	// the status line of the window, under the page
+	m_status.iFlags |= QMF_INACTIVE;
+	AddItem( m_status );
+}
