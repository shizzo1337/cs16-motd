+static void SteamProgressBar( int x, int y, int w, int h, float frac )
+{
+	using namespace SteamUI;
+	Fill( x, y, w, h, ListBG );
+	InsetBorder( x, y, w, h );
+	if( frac < 0.0f ) frac = 0.0f;
+	if( frac > 1.0f ) frac = 1.0f;
+	const int blocks = ( w - 8 + 4 ) / 12;
+	const int shown = (int)( blocks * frac );
+	for( int i = 0; i < shown; i++ )
+		Fill( x + 4 + i * 12, y + 4, 8, h - 8, BrightControlText );
+}
