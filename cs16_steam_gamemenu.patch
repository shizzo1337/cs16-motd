@@ -0,0 +1,173 @@
+/*
+SteamGameMenu.cpp - the main menu as in the Steam version of Half-Life and its mods (see SteamGameMenu.h)
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+#include <string.h>
+#include <stdlib.h>
+
+#include "BaseMenu.h"
+#include "SteamGameMenu.h"
+#include "client/ClientWindow.h"
+
+namespace SteamGameMenu {
+
+static bool IsTrue( const char *value )
+{
+	return atoi( value ) != 0;
+}
+
+bool Load( CUtlVector<Entry> &entries )
+{
+	entries.RemoveAll();
+
+	char *afile = (char *)EngFuncs::COM_LoadFile( "resource/GameMenu.res" );
+	if( !afile )
+		return false;
+
+	char token[1024];
+	char *pfile = EngFuncs::COM_ParseFile( afile, token, sizeof( token ));
+
+	// "GameMenu" { "1" { "label" "..." "command" "..." ... } ... }
+	if( pfile )
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+
+	if( !pfile || strcmp( token, "{" ))
+	{
+		EngFuncs::COM_FreeFile( afile );
+		return false;
+	}
+
+	while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))))
+	{
+		if( !strcmp( token, "}" ))
+			break; // the end of "GameMenu"
+
+		// the name of the item ("1", "2"...), then its block
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+		if( !pfile || strcmp( token, "{" ))
+			break;
+
+		Entry e;
+		memset( &e, 0, sizeof( e ));
+
+		while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))))
+		{
+			if( !strcmp( token, "}" ))
+				break;
+
+			char key[64];
+			Q_strncpy( key, token, sizeof( key ));
+
+			pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+			if( !pfile )
+				break;
+
+			if( !stricmp( key, "label" ))
+				Q_strncpy( e.label, token, sizeof( e.label ));
+			else if( !stricmp( key, "command" ))
+				Q_strncpy( e.command, token, sizeof( e.command ));
+			else if( !stricmp( key, "OnlyInGame" ))
+				e.onlyInGame = IsTrue( token );
+			else if( !stricmp( key, "notsingle" ))
+				e.notSingle = IsTrue( token );
+			else if( !stricmp( key, "notmulti" ))
+				e.notMulti = IsTrue( token );
+			else if( !stricmp( key, "notsteam" ))
+				e.notSteam = IsTrue( token );
+		}
+
+		if( !pfile )
+			break;
+
+		entries.AddToTail( e );
+	}
+
+	EngFuncs::COM_FreeFile( afile );
+	return entries.Count() > 0;
+}
+
+} // namespace SteamGameMenu
+
+CSteamGameMenuItem::CSteamGameMenuItem() : BaseClass()
+{
+	label[0] = 0;
+	bDrawStroke = false;
+	SetText( "" );
+}
+
+void CSteamGameMenuItem::VidInit( void )
+{
+	BaseClass::VidInit();
+	m_scPos = pixelPos;
+	m_scSize = pixelSize;
+}
+
+void CSteamGameMenuItem::Draw( void )
+{
+	if( spacer || !label[0] )
+		return;
+
+	if( uiStatic.realTime < appearTime )
+		return;
+
+	unsigned int color = SteamGameMenu::MENU_COLOR;
+
+	if( iFlags & QMF_GRAYED )
+		color = PackRGBA( 117, 128, 111, 255 ); // "DisabledText1"
+	else if( m_bPressed )
+		color = SteamGameMenu::DEPRESSED_COLOR;
+	else if( iFlags & ( QMF_HASMOUSEFOCUS | QMF_HASKEYBOARDFOCUS ))
+		color = SteamGameMenu::ARMED_COLOR;
+
+	CClientWindow::DrawSteamText( textFont, m_scPos.x, capTop, capHeight, gpGlobals->scrWidth - m_scPos.x, label, color );
+}
+
+CSteamGameMenuLogo::CSteamGameMenuLogo() : BaseClass()
+{
+	iFlags |= QMF_INACTIVE; // not a button: only lit under the mouse, as in the Steam version
+}
+
+bool CSteamGameMenuLogo::Load( void )
+{
+	if( !EngFuncs::FileExists( "resource/game_menu.tga" ))
+		return false;
+
+	m_hLogo = EngFuncs::PIC_Load( "resource/game_menu.tga", PIC_NOFLIP_TGA );
+	if( EngFuncs::FileExists( "resource/game_menu_mouseover.tga" ))
+		m_hLogoOver = EngFuncs::PIC_Load( "resource/game_menu_mouseover.tga", PIC_NOFLIP_TGA );
+
+	return m_hLogo != 0;
+}
+
+void CSteamGameMenuLogo::VidInit( void )
+{
+	BaseClass::VidInit();
+
+	if( !m_hLogo )
+		return;
+
+	// pixels, like the Steam version (not scaled with the screen)
+	m_scSize = Size( EngFuncs::PIC_Width( m_hLogo ), EngFuncs::PIC_Height( m_hLogo ));
+	m_scPos = Point( SteamGameMenu::INSET, gpGlobals->scrHeight - SteamGameMenu::LOGO_FROM_BOTTOM );
+}
+
+void CSteamGameMenuLogo::Draw( void )
+{
+	if( !m_hLogo )
+		return;
+
+	const bool over = m_hLogoOver && UI_CursorInRect( m_scPos, m_scSize );
+
+	EngFuncs::PIC_Set( over ? m_hLogoOver : m_hLogo, 255, 255, 255, 255 );
+	EngFuncs::PIC_DrawTrans( m_scPos, m_scSize );
+}
