+void CSteamOptionsDialog::_Init()
+{
+	SetTitle( "#GameUI_Options" );
+
+	const int pMulti = AddPage( "#GameUI_Multiplayer" );
+	const int pKeys = AddPage( "#GameUI_Keyboard" );
+	const int pMouse = AddPage( "#GameUI_Mouse" );
+	const int pAudio = AddPage( "#GameUI_Audio" );
+	const int pVideo = AddPage( "#GameUI_Video" );
+	const int pVoice = AddPage( "#GameUI_Voice" );
+	const int pLock = AddPage( "#GameUI_Advanced" );
+
+	// --- Multiplayer
+	BuildPage( pMulti, "resource/OptionsSubMultiplayer.res" );
+	m_name = Get<CSteamTextEntry>( "NameEntry", K_TEXT );
+	m_logo = Get<CSteamComboBox>( "SpraypaintList", K_COMBO );
+	m_logoColor = Get<CSteamComboBox>( "SpraypaintColor", K_COMBO );
+	m_logoImage = Get<CSteamPreview>( "LogoImage", K_PREVIEW );
+	m_xhairSize = Get<CSteamComboBox>( "CrosshairSizeComboBox", K_COMBO );
+	m_xhairColor = Get<CSteamComboBox>( "CrosshairColorComboBox", K_COMBO );
+	m_xhairTranslucent = Get<CSteamCheckButton>( "CrosshairTranslucencyCheck", K_CHECK );
+	m_xhairImage = Get<CSteamPreview>( "CrosshairImage", K_PREVIEW );
+
+	if( m_xhairImage )
+	{
+		m_xhairImage->kind = CSteamPreview::CROSSHAIR;
+		if( EngFuncs::FileExists( "gfx/vgui/crosshair.tga" ))
+			m_xhairImage->image = EngFuncs::PIC_Load( "gfx/vgui/crosshair.tga", PIC_NOFLIP_TGA );
+	}
+
+	if( m_logo )
+	{
+		int numFiles = 0;
+		char **files = EngFuncs::GetFilesList( "logos/*.bmp", &numFiles, false );
+		for( int i = 0; files && i < numFiles; i++ )
+		{
+			char base[128];
+			COM_FileBase( files[i], base, sizeof( base ));
+			if( !stricmp( base, "remapped" ))
+				continue;
+			m_logo->AddItem( base, base );
+		}
+		m_logo->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_logoColor )
+	{
+		for( const NamedColor &c : g_logoColors )
+			m_logoColor->AddItem( L( c.name ), c.rgb );
+		m_logoColor->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_xhairSize )
+	{
+		for( const NamedColor &c : g_crosshairSizes )
+			m_xhairSize->AddItem( L( c.name ), c.rgb );
+		m_xhairSize->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_xhairColor )
+	{
+		for( const NamedColor &c : g_crosshairColors )
+			m_xhairColor->AddItem( L( c.name ), c.rgb );
+		m_xhairColor->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_xhairTranslucent )
+		m_xhairTranslucent->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+
+	if( CSteamButton *adv = Get<CSteamButton>( "Advanced", K_BUTTON ))
+		adv->onReleased = UI_SteamMultiplayerAdvanced_Menu; // the Advanced window of the Steam version (SteamCreateServer.cpp)
+
+	// --- Keyboard
+	BuildPage( pKeys, "resource/OptionsSubKeyboard.res" );
+	m_keys = Get<CSteamKeyList>( "listpanel_keybindlist", K_KEYLIST );
+	if( m_keys )
+		m_keys->onActivate = VoidCb( &CSteamOptionsDialog::StartGrab );
+	if( CSteamButton *b = Get<CSteamButton>( "Defaults", K_BUTTON ))
+		b->onReleased = VoidCb( &CSteamOptionsDialog::ResetKeys );
+	if( CSteamButton *b = Get<CSteamButton>( "ChangeKeyButton", K_BUTTON ))
+		b->onReleased = VoidCb( &CSteamOptionsDialog::StartGrab );
+	if( CSteamButton *b = Get<CSteamButton>( "ClearKeyButton", K_BUTTON ))
+		b->onReleased = VoidCb( &CSteamOptionsDialog::ClearKey );
+
+	// --- Mouse
+	BuildPage( pMouse, "resource/OptionsSubMouse.res" );
+	m_reverseMouse = Get<CSteamCheckButton>( "ReverseMouse", K_CHECK );
+	m_mouseLook = Get<CSteamCheckButton>( "MouseLook", K_CHECK );
+	m_mouseFilter = Get<CSteamCheckButton>( "MouseFilter", K_CHECK );
+	m_joystick = Get<CSteamCheckButton>( "Joystick", K_CHECK );
+	m_joystickLook = Get<CSteamCheckButton>( "JoystickLook", K_CHECK );
+	m_autoAim = Get<CSteamCheckButton>( "Auto-Aim", K_CHECK );
+	m_rawInput = Get<CSteamCheckButton>( "RawInput", K_CHECK );
+	m_sensitivity = Get<CSteamSlider>( "Slider", K_SLIDER );
+	m_sensitivityText = Get<CSteamTextEntry>( "SensitivityLabel", K_TEXT );
+	if( m_sensitivity )
+	{
+		m_sensitivity->minValue = 0.2f;
+		m_sensitivity->maxValue = 20.0f;
+		Q_strncpy( m_sensitivity->leftText, "0.20", sizeof( m_sensitivity->leftText ));
+		Q_strncpy( m_sensitivity->rightText, "20.00", sizeof( m_sensitivity->rightText ));
+		SET_EVENT_MULTI( m_sensitivity->onChanged,
+		{
+			CSteamSlider *s = (CSteamSlider *)pSelf;
+			CSteamOptionsDialog *dlg = (CSteamOptionsDialog *)s->Parent();
+			if( dlg->m_sensitivityText )
+			{
+				char buf[32];
+				snprintf( buf, sizeof( buf ), "%.1f", s->value );
+				dlg->m_sensitivityText->SetBuffer( buf );
+			}
+		});
+	}
+	if( m_sensitivityText )
+		m_sensitivityText->bNumbersOnly = false;
+
+	// --- Audio
+	BuildPage( pAudio, "resource/OptionsSubAudio.res" );
+	m_sfx = Get<CSteamSlider>( "SFX Slider", K_SLIDER );
+	m_mp3 = Get<CSteamSlider>( "MP3 Volume", K_SLIDER );
+	m_suit = Get<CSteamSlider>( "Suit Slider", K_SLIDER );
+	m_soundQuality = Get<CSteamComboBox>( "Sound Quality", K_COMBO );
+	if( m_soundQuality )
+	{
+		m_soundQuality->AddItem( L( "GameUI_Low" ), "0" );
+		m_soundQuality->AddItem( L( "GameUI_Medium" ), "1" );
+		m_soundQuality->AddItem( L( "GameUI_High" ), "2" );
+	}
+	// the HEV suit is Half-Life's: the Steam version of the mods shows no slider for it
+	if( stricmp( gMenu.m_gameinfo.gamefolder, "valve" ))
+	{
+		if( m_suit ) m_suit->Hide();
+		if( CSteamLabel *l = Get<CSteamLabel>( "suit label", K_LABEL )) l->Hide();
+		m_suit = nullptr;
+	}
+
+	// --- Video
+	BuildPage( pVideo, "resource/OptionsSubVideo.res" );
+	m_renderer = Get<CSteamComboBox>( "Renderer", K_COMBO );
+	m_resolution = Get<CSteamComboBox>( "Resolution", K_COMBO );
+	m_aspect = Get<CSteamComboBox>( "AspectRatio", K_COMBO );
+	m_windowed = Get<CSteamCheckButton>( "Windowed", K_CHECK );
+	m_vsync = Get<CSteamCheckButton>( "VSync", K_CHECK );
+	m_hdModels = Get<CSteamCheckButton>( "HDModels", K_CHECK );
+	m_addons = Get<CSteamCheckButton>( "AddonsFolder", K_CHECK );
+	m_lowVideo = Get<CSteamCheckButton>( "LowVideoDetail", K_CHECK );
+	m_detailTextures = Get<CSteamCheckButton>( "DetailTextures", K_CHECK );
+	m_brightness = Get<CSteamSlider>( "Brightness", K_SLIDER );
+	m_gamma = Get<CSteamSlider>( "Gamma", K_SLIDER );
+
+	// the colour depth of the older .res (the game is always 32 bit now): one item, nothing to change
+	if( CSteamComboBox *depth = Get<CSteamComboBox>( "ColorDepth", K_COMBO ))
+	{
+		depth->AddItem( Localize( "#GameUI_HighBitDepth" ), "32" );
+		depth->Select( 0 );
+	}
+	if( m_vsync && !m_vsync->text[0] )
+		Q_strncpy( m_vsync->text, "Wait for vertical sync", sizeof( m_vsync->text )); // no text in the .res
+	if( m_renderer )
+	{
+		for( unsigned int i = 0; ; i++ )
+		{
+			char shortName[64], readable[128];
+			if( !EngFuncs::GetRenderers( i, shortName, sizeof( shortName ), readable, sizeof( readable )))
+				break;
+			m_renderer->AddItem( readable, shortName );
+		}
+	}
+	if( m_aspect )
+	{
+		m_aspect->AddItem( L( "GameUI_AspectNormal" ), "0" );
+		m_aspect->AddItem( L( "GameUI_AspectWide" ), "1" );
+		m_aspect->onChanged = VoidCb( &CSteamOptionsDialog::FillResolutions );
+	}
+	if( m_brightness )
+	{
+		m_brightness->minValue = 0.0f;
+		m_brightness->maxValue = 3.0f;
+	}
+	if( m_gamma )
+	{
+		m_gamma->minValue = 1.8f;
+		m_gamma->maxValue = 3.0f;
+	}
+
+	// --- Voice
+	BuildPage( pVoice, "resource/OptionsSubVoice.res" );
+	m_voiceEnable = Get<CSteamCheckButton>( "voice_modenable", K_CHECK );
+	m_micBoost = Get<CSteamCheckButton>( "MicBoost", K_CHECK );
+	m_voiceTransmit = Get<CSteamSlider>( "#GameUI_MicrophoneVolume", K_SLIDER );
+	m_voiceReceive = Get<CSteamSlider>( "VoiceReceive", K_SLIDER );
+	m_testMic = Get<CSteamButton>( "TestMicrophone", K_BUTTON );
+	if( m_testMic )
+		m_testMic->onReleased = VoidCb( &CSteamOptionsDialog::ToggleMicTest );
+	if( CSteamPreview *meter = Get<CSteamPreview>( "MicMeter", K_PREVIEW ))
+	{
+		meter->kind = CSteamPreview::MIC_METER;
+		if( EngFuncs::FileExists( "resource/mic_meter_dead.tga" ))
+			meter->image = EngFuncs::PIC_Load( "resource/mic_meter_dead.tga", PIC_NOFLIP_TGA );
+	}
+
+	// --- Lock
+	BuildPage( pLock, "resource/OptionsSubAdvanced.res" );
+	m_contentLock = Get<CSteamButton>( "ContentlockButton", K_BUTTON );
+	m_contentLockLabel = Get<CSteamLabel>( "ContentlockLabel", K_LABEL );
+	if( m_contentLock )
+	{
+		SET_EVENT_MULTI( m_contentLock->onReleased,
+		{
+			// the violence of the game: on when the lock is off
+			const bool locked = EngFuncs::GetCvarFloat( "violence_hblood" ) == 0.0f;
+			const float v = locked ? 1.0f : 0.0f;
+			EngFuncs::CvarSetValue( "violence_hblood", v );
+			EngFuncs::CvarSetValue( "violence_ablood", v );
+			EngFuncs::CvarSetValue( "violence_hgibs", v );
+			EngFuncs::CvarSetValue( "violence_agibs", v );
+			((CSteamOptionsDialog *)pSelf->Parent())->UpdateContentLockLabel();
+		});
+	}
+
+	m_iBuildPage = -1;
+
+	// the buttons of the window
+	const int by = 406 - 9 - 24;
+	m_ok.SetBounds( 512 - 14 - 72 * 3 - 8 * 2 + 1, by, 72, 24 );
+	m_cancel.SetBounds( 512 - 14 - 72 * 2 - 8 + 1, by, 72, 24 );
+	m_apply.SetBounds( 512 - 14 - 72 + 1, by, 72, 24 );
+	Q_strncpy( m_ok.text, "#GameUI_OK", sizeof( m_ok.text ));
+	Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+	Q_strncpy( m_apply.text, "#GameUI_Apply", sizeof( m_apply.text ));
+	m_ok.isDefault = true;
+
+	SET_EVENT_MULTI( m_ok.onReleased,
+	{
+		CSteamOptionsDialog *dlg = (CSteamOptionsDialog *)pSelf->Parent();
+		dlg->Apply();
+		dlg->SaveAndPopMenu();
+	});
+	m_cancel.onReleased = VoidCb( &CSteamOptionsDialog::Hide );
+	m_apply.onReleased = VoidCb( &CSteamOptionsDialog::Apply );
+
+	AddItem( m_ok );
+	AddItem( m_cancel );
+	AddItem( m_apply );
+}
+
+void CSteamOptionsDialog::UpdateContentLockLabel()
+{
+	if( !m_contentLockLabel )
+		return;
+	const bool locked = EngFuncs::GetCvarFloat( "violence_hblood" ) == 0.0f;
+	Q_strncpy( m_contentLockLabel->text, locked ? "#GameUI_ContentStatusEnabled" : "#GameUI_ContentLockLabel",
+		sizeof( m_contentLockLabel->text ));
+}
+
+void CSteamOptionsDialog::UpdatePreviews()
+{
+	if( m_logoImage && m_logo )
+	{
+		char path[256];
+		snprintf( path, sizeof( path ), "logos/%s.bmp", m_logo->SelectedText());
+		m_logoImage->image = m_logo->SelectedText()[0] ? EngFuncs::PIC_Load( path ) : 0;
+		if( m_logoColor )
+			ParseRGB( m_logoColor->SelectedData(), m_logoImage->r, m_logoImage->g, m_logoImage->b );
+	}
+
+	if( m_xhairImage )
+	{
+		if( m_xhairColor )
+			ParseRGB( m_xhairColor->SelectedData(), m_xhairImage->r, m_xhairImage->g, m_xhairImage->b );
+		if( m_xhairSize )
+			m_xhairImage->crosshairSize = m_xhairSize->SelectedData()[0] ? m_xhairSize->SelectedData() : "auto";
+		if( m_xhairTranslucent )
+			m_xhairImage->translucent = m_xhairTranslucent->checked;
+	}
+}
+
+static void SetCheck( CSteamCheckButton *b, bool on ) { if( b ) b->checked = on; }
+
+void CSteamOptionsDialog::Load()
+{
+	// Multiplayer
+	if( m_name )
+		m_name->SetBuffer( EngFuncs::GetCvarString( "name" ));
+	if( m_logo )
+	{
+		int i = -1;
+		for( int k = 0; k < m_logo->items.Count(); k++ )
+			if( !stricmp( m_logo->items[k].text, EngFuncs::GetCvarString( "cl_logofile" ))) { i = k; break; }
+		m_logo->Select( i >= 0 ? i : ( m_logo->items.Count() ? 0 : -1 ));
+	}
+	if( m_logoColor )
+	{
+		const int i = m_logoColor->FindData( EngFuncs::GetCvarString( "cl_logocolor" ));
+		m_logoColor->Select( i >= 0 ? i : 0 );
+	}
+	if( m_xhairSize )
+	{
+		const int i = m_xhairSize->FindData( EngFuncs::GetCvarString( "cl_crosshair_size" ));
+		m_xhairSize->Select( i >= 0 ? i : 0 );
+	}
+	if( m_xhairColor )
+	{
+		const int i = m_xhairColor->FindData( EngFuncs::GetCvarString( "cl_crosshair_color" ));
+		m_xhairColor->Select( i >= 0 ? i : 0 );
+	}
+	SetCheck( m_xhairTranslucent, EngFuncs::GetCvarFloat( "cl_crosshair_translucent" ) != 0.0f );
+	UpdatePreviews();
+
+	// Keyboard
+	if( m_keys )
+	{
+		m_keys->grabbing = false;
+		m_keys->Refresh();
+	}
+
+	// Mouse
+	SetCheck( m_reverseMouse, EngFuncs::GetCvarFloat( "m_pitch" ) < 0.0f );
+	SetCheck( m_mouseLook, EngFuncs::GetCvarFloat( "ui_steam_mouselook" ) != 0.0f );
+	SetCheck( m_mouseFilter, EngFuncs::GetCvarFloat( "m_filter" ) != 0.0f );
+	SetCheck( m_joystick, EngFuncs::GetCvarFloat( "joy_enable" ) != 0.0f );
+	SetCheck( m_joystickLook, EngFuncs::GetCvarFloat( "joy_lookspring" ) == 0.0f );
+	SetCheck( m_autoAim, EngFuncs::GetCvarFloat( "sv_aim" ) != 0.0f );
+	SetCheck( m_rawInput, EngFuncs::GetCvarFloat( "m_rawinput" ) != 0.0f );
+	if( m_sensitivity )
+	{
+		m_sensitivity->value = EngFuncs::GetCvarFloat( "sensitivity" );
+		if( m_sensitivity->onChanged )
+			m_sensitivity->onChanged( m_sensitivity );
+	}
+
+	// Audio
+	if( m_sfx ) m_sfx->value = EngFuncs::GetCvarFloat( "volume" );
+	if( m_mp3 ) m_mp3->value = EngFuncs::GetCvarFloat( "MP3Volume" );
+	if( m_suit ) m_suit->value = EngFuncs::GetCvarFloat( "suitvolume" );
+	if( m_soundQuality )
+		m_soundQuality->Select( (int)EngFuncs::GetCvarFloat( "ui_steam_soundquality" ) >= 0 ? (int)EngFuncs::GetCvarFloat( "ui_steam_soundquality" ) : 2 );
+
+	// Video
+	if( m_renderer )
+	{
+		const int i = m_renderer->FindData( EngFuncs::GetCvarString( "r_refdll_loaded" ));
+		m_renderer->Select( i );
+	}
+	if( m_aspect )
+	{
+		const bool wide = gpGlobals->scrWidth * 3 > gpGlobals->scrHeight * 4 + gpGlobals->scrHeight / 2;
+		m_aspect->Select( wide ? 1 : 0 );
+	}
+	if( m_resolution )
+	{
+		m_resolution->RemoveAll();
+		FillResolutions();
+	}
+	SetCheck( m_windowed, EngFuncs::GetCvarFloat( "fullscreen" ) == 0.0f );
+	SetCheck( m_vsync, EngFuncs::GetCvarFloat( "gl_vsync" ) != 0.0f );
+	SetCheck( m_hdModels, EngFuncs::GetCvarFloat( "fs_mount_hd" ) != 0.0f );
+	SetCheck( m_addons, EngFuncs::GetCvarFloat( "fs_mount_addon" ) != 0.0f );
+	SetCheck( m_lowVideo, EngFuncs::GetCvarFloat( "ui_steam_lowvideo" ) != 0.0f );
+	SetCheck( m_detailTextures, EngFuncs::GetCvarFloat( "r_detailtextures" ) != 0.0f );
+	if( m_brightness ) m_brightness->value = EngFuncs::GetCvarFloat( "brightness" );
+	if( m_gamma ) m_gamma->value = EngFuncs::GetCvarFloat( "gamma" );
+
+	// Voice
+	SetCheck( m_voiceEnable, EngFuncs::GetCvarFloat( "voice_modenable" ) != 0.0f );
+	SetCheck( m_micBoost, EngFuncs::GetCvarFloat( "ui_steam_micboost" ) != 0.0f );
+	if( m_voiceTransmit ) m_voiceTransmit->value = EngFuncs::GetCvarFloat( "voice_transmit_scale" );
+	if( m_voiceReceive ) m_voiceReceive->value = EngFuncs::GetCvarFloat( "voice_scale" );
+
+	// Lock
+	UpdateContentLockLabel();
+
+	SetUnchanged();
+}
+
+void CSteamOptionsDialog::ApplyLogo()
+{
+	if( !m_logo || !m_logo->SelectedText()[0] )
+		return;
+
+	char path[256];
+	snprintf( path, sizeof( path ), "logos/%s.bmp", m_logo->SelectedText());
+
+	CBMP *bmp = CBMP::LoadFile( path );
+	if( !bmp )
+		return;
+
+	int r = 255, g = 255, b = 255;
+	if( m_logoColor )
+		ParseRGB( m_logoColor->SelectedData(), r, g, b );
+	const byte rgb[3] = { (byte)r, (byte)g, (byte)b };
+	bmp->RemapLogo( 1, rgb );
+
+	EngFuncs::DeleteFile( "logos/remapped.png" );
+	EngFuncs::DeleteFile( "logos/remapped.bmp" );
+	bmp->Save( "logos/remapped.bmp" );
+	delete bmp;
+
+	EngFuncs::CvarSetString( "cl_logoext", "bmp" );
+	EngFuncs::CvarSetString( "cl_logofile", m_logo->SelectedText());
+	if( m_logoColor )
+		EngFuncs::CvarSetString( "cl_logocolor", m_logoColor->SelectedData());
+	EngFuncs::CvarSetValue( "@cl_logoupdate", !EngFuncs::GetCvarFloat( "@cl_logoupdate" ));
+}
+
+void CSteamOptionsDialog::Apply()
+{
+	// Multiplayer
+	if( m_name && m_name->GetBuffer()[0] )
+		EngFuncs::CvarSetString( "name", m_name->GetBuffer());
+	ApplyLogo();
+	if( m_xhairSize ) EngFuncs::CvarSetString( "cl_crosshair_size", m_xhairSize->SelectedData());
+	if( m_xhairColor ) EngFuncs::CvarSetString( "cl_crosshair_color", m_xhairColor->SelectedData());
+	if( m_xhairTranslucent ) EngFuncs::CvarSetValue( "cl_crosshair_translucent", m_xhairTranslucent->checked );
+
+	// Mouse
+	if( m_reverseMouse )
+	{
+		const float pitch = fabsf( EngFuncs::GetCvarFloat( "m_pitch" ));
+		EngFuncs::CvarSetValue( "m_pitch", ( pitch > 0.0f ? pitch : 0.022f ) * ( m_reverseMouse->checked ? -1.0f : 1.0f ));
+	}
+	if( m_mouseLook )
+	{
+		EngFuncs::CvarSetValue( "ui_steam_mouselook", m_mouseLook->checked );
+		EngFuncs::ClientCmd( false, m_mouseLook->checked ? "+mlook\n" : "-mlook\n" );
+	}
+	if( m_mouseFilter ) EngFuncs::CvarSetValue( "m_filter", m_mouseFilter->checked );
+	if( m_joystick ) EngFuncs::CvarSetValue( "joy_enable", m_joystick->checked );
+	if( m_joystickLook ) EngFuncs::CvarSetValue( "joy_lookspring", !m_joystickLook->checked );
+	if( m_autoAim ) EngFuncs::CvarSetValue( "sv_aim", m_autoAim->checked );
+	if( m_rawInput ) EngFuncs::CvarSetValue( "m_rawinput", m_rawInput->checked );
+	if( m_sensitivityText && m_sensitivityText->GetBuffer()[0] )
+	{
+		float s = (float)atof( m_sensitivityText->GetBuffer());
+		if( s > 0.0f )
+			EngFuncs::CvarSetValue( "sensitivity", s );
+	}
+	else if( m_sensitivity )
+		EngFuncs::CvarSetValue( "sensitivity", m_sensitivity->value );
+
+	// Audio
+	if( m_sfx ) EngFuncs::CvarSetValue( "volume", m_sfx->value );
+	if( m_mp3 ) EngFuncs::CvarSetValue( "MP3Volume", m_mp3->value );
+	if( m_suit ) EngFuncs::CvarSetValue( "suitvolume", m_suit->value );
+	if( m_soundQuality ) EngFuncs::CvarSetValue( "ui_steam_soundquality", m_soundQuality->Selected());
+
+	// Video
+	if( m_vsync ) EngFuncs::CvarSetValue( "gl_vsync", m_vsync->checked );
+	if( m_hdModels ) EngFuncs::CvarSetValue( "fs_mount_hd", m_hdModels->checked );
+	if( m_addons ) EngFuncs::CvarSetValue( "fs_mount_addon", m_addons->checked );
+	if( m_lowVideo ) EngFuncs::CvarSetValue( "ui_steam_lowvideo", m_lowVideo->checked );
+	if( m_detailTextures ) EngFuncs::CvarSetValue( "r_detailtextures", m_detailTextures->checked );
+	if( m_brightness ) EngFuncs::CvarSetValue( "brightness", m_brightness->value );
+	if( m_gamma ) EngFuncs::CvarSetValue( "gamma", m_gamma->value );
+
+	bool restart = false;
+	if( m_renderer && m_renderer->Selected() >= 0 && stricmp( m_renderer->SelectedData(), EngFuncs::GetCvarString( "r_refdll_loaded" )))
+	{
+		EngFuncs::CvarSetString( "r_refdll", m_renderer->SelectedData());
+		restart = true;
+	}
+	if( m_windowed )
+	{
+		const float fs = m_windowed->checked ? 0.0f : 1.0f;
+		if( EngFuncs::GetCvarFloat( "fullscreen" ) != fs )
+			EngFuncs::CvarSetValue( "fullscreen", fs );
+	}
+	if( m_resolution && m_resolution->Selected() >= 0 )
+	{
+		const int mode = atoi( m_resolution->SelectedData());
+		if( mode != (int)EngFuncs::GetCvarFloat( "vid_mode" ))
+		{
+			EngFuncs::ClientCmdF( true, "vid_setmode %i\n", mode );
+			EngFuncs::CvarSetValue( "vid_mode", mode );
+		}
+	}
+
+	// Voice
+	if( m_voiceEnable ) EngFuncs::CvarSetValue( "voice_modenable", m_voiceEnable->checked );
+	if( m_micBoost ) EngFuncs::CvarSetValue( "ui_steam_micboost", m_micBoost->checked );
+	if( m_voiceTransmit ) EngFuncs::CvarSetValue( "voice_transmit_scale", m_voiceTransmit->value );
+	if( m_voiceReceive ) EngFuncs::CvarSetValue( "voice_scale", m_voiceReceive->value );
+
+	SetUnchanged();
+
+	if( restart )
+		UI_ShowMessageBox( L( "GameUI_VideoRestart" ));
+}
+
+unsigned int CSteamOptionsDialog::ControlsHash() const
+{
+	unsigned int h = 2166136261u; // FNV-1a
+	auto mix = [&h]( const void *data, size_t len )
+	{
+		const unsigned char *b = (const unsigned char *)data;
+		for( size_t i = 0; i < len; i++ )
+		{
+			h ^= b[i];
+			h *= 16777619u;
+		}
+	};
+
+	for( int i = 0; i < m_built.Count(); i++ )
+	{
+		const Built &b = m_built[i];
+		switch( b.kind )
+		{
+		case K_CHECK:
+		{
+			const bool v = static_cast<CSteamCheckButton *>( b.item )->checked;
+			mix( &v, sizeof( v ));
+			break;
+		}
+		case K_SLIDER:
+		{
+			const float v = static_cast<CSteamSlider *>( b.item )->value;
+			mix( &v, sizeof( v ));
+			break;
+		}
+		case K_COMBO:
+		{
+			const int v = static_cast<CSteamComboBox *>( b.item )->Selected();
+			mix( &v, sizeof( v ));
+			break;
+		}
+		case K_TEXT:
+		{
+			const char *v = static_cast<CSteamTextEntry *>( b.item )->GetBuffer();
+			mix( v, strlen( v ));
+			break;
+		}
+		}
+	}
+	return h;
+}
+
+void CSteamOptionsDialog::Draw()
+{
+	if( !m_bChanged && ControlsHash() != m_iHash )
+		m_bChanged = true;
+	m_apply.SetGrayed( !m_bChanged );
+	BaseClass::Draw();
+}
+
+void CSteamOptionsDialog::UnbindCommand( const char *command )
+{
+	for( int i = 0; ; i++ )
+	{
+		const char *str = EngFuncs::KeynumToString( i );
+		if( !strcmp( str, "<OUT OF RANGE>" ))
+			break;
+
+		const char *b = EngFuncs::KEY_GetBinding( i );
+		if( b && !stricmp( b, command ))
+			EngFuncs::KEY_SetBinding( i, "" );
+	}
+}
+
+void CSteamOptionsDialog::ResetKeys()
+{
+	char *afile = (char *)EngFuncs::COM_LoadFile( "gfx/shell/kb_def.lst", NULL );
+	if( !afile )
+		return;
+
+	EngFuncs::ClientCmd( true, "unbindall" );
+
+	char token[1024];
+	char *pfile = afile;
+	while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))) != NULL )
+	{
+		char key[32];
+		Q_strncpy( key, token, sizeof( key ));
+
+		pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ));
+		if( !pfile )
+			break;
+
+		if( key[0] == '\\' && key[1] == '\\' )
+			key[1] = 0;
+
+		EngFuncs::ClientCmdF( true, "bind \"%s\" \"%s\"\n", key, token );
+	}
+
+	EngFuncs::COM_FreeFile( afile );
+	if( m_keys )
+		m_keys->Refresh();
+	m_bChanged = true;
+}
+
+void CSteamOptionsDialog::ClearKey()
+{
+	if( !m_keys || !m_keys->SelectedBind()[0] )
+		return;
+	UnbindCommand( m_keys->SelectedBind());
+	m_keys->Refresh();
+	m_bChanged = true;
+}
+
+void CSteamOptionsDialog::StartGrab()
+{
+	if( !m_keys || !m_keys->SelectedBind()[0] )
+		return;
+
+	// two keys already: the next one replaces them, as in the Steam version
+	int keys[2];
+	CMenuKbActListModel::LookupBoundKeys( m_keys->SelectedBind(), keys );
+	if( keys[1] != -1 )
+		UnbindCommand( m_keys->SelectedBind());
+
+	m_keys->grabbing = true;
+	m_iGrabKey = -1; // the key that started it (Enter, the double click) is still down: its release is not taken
+}
+
+void CSteamOptionsDialog::ToggleMicTest()
+{
+	m_bMicTest = !m_bMicTest;
+	EngFuncs::CvarSetValue( "voice_loopback", m_bMicTest );
+	EngFuncs::ClientCmd( false, m_bMicTest ? "+voicerecord\n" : "-voicerecord\n" );
+	if( m_testMic )
+		Q_strncpy( m_testMic->text, m_bMicTest ? "#GameUI_StopTestMicrophone" : "#GameUI_TestMicrophone", sizeof( m_testMic->text ));
+}
+
+void CSteamOptionsDialog::Show()
+{
+	BaseClass::Show();
+	Load();
+}
+
+bool CSteamOptionsDialog::KeyDown( int key )
+{
+	// waiting for the key of an action: the key (or a mouse button) pressed now is taken when it is released
+	if( m_keys && m_keys->grabbing )
+	{
+		m_iGrabKey = key;
+		return true;
+	}
+
+	if( UI::Key::IsEscape( key ) && m_bMicTest )
+		ToggleMicTest();
+
+	return BaseClass::KeyDown( key );
+}
+
+bool CSteamOptionsDialog::KeyUp( int key )
+{
+	if( m_keys && m_keys->grabbing )
+	{
+		if( key != m_iGrabKey )
+			return true; // the release of a key pressed before the waiting began
+
+		m_keys->grabbing = false;
+
+		// Escape and the console key cancel, as in the Steam version
+		if( !UI::Key::IsConsole( key ) && key != K_ESCAPE && m_keys->SelectedBind()[0] )
+		{
+			EngFuncs::ClientCmdF( true, "bind \"%s\" \"%s\"\n", EngFuncs::KeynumToString( key ), m_keys->SelectedBind());
+			PlayLocalSound( uiStatic.sounds[SND_LAUNCH] );
+			m_bChanged = true;
+		}
+		else PlayLocalSound( uiStatic.sounds[SND_BUZZ] );
+
+		m_keys->Refresh();
+		return true;
+	}
+
+	return BaseClass::KeyUp( key );
+}
+
+static CSteamOptionsDialog *s_options = nullptr;
+
+void UI_SteamOptions_Menu( void )
+{
+	if( !s_options )
+	{
+		s_options = new CSteamOptionsDialog;
+		EngFuncs::CvarRegister( "ui_steam_mouselook", "1", FCVAR_ARCHIVE );
+		EngFuncs::CvarRegister( "ui_steam_soundquality", "2", FCVAR_ARCHIVE );
+		EngFuncs::CvarRegister( "ui_steam_lowvideo", "0", FCVAR_ARCHIVE );
+		EngFuncs::CvarRegister( "ui_steam_micboost", "0", FCVAR_ARCHIVE );
+	}
+	s_options->Show();
+}
