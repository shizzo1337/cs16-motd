+void CSteamOptionsDialog::UpdatePreviews()
+{
+	if( m_logoImage && m_logo )
+	{
+		char path[256];
+		snprintf( path, sizeof( path ), "logos/%s.bmp", m_logo->SelectedText());
+		m_logoImage->image = m_logo->SelectedText()[0] ? EngFuncs::PIC_Load( path ) : 0;
+		if( m_logoColor )
+			ParseRGB( m_logoColor->SelectedData(), m_logoImage->r, m_logoImage->g, m_logoImage->b );
+	}
+
+	if( m_xhairImage )
+	{
+		if( m_xhairColor )
+			ParseRGB( m_xhairColor->SelectedData(), m_xhairImage->r, m_xhairImage->g, m_xhairImage->b );
+		if( m_xhairSize )
+			m_xhairImage->crosshairSize = m_xhairSize->SelectedData()[0] ? m_xhairSize->SelectedData() : "auto";
+		if( m_xhairTranslucent )
+			m_xhairImage->translucent = m_xhairTranslucent->checked;
+	}
+}
