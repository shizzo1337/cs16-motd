+
+	if( m_xhairImage )
+	{
+		m_xhairImage->kind = CSteamPreview::CROSSHAIR;
+		if( EngFuncs::FileExists( "gfx/vgui/crosshair.tga" ))
+			m_xhairImage->image = EngFuncs::PIC_Load( "gfx/vgui/crosshair.tga", PIC_NOFLIP_TGA );
+	}
+
+	if( m_logo )
+	{
+		int numFiles = 0;
+		char **files = EngFuncs::GetFilesList( "logos/*.bmp", &numFiles, false );
+		for( int i = 0; files && i < numFiles; i++ )
+		{
+			char base[128];
+			COM_FileBase( files[i], base, sizeof( base ));
+			if( !stricmp( base, "remapped" ))
+				continue;
+			m_logo->AddItem( base, base );
+		}
+		m_logo->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_logoColor )
+	{
+		for( const NamedColor &c : g_logoColors )
+			m_logoColor->AddItem( L( c.name ), c.rgb );
+		m_logoColor->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_xhairSize )
+	{
+		for( const NamedColor &c : g_crosshairSizes )
+			m_xhairSize->AddItem( L( c.name ), c.rgb );
+		m_xhairSize->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_xhairColor )
+	{
+		for( const NamedColor &c : g_crosshairColors )
+			m_xhairColor->AddItem( L( c.name ), c.rgb );
+		m_xhairColor->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+	}
+	if( m_xhairTranslucent )
+		m_xhairTranslucent->onChanged = VoidCb( &CSteamOptionsDialog::UpdatePreviews );
+
+	if( CSteamButton *adv = Get<CSteamButton>( "Advanced", K_BUTTON ))
