+
+// Measured on screenshots of the Steam version at 1920x1080 (a window of 960 x 569):
+//   the tabs from (8, 48) (the chosen one from 46), at least 72 pixels wide; the page under them a raised border from
+//   (8, 72) to (wide - 9, tall - 34); the status line under it from (11, tall - 28)
+//   the list of the servers: from the page (0, 8), a header of 18 pixels (raised cells, "DefaultSmall"), rows of 14
+//   pixels in "DefaultSmall"; the columns: the lock 16, the shield 16, Players 55, Servers (the rest), Game 112,
+//   Map 90, Latency 56, the scroll bar 17
+// The places of the list, the buttons and the filters come from platform/servers/InternetGamesPage.res and
+// InternetGamesPage_Filters.res of the Steam version (copied into resource/ of the game or found in servers/), with the
+// same numbers built in when the game has no such files. "AutoResize" and "PinCorner" of the files make the controls
+// follow the window when it is made bigger or smaller by its edges, as in the Steam version.
+//
+// The servers come from the engine (UI_AddServerToList), as for the server browser of mainui: the Internet and the
+// Spectate tabs ask the master servers ("internetservers"), Lan the local network ("localservers"), Favorites and
+// History ask every server of their lists ("ui_queryserver"). The lists are the files of mainui: favorite_servers.lst and
+// history_servers.lst. There is no Friends tab: it needs Steam.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "SteamUI.h"
+#include "SteamGameMenu.h"
+#include "net_api.h"
+
+using namespace SteamUI;
+
+namespace {
+
+enum ETab { TAB_INTERNET = 0, TAB_FAVORITES, TAB_HISTORY, TAB_SPECTATE, TAB_LAN, TAB_COUNT };
+
+// a translation of the server browser, or the English text of the Steam version when the game has no
+// resource/serverbrowser_<language>.txt
+const char *SB( const char *key, const char *english )
+{
+	const char *t = L( key );
+	return t != key && strcmp( t, key ) ? t : english;
+}
+
+struct SteamServer
+{
+	netadr_t adr;
+	char name[128];
+	char map[64];
+	char game[64];
+	int numcl = 0, maxcl = 0;
+	bool password = false;
+	bool secure = false;  // the anti-cheat (from the engine of cs16-client: "secure" of the answer)
+	bool secureKnown = false;
+	bool goldsrc = false;
+	bool pending = true; // no answer yet (a server of the favorites or the history)
+	float ping = 0.0f;   // seconds
+	double queried = 0.0; // when it was asked (0: with the list of its tab)
+
+	const char *Protocol() const { return goldsrc ? "gs" : "49"; }
+};
+
+struct ListEntry
+{
+	char adr[128];
+	char prot[16];
+};
+
+void ReadList( const char *file, CUtlVector<ListEntry> &list )
+{
+	list.RemoveAll();
+	char *afile = (char *)EngFuncs::COM_LoadFile( file );
+	if( !afile )
+		return;
+
+	char *p = afile;
+	while( true )
+	{
+		ListEntry e;
+		p = EngFuncs::COM_ParseFile( p, e.adr, sizeof( e.adr ));
+		if( !p )
+			break;
+		p = EngFuncs::COM_ParseFile( p, e.prot, sizeof( e.prot ));
+		if( !p )
+			break;
+		if( !strcmp( e.prot, "48" ))
+			continue; // the old protocol, as mainui
+		list.AddToTail( e );
+	}
+	EngFuncs::COM_FreeFile( afile );
+}
+
+void WriteList( const char *file, const CUtlVector<ListEntry> &list )
+{
+	if( !list.Count( ))
+	{
+		EngFuncs::DeleteFile( file );
+		return;
+	}
+
+	CUtlString s;
+	for( int i = 0; i < list.Count(); i++ )
+		s.AppendFormat( "%s %s\n", list[i].adr, list[i].prot );
+	EngFuncs::COM_SaveFile( file, s.Get(), s.Length());
+}
+
+int FindInList( const CUtlVector<ListEntry> &list, const char *adr )
+{
+	for( int i = 0; i < list.Count(); i++ )
+		if( !strcmp( list[i].adr, adr ))
+			return i;
+	return -1;
+}
+
+// a lock, as the icon of the password column (7 x 9)
+void DrawLock( int x, int y, unsigned int c )
+{
+	Fill( x + 1, y, 5, 1, c );
+	Fill( x + 1, y, 1, 4, c );
+	Fill( x + 5, y, 1, 4, c );
+	Fill( x, y + 4, 7, 5, c );
+}
+
+// a shield, as the icon of the anti-cheat column (7 x 8)
+void DrawShield( int x, int y, unsigned int c )
+{
+	Fill( x, y, 7, 4, c );
+	Fill( x + 1, y + 4, 5, 2, c );
+	Fill( x + 2, y + 6, 3, 1, c );
+	Fill( x + 3, y + 7, 1, 1, c );
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// The list of the servers of a tab: a header of columns that sort it, rows of servers
+class CSteamServerList : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	enum EColumn { COL_PASSWORD = 0, COL_SECURE, COL_PLAYERS, COL_NAME, COL_GAME, COL_MAP, COL_PING, COL_COUNT };
+
+	bool KeyDown( int key ) override;
+	bool KeyUp( int key ) override;
+	void Draw() override;
+
+	void LoadWidths(); // the widths of the columns the player gave them the last time
+	void SetServers( CUtlVector<SteamServer> *servers ) { m_servers = servers; Resort(); }
+	void Resort();
+	int Selected() const { return m_iSelected >= 0 && m_servers && m_iSelected < m_order.Count() ? m_order[m_iSelected] : -1; }
+	void ClearSelection() { m_iSelected = -1; }
+	int Count() const { return m_order.Count(); }
+
+	CEventCallback onActivate;   // a double click or Enter
+	CEventCallback onContext;    // a right click on a server
+	const char *emptyText = "";  // shown when there are no servers
+
+private:
+	void ColumnRect( int col, int &x, int &w ) const;
+	int RowsTop() const { return m_scPos.y + 19; }
+	int VisibleRows() const { return ( m_scSize.h - 21 ) / 14; }
+	void ClampTop();
+	bool Passes( int i ) const;
+
+	CUtlVector<SteamServer> *m_servers = nullptr;
+	CUtlVector<int> m_order;
+	int m_iSortColumn = COL_PING;
+	bool m_bAscend = true;
+	int m_iSelected = -1;
+	int m_iTop = 0;
+	int m_iLastClick = 0, m_iLastClickRow = -1;
+	SteamUI::ScrollBar m_sb;
+	void PlaceScrollBar()
+	{
+		m_sb.x = m_scPos.x + m_scSize.w - 18;
+		m_sb.y = m_scPos.y + 1;
+		m_sb.w = 17;
+		m_sb.h = m_scSize.h - 2;
+		m_sb.total = m_order.Count();
+		m_sb.visible = VisibleRows();
+		m_sb.top = m_iTop;
+	}
+
+	// the widths of the columns; Servers takes the rest. A column is made wider or narrower by the line at its edge
+	// in the header, as in the Steam version: the columns left of Servers by their right edge, the columns right of it
+	// by their left edge (Servers gives or takes the pixels)
+	int m_width[COL_COUNT] = { 16, 16, 55, 0, 112, 90, 56 };
+	int m_iDragEdge = -1;     // the column whose edge is moved
+	int m_iDragStartX = 0, m_iDragStartW = 0;
+	int EdgeAt( int x ) const; // the column whose edge is at x in the header, or -1
+	void SaveWidths();
+
+public:
+	// the filters of the page
+	int maxPing = 0;           // 0: any
+	char mapFilter[64] = "";
+	bool notFull = false, notEmpty = false, noPassword = false;
+};
+
+void CSteamServerList::ColumnRect( int col, int &x, int &w ) const
+{
+	const int inner = m_scSize.w - 2 - 17; // the scroll bar
+	int nameW = inner;
+	for( int i = 0; i < COL_COUNT; i++ )
+		if( i != COL_NAME )
+			nameW -= m_width[i];
+	if( nameW < 40 )
+		nameW = 40;
+
+	x = m_scPos.x + 1;
+	for( int i = 0; i < col; i++ )
+		x += i == COL_NAME ? nameW : m_width[i];
+	w = col == COL_NAME ? nameW : m_width[col];
+}
+
+int CSteamServerList::EdgeAt( int cx ) const
+{
+	// the lines between the columns: the right edge of every column but the last one
+	for( int col = 0; col < COL_COUNT - 1; col++ )
+	{
+		int x, w;
+		ColumnRect( col, x, w );
+		const int edge = x + w;
+		if( cx >= edge - 3 && cx <= edge + 2 )
+			return col;
+	}
+	return -1;
+}
+
+void CSteamServerList::LoadWidths()
+{
+	int w[COL_COUNT];
+	if( sscanf( EngFuncs::GetCvarString( "ui_steam_serverbrowser_columns" ), "%d %d %d %d %d %d %d",
+		&w[0], &w[1], &w[2], &w[3], &w[4], &w[5], &w[6] ) != COL_COUNT )
+		return;
+	for( int i = 0; i < COL_COUNT; i++ )
+		if( w[i] >= 10 && w[i] < 2000 )
+			m_width[i] = w[i];
+}
+
+void CSteamServerList::SaveWidths()
+{
+	char buf[96];
+	snprintf( buf, sizeof( buf ), "%d %d %d %d %d %d %d", m_width[0], m_width[1], m_width[2], 0, m_width[4], m_width[5], m_width[6] );
+	EngFuncs::CvarSetString( "ui_steam_serverbrowser_columns", buf );
+}
+
+bool CSteamServerList::KeyUp( int key )
+{
+	if( UI::Key::IsLeftMouse( key ) && m_iDragEdge >= 0 )
+	{
+		m_iDragEdge = -1;
+		SaveWidths();
+		return true;
+	}
+	return BaseClass::KeyUp( key );
+}
+
+bool CSteamServerList::Passes( int i ) const
+{
+	const SteamServer &s = ( *m_servers )[i];
+	if( s.pending )
+		return true;
+	if( maxPing > 0 && s.ping * 1000.0f > maxPing )
+		return false;
+	if( notFull && s.maxcl > 0 && s.numcl >= s.maxcl )
+		return false;
+	if( notEmpty && s.numcl <= 0 )
+		return false;
+	if( noPassword && s.password )
+		return false;
+	if( mapFilter[0] && !strstr( s.map, mapFilter ))
+		return false;
+	return true;
+}
+
+void CSteamServerList::Resort()
+{
+	// keep the chosen server chosen
+	const int sel = Selected();
+
+	m_order.RemoveAll();
+	if( !m_servers )
+		return;
+
+	for( int i = 0; i < m_servers->Count(); i++ )
+		if( Passes( i ))
+			m_order.AddToTail( i );
+
+	const CUtlVector<SteamServer> &sv = *m_servers;
+	const int col = m_iSortColumn;
+	const bool asc = m_bAscend;
+
+	// a stable insertion sort: the lists are short (a few thousand at most)
+	for( int i = 1; i < m_order.Count(); i++ )
+	{
+		const int v = m_order[i];
+		int j = i - 1;
+		while( j >= 0 )
+		{
+			const SteamServer &a = sv[m_order[j]], &b = sv[v];
+			int c = 0;
+			switch( col )
+			{
+			case COL_PASSWORD: c = (int)a.password - (int)b.password; break;
+			case COL_PLAYERS: c = a.numcl - b.numcl; break;
+			case COL_NAME: c = stricmp( a.name, b.name ); break;
+			case COL_GAME: c = stricmp( a.game, b.game ); break;
+			case COL_MAP: c = stricmp( a.map, b.map ); break;
+			default: c = a.ping < b.ping ? -1 : a.ping > b.ping ? 1 : 0; break;
+			}
+			if( !asc )
+				c = -c;
+			if( c <= 0 )
+				break;
+			m_order[j + 1] = m_order[j];
+			j--;
+		}
+		m_order[j + 1] = v;
+	}
+
+	m_iSelected = -1;
+	for( int i = 0; i < m_order.Count(); i++ )
+		if( m_order[i] == sel ) { m_iSelected = i; break; }
+	ClampTop();
+}
+
+void CSteamServerList::ClampTop()
+{
+	const int maxTop = m_order.Count() - VisibleRows();
+	if( m_iTop > maxTop ) m_iTop = maxTop;
+	if( m_iTop < 0 ) m_iTop = 0;
+}
+
+bool CSteamServerList::KeyDown( int key )
+{
+	if( key == K_MWHEELUP || key == K_MWHEELDOWN )
+	{
+		m_iTop += key == K_MWHEELUP ? -3 : 3;
+		ClampTop();
+		return true;
+	}
+
+	if( UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+	{
+		m_iSelected += UI::Key::IsUpArrow( key ) ? -1 : 1;
+		if( m_iSelected < 0 ) m_iSelected = 0;
+		if( m_iSelected >= m_order.Count( )) m_iSelected = m_order.Count() - 1;
+		if( m_iSelected < m_iTop ) m_iTop = m_iSelected;
+		if( m_iSelected >= m_iTop + VisibleRows( )) m_iTop = m_iSelected - VisibleRows() + 1;
+		ClampTop();
+		return true;
+	}
+
+	if( UI::Key::IsEnter( key ))
+	{
+		if( Selected() >= 0 && onActivate )
+			onActivate( this );
+		return true;
+	}
+
+	const bool left = UI::Key::IsLeftMouse( key ), right = key == K_MOUSE2;
+	if(( left || right ) && Hovered( ))
+	{
+		const int cx = uiStatic.cursorX, cy = uiStatic.cursorY;
+		const int sbX = m_scPos.x + m_scSize.w - 18;
+
+		if( cx >= sbX )
+		{
+			// the scroll bar: its buttons, its slider (held by the mouse), a page up / down
+			if( left )
+			{
+				PlaceScrollBar();
+				m_sb.Press( cx, cy );
+				m_iTop = m_sb.top;
+			}
+			return true;
+		}
+
+		// the header: the line between two columns changes their width, a click on a column sorts by it
+		// (again: the other way)
+		if( cy < RowsTop( ))
+		{
+			if( !left )
+				return true;
+
+			const int edge = EdgeAt( cx );
+			if( edge >= 0 )
+			{
+				// left of Servers: the column itself; right of it: the next column
+				const int col = edge < COL_NAME ? edge : edge + 1;
+				m_iDragEdge = edge;
+				m_iDragStartX = cx;
+				m_iDragStartW = m_width[col];
+				return true;
+			}
+
+			for( int col = 0; col < COL_COUNT; col++ )
+			{
+				int x, w;
+				ColumnRect( col, x, w );
+				if( cx >= x && cx < x + w )
+				{
+					if( m_iSortColumn == col )
+						m_bAscend = !m_bAscend;
+					else
+					{
+						m_iSortColumn = col;
+						m_bAscend = col != COL_PLAYERS; // the most players first, as in the Steam version
+					}
+					Resort();
+					break;
+				}
+			}
+			return true;
+		}
+
+		const int row = m_iTop + ( cy - RowsTop( )) / 14;
+		if( row >= 0 && row < m_order.Count( ))
+		{
+			const bool dbl = left && row == m_iLastClickRow && uiStatic.realTime - m_iLastClick < 400;
+			m_iSelected = row;
+			m_iLastClickRow = row;
+			m_iLastClick = uiStatic.realTime;
+
+			if( right && onContext )
+				onContext( this );
+			else if( dbl && onActivate )
+				onActivate( this );
+		}
+		return true;
+	}
+
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamServerList::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+	const EFont font = FONT_DEFAULT_SMALL;
+
+	// the arrows over the line between two columns in the header, and while it is dragged
+	if( m_iDragEdge >= 0 )
+		WantCursor( this, dc_sizewe, true );
+	else if( UI_CursorInRect( m_scPos, m_scSize ) && uiStatic.cursorY < RowsTop() && EdgeAt( uiStatic.cursorX ) >= 0 )
+		WantCursor( this, dc_sizewe );
+
+	// the slider held by the mouse moves the rows
+	PlaceScrollBar();
+	m_sb.Clamp(); // a window made bigger shows more rows: the first one may have to go up
+	m_sb.Think();
+	m_iTop = m_sb.top;
+
+	// a column being made wider or narrower (the button released outside the list ends it too)
+	if( m_iDragEdge >= 0 && !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+	{
+		m_iDragEdge = -1;
+		SaveWidths();
+	}
+	if( m_iDragEdge >= 0 )
+	{
+		const int dx = uiStatic.cursorX - m_iDragStartX;
+		const int col = m_iDragEdge < COL_NAME ? m_iDragEdge : m_iDragEdge + 1;
+		int nw = m_iDragEdge < COL_NAME ? m_iDragStartW + dx : m_iDragStartW - dx;
+		const int minW = col <= COL_SECURE ? 12 : 24;
+		if( nw < minW )
+			nw = minW;
+
+		// Servers keeps at least 40 pixels
+		int others = 0;
+		for( int i = 0; i < COL_COUNT; i++ )
+			if( i != COL_NAME && i != col )
+				others += m_width[i];
+		const int maxW = w - 2 - 17 - others - 40;
+		if( nw > maxW )
+			nw = maxW;
+		if( nw >= minW )
+			m_width[col] = nw;
+	}
+
+	Fill( x, y, w, h, ListBG );
+	InsetBorder( x, y, w, h );
+
+	// the header
+	for( int col = 0; col < COL_COUNT; col++ )
+	{
+		int cx, cw;
+		ColumnRect( col, cx, cw );
+		Fill( cx, y + 1, cw, 18, ControlBG );
+		RaisedBorder( cx, y + 1, cw, 18 );
+
+		char title[96] = "";
+		switch( col )
+		{
+		case COL_PASSWORD: DrawLock( cx + 4, y + 5, ControlText ); break;
+		case COL_SECURE: DrawShield( cx + 4, y + 6, ControlText ); break;
+		case COL_PLAYERS: Q_strncpy( title, SB( "ServerBrowser_Players", "Players" ), sizeof( title )); break;
+		case COL_NAME:
+		{
+			char count[16];
+			snprintf( count, sizeof( count ), "%d", m_order.Count());
+			const char *fmt = SB( "ServerBrowser_ServersCount", "Servers (%s1)" );
+			const char *p = strstr( fmt, "%s1" );
+			if( p )
+				snprintf( title, sizeof( title ), "%.*s%s%s", (int)( p - fmt ), fmt, count, p + 3 );
+			else
+				Q_strncpy( title, fmt, sizeof( title ));
+			break;
+		}
+		case COL_GAME: Q_strncpy( title, SB( "ServerBrowser_Game", "Game" ), sizeof( title )); break;
+		case COL_MAP: Q_strncpy( title, SB( "ServerBrowser_Map", "Map" ), sizeof( title )); break;
+		case COL_PING: Q_strncpy( title, SB( "ServerBrowser_Latency", "Latency" ), sizeof( title )); break;
+		}
+		if( title[0] )
+			TextInBox( font, cx + 4, y + 1, cw - 6, 18, title, ControlText );
+	}
+
+	// the rows
+	const int visible = VisibleRows();
+	for( int i = 0; i < visible && m_iTop + i < m_order.Count(); i++ )
+	{
+		const int idx = m_order[m_iTop + i];
+		const SteamServer &s = ( *m_servers )[idx];
+		const int ry = RowsTop() + i * 14;
+		const bool sel = m_iTop + i == m_iSelected;
+
+		if( sel )
+		{
+			int nx, nw;
+			ColumnRect( COL_COUNT - 1, nx, nw );
+			Fill( x + 1, ry, nx + nw - x - 1, 14, SelectionBG );
+		}
+
+		const unsigned int c = sel ? BrightBaseText : ControlText;
+		int cx, cw;
+		char buf[64];
+
+		if( s.password )
+		{
+			ColumnRect( COL_PASSWORD, cx, cw );
+			DrawLock( cx + 4, ry + 3, c );
+		}
+
+		if( s.secure )
+		{
+			ColumnRect( COL_SECURE, cx, cw );
+			DrawShield( cx + 4, ry + 3, c );
+		}
+
+		ColumnRect( COL_PLAYERS, cx, cw );
+		if( !s.pending )
+		{
+			snprintf( buf, sizeof( buf ), "%d / %d", s.numcl, s.maxcl );
+			TextInBox( font, cx + 6, ry, cw - 8, 14, buf, c );
+		}
+
+		ColumnRect( COL_NAME, cx, cw );
+		TextInBox( font, cx + 4, ry, cw - 6, 14, s.name, c );
+
+		ColumnRect( COL_GAME, cx, cw );
+		TextInBox( font, cx + 4, ry, cw - 6, 14, s.game, c );
+
+		ColumnRect( COL_MAP, cx, cw );
+		TextInBox( font, cx + 4, ry, cw - 6, 14, s.map, c );
+
+		ColumnRect( COL_PING, cx, cw );
+		if( !s.pending )
+		{
+			snprintf( buf, sizeof( buf ), "%d", (int)( s.ping * 1000.0f + 0.5f ));
+			TextInBox( font, cx + 6, ry, cw - 8, 14, buf, c );
+		}
+	}
+
+	if( !m_order.Count() && emptyText && emptyText[0] )
+		WrappedText( font, x + 8, RowsTop() + 4, w - 40, h - 24, emptyText, DimBaseText );
+
+	// the scroll bar
+	PlaceScrollBar();
+	m_sb.Draw();
+}
