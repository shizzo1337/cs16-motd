+
+// the next letter of a UTF-8 text, never past its end
+static int NextChar( const char *text, int pos, int len )
+{
+	const int next = Con_UtfMoveRight( text, pos, len );
+	return next > len ? len : next;
+}
+
+const char *CSteamTextEntry::Shown( char *out, size_t len ) const
+{
+	const char *buf = const_cast<CSteamTextEntry *>( this )->GetBuffer();
+	if( !bHideInput )
+		return buf;
+
+	// a "*" for each letter (not for each byte of a Russian one)
+	size_t n = 0;
+	for( const char *p = buf; *p && n + 1 < len; p++ )
+		if(( *p & 0xC0 ) != 0x80 )
+			out[n++] = '*';
+	out[n] = 0;
+	return out;
+}
+
+int CSteamTextEntry::ShownPos( int pos ) const
+{
+	if( !bHideInput )
+		return pos;
+	const char *buf = const_cast<CSteamTextEntry *>( this )->GetBuffer();
+	int n = 0;
+	for( int i = 0; i < pos && buf[i]; i++ )
+		if(( buf[i] & 0xC0 ) != 0x80 )
+			n++;
+	return n;
+}
+
+// the width of the bytes [from, to) of a text
+static int SpanWidth( const char *text, int from, int to )
+{
+	char part[UI_MAX_FIELD_LINE];
+	int n = to - from;
+	if( n <= 0 )
+		return 0;
+	if( n >= (int)sizeof( part ))
+		n = sizeof( part ) - 1;
+	memcpy( part, text + from, n );
+	part[n] = 0;
+	return TextWidth( FONT_DEFAULT, part );
+}
+
+bool CSteamTextEntry::KeyDown( int key )
+{
+	// a click puts the cursor between the letters under the mouse, as the text is drawn here (CMenuField counts
+	// with its own place of the text)
+	if( UI::Key::IsLeftMouse( key ) && UI_CursorInRect( m_scPos, m_scSize ))
+	{
+		char tmp[UI_MAX_FIELD_LINE];
+		const char *t = Shown( tmp, sizeof( tmp ));
+		const char *buf = GetBuffer();
+		const int len = (int)strlen( t );
+		const int first = ShownPos( m_iFirst );
+		const int cx = uiStatic.cursorX - ( m_scPos.x + 4 );
+
+		int best = first, bestDist = 1 << 30;
+		for( int i = first; i <= len; i = i < len ? NextChar( t, i, len ) : len + 1 )
+		{
+			const int d = abs( SpanWidth( t, first, i ) - cx );
+			if( d < bestDist )
+			{
+				bestDist = d;
+				best = i;
+			}
+			if( i == len )
+				break;
+		}
+
+		// back to the bytes of the buffer
+		int pos = best;
+		if( bHideInput )
+		{
+			pos = 0;
+			for( int n = 0; buf[pos] && n < best; n++ )
+				pos = NextChar( buf, pos, (int)strlen( buf ));
+		}
+		SetCursorPos( pos );
+		return true;
+	}
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamTextEntry::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+
+	Fill( x, y, w, h, WindowBG );
+	InsetBorder( x, y, w, h );
+
+	char tmp[UI_MAX_FIELD_LINE];
+	const char *t = Shown( tmp, sizeof( tmp ));
+	const int len = (int)strlen( t );
+	const int inner = w - 8;
+	const int cursor = ShownPos( GetCursorPos( ));
+
+	// the part shown: from m_iFirst, moved so that the cursor is in the field (in the shown text)
+	int first = ShownPos( m_iFirst );
+	if( first > len ) first = len;
+	if( cursor < first ) first = cursor;
+	while( first < cursor && SpanWidth( t, first, cursor ) > inner )
+		first = NextChar( t, first, len );
+	// no empty room on the right while there is text on the left
+	while( first > 0 && SpanWidth( t, Con_UtfMoveLeft( t, first ), len ) <= inner )
+		first = Con_UtfMoveLeft( t, first );
+
+	// keep it in the bytes of the buffer
+	if( bHideInput )
+	{
+		const char *buf = GetBuffer();
+		int pos = 0;
+		for( int n = 0; buf[pos] && n < first; n++ )
+			pos = NextChar( buf, pos, (int)strlen( buf ));
+		m_iFirst = pos;
+	}
+	else m_iFirst = first;
+
+	// the letters that fit
+	int last = first;
+	while( last < len && SpanWidth( t, first, NextChar( t, last, len )) <= inner )
+		last = NextChar( t, last, len );
+	char part[UI_MAX_FIELD_LINE];
+	const int n = last - first;
+	memcpy( part, t + first, n );
+	part[n] = 0;
+
+	TextInBox( FONT_DEFAULT, x + 4, y, inner, h, part, ( iFlags & QMF_GRAYED ) ? DisabledText1 : ControlText );
+
+	// the cursor while the entry has the keyboard, where the next letter goes
+	if(( iFlags & ( QMF_HASKEYBOARDFOCUS | QMF_HASMOUSEFOCUS )) && (( uiStatic.realTime / 500 ) & 1 ) == 0 )
+	{
+		const int cx = x + 4 + SpanWidth( t, first, cursor );
+		const int tall = FontTall( FONT_DEFAULT );
+		Fill( cx, y + ( h - tall ) / 2 + 1, 1, tall - 2, BaseText );
+	}
+}
