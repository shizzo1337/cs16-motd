+void CSteamSlider::SetFromCursor()
+{
+	const int trackW = m_scSize.w - 8;
+	const int usable = trackW - 8;
+	float frac = usable > 0 ? (float)( uiStatic.cursorX - ( m_scPos.x + 4 )) / usable : 0.0f;
+	if( frac < 0.0f ) frac = 0.0f;
+	if( frac > 1.0f ) frac = 1.0f;
+
+	const float v = minValue + frac * ( maxValue - minValue );
+	if( v != value )
+	{
+		value = v;
+		if( onChanged )
+			onChanged( this );
+	}
+}
+
+bool CSteamSlider::KeyDown( int key )
+{
+	if( UI::Key::IsLeftMouse( key ) && Hovered( ))
+	{
+		m_bDragging = true;
+		SetFromCursor();
+		return true;
+	}
+
+	const float step = ( maxValue - minValue ) / 20.0f;
+	if( UI::Key::IsLeftArrow( key ) || UI::Key::IsRightArrow( key ))
+	{
+		value += UI::Key::IsLeftArrow( key ) ? -step : step;
+		if( value < minValue ) value = minValue;
+		if( value > maxValue ) value = maxValue;
+		if( onChanged )
+			onChanged( this );
+		return true;
+	}
+
+	return BaseClass::KeyDown( key );
+}
+
+bool CSteamSlider::KeyUp( int key )
+{
+	if( UI::Key::IsLeftMouse( key ) && m_bDragging )
+	{
+		m_bDragging = false;
+		return true;
+	}
+	return BaseClass::KeyUp( key );
+}
+
+void CSteamSlider::Draw()
+{
+	if( m_bDragging && !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+		m_bDragging = false; // released outside the slider
+	if( m_bDragging )
+		SetFromCursor();
+
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w;
+	const int trackW = w - 8;
+
+	// the track
+	Fill( x, y + 8, trackW, 3, SliderTrackColor );
+	Fill( x, y + 11, trackW, 1, BorderBright );
+
+	// the ticks: 11, from the left end of the track to the right one
+	for( int i = 0; i <= 10; i++ )
+	{
+		const int tx = x + 3 + ( trackW - 6 ) * i / 10;
+		Fill( tx, y + 23, 1, 4, SliderTickColor );
+	}
+
+	// the nob
+	float frac = maxValue != minValue ? ( value - minValue ) / ( maxValue - minValue ) : 0.0f;
+	if( frac < 0.0f ) frac = 0.0f;
+	if( frac > 1.0f ) frac = 1.0f;
+	const int cx = x + 4 + (int)( frac * ( trackW - 8 ) + 0.5f );
+	Fill( cx - 4, y + 2, 8, 16, ControlBG );
+	RaisedBorder( cx - 4, y + 2, 8, 16 );
+
+	// the texts at the ends
+	const int ty = y + 27;
+	if( leftText[0] )
+		Text( FONT_DEFAULT_VERYSMALL, x, ty, Localize( leftText ), DimBaseText, w );
+	if( rightText[0] )
+	{
+		const char *r = Localize( rightText );
+		Text( FONT_DEFAULT_VERYSMALL, x + trackW - TextWidth( FONT_DEFAULT_VERYSMALL, r ), ty, r, DimBaseText, w );
+	}
+}
