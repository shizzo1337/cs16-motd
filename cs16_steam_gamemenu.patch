+CSteamTextEntry::CSteamTextEntry() : BaseClass()
+{
+	iFlags |= QMF_DISABLESCAILING;
+	bDrawStroke = false;
+}
+
+void CSteamTextEntry::SetBounds( int x, int y, int w, int h )
+{
+	pos = Point( x, y );
+	size = Size( w, h );
+}
+
+void CSteamTextEntry::VidInit()
+{
+	font = Font( FONT_DEFAULT );
+	charSize = FontTall( FONT_DEFAULT );
+	BaseClass::VidInit();
+}
+
+void CSteamTextEntry::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+
+	Fill( x, y, w, h, WindowBG );
+	InsetBorder( x, y, w, h );
+
+	char shown[UI_MAX_FIELD_LINE];
+	const char *buf = const_cast<CSteamTextEntry *>( this )->GetBuffer();
+	if( bHideInput )
+	{
+		size_t n = strlen( buf );
+		if( n >= sizeof( shown ))
+			n = sizeof( shown ) - 1;
+		memset( shown, '*', n );
+		shown[n] = 0;
+		buf = shown;
+	}
+
+	// the end of a long text stays visible
+	const int inner = w - 8;
+	while( *buf && TextWidth( FONT_DEFAULT, buf ) > inner )
+		buf++;
+
+	TextInBox( FONT_DEFAULT, x + 4, y, inner, h, buf, ( iFlags & QMF_GRAYED ) ? DisabledText1 : ControlText );
+
+	// the cursor while the entry has the keyboard
+	if(( iFlags & ( QMF_HASKEYBOARDFOCUS | QMF_HASMOUSEFOCUS )) && (( uiStatic.realTime / 500 ) & 1 ) == 0 )
+	{
+		const int cx = x + 4 + TextWidth( FONT_DEFAULT, buf );
+		const int tall = FontTall( FONT_DEFAULT );
+		Fill( cx, y + ( h - tall ) / 2 + 1, 1, tall - 2, BaseText );
+	}
+}
