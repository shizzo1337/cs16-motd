+
+// Measured on a screenshot of the Steam version at 1920x1080: the window 348 x 460, the tabs Server and Game, the
+// buttons Start and Cancel (72 x 24, 13 pixels from the right edge, 9 from the bottom, 8 between them).
+// The Server page is resource/CreateMultiplayerGameServerPage.res of the game (CS: the label Map at (28, 28) 38 x 24,
+// the list of the maps at (66, 28) 174 x 24 with "< Random Map >" first, a divider at (28, 70) 280 x 2; the bots
+// controls are hidden in it). The Game page is a list of the server settings of settings.scr of the game (as
+// CreateMultiplayerGameGameplayPage.res: a list at (10, 10) 320 x 325): rows of 28 pixels, a prompt on the left half
+// and its control on the right (a text entry for STRING and NUMBER, a combo box for LIST), a check button across the
+// row for BOOL, as GameUI does it.
+//
+// The rows show the values of settings.scr; Start writes the settings into settings.scr and their cvars, then starts the listen server as the Create Game menu
+// of mainui does it.
+
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "BaseMenu.h"
+#include "keydefs.h"
+#include "CFGScript.h"
+#include "SteamUI.h"
+#include "SteamGameMenu.h"
+#include "Scissor.h"
+
+using namespace SteamUI;
+
+namespace
+{
+
+// "Divider" of VGUI2: a dark line over a bright one
+class CSteamDivider : public CSteamControl
+{
+public:
+	void Draw() override
+	{
+		Fill( m_scPos.x, m_scPos.y, m_scSize.w, 1, BorderDark );
+		Fill( m_scPos.x, m_scPos.y + 1, m_scSize.w, 1, BorderBright );
+	}
+};
+
+// the text of a key of a dictionary, or the English text when the game has no such string
+const char *Text( const char *key, const char *english )
+{
+	const char *s = Localize( key );
+	return ( !s[0] || !strcmp( s, key ) || ( key[0] == '#' && !strcmp( s, key + 1 ))) ? english : s;
+}
+
+} // namespace
+
+// The list of the Game page (CPanelListPanel of GameUI): an inset border, the rows 10 pixels in from its left edge and
+// 8 from the scroll bar, scrolled by pixels. The slider of the scroll bar is as big as the part of the rows the list
+// shows (GameUI makes it small whatever the rows). The rows are the controls of the window: those out
+// of the list are hidden, those partly in it are clipped by a scissor from the list (CSteamOptionRowsEnd ends it)
+class CSteamOptionRows : public CSteamControl
+{
+public:
+	typedef CSteamControl BaseClass;
+
+	static const int ROW_TALL = 28;
+	static const int INSET = 4;   // above and under the control of a row
+	static const int LEFT = 10;   // the rows from the left edge of the list
+	static const int RIGHT = 8;   // and from the scroll bar
+	static const int SB_WIDE = 17;
+
+	struct Row
+	{
+		CMenuBaseItem *prompt; // NULL for a check button
+		CMenuBaseItem *control;
+	};
+	CUtlVector<Row> rows;
+	bool shown = false; // its page is the active one
+	bool clipping = false; // the scissor of the list is on
+
+	bool KeyDown( int key ) override
+	{
+		const bool inside = UI_CursorInRect( m_scPos, m_scSize );
+		if(( key == K_MWHEELUP || key == K_MWHEELDOWN ) && inside )
+		{
+			m_iTop += key == K_MWHEELUP ? -ROW_TALL : ROW_TALL;
+			Layout();
+			return true;
+		}
+		if( UI::Key::IsLeftMouse( key ) && inside )
+		{
+			PlaceScrollBar();
+			if( m_sb.Press( uiStatic.cursorX, uiStatic.cursorY ))
+			{
+				m_iTop = m_sb.top;
+				Layout();
+				return true;
+			}
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void Draw() override
+	{
+		PlaceScrollBar();
+		m_sb.Clamp();
+		m_sb.Think();
+		if( m_sb.top != m_iTop )
+		{
+			m_iTop = m_sb.top;
+			Layout();
+		}
+
+		InsetBorder( m_scPos.x, m_scPos.y, m_scSize.w, m_scSize.h );
+		PlaceScrollBar();
+		m_sb.Draw();
+
+	}
+
+	// the rows are clipped by the list: from CSteamOptionRowsClip before them to the one after them
+	void BeginClip()
+	{
+		if( !shown || !IsVisible( ))
+			return;
+		UI::Scissor::PushScissor( m_scPos.x + 1, m_scPos.y + 1, m_scSize.w - 2 - SB_WIDE, m_scSize.h - 2 );
+		SetFillClip( m_scPos.x + 1, m_scPos.y + 1, m_scSize.w - 2 - SB_WIDE, m_scSize.h - 2 );
+		clipping = true;
+	}
+	void EndClip()
+	{
+		if( clipping )
+		{
+			UI::Scissor::PopScissor();
+			ClearFillClip();
+		}
+		clipping = false;
+	}
+
+	// the rows to their places, those wholly out of the list hidden
+	void Layout()
+	{
+		const int maxTop = MaxTop();
+		if( m_iTop > maxTop ) m_iTop = maxTop;
+		if( m_iTop < 0 ) m_iTop = 0;
+
+		const int rowWide = size.w - LEFT - SB_WIDE - 1 - RIGHT;
+		const int half = rowWide / 2;
+		const int innerTop = pos.y + 1, innerBottom = pos.y + size.h - 1;
+		for( int i = 0; i < rows.Count(); i++ )
+		{
+			const Row &r = rows[i];
+			const int rowY = innerTop + i * ROW_TALL - m_iTop;
+			const int y = rowY + INSET;
+			const bool in = shown && rowY + ROW_TALL > innerTop && rowY < innerBottom;
+			const int x = pos.x + LEFT;
+
+			if( r.prompt )
+			{
+				r.prompt->pos = Point( x + 5, y ); // the text 5 pixels in, as GameUI
+				r.prompt->size = Size( half + 20 - 5, ROW_TALL - INSET * 2 );
+				r.control->pos = Point( x + half + 20, y );
+				r.control->size = Size( rowWide - half - 20, ROW_TALL - INSET * 2 );
+				r.prompt->SetVisibility( in );
+				r.prompt->CalcPosition();
+				r.prompt->CalcSizes();
+			}
+			else
+			{
+				r.control->pos = Point( x, y );
+				r.control->size = Size( rowWide, ROW_TALL - INSET * 2 );
+			}
+			r.control->SetVisibility( in );
+			r.control->CalcPosition();
+			r.control->CalcSizes();
+		}
+	}
+
+private:
+	int Needed() const { return rows.Count() * ROW_TALL; }
+	int MaxTop() const { const int m = Needed() - ( size.h - 2 ); return m > 0 ? m : 0; }
+	void PlaceScrollBar()
+	{
+		m_sb.w = SB_WIDE;
+		m_sb.x = m_scPos.x + m_scSize.w - 1 - m_sb.w;
+		m_sb.y = m_scPos.y + 1;
+		m_sb.h = m_scSize.h - 2;
+		// the slider as big as the part of the rows the list shows
+		m_sb.visible = size.h - 2;
+		m_sb.total = Needed() > m_sb.visible ? Needed() : m_sb.visible;
+		m_sb.step = ROW_TALL;
+		m_sb.top = m_iTop;
+	}
+
+	int m_iTop = 0; // in pixels
+	ScrollBar m_sb;
+};
+
+// before the first row and after the last one: the scissor of the list on and off
+class CSteamOptionRowsClip : public CSteamControl
+{
+public:
+	CSteamOptionRows *list = nullptr;
+	bool begin = false;
+	void Draw() override
+	{
+		if( list )
+			begin ? list->BeginClip() : list->EndClip();
+	}
+};
+
+// A window with a list of the cvars of a script of the game (settings.scr, user.scr), as CInfoDescription and
+// CPanelListPanel of GameUI
+class CSteamScriptFrame : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamScriptFrame( const char *name, int wide, int tall ) : BaseClass( name, wide, tall ) {}
+	~CSteamScriptFrame() override
+	{
+		FreeRows();
+		if( m_pVars )
+			CSCR_FreeList( m_pVars );
+	}
+
+protected:
+	virtual bool RowsShown() const { return true; } // the list is on the active page
+
+	void FreeRows()
+	{
+		m_pOpenList = nullptr; // the list of a combo box of a row may be open
+		for( int i = 0; i < m_owned.Count(); i++ )
+		{
+			RemoveItem( *m_owned[i] );
+			delete m_owned[i];
+		}
+		m_owned.RemoveAll();
+		m_rows.rows.RemoveAll();
+		if( m_bClipItems )
+		{
+			RemoveItem( m_clipBegin );
+			RemoveItem( m_clipEnd );
+			m_bClipItems = false;
+		}
+	}
+
+	// the rows from a script of the game (settings.scr, user.scr) with the values of the file or of their cvars
+	void LoadRows( const char *script, bool cvarValues )
+	{
+		FreeRows();
+		if( m_pVars )
+			CSCR_FreeList( m_pVars );
+		int count = 0;
+		m_pVars = CSCR_LoadDefaultCVars( script, &count );
+
+		m_clipBegin.list = m_clipEnd.list = &m_rows;
+		m_clipBegin.begin = true;
+		m_clipBegin.iFlags |= QMF_INACTIVE;
+		m_clipEnd.iFlags |= QMF_INACTIVE;
+		AddItem( m_clipBegin );
+
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+		{
+			const char *value = var->value;
+			if( cvarValues )
+			{
+				const char *v = EngFuncs::GetCvarString( var->name );
+				if( v && v[0] )
+					value = v;
+			}
+
+			CSteamOptionRows::Row row = { nullptr, nullptr };
+
+			if( var->type == T_BOOL )
+			{
+				CSteamCheckButton *b = new CSteamCheckButton;
+				Q_strncpy( b->text, var->desc, sizeof( b->text ));
+				b->checked = atof( value ) != 0.0f;
+				row.control = b;
+			}
+			else if( var->type == T_LIST )
+			{
+				CSteamComboBox *c = new CSteamComboBox;
+				int sel = 0, i = 0;
+				for( scrvarlistentry_t *e = var->list.pEntries; e; e = e->next, i++ )
+				{
+					char data[32];
+					snprintf( data, sizeof( data ), "%g", e->flValue );
+					c->AddItem( Localize( e->szName ), data );
+					if( e->flValue == (float)atof( value ))
+						sel = i;
+				}
+				c->Select( c->items.Count() ? sel : -1 );
+				row.control = c;
+			}
+			else if( var->type == T_STRING || var->type == T_NUMBER )
+			{
+				CSteamTextEntry *t = new CSteamTextEntry;
+				t->iMaxLength = 63;
+				if( var->type == T_NUMBER && !cvarValues ) // the cvar as the engine has it ("600.000000"), as GameUI
+				{
+					char buf[32];
+					snprintf( buf, sizeof( buf ), "%g", atof( value ));
+					t->SetBuffer( buf );
+				}
+				else t->SetBuffer( value );
+				row.control = t;
+			}
+			else continue;
+
+			if( var->type != T_BOOL )
+			{
+				CSteamLabel *l = new CSteamLabel;
+				snprintf( l->text, sizeof( l->text ), "%s", var->desc );
+				l->iFlags |= QMF_INACTIVE;
+				row.prompt = l;
+				m_owned.AddToTail( l );
+				AddItem( *l );
+			}
+			m_owned.AddToTail( row.control );
+			AddItem( *row.control );
+			m_rows.rows.AddToTail( row );
+		}
+		AddItem( m_clipEnd );
+		m_bClipItems = true;
+
+		// the controls are placed in pixels, as the other controls of the window; made after the window was, so
+		// their fonts and places are made here
+		for( int i = 0; i < m_owned.Count(); i++ )
+		{
+			m_owned[i]->iFlags |= QMF_DISABLESCAILING;
+			m_owned[i]->VidInit();
+		}
+
+		m_rows.shown = RowsShown();
+		m_rows.Layout();
+	}
+
+	// the values of the rows into the list of the script (its cvars in the same order)
+	void CollectRows()
+	{
+		int r = 0;
+		for( scrvardef_t *var = m_pVars; var && r < m_rows.rows.Count(); var = var->next )
+		{
+			if( var->type != T_BOOL && var->type != T_LIST && var->type != T_STRING && var->type != T_NUMBER )
+				continue;
+			RowValue( var, m_rows.rows[r++].control, var->value, sizeof( var->value ));
+		}
+	}
+
+	// the value of a row for its cvar and settings.scr
+	static void RowValue( const scrvardef_t *var, CMenuBaseItem *control, char *out, size_t len )
+	{
+		if( var->type == T_BOOL )
+			snprintf( out, len, "%d", static_cast<CSteamCheckButton *>( control )->checked ? 1 : 0 );
+		else if( var->type == T_LIST )
+			snprintf( out, len, "%s", static_cast<CSteamComboBox *>( control )->SelectedData());
+		else if( var->type == T_NUMBER )
+		{
+			float v = (float)atof( static_cast<CSteamTextEntry *>( control )->GetBuffer());
+			if( var->number.fMin != -1.0f && v < var->number.fMin ) v = var->number.fMin;
+			if( var->number.fMax != -1.0f && var->number.fMax > var->number.fMin && v > var->number.fMax ) v = var->number.fMax;
+			snprintf( out, len, "%g", v );
+		}
+		else
+			snprintf( out, len, "%s", static_cast<CSteamTextEntry *>( control )->GetBuffer());
+	}
+
+	CSteamOptionRows m_rows;
+	CSteamOptionRowsClip m_clipBegin, m_clipEnd;
+	bool m_bClipItems = false;
+	scrvardef_t *m_pVars = nullptr;
+	CUtlVector<CMenuBaseItem *> m_owned;
+};
+
+class CSteamCreateServer : public CSteamScriptFrame
+{
+public:
+	typedef CSteamScriptFrame BaseClass;
+
+	CSteamCreateServer() : BaseClass( "CSteamCreateServer", 348, 460 ) {}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		FillMaps();
+		LoadRows( "settings.scr", false ); // the values of the file, as GameUI (maxplayers is 1 after a single player game)
+	}
+
+private:
+	bool RowsShown() const override { return ActivePage() == m_iGamePage; }
+
+	void _Init() override
+	{
+		SetTitle( "#GameUI_CreateServer" );
+		m_iServerPage = AddPage( "#GameUI_Server" );
+		m_iGamePage = AddPage( "#GameUI_Game" );
+
+		// the Server page from its .res, as in the Steam version (the bots controls are hidden there)
+		int lx = 28, ly = 28, lw = 38, lh = 24, mx = 66, my = 28, mw = 174, mh = 24, dx = 28, dy = 70, dw = 280;
+		bool divider = true;
+		if( ResNode *res = LoadRes( "resource/CreateMultiplayerGameServerPage.res" ))
+		{
+			if( const ResNode *n = res->Find( "Label1" ))
+			{
+				lx = n->GetInt( "xpos", lx ); ly = n->GetInt( "ypos", ly ); lw = n->GetInt( "wide", lw ); lh = n->GetInt( "tall", lh );
+				Q_strncpy( m_mapLabel.text, n->GetString( "labelText", "" ), sizeof( m_mapLabel.text ));
+			}
+			if( const ResNode *n = res->Find( "MapList" ))
+			{
+				mx = n->GetInt( "xpos", mx ); my = n->GetInt( "ypos", my ); mw = n->GetInt( "wide", mw ); mh = n->GetInt( "tall", mh );
+			}
+			const ResNode *n = res->Find( "Divider1" );
+			if( n )
+			{
+				dx = n->GetInt( "xpos", dx ); dy = n->GetInt( "ypos", dy ); dw = n->GetInt( "wide", dw );
+				divider = n->GetInt( "visible", 1 ) != 0;
+			}
+			delete res;
+		}
+
+		// "#Cstrike_Listen_MapName" is "Map" in English; the Russian file of CS has no such string, the Steam version
+		// shows "Map" too
+		const char *label = m_mapLabel.text[0] ? m_mapLabel.text : "#Cstrike_Listen_MapName";
+		Q_strncpy( m_mapLabel.text, Text( label, "Map" ), sizeof( m_mapLabel.text ));
+		m_mapLabel.iFlags |= QMF_INACTIVE;
+		m_mapLabel.SetBounds( lx, ly, lw, lh );
+		m_maps.SetBounds( mx, my, mw, mh );
+		m_divider.iFlags |= QMF_INACTIVE;
+		m_divider.SetBounds( dx, dy, dw, 2 );
+		AddToPage( m_iServerPage, m_mapLabel );
+		AddToPage( m_iServerPage, m_maps );
+		if( divider )
+			AddToPage( m_iServerPage, m_divider );
+
+		// the Game page: the list; its rows are made by LoadSettings
+		int gx = 10, gy = 10, gw = 320, gh = 325;
+		if( ResNode *res = LoadRes( "resource/CreateMultiplayerGameGameplayPage.res" ))
+		{
+			if( const ResNode *n = res->Find( "Resource/CreateMultiplayerGameGameplayPage.res" ))
+			{
+				gx = n->GetInt( "xpos", gx ); gy = n->GetInt( "ypos", gy ); gw = n->GetInt( "wide", gw ); gh = n->GetInt( "tall", gh );
+			}
+			delete res;
+		}
+		m_rows.SetBounds( gx, gy, gw, gh );
+		AddToPage( m_iGamePage, m_rows );
+
+		// the buttons of the window
+		const int by = 460 - 9 - 24;
+		m_start.SetBounds( 348 - 13 - 72 * 2 - 8, by, 72, 24 );
+		m_cancel.SetBounds( 348 - 13 - 72, by, 72, 24 );
+		Q_strncpy( m_start.text, "#GameUI_Start", sizeof( m_start.text ));
+		Q_strncpy( m_cancel.text, "#GameUI_Cancel", sizeof( m_cancel.text ));
+		m_start.isDefault = true;
+		m_start.onReleased = VoidCb( &CSteamCreateServer::Start );
+		m_cancel.onReleased = VoidCb( &CSteamCreateServer::Hide );
+		AddItem( m_start );
+		AddItem( m_cancel );
+	}
+
+	void OnPageChanged( int page ) override
+	{
+		m_rows.shown = page == m_iGamePage;
+		m_rows.Layout();
+	}
+
+	bool KeyDown( int key ) override
+	{
+		if( UI::Key::IsEnter( key ) && !m_pOpenList )
+		{
+			Start();
+			return true;
+		}
+		return BaseClass::KeyDown( key );
+	}
+
+	void FillMaps()
+	{
+		char keep[64];
+		Q_strncpy( keep, m_maps.SelectedData(), sizeof( keep ));
+
+		m_maps.RemoveAll();
+		m_maps.AddItem( Text( "#GameUI_RandomMap", "< Random Map >" ), "" );
+
+		char *afile = nullptr;
+		if( EngFuncs::CreateMapsList( 1 ))
+			afile = (char *)EngFuncs::COM_LoadFile( "maps.lst", NULL );
+		if( afile )
+		{
+			char *pfile = afile;
+			char token[1024];
+			while(( pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token ))) != NULL )
+			{
+				char name[64];
+				Q_strncpy( name, token, sizeof( name ));
+				pfile = EngFuncs::COM_ParseFile( pfile, token, sizeof( token )); // the title of the map
+				if( strnicmp( name, "tr_", 3 )) // the training maps, as the Create Game menu of mainui
+					m_maps.AddItem( name, name );
+				if( !pfile )
+					break;
+			}
+			EngFuncs::COM_FreeFile( afile );
+		}
+
+		const int i = keep[0] ? m_maps.FindData( keep ) : -1;
+		m_maps.Select( i >= 0 ? i : 0 );
+		m_start.SetGrayed( m_maps.items.Count() <= 1 );
+	}
+
+	void Start()
+	{
+		if( m_maps.items.Count() <= 1 )
+			return;
+
+		int item = m_maps.Selected();
+		if( item <= 0 )
+			item = EngFuncs::RandomLong( 1, m_maps.items.Count() - 1 );
+		char mapName[64];
+		Q_strncpy( mapName, m_maps.items[item].data, sizeof( mapName ));
+		if( !EngFuncs::IsMapValid( mapName ))
+			return;
+
+		// the values of the rows (the rows and the cvars of settings.scr are in the same order)
+		int maxPlayers = (int)EngFuncs::GetCvarFloat( "maxplayers" );
+		CollectRows();
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+			if( !stricmp( var->name, "maxplayers" ))
+				maxPlayers = atoi( var->value );
+		if( maxPlayers < 1 ) maxPlayers = 1;
+		if( maxPlayers > MAX_CLIENTS ) maxPlayers = MAX_CLIENTS;
+
+		if( m_pVars )
+			CSCR_SaveToFile( "settings.scr", "SERVER_OPTIONS", m_pVars );
+
+		if( EngFuncs::GetCvarFloat( "host_serverstate" ))
+		{
+			if( EngFuncs::GetCvarFloat( "maxplayers" ) == 1.0f )
+				EngFuncs::HostEndGame( "end of the game" );
+			else
+				EngFuncs::HostEndGame( "starting new server" );
+		}
+
+		EngFuncs::CvarSetValue( "deathmatch", 1.0f );
+		EngFuncs::PlayBackgroundTrack( NULL, NULL );
+
+		// listenserver.cfg first: the settings of the window are set after it, as in the Steam version
+		char cmd[1024];
+		snprintf( cmd, sizeof( cmd ), "exec %s\n", EngFuncs::GetCvarString( "lservercfgfile" ));
+		EngFuncs::ClientCmd( true, cmd );
+
+		for( scrvardef_t *var = m_pVars; var; var = var->next )
+			if( stricmp( var->name, "maxplayers" ))
+				EngFuncs::CvarSetString( var->name, var->value );
+
+		Hide();
+
+		// as the Create Game menu of mainui: three frames for the old server to shut down, then maxplayers and the map
+		char escaped[256];
+		Com_EscapeCommand( escaped, mapName, sizeof( escaped ));
+		snprintf( cmd, sizeof( cmd ), "disconnect;menu_connectionprogress localserver;wait;wait;wait;maxplayers %i;latch;map %s\n",
+			maxPlayers, escaped );
+		EngFuncs::ClientCmd( false, cmd );
+	}
+
+	int m_iServerPage = 0, m_iGamePage = 1;
+	CSteamLabel m_mapLabel;
+	CSteamComboBox m_maps;
+	CSteamDivider m_divider;
+	CSteamButton m_start, m_cancel;
+};
+
