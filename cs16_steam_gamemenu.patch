+
+class CSteamConsoleDialog : public CSteamFrame
+{
+public:
+	typedef CSteamFrame BaseClass;
+
+	CSteamConsoleDialog() : BaseClass( "CSteamConsoleDialog", 560, 400 )
+	{
+		m_iFirstX = 40;
+		m_iFirstY = 40;
+	}
+
+	void Show() override
+	{
+		BaseClass::Show();
+		m_entry.ignoreUntil = uiStatic.realTime + 150;
+		SetCursorToItem( m_entry );
+		m_history.ScrollToEnd();
+	}
+
+	bool KeyDown( int key ) override;
+	void Char( int key ) override
+	{
+		// typed letters always go to the field, as the field of GameUI keeps the keyboard
+		m_entry.Char( key );
+		SetCursorToItem( m_entry );
+	}
+	void Draw() override;
+
+private:
+	void _Init() override
+	{
+		SetTitle( "#GameUI_Console" );
+		SetSizeable( true, 100, 100 );
+		Q_strncpy( m_submit.text, "#GameUI_Submit", sizeof( m_submit.text ));
+		m_submit.onReleased = VoidCb( &CSteamConsoleDialog::Submit );
+		m_entry.iMaxLength = 255;
+		AddItem( m_history );
+		AddItem( m_entry );
+		AddItem( m_submit );
+		OnResized();
+	}
+
+	void OnResized() override
+	{
+		const int w = Wide(), h = Tall();
+		m_history.SetBounds( 8, 35, w - 16, h - 35 - 41 );
+		m_submit.SetBounds( w - 8 - 64, h - 33, 64, 24 );
+		m_entry.SetBounds( 8, h - 33, w - 8 - 64 - 8 - 8, 24 );
+	}
+
+	void Submit();
+	void UpdateCompletion();
+	void ChooseCompletion( int i );
+	void HideCompletion() { m_iCompletion = 0; m_iChosen = -1; }
+	void CompletionRect( int &x, int &y, int &w, int &h ) const;
+	void History( int dir );
+
+	CSteamConsoleHistory m_history;
+	CSteamConsoleEntry m_entry;
+	CSteamButton m_submit;
+
+	// the list under the field
+	enum { MAX_SHOWN = 6 };
+	char m_completion[MAX_SHOWN][128]; // "name value"
+	char m_completionName[MAX_SHOWN][96];
+	int m_iCompletion = 0;   // shown
+	bool m_bMore = false;    // "..." after them
+	int m_iChosen = -1;
+	char m_szLastTyped[256] = ""; // the text the list was made for
+
+	// the commands typed
+	CUtlVector<char *> m_typed;
+	int m_iTyped = -1; // the one in the field (-1: what is being typed)
+	char m_szTyping[256] = "";
+};
+
+void CSteamConsoleDialog::CompletionRect( int &x, int &y, int &w, int &h ) const
+{
+	const Point ep = m_entry.GetRenderPosition();
+	const Size es = m_entry.GetRenderSize();
+	x = ep.x;
+	y = ep.y + es.h + 10;
+	w = 0;
+	for( int i = 0; i < m_iCompletion; i++ )
+	{
+		const int tw = TextWidth( FONT_DEFAULT, m_completion[i] );
+		if( tw > w ) w = tw;
+	}
+	w += 12;
+	if( w < 60 ) w = 60;
+	h = ( m_iCompletion + ( m_bMore ? 1 : 0 )) * 22 + 4;
+}
+
+void CSteamConsoleDialog::UpdateCompletion()
+{
+	const char *typed = m_entry.GetBuffer();
+	if( !strcmp( typed, m_szLastTyped ))
+		return;
+	Q_strncpy( m_szLastTyped, typed, sizeof( m_szLastTyped ));
+	HideCompletion();
+
+	// the first word only, while it is typed
+	if( !typed[0] || strchr( typed, ' ' ) || !g_pSteamUIEngine || !g_pSteamUIEngine->pfnCompleteCommand )
+		return;
+
+	char list[8192];
+	const int count = g_pSteamUIEngine->pfnCompleteCommand( typed, list, sizeof( list ), MAX_SHOWN + 1 );
+	m_bMore = count > MAX_SHOWN;
+
+	char *p = list;
+	while( *p && m_iCompletion < MAX_SHOWN )
+	{
+		char *end = strchr( p, '\n' );
+		if( end ) *end = 0;
+		char *tab = strchr( p, '\t' );
+		if( tab )
+		{
+			*tab = 0;
+			snprintf( m_completion[m_iCompletion], sizeof( m_completion[0] ), "%s %s", p, tab + 1 );
+		}
+		else Q_strncpy( m_completion[m_iCompletion], p, sizeof( m_completion[0] ));
+		Q_strncpy( m_completionName[m_iCompletion], p, sizeof( m_completionName[0] ));
+		m_iCompletion++;
+		if( !end )
+			break;
+		p = end + 1;
+	}
+
+	// the only one typed in full: no list
+	if( m_iCompletion == 1 && !m_bMore && !stricmp( m_completionName[0], typed ))
+		HideCompletion();
+}
+
+void CSteamConsoleDialog::ChooseCompletion( int i )
+{
+	if( i < 0 || i >= m_iCompletion )
+		return;
+	m_iChosen = i;
+	char text[256];
+	snprintf( text, sizeof( text ), "%s ", m_completionName[i] );
+	m_entry.SetBuffer( text );
+	Q_strncpy( m_szLastTyped, text, sizeof( m_szLastTyped )); // the list stays while it is gone through
+}
+
+void CSteamConsoleDialog::History( int dir )
+{
+	if( !m_typed.Count( ))
+		return;
+
+	if( m_iTyped < 0 )
+		Q_strncpy( m_szTyping, m_entry.GetBuffer(), sizeof( m_szTyping ));
+
+	int i = m_iTyped < 0 ? m_typed.Count() : m_iTyped;
+	i += dir;
+	if( i < 0 )
+		i = 0;
+	if( i >= m_typed.Count( ))
+	{
+		m_iTyped = -1;
+		m_entry.SetBuffer( m_szTyping );
+	}
+	else
+	{
+		m_iTyped = i;
+		m_entry.SetBuffer( m_typed[i] );
+	}
+	Q_strncpy( m_szLastTyped, m_entry.GetBuffer(), sizeof( m_szLastTyped ));
+}
+
+void CSteamConsoleDialog::Submit()
+{
+	const char *text = m_entry.GetBuffer();
+	char line[256];
+	Q_strncpy( line, text, sizeof( line ));
+	m_entry.SetBuffer( "" );
+	HideCompletion();
+	m_szLastTyped[0] = 0;
+	m_iTyped = -1;
+	SetCursorToItem( m_entry );
+	m_history.ScrollToEnd();
+
+	if( !line[0] )
+		return;
+
+	if( !m_typed.Count() || strcmp( m_typed[m_typed.Count() - 1], line ))
+	{
+		const size_t n = strlen( line ) + 1;
+		char *copy = (char *)malloc( n );
+		if( copy )
+		{
+			memcpy( copy, line, n );
+			m_typed.AddToTail( copy );
+		}
+		while( m_typed.Count() > 64 )
+		{
+			free( m_typed[0] );
+			m_typed.Remove( 0 );
+		}
+	}
+
+	if( g_pSteamUIEngine && g_pSteamUIEngine->pfnConsoleCommand )
+		g_pSteamUIEngine->pfnConsoleCommand( line );
+	else
+	{
+		char cmd[260];
+		snprintf( cmd, sizeof( cmd ), "%s\n", line );
+		EngFuncs::ClientCmd( false, cmd );
+	}
+}
+
+bool CSteamConsoleDialog::KeyDown( int key )
+{
+	const bool ctrl = EngFuncs::KEY_IsDown( K_CTRL ) != 0;
+
+	// the list under the field (outside the window: before the window gives the click to what is under it)
+	if( m_iCompletion && ( key == K_MOUSE1 || key == K_MOUSE2 ))
+	{
+		int x, y, w, h;
+		CompletionRect( x, y, w, h );
+		if( UI_CursorInRect( x, y, w, h ))
+		{
+			const int i = ( uiStatic.cursorY - y - 2 ) / 22;
+			if( key == K_MOUSE1 && i >= 0 && i < m_iCompletion )
+			{
+				ChooseCompletion( i );
+				HideCompletion();
+			}
+			SetCursorToItem( m_entry );
+			return true;
+		}
+	}
+
+	if( UI::Key::IsEscape( key ) && m_iCompletion )
+	{
+		HideCompletion();
+		return true;
+	}
+
+	// Escape closes the window, as the key of the console does: in a game the menu too, back to the game
+	if( UI::Key::IsEscape( key ))
+	{
+		Hide();
+		if( SteamGameMenu::InGame() || CL_IsActive( ))
+			UI_CloseMenu();
+		return true;
+	}
+
+	if( UI::Key::IsEnter( key ))
+	{
+		Submit();
+		return true;
+	}
+
+	if( key == K_TAB || UI::Key::IsUpArrow( key ) || UI::Key::IsDownArrow( key ))
+	{
+		const bool up = UI::Key::IsUpArrow( key ) || ( key == K_TAB && EngFuncs::KEY_IsDown( K_SHIFT ));
+		if( m_iCompletion )
+		{
+			int i = m_iChosen < 0 ? ( up ? m_iCompletion - 1 : 0 ) : m_iChosen + ( up ? -1 : 1 );
+			if( i < 0 ) i = m_iCompletion - 1;
+			if( i >= m_iCompletion ) i = 0;
+			ChooseCompletion( i );
+		}
+		else if( key != K_TAB )
+			History( up ? -1 : 1 );
+		SetCursorToItem( m_entry );
+		return true;
+	}
+
+	// Ctrl+C copies the text selected in the console (else the field copies its own)
+	if( key == 'c' && ctrl && m_history.HasSelection( ))
+	{
+		m_history.Copy();
+		return true;
+	}
+
+	// the text: the wheel and the mouse in it
+	if(( key == K_MOUSE1 || key == K_MWHEELUP || key == K_MWHEELDOWN ) && UI_CursorInRect( m_history.GetRenderPosition(), m_history.GetRenderSize( )))
+	{
+		m_history.MouseDown( key );
+		return true;
+	}
+
+	// the keys of the field go to it wherever the mouse is
+	if( !UI::Key::IsLeftMouse( key ) && key != K_MOUSE2 && key != K_MOUSE3 && key != K_MWHEELUP && key != K_MWHEELDOWN &&
+		!UI::Key::IsEscape( key ) && key != '`' && key != '~' )
+	{
+		SetCursorToItem( m_entry );
+		const bool handled = m_entry.KeyDown( key );
+		return handled;
+	}
+
+	return BaseClass::KeyDown( key );
+}
+
+void CSteamConsoleDialog::Draw()
+{
+	UpdateCompletion();
+	BaseClass::Draw();
+
+	if( !m_iCompletion )
+		return;
+
+	int x, y, w, h;
+	CompletionRect( x, y, w, h );
+	Fill( x, y, w, h, ControlBG );
+	RaisedBorder( x, y, w, h );
+	for( int i = 0; i < m_iCompletion; i++ )
+	{
+		const int ry = y + 2 + i * 22;
+		const bool chosen = i == m_iChosen || ( m_iChosen < 0 && UI_CursorInRect( x + 1, ry, w - 2, 22 ));
+		if( chosen )
+			Fill( x + 1, ry, w - 2, 22, SelectionBG );
+		TextInBox( FONT_DEFAULT, x + 5, ry, w - 8, 22, m_completion[i], chosen ? BrightBaseText : DimBaseText );
+	}
+	if( m_bMore )
+		TextInBox( FONT_DEFAULT, x + 5, y + 2 + m_iCompletion * 22, w - 8, 22, "...", DimBaseText );
+}
+
+CSteamConsoleDialog *s_console = nullptr;
+
+// ---------------------------------------------------------------------------------------------------------------------
+// for the engine (steamui_int.h)
+
+int GetFeatures( void )
+{
+	// the menu of the Steam version is on: its console and its loading window
+	return SteamGameMenu::g_bActive ? ( STEAMUI_FEATURE_CONSOLE | STEAMUI_FEATURE_LOADING | STEAMUI_FEATURE_WORLD ) : 0;
+}
+
+void ConsoleShow( int show )
+{
+	if( show )
+	{
+		if( !s_console )
+			s_console = new CSteamConsoleDialog;
+		s_console->Show();
+	}
+	else if( s_console && uiStatic.menu.IsVisible( s_console ))
+		s_console->Hide();
+}
+
+int ConsoleVisible( void )
+{
+	return s_console && uiStatic.menu.IsVisible( s_console );
+}
+
+void ConsolePrint( const char *text )
+{
+	if( text )
+		AddText( text );
+}
+
+void ConsoleClear( void )
+{
+	ClearText();
+}
+
+steamui_functions_t s_steamFuncs =
+{
+	GetFeatures,
+	ConsoleShow,
+	ConsoleVisible,
+	ConsolePrint,
+	ConsoleClear,
+};
+
+} // namespace
+
+extern "C" EXPORT int GetSteamUIAPI( int version, steamui_functions_t *pFunctionTable, const steamui_enginefuncs_t *pEngfuncs )
+{
+	if( version != STEAMUI_API_VERSION || !pFunctionTable || !pEngfuncs )
+		return false;
+
+	static steamui_enginefuncs_t engfuncs;
+	engfuncs = *pEngfuncs;
+	g_pSteamUIEngine = &engfuncs;
+	*pFunctionTable = s_steamFuncs;
+	return true;
+}
+
+bool SteamGameMenu::InGame()
+{
+	return g_pSteamUIEngine && g_pSteamUIEngine->pfnClientActive && g_pSteamUIEngine->pfnClientActive();
+}
+
+// the console window from the menu (the command "toggleconsole" is the engine's)
+void UI_SteamConsole_Menu( void )
+{
+	ConsoleShow( 1 );
+}
