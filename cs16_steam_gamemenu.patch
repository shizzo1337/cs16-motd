+
+// the next letter of a UTF-8 text, never past its end
+static int NextChar( const char *text, int pos, int len )
+{
+	const int next = Con_UtfMoveRight( text, pos, len );
+	return next > len ? len : next;
+}
+
+const char *CSteamTextEntry::Shown( char *out, size_t len ) const
+{
+	const char *buf = const_cast<CSteamTextEntry *>( this )->GetBuffer();
+	if( !bHideInput )
+		return buf;
+
+	// a "*" for each letter (not for each byte of a Russian one)
+	size_t n = 0;
+	for( const char *p = buf; *p && n + 1 < len; p++ )
+		if(( *p & 0xC0 ) != 0x80 )
+			out[n++] = '*';
+	out[n] = 0;
+	return out;
+}
+
+int CSteamTextEntry::ShownPos( int pos ) const
+{
+	if( !bHideInput )
+		return pos;
+	const char *buf = const_cast<CSteamTextEntry *>( this )->GetBuffer();
+	int n = 0;
+	for( int i = 0; i < pos && buf[i]; i++ )
+		if(( buf[i] & 0xC0 ) != 0x80 )
+			n++;
+	return n;
+}
+
+// the width of the bytes [from, to) of a text
+static int SpanWidth( const char *text, int from, int to )
+{
+	char part[UI_MAX_FIELD_LINE];
+	int n = to - from;
+	if( n <= 0 )
+		return 0;
+	if( n >= (int)sizeof( part ))
+		n = sizeof( part ) - 1;
+	memcpy( part, text + from, n );
+	part[n] = 0;
+	return TextWidth( FONT_DEFAULT, part );
+}
+
+int CSteamTextEntry::FromShown( int shown ) const
+{
+	if( !bHideInput )
+		return shown;
+	const char *buf = const_cast<CSteamTextEntry *>( this )->GetBuffer();
+	const int len = (int)strlen( buf );
+	int pos = 0;
+	for( int n = 0; buf[pos] && n < shown; n++ )
+		pos = NextChar( buf, pos, len );
+	return pos;
+}
+
+int CSteamTextEntry::PosAt( int cx ) const
+{
+	// the places left of the first letter shown count to the left of the field: the text scrolls while it is dragged
+	char tmp[UI_MAX_FIELD_LINE];
+	const char *t = Shown( tmp, sizeof( tmp ));
+	const int len = (int)strlen( t );
+	int first = ShownPos( m_iFirst );
+	if( first > len ) first = len;
+
+	int best = first, bestDist = 1 << 30;
+	for( int i = 0; ; i = NextChar( t, i, len ))
+	{
+		const int px = i >= first ? SpanWidth( t, first, i ) : -SpanWidth( t, i, first );
+		const int d = abs( px - cx );
+		if( d < bestDist )
+		{
+			bestDist = d;
+			best = i;
+		}
+		if( i >= len )
+			break;
+	}
+	return FromShown( best );
+}
+
+void CSteamTextEntry::Seen()
+{
+	Q_strncpy( m_szSeen, GetBuffer(), sizeof( m_szSeen ));
+}
+
+bool CSteamTextEntry::Selection( int &from, int &to )
+{
+	// a text set from outside (SetBuffer) has no selection
+	if( strcmp( m_szSeen, GetBuffer( )))
+	{
+		m_iAnchor = GetCursorPos();
+		Seen();
+	}
+	const int len = (int)strlen( GetBuffer( ));
+	if( m_iAnchor > len )
+		m_iAnchor = len;
+	const int cur = GetCursorPos();
+	from = m_iAnchor < cur ? m_iAnchor : cur;
+	to = m_iAnchor < cur ? cur : m_iAnchor;
+	return from != to;
+}
+
+bool CSteamTextEntry::DeleteSelection()
+{
+	int a, b;
+	if( !Selection( a, b ))
+		return false;
+	char buf[UI_MAX_FIELD_LINE];
+	const char *s = GetBuffer();
+	snprintf( buf, sizeof( buf ), "%.*s%s", a, s, s + b );
+	SetBuffer( buf );
+	SetCursorPos( a );
+	m_iAnchor = a;
+	Seen();
+	_Event( QM_CHANGED );
+	return true;
+}
+
+bool CSteamTextEntry::KeyDown( int key )
+{
+	int a, b;
+	const bool selected = Selection( a, b );
+	const bool shift = EngFuncs::KEY_IsDown( K_SHIFT ) != 0;
+
+	// a click puts the cursor between the letters under the mouse, as the text is drawn here (CMenuField counts
+	// with its own place of the text); dragged, it selects; Shift+click selects up to there; a double click, a word
+	if( UI::Key::IsLeftMouse( key ) && UI_CursorInRect( m_scPos, m_scSize ))
+	{
+		const int pos = PosAt( uiStatic.cursorX - ( m_scPos.x + 4 ));
+		const bool dbl = uiStatic.realTime - m_iLastClick < 400 && pos == m_iLastClickPos;
+		m_iLastClick = uiStatic.realTime;
+		m_iLastClickPos = pos;
+
+		if( dbl )
+		{
+			// the word under the cursor (a password: all of it)
+			const char *buf = GetBuffer();
+			const int len = (int)strlen( buf );
+			int from = pos, to = pos;
+			if( bHideInput )
+				from = 0, to = len;
+			else
+			{
+				while( from > 0 && buf[from - 1] != ' ' )
+					from--;
+				while( to < len && buf[to] != ' ' )
+					to++;
+			}
+			m_iAnchor = from;
+			SetCursorPos( to );
+			m_bSelecting = false;
+			m_iLastClickPos = -1;
+			return true;
+		}
+
+		if( !shift )
+			m_iAnchor = pos; // with Shift the anchor stays: from it up to here
+		SetCursorPos( pos );
+		m_bSelecting = true;
+		return true;
+	}
+
+	const bool left = UI::Key::IsLeftArrow( key ), right = UI::Key::IsRightArrow( key );
+	if( left || right || UI::Key::IsHome( key ) || UI::Key::IsEnd( key ))
+	{
+		// without Shift an arrow takes the cursor to that end of the selection, as VGUI2 does
+		if( !shift && selected && ( left || right ))
+		{
+			SetCursorPos( left ? a : b );
+			m_iAnchor = GetCursorPos();
+			return true;
+		}
+		const int old = GetCursorPos();
+		const bool handled = BaseClass::KeyDown( key );
+		if( !shift )
+			m_iAnchor = GetCursorPos();
+		else if( !selected )
+			m_iAnchor = old;
+		Seen();
+		return handled;
+	}
+
+	if( UI::Key::IsBackspace( key ) || UI::Key::IsDelete( key, true ))
+	{
+		if( DeleteSelection( ))
+			return true;
+		const bool handled = BaseClass::KeyDown( key );
+		m_iAnchor = GetCursorPos();
+		Seen();
+		return handled;
+	}
+
+	// Shift+Insert pastes over the selection
+	if( UI::Key::IsInsert( key ) && shift )
+		DeleteSelection();
+
+	const bool handled = BaseClass::KeyDown( key );
+	if( strcmp( m_szSeen, GetBuffer( )))
+	{
+		m_iAnchor = GetCursorPos();
+		Seen();
+	}
+	return handled;
+}
+
+void CSteamTextEntry::Char( int key )
+{
+	int a, b;
+	Selection( a, b );
+
+	if( key == 'a' - 'a' + 1 )
+	{
+		// Ctrl+A: all of it
+		m_iAnchor = 0;
+		SetCursorPos( (int)strlen( GetBuffer( )));
+		return;
+	}
+	if( key == 'c' - 'a' + 1 || key == 'x' - 'a' + 1 )
+	{
+		// Ctrl+C, Ctrl+X: the selection to the clipboard, through the engine of cs16-client (steamui_int.h; another
+		// engine has no way for it); a password is not copied. The field isn't cleared as the fields of mainui are
+		if( a != b && !bHideInput && g_pSteamUIEngine && g_pSteamUIEngine->pfnSetClipboardText )
+		{
+			char part[UI_MAX_FIELD_LINE];
+			snprintf( part, sizeof( part ), "%.*s", b - a, GetBuffer() + a );
+			g_pSteamUIEngine->pfnSetClipboardText( part );
+			if( key == 'x' - 'a' + 1 )
+				DeleteSelection();
+		}
+		return;
+	}
+
+	// a letter or Ctrl+V takes the place of the selection
+	if( key == 'v' - 'a' + 1 || key >= 32 )
+		DeleteSelection();
+
+	BaseClass::Char( key );
+	m_iAnchor = GetCursorPos();
+	Seen();
+}
+
+void CSteamTextEntry::Draw()
+{
+	const int x = m_scPos.x, y = m_scPos.y, w = m_scSize.w, h = m_scSize.h;
+
+	// the selection dragged by the mouse
+	if( m_bSelecting )
+	{
+		if( !EngFuncs::KEY_IsDown( K_MOUSE1 ))
+			m_bSelecting = false;
+		else
+			SetCursorPos( PosAt( uiStatic.cursorX - ( x + 4 )));
+	}
+	else if( EngFuncs::KEY_IsDown( K_MOUSE1 ) && !UI_CursorInRect( m_scPos, m_scSize ))
+		m_iAnchor = GetCursorPos(); // a click somewhere else: the selection goes
+	int selA, selB;
+	const bool selected = Selection( selA, selB );
+
+	Fill( x, y, w, h, WindowBG );
+	InsetBorder( x, y, w, h );
+
+	char tmp[UI_MAX_FIELD_LINE];
+	const char *t = Shown( tmp, sizeof( tmp ));
+	const int len = (int)strlen( t );
+	const int inner = w - 8;
+	const int cursor = ShownPos( GetCursorPos( ));
+
+	// the part shown: from m_iFirst, moved so that the cursor is in the field (in the shown text)
+	int first = ShownPos( m_iFirst );
+	if( first > len ) first = len;
+	if( cursor < first ) first = cursor;
+	while( first < cursor && SpanWidth( t, first, cursor ) > inner )
+		first = NextChar( t, first, len );
+	// no empty room on the right while there is text on the left
+	while( first > 0 && SpanWidth( t, Con_UtfMoveLeft( t, first ), len ) <= inner )
+		first = Con_UtfMoveLeft( t, first );
+
+	// keep it in the bytes of the buffer
+	m_iFirst = FromShown( first );
+
+	// the letters that fit
+	int last = first;
+	while( last < len && SpanWidth( t, first, NextChar( t, last, len )) <= inner )
+		last = NextChar( t, last, len );
+
+	const unsigned int color = ( iFlags & QMF_GRAYED ) ? DisabledText1 : ControlText;
+	const int tall = FontTall( FONT_DEFAULT );
+	const int ty = y + ( h - tall ) / 2;
+	auto piece = [&]( int from, int to, unsigned int c )
+	{
+		if( to <= from )
+			return;
+		char part[UI_MAX_FIELD_LINE];
+		memcpy( part, t + from, to - from );
+		part[to - from] = 0;
+		Text( FONT_DEFAULT, x + 4 + SpanWidth( t, first, from ), ty, part, c, inner - SpanWidth( t, first, from ));
+	};
+
+	if( selected )
+	{
+		// the selection on "SelectionBG", its letters bright; the rest as usual
+		int sa = ShownPos( selA ), sb = ShownPos( selB );
+		if( sa < first ) sa = first;
+		if( sb > last ) sb = last;
+		if( sa > sb ) sa = sb;
+		Fill( x + 4 + SpanWidth( t, first, sa ), ty, SpanWidth( t, sa, sb ), tall, SelectionBG );
+		piece( first, sa, color );
+		piece( sa, sb, BrightBaseText );
+		piece( sb, last, color );
+	}
+	else
+		piece( first, last, color );
+
+	// the cursor while the entry has the keyboard, where the next letter goes
+	if(( iFlags & ( QMF_HASKEYBOARDFOCUS | QMF_HASMOUSEFOCUS )) && (( uiStatic.realTime / 500 ) & 1 ) == 0 )
+	{
+		const int cx = x + 4 + SpanWidth( t, first, cursor );
+		Fill( cx, ty + 1, 1, tall - 2, BaseText );
+	}
+}
