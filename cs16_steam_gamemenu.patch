+void CSteamServerBrowser::QueryList( const CUtlVector<ListEntry> &list )
+{
+	CUtlVector<SteamServer> &servers = m_servers[m_iRefreshTab];
+
+	for( int i = 0; i < list.Count(); i++ )
+	{
+		netadr_t adr;
+		if( !EngFuncs::textfuncs.pNetAPI->StringToAdr( (char *)list[i].adr, &adr ))
+			continue;
+
+		bool found = false;
+		for( int k = 0; k < servers.Count(); k++ )
+			if( !EngFuncs::NET_CompareAdr( &servers[k].adr, &adr ))
+			{
+				servers[k].pending = true;
+				servers[k].queried = EngFuncs::DoubleTime();
+				found = true;
+				break;
+			}
+
+		// the server is shown at once with its address, the answer fills it in
+		if( !found )
+		{
+			SteamServer s;
+			s.adr = adr;
+			Q_strncpy( s.name, list[i].adr, sizeof( s.name ));
+			s.map[0] = s.game[0] = 0;
+			s.goldsrc = !stricmp( list[i].prot, "gs" ) || !stricmp( list[i].prot, "goldsrc" );
+			s.pending = true;
+			s.queried = EngFuncs::DoubleTime();
+			servers.AddToTail( s );
+		}
+
+		EngFuncs::ClientCmdF( false, "ui_queryserver \"%s\" \"%s\"\n", list[i].adr, list[i].prot );
+	}
+}
+
+void CSteamServerBrowser::Refresh( bool newList )
+{
+	const int tab = ActivePage();
+	if( tab < 0 )
+		return;
+
+	m_iRefreshTab = tab;
+	m_refreshStart[tab] = EngFuncs::DoubleTime();
+	m_iRefreshUntil = uiStatic.realTime + 5000;
+
+	if( newList && tab != TAB_FAVORITES && tab != TAB_HISTORY )
+		m_servers[tab].RemoveAll();
+
+	// the servers kept are asked again: their answers give their latency
+	for( int i = 0; i < m_servers[tab].Count(); i++ )
+	{
+		m_servers[tab][i].pending = true;
+		m_servers[tab][i].queried = 0.0;
+	}
+	m_list.SetServers( &m_servers[tab] );
+
+	switch( tab )
+	{
+	case TAB_FAVORITES: QueryList( m_favorites ); break;
+	case TAB_HISTORY: QueryList( m_history ); break;
+	case TAB_LAN: EngFuncs::ClientCmd( false, "localservers\n" ); break;
+	case TAB_SPECTATE: EngFuncs::ClientCmd( false, "internetservers \\proxy\\1\n" ); break;
+	default:
+		if( newList )
+			EngFuncs::ClientCmd( false, "internetservers\n" );
+		else
+		{
+			// a quick refresh asks the servers of the list again
+			CUtlVector<ListEntry> list;
+			for( int i = 0; i < m_servers[tab].Count(); i++ )
+			{
+				ListEntry e;
+				Q_strncpy( e.adr, EngFuncs::NET_AdrToString( m_servers[tab][i].adr ), sizeof( e.adr ));
+				Q_strncpy( e.prot, m_servers[tab][i].Protocol(), sizeof( e.prot ));
+				list.AddToTail( e );
+			}
+			QueryList( list );
+		}
+		break;
+	}
+
+	Q_strncpy( m_status.text, SB( "ServerBrowser_RefreshingServerList", "Refreshing server list..." ), sizeof( m_status.text ));
+}
+
+void CSteamServerBrowser::AddServer( netadr_t adr, const char *info )
+{
+#ifndef XASH_ALL_SERVERS
+	if( stricmp( gMenu.m_gameinfo.gamefolder, Info_ValueForKey( info, "gamedir" )) != 0 )
+		return;
+#endif
+
+	const int tab = m_iRefreshTab;
+	if( tab < 0 || tab >= TAB_COUNT )
+		return;
+
+	// the favorites and the history take only their own servers
+	const char *sadr = EngFuncs::NET_AdrToString( adr );
+	if( tab == TAB_FAVORITES && FindInList( m_favorites, sadr ) < 0 )
+		return;
+	if( tab == TAB_HISTORY && FindInList( m_history, sadr ) < 0 )
+		return;
+
+	CUtlVector<SteamServer> &servers = m_servers[tab];
+	int pos = -1;
+	for( int i = 0; i < servers.Count(); i++ )
+		if( !EngFuncs::NET_CompareAdr( &servers[i].adr, &adr ))
+		{
+			pos = i;
+			break;
+		}
+
+	if( pos < 0 )
+	{
+		SteamServer s;
+		s.adr = adr;
+		pos = servers.AddToTail( s );
+	}
+
+	// the latency: the time since the server was asked. An answer nobody waits for (the engine also passes the
+	// answers to the window Game Info and the like) changes the server, not its latency
+	SteamServer &s = servers[pos];
+	const bool asked = s.pending;
+	const double since = s.queried > 0.0 ? s.queried : m_refreshStart[tab];
+	ServerFromInfo( s, adr, info );
+	if( asked )
+		s.ping = (float)( EngFuncs::DoubleTime() - since );
+
+	if( tab == ActivePage( ))
+		m_list.Resort();
+}
+
+void CSteamServerBrowser::Think()
+{
+	if( m_iRefreshTab >= 0 && uiStatic.realTime > m_iRefreshUntil && m_status.text[0] )
+		m_status.text[0] = 0;
+
+	// the map filter is a text: the list follows it while it is typed
+	if( strcmp( m_szLastMapFilter, m_mapFilter.GetBuffer( )))
+	{
+		Q_strncpy( m_szLastMapFilter, m_mapFilter.GetBuffer(), sizeof( m_szLastMapFilter ));
+		ApplyFilters();
+	}
+
+	UpdateButtons();
+	BaseClass::Think();
+}
