+	void Ask( const char *title, const char *message, const char *okText, const char *cancelText, CEventCallback onOk );
+	bool KeyDown( int key ) override;
+
+private:
+	void _Init() override;
+	void _VidInit() override;
+	void Ok();
+
+	CSteamLabel m_message;
+	CSteamButton m_ok, m_cancel;
+	CEventCallback m_onOk;
+};
