+		const size_t n = len - i;
+
+		if( n > 1 ) v |= (unsigned char)text[i + 1] << 8;
+		if( n > 2 ) v |= (unsigned char)text[i + 2];
+
+		out += b64[( v >> 18 ) & 63];
+		out += b64[( v >> 12 ) & 63];
+		out += ( n > 1 ) ? b64[( v >> 6 ) & 63] : '=';
+		out += ( n > 2 ) ? b64[v & 63] : '=';
+	}
+
+	return out;
