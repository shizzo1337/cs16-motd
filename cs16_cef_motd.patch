+RenderExtents VisibleRenderExtents()
+{
+	RenderExtents e;
+	e.w = ScreenWidth;
+	e.h = ScreenHeight;
+
+	if( gRenderAPI.RenderGetParm )
+	{
+		const int rw = static_cast<int>( gRenderAPI.RenderGetParm( PARM_SCREEN_WIDTH, 0 ) );
+		const int rh = static_cast<int>( gRenderAPI.RenderGetParm( PARM_SCREEN_HEIGHT, 0 ) );
+		if( rw > 0 )
+			e.w = rw;
+		if( rh > 0 )
+			e.h = rh;
+	}
+
+	return e;
+}
+
+void FitCenterLetterbox( float aspect, int fw, int fh, float& x1, float& y1, float& x2, float& y2 )
+{
+	if( fw <= 0 || fh <= 0 || aspect <= 0.f )
+	{
+		x1 = y1 = 0.f;
+		x2 = static_cast<float>( fw );
+		y2 = static_cast<float>( fh );
+		return;
+	}
+
+	const float frame_aspect = static_cast<float>( fw ) / static_cast<float>( fh );
+
+	float vw = static_cast<float>( fw );
+	float vh = static_cast<float>( fh );
+	if( frame_aspect > aspect )
+		vw = vh * aspect;
+	else if( frame_aspect < aspect )
+		vh = vw / aspect;
+
+	const float ox = ( static_cast<float>( fw ) - vw ) * 0.5f;
+	const float oy = ( static_cast<float>( fh ) - vh ) * 0.5f;
+	x1 = ox;
+	y1 = oy;
+	x2 = ox + vw;
+	y2 = oy + vh;
+}
+
+void PresentDebugQuad( ChromeInstance* inst )
+{
+	if( !inst )
+		return;
+
+	const unsigned int tex = inst->texture_id();
+	if( tex == 0 || !gEngfuncs.pTriAPI )
+		return;
+
+	const RenderExtents ext = VisibleRenderExtents();
+	if( ext.w <= 1 || ext.h <= 1 )
+		return;
+
+	int bw = inst->width();
+	int bh = inst->height();
+	if( bw < 1 )
+		bw = 1;
+	if( bh < 1 )
+		bh = 1;
+
+	inst->set_viewport( ChromeRect{ 0, 0, bw, bh } );
+
+	float x1, y1, x2, y2;
+	FitCenterLetterbox( 16.f / 9.f, ext.w, ext.h, x1, y1, x2, y2 );
+
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, tex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->Color4f( 1.0f, 1.0f, 1.0f, 1.0f );
+	DrawUtils::Draw2DQuad( x1, y1, x2, y2 );
+}
+
+double NowSeconds()
+{
+	return std::chrono::duration<double>( std::chrono::steady_clock::now().time_since_epoch() ).count();
+}
+
+// Executes what the input logic asks for
+void ApplyMotdOutput( const MotdOutput& out )
+{
+	if( g_motd_id < 0 )
+		return;
+
+	if( ChromeInstance* inst = Lookup( g_motd_id ))
+		for( int i = 0; i < out.count; ++i )
+			inst->EnqueueInput( out.events[i] );
+
+	if( out.close )
+	{
+		gEngfuncs.Con_Printf( "[motd] window closed by user\n" );
+		Chrome::HideMotd();
+	}
+}
+
+void DrawMotdCursor( int x, int y )
+{
+	// an arrow made of 1 pixel rows: black outline, white inside
+	for( int r = 0; r < 14; ++r )
+	{
+		const int w = r < 9 ? r + 1 : ( r < 12 ? 4 : 3 );
+		FillRGBA( x - 1, y + r, w + 2, 1, 0, 0, 0, 255 );
+	}
+	FillRGBA( x - 1, y - 1, 3, 1, 0, 0, 0, 255 );
+	FillRGBA( x - 1, y + 14, 5, 1, 0, 0, 0, 255 );
+
+	for( int r = 0; r < 14; ++r )
+	{
+		const int w = r < 9 ? r + 1 : ( r < 12 ? 4 : 3 );
+		FillRGBA( x, y + r, w, 1, 255, 255, 255, 255 );
+	}
+}
+
+// Rectangle made of 1 pixel rows, the upper and/or the lower corners are rounded
+void FillRoundedRect( int x, int y, int w, int h, int radius, bool roundTop, bool roundBottom, int r, int g, int b, int a )
+{
+	if( w <= 0 || h <= 0 )
+		return;
+
+	radius = std::max( 0, std::min( radius, std::min( w, h ) / 2 ));
+
+	const int rt = roundTop ? radius : 0;
+	const int rb = roundBottom ? radius : 0;
+
+	FillRGBABlend( x, y + rt, w, h - rt - rb, r, g, b, a );
+
+	for( int i = 0; i < rt; ++i )
+	{
+		const float dy = rt - i - 0.5f;
+		const int inset = rt - (int)( std::sqrt( (float)( rt * rt ) - dy * dy ) + 0.5f );
+
+		FillRGBABlend( x + inset, y + i, w - inset * 2, 1, r, g, b, a );
+	}
+
+	for( int i = 0; i < rb; ++i )
+	{
+		const float dy = rb - i - 0.5f;
+		const int inset = rb - (int)( std::sqrt( (float)( rb * rb ) - dy * dy ) + 0.5f );
+
+		FillRGBABlend( x + inset, y + h - 1 - i, w - inset * 2, 1, r, g, b, a );
+	}
+}
+
+void FillFrame( int x, int y, int w, int h, int r, int g, int b, int a )
+{
+	FillRGBABlend( x, y, w, 1, r, g, b, a );
+	FillRGBABlend( x, y + h - 1, w, 1, r, g, b, a );
+	FillRGBABlend( x, y + 1, 1, h - 2, r, g, b, a );
+	FillRGBABlend( x + w - 1, y + 1, 1, h - 2, r, g, b, a );
+}
+
+// Texture with the glyphs of the window (see chrome_motd_font_data.h)
+int GetMotdFontTexture()
+{
+	if( g_motd_font_tex < 0 )
+	{
+		g_motd_font_tex = 0;
+
+		std::vector<std::uint8_t> rgba;
+
+		if( gRenderAPI.GL_CreateTexture && BuildMotdFontRgba( rgba ))
+		{
+			const int tex = gRenderAPI.GL_CreateTexture( "*motd_font", MotdFontData::kAtlasW, MotdFontData::kAtlasH,
+				rgba.data(), static_cast<texFlags_t>( TF_NOMIPMAP | TF_CLAMP | TF_HAS_ALPHA ));
+
+			if( tex > 0 )
+				g_motd_font_tex = tex;
+		}
+	}
+
+	return g_motd_font_tex;
+}
+
+// Draws a text glyph by glyph. With scale 1 every texel lands on its own pixel, so the text is sharp.
+// Returns false if the glyphs are not available.
+bool DrawMotdText( int face, const std::string& utf8, int x, int baseline, float scale, int r, int g, int b )
+{
+	const int tex = GetMotdFontTexture();
+
+	if( tex <= 0 || !gEngfuncs.pTriAPI )
+		return false;
+
+	std::vector<MotdGlyphQuad> quads;
+	MotdLayoutText( face, utf8, x, baseline, scale, quads );
+
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, tex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->Color4f( r / 255.0f, g / 255.0f, b / 255.0f, 1.0f );
+
+	for( const MotdGlyphQuad& q : quads )
+	{
+		const float x1 = (float)q.x, y1 = (float)q.y, x2 = (float)( q.x + q.w ), y2 = (float)( q.y + q.h );
+
+		gEngfuncs.pTriAPI->Begin( TRI_QUADS );
+		gEngfuncs.pTriAPI->TexCoord2f( q.u0, q.v0 );
+		gEngfuncs.pTriAPI->Vertex3f( x1, y1, 0 );
+		gEngfuncs.pTriAPI->TexCoord2f( q.u0, q.v1 );
+		gEngfuncs.pTriAPI->Vertex3f( x1, y2, 0 );
+		gEngfuncs.pTriAPI->TexCoord2f( q.u1, q.v1 );
+		gEngfuncs.pTriAPI->Vertex3f( x2, y2, 0 );
+		gEngfuncs.pTriAPI->TexCoord2f( q.u1, q.v0 );
+		gEngfuncs.pTriAPI->Vertex3f( x2, y1, 0 );
+		gEngfuncs.pTriAPI->End();
+	}
+
+	return true;
+}
+
+// The server MOTD is shown as a window like the one of the Steam version of the game:
+// a dark rounded panel with a cut through it, the server name, the page and the OK button.
+// All sizes are measured on the window of the Steam version (1126x824 for a page of 900x450 pixels)
+// and are scaled with the window.
+void PresentMotdWindow( ChromeInstance* inst )
+{
+	if( !inst )
+		return;
+
+	const unsigned int tex = inst->texture_id();
+	if( tex == 0 || !gEngfuncs.pTriAPI )
+		return;
+
+	const RenderExtents ext = VisibleRenderExtents();
+	if( ext.w <= 1 || ext.h <= 1 )
+		return;
+
+	int bw = inst->width();
+	int bh = inst->height();
+	if( bw < 1 )
+		bw = 1;
+	if( bh < 1 )
+		bh = 1;
+
+	inst->set_viewport( ChromeRect{ 0, 0, bw, bh } );
+
+	// layout (in pixels of the unscaled window)
+	const int marginL = 108, marginR = 118, marginT = 163;
+	const int buttonGap = 15, buttonW = 240, buttonH = 37, marginB = 159;
+	const int slitY = 99, slitH = 2;       // a cut through the panel: the game is seen through it
+	const int panelW = marginL + bw + marginR;
+	const int panelH = marginT + bh + buttonGap + buttonH + marginB;
+
+	const float scale = std::min( 1.0f, std::min( ext.w * 0.95f / panelW, ext.h * 0.95f / panelH ));
+	auto S = [scale]( int v ) { return (int)( v * scale + 0.5f ); };
+
+	const int panelX = (int)(( ext.w - panelW * scale ) * 0.5f );
+	const int panelY = std::max( 0, (int)(( ext.h - panelH * scale ) * 0.5f + ext.h * 0.0216f ));
+
+	const int pageX = panelX + S( marginL );
+	const int pageY = panelY + S( marginT );
+	const int pageW = S( bw );
+	const int pageH = S( bh );
+
+	const int btnX = pageX;
+	const int btnY = pageY + pageH + S( buttonGap );
+	const int btnW = S( buttonW );
+	const int btnH = S( buttonH );
+
+	MotdLayout lay;
+	lay.valid = true;
+	lay.x = (float)pageX;
+	lay.y = (float)pageY;
+	lay.w = (float)pageW;
+	lay.h = (float)pageH;
+	lay.scale = (float)pageW / bw;
+	lay.close_x = (float)btnX;
+	lay.close_y = (float)btnY;
+	lay.close_w = (float)btnW;
+	lay.close_h = (float)btnH;
+	g_motd_input.SetScreen( ext.w, ext.h );
+	g_motd_input.SetLayout( lay );
+
+	// panel: two parts with a cut between them
+	const int cutH = std::max( 1, S( slitH ));
+	const int upperH = S( slitY );
+	const int lowerY = panelY + upperH + cutH;
+	FillRoundedRect( panelX, panelY, S( panelW ), upperH, S( 14 ), true, false, 0, 0, 0, 204 );
+	FillRoundedRect( panelX, lowerY, S( panelW ), panelY + S( panelH ) - lowerY, S( 14 ), false, true, 0, 0, 0, 204 );
+
+	// title: the name of the server, with the same indent as in the Steam version
+	const std::string title = ToUtf8( gHUD.m_szServerName[0] ? gHUD.m_szServerName : "MOTD" );
+	const int titleX = panelX + S( 110 );
+	const int titleBase = panelY + S( 41 );
+	const float titleMax = ( panelW - 110 - 40 ) * 1.0f;
+
+	if( !DrawMotdText( 0, MotdFitText( 0, title, titleMax ), titleX, titleBase, scale, 255, 176, 0 ))
+	{
+		// no glyphs: the font of the HUD
+		const float titleScale = 1.4f * std::max( 0.6f, scale );
+		const int titleY = panelY + S( 31 ) - (int)( gHUD.GetCharHeight() * titleScale * 0.5f );
+		DrawUtils::DrawHudString( titleX, titleY, 9999, title.c_str(), 255, 176, 0, titleScale );
+	}
+
+	// the page
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, tex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->Color4f( 1.0f, 1.0f, 1.0f, 1.0f );
+	DrawUtils::Draw2DQuad( (float)pageX, (float)pageY, (float)pageW + pageX, (float)( pageY + pageH ));
+
+	// OK button
+	const bool hover = g_motd_input.cursor_over_close();
+	FillRGBABlend( btnX, btnY, btnW, btnH, 0, 0, 0, hover ? 230 : 200 );
+	if( hover )
+		FillFrame( btnX, btnY, btnW, btnH, 214, 147, 0, 255 );
+	else
+		FillFrame( btnX, btnY, btnW, btnH, 84, 58, 0, 255 );
+
+	const int okCap = (int)( MotdFontData::kFaces[1].cap * scale + 0.5f );
+	const int okW = (int)( MotdTextWidth( 1, "OK" ) * scale + 0.5f );
+	const int okX = btnX + ( btnW - okW ) / 2;
+	const int okBase = btnY + ( btnH + okCap ) / 2;
+
+	if( !DrawMotdText( 1, "OK", okX, okBase, scale, 255, 176, 0 ))
+	{
+		const float okScale = 0.85f * std::max( 0.6f, scale );
+		const int fbW = (int)( DrawUtils::HudStringLen( "OK" ) * okScale );
+		const int fbY = btnY + ( btnH - (int)( gHUD.GetCharHeight() * okScale )) / 2;
+		DrawUtils::DrawHudString( btnX + ( btnW - fbW ) / 2, fbY, 9999, "OK", 255, 176, 0, okScale );
+	}
+
+	DrawMotdCursor( (int)g_motd_input.cursor_x(), (int)g_motd_input.cursor_y() );
+}
+
+void Cmd_MotdClose()
+{
+	if( Chrome::IsMotdShown() )
+	{
+		gEngfuncs.Con_Printf( "[motd] closed by command\n" );
+		Chrome::HideMotd();
+	}
+}
+
+} // namespace
+
+namespace Chrome {
+
+bool Initialize()
+{
+	RegisterEngineCvars();
+	if( !EnsureCefInitialized() )
+		return false;
+
+	RegisterCommands();
+
+	return true;
+}
+
+void Shutdown()
+{
+	g_instances.clear();
+	g_toggle_demo_id = -1;
+	g_openurl_demo_id = -1;
+	g_motd_id = -1;
+
+	if( !g_chrome_service_up )
+		return;
+
+	iHTMLChrome::CEF::CefRuntime::Get().Shutdown();
+	g_chrome_service_up = false;
+	s_toggle_sync = -1;
+	Chrome_DPrintf( 1.f, "[chrome] Chrome::Shutdown complete\n" );
+}
+
+void RunFrame()
+{
+	if( !g_chrome_service_up )
+		return;
+
+	SetChromeZoom( static_cast<double>( CvarFloat( cl_chrome_zoom, 1.0f ) ) );
+	SetChromeFrameRate( static_cast<int>( CvarFloat( cl_chrome_framerate, 30.0f ) ) );
+
+	iHTMLChrome::CEF::CefRuntime::Get().DoMessageLoopWork();
+
+	for( auto& kv : g_instances )
+		if( kv.second )
+			kv.second->Tick();
+
+	SyncToggleDemoBrowser();
+}
+
+void PresentDebugPresentationOverlays()
+{
+	if( !g_chrome_service_up )
+		return;
+
+	if( g_toggle_demo_id >= 0 )
+		PresentDebugQuad( Lookup( g_toggle_demo_id ) );
+
+	if( g_openurl_demo_id >= 0 )
+		PresentDebugQuad( Lookup( g_openurl_demo_id ) );
+
+	if( g_motd_id >= 0 )
+		PresentMotdWindow( Lookup( g_motd_id ) );
+}
+
+int Create(
+	const char* url,
+	const int width,
+	const int height,
+	const ChromeOnPaintCallback callback,
+	void* userdata )
+{
+	if( !EnsureCefInitialized() )
+		return -1;
+
+	const int logical_w = width > 0 ? width : 1280;
+	const int logical_h = height > 0 ? height : 720;
+
+	const int id = g_next_instance_id++;
+
+	auto inst = std::make_unique<ChromeInstance>( id );
+	const char* start = ( url && url[0] ) ? url : "about:blank";
+
+	Chrome_DPrintf(
+		1.f,
+		"[chrome] Create id=%d url=%s logical=%dx%d\n",
+		id,
+		start,
+		logical_w,
+		logical_h );
+
+	if( !inst->Initialize( start ) )
+	{
+		Chrome_Printf( "[chrome] Chrome::Create failed during Initialize\n" );
+		return -1;
+	}
+
+	if( callback )
+		inst->SetPaintConsumer(
+			reinterpret_cast<ChromePaintConsumerFn>( callback ), userdata );
+
+	g_instances.emplace( id, std::move( inst ) );
+
+	Chrome::Resize( id, logical_w, logical_h );
+	return id;
+}
+
+void Destroy( const int instance_id )
+{
+	if( instance_id == g_toggle_demo_id )
+		g_toggle_demo_id = -1;
+	if( instance_id == g_openurl_demo_id )
+		g_openurl_demo_id = -1;
+	if( instance_id == g_motd_id )
+		g_motd_id = -1;
+	EraseInstanceRecord( instance_id );
+}
+
+void Resize( const int instance_id, const int width, const int height )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return;
+
+	Chrome_DPrintf( 1.f, "[chrome] Resize id=%d -> %dx%d\n", instance_id, width, height );
+	inst->Resize( width, height );
+}
+
+void Navigate( const int instance_id, const char* url )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return;
+
+	const char* nav = url && url[0] ? url : "about:blank";
+	Chrome_DPrintf( 1.f, "[chrome] Navigate id=%d -> %s\n", instance_id, nav );
+	inst->LoadURL( std::string( nav ) );
+}
+
+void SendMouseMove( const int instance_id, const int x, const int y )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return;
+
+	g_last_mouse_pos[instance_id] = std::make_pair( x, y );
+
+	InputEvent e;
+	e.type = InputType::MouseMove;
+	e.x = x;
+	e.y = y;
+	inst->EnqueueInput( e );
+}
+
+void SendMouseButton( const int instance_id, const int button, const bool down )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return;
+
+	const auto pos = g_last_mouse_pos.find( instance_id );
+
+	InputEvent e;
+	e.type = down ? InputType::MouseDown : InputType::MouseUp;
+	e.button = button;
+	if( pos != g_last_mouse_pos.end() )
+	{
+		e.x = pos->second.first;
+		e.y = pos->second.second;
+	}
+	inst->EnqueueInput( e );
+}
+
+void SendMouseWheel( const int instance_id, const int delta_x, const int delta_y )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return;
+
+	const auto pos = g_last_mouse_pos.find( instance_id );
+
+	InputEvent e;
+	e.type = InputType::MouseWheel;
+	e.delta_x = delta_x;
+	e.delta_y = delta_y;
+	if( pos != g_last_mouse_pos.end() )
+	{
+		e.x = pos->second.first;
+		e.y = pos->second.second;
+	}
+	inst->EnqueueInput( e );
+}
+
+void SendKeyEvent( const int instance_id, const int key_code, const bool down )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return;
+
+	int vk, ch;
+	if( !MapMotdKey( key_code, false, vk, ch ))
+		return;
+
+	InputEvent e;
+	e.type = down ? InputType::KeyDown : InputType::KeyUp;
+	e.key = vk;
+	inst->EnqueueInput( e );
+
+	if( down && ch )
+	{
+		InputEvent c;
+		c.type = InputType::KeyChar;
+		c.key = ch;
+		c.codepoint = (std::uint32_t)ch;
+		inst->EnqueueInput( c );
+	}
+}
+
+unsigned int GetTextureId( const int instance_id )
+{
+	ChromeInstance* inst = Lookup( instance_id );
+	if( !inst )
+		return 0;
+	return inst->texture_id();
+}
+
+bool IsAvailable()
+{
+#if defined( CS16CLIENT_ENABLE_CEF )
+	return g_chrome_service_up;
+#else
+	return false;
+#endif
+}
+
+bool ShowMotd( const char* url )
+{
+	if( !IsAvailable() || !url || !url[0] )
+		return false;
+
+	HideMotd();
+
+	// the page gets a window-like size (4:3), not the whole screen
+	const int id = Chrome::Create( url, 900, 450, nullptr, nullptr );
+	if( id < 0 )
+		return false;
+
+	g_motd_id = id;
+	g_motd_font_tex = -1;
+	g_motd_shown_at = std::chrono::steady_clock::now();
+
+	const RenderExtents ext = VisibleRenderExtents();
+	g_motd_input.Open( ext.w, ext.h );
+
+	gEngfuncs.Con_Printf( "[motd] shown: mouse and keyboard work in the window, ESC / OK button / cl_motd_close close it\n" );
+	return true;
+}
+
+void HideMotd()
+{
+	if( g_motd_id < 0 )
+		return;
+
+	const int id = g_motd_id;
+	g_motd_id = -1;
+	Chrome::Destroy( id );
+	gEngfuncs.Con_Printf( "[motd] window closed\n" );
+}
+
+bool IsMotdShown()
+{
+	return g_motd_id >= 0;
+}
+
+bool HandleMotdKey( int down, int keynum )
+{
+	if( keynum < 0 || keynum >= 256 )
+		return false;
+
+	// the window is closed: the release of a key that was used by it must not reach the game either
+	if( g_motd_id < 0 )
+		return !down && g_motd_input.OnKey( 0, keynum, NowSeconds() ).consumed;
+
+	const MotdOutput out = g_motd_input.OnKey( down, keynum, NowSeconds() );
+
+	ApplyMotdOutput( out );
+	return out.consumed;
+}
+
+bool MotdCapturesMouse()
+{
+	return g_motd_id >= 0;
+}
+
+void MotdMouseDelta( float dx, float dy )
+{
+	if( g_motd_id >= 0 )
+		ApplyMotdOutput( g_motd_input.OnMouseDelta( dx, dy ));
+}
+
+void HideMotdOnLevelChange()
+{
+	// the MOTD of a server comes right after the level is loaded, do not close it by mistake
+	if( g_motd_id >= 0 && std::chrono::steady_clock::now() - g_motd_shown_at > std::chrono::seconds( 3 ))
+	{
+		gEngfuncs.Con_Printf( "[motd] window closed: a new level was loaded\n" );
+		HideMotd();
+	}
+}
+} // namespace Chrome
