diff --git a/cl_dll/hud/MOTD_browser.cpp b/cl_dll/hud/MOTD_browser.cpp
new file mode 100644
index 0000000..0c32b91
--- /dev/null
+++ b/cl_dll/hud/MOTD_browser.cpp
@@ -0,0 +1,87 @@
+//
+// MOTD_browser.cpp
+//
+// OS specific helpers for opening server MOTD in the system web browser.
+// Kept in a separate file because <windows.h> conflicts with engine headers.
+// All strings here are UTF-8 (the addresses are plain ASCII after MotdUtil::MakeSafeUrl).
+//
+
+#include <stddef.h>
+
+bool MOTD_OpenInBrowser( const char *target );
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize );
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <shellapi.h>
+#include <stdio.h>
+#include <wchar.h>
+
+static bool Utf8ToWide( const char *s, wchar_t *out, int outCount )
+{
+	return MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, s, -1, out, outCount ) > 0;
+}
+
+bool MOTD_OpenInBrowser( const char *target )
+{
+	wchar_t wide[4096];
+
+	if( !target || !Utf8ToWide( target, wide, (int)( sizeof( wide ) / sizeof( wide[0] ))))
+		return false;
+
+	HINSTANCE result = ShellExecuteW( NULL, L"open", wide, NULL, NULL, SW_SHOWNORMAL );
+
+	return (INT_PTR)result > 32;
+}
+
+// The page is saved to %TEMP%\cs16_motd.html. The folder of a user can have any letters in its
+// name (C:\Users\Иван\...), so the wide functions of Windows are used and the path is given back in UTF-8.
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	wchar_t dir[MAX_PATH + 1];
+	const DWORD n = GetTempPathW( MAX_PATH + 1, dir );
+
+	if( n == 0 || n > MAX_PATH )
+		return false;
+
+	wchar_t path[MAX_PATH + 32];
+
+	if( _snwprintf( path, sizeof( path ) / sizeof( path[0] ), L"%lscs16_motd.html", dir ) <= 0 )
+		return false;
+
+	path[sizeof( path ) / sizeof( path[0] ) - 1] = 0;
+
+	FILE *f = _wfopen( path, L"wb" );
+
+	if( !f )
+		return false;
+
+	const size_t written = fwrite( html, 1, len, f );
+	fclose( f );
+
+	if( written != len )
+		return false;
+
+	return WideCharToMultiByte( CP_UTF8, 0, path, -1, outPath, (int)outSize, NULL, NULL ) > 0;
+}
+
+#else // not implemented on other platforms yet
+
+bool MOTD_OpenInBrowser( const char *target )
+{
+	(void)target;
+	return false;
+}
+
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	(void)html; (void)len; (void)outPath; (void)outSize;
+	return false;
+}
+
+#endif
diff --git a/cl_dll/hud/MOTD_text_gdi.cpp b/cl_dll/hud/MOTD_text_gdi.cpp
new file mode 100644
index 0000000..026a43d
--- /dev/null
+++ b/cl_dll/hud/MOTD_text_gdi.cpp
@@ -0,0 +1,190 @@
+//
+// MOTD_text_gdi.cpp
+//
+// Text of the server MOTD window, drawn with the fonts of Windows (GDI): the same families that
+// the Steam version uses, any size, any characters. The result is a picture with the coverage of
+// the glyphs that the client shows as a texture, one pixel on one pixel.
+// Kept in a separate file because <windows.h> conflicts with engine headers.
+//
+
+#include <string.h>
+#include <string>
+#include <vector>
+
+// utf8        - the text
+// pixelHeight - height of the font in pixels
+// maxWidth    - the text is cut with "..." if it is wider (0 - no limit)
+// alpha       - width * height bytes: how much of every pixel is covered by the glyphs
+// ascent      - distance from the top of the picture to the baseline
+bool MOTD_RenderText( const char *utf8, int pixelHeight, bool bold, int maxWidth,
+					  std::vector<unsigned char> &alpha, int &width, int &height, int &ascent );
+
+// The same with the font given: face (tried first, then the usual list), weight (400 normal, 700 bold) and
+// antialiasing
+bool MOTD_RenderTextFont( const char *utf8, const char *face, int pixelHeight, int weight, bool antialias, int maxWidth,
+						  std::vector<unsigned char> &alpha, int &width, int &height, int &ascent );
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <wchar.h>
+
+// a font the system really has is searched in this order (the wanted one first)
+static HFONT CreateUiFont( HDC dc, int pixelHeight, int weight, bool antialias, const wchar_t *wanted )
+{
+	static const wchar_t *defaults[] = { L"Trebuchet MS", L"Tahoma", L"Segoe UI", L"Verdana", L"Arial" };
+	const wchar_t *faces[6];
+	int count = 0;
+
+	if( wanted && wanted[0] )
+		faces[count++] = wanted;
+	for( const wchar_t *f : defaults )
+		faces[count++] = f;
+
+	const DWORD quality = antialias ? ANTIALIASED_QUALITY : NONANTIALIASED_QUALITY;
+
+	for( int i = 0; i < count; ++i )
+	{
+		const wchar_t *face = faces[i];
+		HFONT font = CreateFontW( -pixelHeight, 0, 0, 0, weight, FALSE, FALSE, FALSE,
+			DEFAULT_CHARSET, OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, quality, DEFAULT_PITCH | FF_SWISS, face );
+
+		if( !font )
+			continue;
+
+		HGDIOBJ old = SelectObject( dc, font );
+		wchar_t actual[LF_FACESIZE] = {};
+		GetTextFaceW( dc, LF_FACESIZE, actual );
+		SelectObject( dc, old );
+
+		if( _wcsicmp( actual, face ) == 0 )
+			return font;
+
+		DeleteObject( font ); // the system gave another font instead
+	}
+
+	// none of them: whatever the system has
+	return CreateFontW( -pixelHeight, 0, 0, 0, weight, FALSE, FALSE, FALSE,
+		DEFAULT_CHARSET, OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, quality, DEFAULT_PITCH | FF_SWISS, L"Arial" );
+}
+
+bool MOTD_RenderText( const char *utf8, int pixelHeight, bool bold, int maxWidth,
+					  std::vector<unsigned char> &alpha, int &width, int &height, int &ascent )
+{
+	return MOTD_RenderTextFont( utf8, nullptr, pixelHeight, bold ? FW_BOLD : FW_NORMAL, true, maxWidth, alpha, width, height, ascent );
+}
+
+bool MOTD_RenderTextFont( const char *utf8, const char *faceUtf8, int pixelHeight, int weight, bool antialias, int maxWidth,
+						  std::vector<unsigned char> &alpha, int &width, int &height, int &ascent )
+{
+	if( !utf8 || !utf8[0] || pixelHeight < 4 )
+		return false;
+
+	const int wlen = MultiByteToWideChar( CP_UTF8, 0, utf8, -1, nullptr, 0 );
+
+	if( wlen <= 1 )
+		return false;
+
+	std::wstring text( (size_t)wlen, L'\0' );
+	MultiByteToWideChar( CP_UTF8, 0, utf8, -1, &text[0], wlen );
+	text.resize( (size_t)wlen - 1 );
+
+	HDC screen = GetDC( nullptr );
+	HDC dc = CreateCompatibleDC( screen );
+	ReleaseDC( nullptr, screen );
+
+	if( !dc )
+		return false;
+
+	bool ok = false;
+	wchar_t face[LF_FACESIZE] = {};
+	if( faceUtf8 && faceUtf8[0] )
+		MultiByteToWideChar( CP_UTF8, 0, faceUtf8, -1, face, LF_FACESIZE - 1 );
+
+	HFONT font = CreateUiFont( dc, pixelHeight, weight, antialias, face );
+	HGDIOBJ oldFont = font ? SelectObject( dc, font ) : nullptr;
+
+	TEXTMETRICW tm = {};
+	SIZE size = {};
+
+	if( font && GetTextMetricsW( dc, &tm ) && GetTextExtentPoint32W( dc, text.c_str(), (int)text.size(), &size ))
+	{
+		int w = size.cx + 2; // a little room for glyphs that stick out
+		const int h = tm.tmHeight;
+
+		if( maxWidth > 0 && w > maxWidth )
+			w = maxWidth;
+
+		BITMAPINFO bi = {};
+		bi.bmiHeader.biSize = sizeof( BITMAPINFOHEADER );
+		bi.bmiHeader.biWidth = w;
+		bi.bmiHeader.biHeight = -h; // from the top to the bottom
+		bi.bmiHeader.biPlanes = 1;
+		bi.bmiHeader.biBitCount = 32;
+		bi.bmiHeader.biCompression = BI_RGB;
+
+		void *bits = nullptr;
+		HBITMAP bitmap = ( w > 0 && h > 0 ) ? CreateDIBSection( dc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0 ) : nullptr;
+
+		if( bitmap && bits )
+		{
+			HGDIOBJ oldBitmap = SelectObject( dc, bitmap );
+
+			memset( bits, 0, (size_t)w * h * 4 );
+			SetBkColor( dc, RGB( 0, 0, 0 ));
+			SetTextColor( dc, RGB( 255, 255, 255 ));
+			SetBkMode( dc, OPAQUE );
+
+			RECT rc = { 0, 0, w, h };
+			DrawTextW( dc, text.c_str(), (int)text.size(), &rc, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS );
+			GdiFlush();
+
+			// white text on black: the brightness of a pixel is how much of it the glyph covers
+			alpha.resize( (size_t)w * h );
+
+			const unsigned char *p = static_cast<const unsigned char *>( bits );
+
+			for( size_t i = 0, n = (size_t)w * h; i < n; ++i, p += 4 )
+			{
+				unsigned char m = p[0] > p[1] ? p[0] : p[1];
+				alpha[i] = m > p[2] ? m : p[2];
+			}
+
+			width = w;
+			height = h;
+			ascent = tm.tmAscent;
+			ok = true;
+
+			SelectObject( dc, oldBitmap );
+		}
+
+		if( bitmap )
+			DeleteObject( bitmap );
+	}
+
+	if( oldFont )
+		SelectObject( dc, oldFont );
+	if( font )
+		DeleteObject( font );
+
+	DeleteDC( dc );
+	return ok;
+}
+
+#else // not implemented on other platforms: the font of the HUD is used there
+
+bool MOTD_RenderText( const char *, int, bool, int, std::vector<unsigned char> &, int &, int &, int & )
+{
+	return false;
+}
+
+bool MOTD_RenderTextFont( const char *, const char *, int, int, bool, int, std::vector<unsigned char> &, int &, int &, int & )
+{
+	return false;
+}
+
+#endif
diff --git a/cl_dll/hud/motd_util.h b/cl_dll/hud/motd_util.h
new file mode 100644
index 0000000..53fcfae
--- /dev/null
+++ b/cl_dll/hud/motd_util.h
@@ -0,0 +1,308 @@
+//
+// motd_util.h
+//
+// Helpers of the server MOTD: recognising HTML, finding the address of an iframe, making an address
+// safe to give to the system. No dependencies on the engine, so the same file is used by every build
+// of the client and can be tested alone.
+//
+
+#pragma once
+
+#include <stddef.h>
+#include <string.h>
+
+namespace MotdUtil {
+
+inline char LowerAscii( char c )
+{
+	return ( c >= 'A' && c <= 'Z' ) ? (char)( c + 'a' - 'A' ) : c;
+}
+
+// prefix must be in lower case
+inline bool StartsWithNoCase( const char *s, const char *prefix )
+{
+	while( *prefix )
+	{
+		if( LowerAscii( *s++ ) != *prefix++ )
+			return false;
+	}
+
+	return true;
+}
+
+inline bool IsBlank( char c )
+{
+	return (unsigned char)c <= ' ';
+}
+
+inline bool IsAsciiLetter( char c )
+{
+	return ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' );
+}
+
+inline bool IsHttpUrl( const char *s )
+{
+	return StartsWithNoCase( s, "http://" ) || StartsWithNoCase( s, "https://" );
+}
+
+// The text of a MOTD is HTML if it starts with a tag: "<html", "<!DOCTYPE", "<b>", "</p>"...
+// A text like "<<< Welcome >>>" or "<-- rules" is not HTML and is shown in the game.
+inline bool LooksLikeHtml( const char *s )
+{
+	while( *s && IsBlank( *s ))
+		s++;
+
+	if( s[0] != '<' )
+		return false;
+
+	if( IsAsciiLetter( s[1] ) || s[1] == '!' || s[1] == '?' )
+		return true;
+
+	return s[1] == '/' && IsAsciiLetter( s[2] );
+}
+
+// the tag <name ...> starts at s ('<' included); name in lower case
+inline bool IsTagStart( const char *s, const char *name )
+{
+	if( s[0] != '<' || !StartsWithNoCase( s + 1, name ))
+		return false;
+
+	const char after = s[1 + strlen( name )];
+	return IsBlank( after ) || after == '>' || after == '/';
+}
+
+// first occurrence of what (lower case) in s, ignoring the case; NULL if there is none
+inline const char *FindNoCase( const char *s, const char *what )
+{
+	for( ; *s; s++ )
+		if( StartsWithNoCase( s, what ))
+			return s;
+
+	return NULL;
+}
+
+// Reads the attributes of a tag that starts at p (right after its name), the way a browser does:
+// with quotes or without, '>' can be inside quotes, the first src counts.
+// Returns: 1 - an http(s) src was found and copied to out, 0 - the tag has no usable src (end is set
+// to the end of the tag), -1 - the tag is not closed (the rest of the page is swallowed by it).
+inline int ReadIframeSrc( const char *p, char *out, size_t outSize, const char **end )
+{
+	for( ;; )
+	{
+		while( *p && ( IsBlank( *p ) || *p == '/' ))
+			p++;
+
+		if( !*p )
+			return -1;
+
+		if( *p == '>' )
+		{
+			*end = p + 1;
+			return 0;
+		}
+
+		// name of the attribute
+		const char *name = p;
+
+		while( *p && !IsBlank( *p ) && *p != '=' && *p != '>' && *p != '/' )
+			p++;
+
+		const size_t nameLen = (size_t)( p - name );
+
+		while( *p && IsBlank( *p ))
+			p++;
+
+		if( *p != '=' )
+			continue; // an attribute without a value
+
+		p++;
+
+		while( *p && IsBlank( *p ))
+			p++;
+
+		// the value
+		char quote = 0;
+
+		if( *p == '"' || *p == '\'' )
+			quote = *p++;
+
+		const char *value = p;
+
+		while( *p && ( quote ? ( *p != quote ) : ( !IsBlank( *p ) && *p != '>' )))
+			p++;
+
+		if( !*p )
+			return -1;
+
+		const char *valueEnd = p;
+
+		if( quote )
+			p++; // the closing quote
+
+		if( nameLen != 3 || !StartsWithNoCase( name, "src" ))
+			continue;
+
+		// blanks around the address are not a part of it
+		while( value < valueEnd && IsBlank( *value ))
+			value++;
+
+		while( valueEnd > value && IsBlank( valueEnd[-1] ))
+			valueEnd--;
+
+		size_t len = 0;
+		bool ok = true;
+
+		for( const char *q = value; q < valueEnd; q++ )
+		{
+			if( IsBlank( *q )) // an address never contains blanks or control characters
+			{
+				ok = false;
+				break;
+			}
+
+			char c = *q;
+
+			if( valueEnd - q >= 5 && !strncmp( q, "&amp;", 5 )) // HTML escaping of '&'
+			{
+				c = '&';
+				q += 4;
+			}
+
+			if( len + 1 >= outSize )
+			{
+				ok = false;
+				break;
+			}
+
+			out[len++] = c;
+		}
+
+		if( ok )
+		{
+			out[len] = 0;
+
+			if( IsHttpUrl( out ))
+				return 1;
+		}
+
+		// the first src of a tag decides: skip the rest of this tag
+		for( ;; )
+		{
+			while( *p && *p != '>' && *p != '"' && *p != '\'' )
+				p++;
+
+			if( !*p )
+				return -1;
+
+			if( *p == '>' )
+			{
+				*end = p + 1;
+				return 0;
+			}
+
+			const char *closing = strchr( p + 1, *p );
+
+			if( !closing )
+				return -1;
+
+			p = closing + 1;
+		}
+	}
+}
+
+// Finds the first <iframe ... src="http(s)://..."> of a page and copies its address to out.
+// Comments (<!-- -->), scripts and styles are skipped: an iframe written there is not on the page.
+// Returns false if there is no such iframe.
+inline bool ExtractIframeSrc( const char *html, char *out, size_t outSize )
+{
+	if( !html || !out || outSize == 0 )
+		return false;
+
+	const char *p = html;
+
+	while(( p = strchr( p, '<' )) != NULL )
+	{
+		if( !strncmp( p, "<!--", 4 ))
+		{
+			const char *close = strstr( p + 4, "-->" );
+
+			if( !close )
+				return false; // the rest of the page is a comment
+			p = close + 3;
+			continue;
+		}
+
+		if( IsTagStart( p, "script" ) || IsTagStart( p, "style" ))
+		{
+			const char *close = FindNoCase( p + 1, IsTagStart( p, "script" ) ? "</script" : "</style" );
+
+			if( !close )
+				return false; // the rest of the page is a script
+			p = close + 2;
+			continue;
+		}
+
+		if( IsTagStart( p, "iframe" ))
+		{
+			const char *end = NULL;
+			const int r = ReadIframeSrc( p + 7, out, outSize, &end );
+
+			if( r == 1 )
+				return true;
+			if( r < 0 )
+				return false;
+
+			p = end;
+			continue;
+		}
+
+		p++;
+	}
+
+	return false;
+}
+
+// Makes an http(s) address of a server safe to give to the system browser: everything that is not
+// a plain character of an address (quotes, '<', '>', '\', '^', '`', '{', '|', '}', letters that are
+// not ASCII) is written as %XX, so the address cannot break out of the command line of the browser.
+// Returns false if it is not an http(s) address, has control characters or does not fit into out.
+inline bool MakeSafeUrl( const char *in, char *out, size_t outSize )
+{
+	static const char hex[] = "0123456789ABCDEF";
+
+	if( !in || !out || outSize == 0 || !IsHttpUrl( in ))
+		return false;
+
+	size_t len = 0;
+
+	for( const unsigned char *p = (const unsigned char *)in; *p; p++ )
+	{
+		const unsigned char c = *p;
+
+		if( c <= ' ' || c == 0x7F )
+			return false;
+
+		const bool plain = ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' ) || ( c >= '0' && c <= '9' )
+			|| ( c < 0x80 && strchr( "-._~:/?#[]@!$&'()*+,;=%", (char)c ));
+
+		if( plain )
+		{
+			if( len + 1 >= outSize )
+				return false;
+			out[len++] = (char)c;
+		}
+		else
+		{
+			if( len + 3 >= outSize )
+				return false;
+			out[len++] = '%';
+			out[len++] = hex[c >> 4];
+			out[len++] = hex[c & 15];
+		}
+	}
+
+	out[len] = 0;
+	return true;
+}
