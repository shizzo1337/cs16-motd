+    # ==================================================
+    # WINDOWS
+    # ==================================================
+    if(WIN32)
+        target_compile_definitions(${target_name} PRIVATE NOMINMAX)
+
+        target_link_directories(${target_name} PRIVATE "${CEF_BIN}")
