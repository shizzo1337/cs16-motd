new file mode 100644
index 0000000..0c32b91
--- /dev/null
+++ b/cl_dll/hud/MOTD_browser.cpp
@@ -0,0 +1,87 @@
+//
+// MOTD_browser.cpp
+//
+// OS specific helpers for opening server MOTD in the system web browser.
+// Kept in a separate file because <windows.h> conflicts with engine headers.
+// All strings here are UTF-8 (the addresses are plain ASCII after MotdUtil::MakeSafeUrl).
+//
+
+#include <stddef.h>
+
+bool MOTD_OpenInBrowser( const char *target );
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize );
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <shellapi.h>
+#include <stdio.h>
+#include <wchar.h>
+
+static bool Utf8ToWide( const char *s, wchar_t *out, int outCount )
+{
+	return MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, s, -1, out, outCount ) > 0;
+}
+
+bool MOTD_OpenInBrowser( const char *target )
+{
+	wchar_t wide[4096];
+
+	if( !target || !Utf8ToWide( target, wide, (int)( sizeof( wide ) / sizeof( wide[0] ))))
+		return false;
+
+	HINSTANCE result = ShellExecuteW( NULL, L"open", wide, NULL, NULL, SW_SHOWNORMAL );
+
+	return (INT_PTR)result > 32;
+}
+
+// The page is saved to %TEMP%\cs16_motd.html. The folder of a user can have any letters in its
+// name (C:\Users\Иван\...), so the wide functions of Windows are used and the path is given back in UTF-8.
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	wchar_t dir[MAX_PATH + 1];
+	const DWORD n = GetTempPathW( MAX_PATH + 1, dir );
+
+	if( n == 0 || n > MAX_PATH )
+		return false;
+
+	wchar_t path[MAX_PATH + 32];
+
+	if( _snwprintf( path, sizeof( path ) / sizeof( path[0] ), L"%lscs16_motd.html", dir ) <= 0 )
+		return false;
+
+	path[sizeof( path ) / sizeof( path[0] ) - 1] = 0;
+
+	FILE *f = _wfopen( path, L"wb" );
+
+	if( !f )
+		return false;
+
+	const size_t written = fwrite( html, 1, len, f );
+	fclose( f );
+
+	if( written != len )
+		return false;
+
+	return WideCharToMultiByte( CP_UTF8, 0, path, -1, outPath, (int)outSize, NULL, NULL ) > 0;
+}
+
+#else // not implemented on other platforms yet
+
+bool MOTD_OpenInBrowser( const char *target )
+{
+	(void)target;
+	return false;
+}
+
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	(void)html; (void)len; (void)outPath; (void)outSize;
+	return false;
+}
+
+#endif
diff --git a/cl_dll/hud/client_texture.h b/cl_dll/hud/client_texture.h
new file mode 100644
index 0000000..c24bcd8
--- /dev/null
+++ b/cl_dll/hud/client_texture.h
@@ -0,0 +1,82 @@
+//
+// client_texture.h
+//
+// The textures the client makes itself (the texts drawn by Windows fonts, the MOTD window) are known by their
+// number and their name. The number alone is not enough: if the engine has freed the texture (a restart of the
+// renderer frees all of them), the same number may be given to a texture of the engine, for example a font.
+// Freeing it, drawing into it or showing it by the old number would break that texture: the texts of the chat
+// and the kill feed become black boxes. So the number is used only while the engine has our name for it.
+//
+
+#pragma once
+
+#include <string.h>
+
+#include "wrect.h"
+#include "cl_dll.h"
+
+namespace ClientTexture {
+
+// a journal of the last operations of the client with its textures (texture_watch.cpp): when a texture of a font
+// of the engine disappears, the journal is printed, so it is seen whether the client had that number
+void Note( const char *op, int tex, const char *name );
+void PrintJournal( int count );
+
+// checks every frame that the textures of the fonts of the engine are still there (texture_watch.cpp)
+void WatchFonts( void );
+
+// the texture of the console font the client draws the chat and the kill feed with is gone (they would be black
+// boxes): the client draws them with the font of the HUD instead (draw_util.h)
+bool EngineFontBroken( void );
+
+// is the texture "tex" still the one we made with the name "name"
+inline bool Owned( int tex, const char *name )
+{
+	if( tex <= 0 || !name || !name[0] )
+		return false;
+
+	if( gRenderAPI.GL_FindTexture )
+		return gRenderAPI.GL_FindTexture( name ) == tex;
+
+	if( gRenderAPI.GL_TextureName )
+	{
+		const char *current = gRenderAPI.GL_TextureName( (unsigned int)tex );
+		return current && !strcmp( current, name );
+	}
+
+	return true; // an engine without these functions: trust the number
+}
+
+// tells in the console (a few times only) that the engine has freed a texture of the client: it helps to find
+// out what breaks the textures (see the command cl_textures_check)
+inline void ReportLost( const char *name )
+{
+	static int reported = 0;
+	if( reported < 8 && name && name[0] )
+	{
+		++reported;
+		gEngfuncs.Con_Printf( "[client textures] the engine has freed \"%s\", the client makes it again\n", name );
+	}
+	Note( "lost", 0, name );
+}
+
+// frees the texture only if it is still ours; the number is forgotten anyway
+inline void Free( int &tex, const char *name )
+{
+	if( tex > 0 )
+	{
+		if( Owned( tex, name ) && gRenderAPI.GL_FreeTexture )
+		{
+			Note( "free", tex, name );
+			gRenderAPI.GL_FreeTexture( (unsigned int)tex );
+		}
+		else
+		{
+			Note( "forget (not ours)", tex, name );
+		}
+	}
+
+	tex = 0;
+}
+
+} // namespace ClientTexture
