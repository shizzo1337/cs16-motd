+static std::string MakeHtmlDataUrl( const char *html, bool cutByBuffer )
+{
+	static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	std::string page( html );
