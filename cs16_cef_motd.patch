+static bool StartsWithNoCase( const char *s, const char *prefix )
+{
+	while( *prefix )
+	{
+		char a = *s++;
+		char b = *prefix++;
+
+		if( a >= 'A' && a <= 'Z' )
+			a += 'a' - 'A';
+
+		if( a != b )
+			return false;
+	}
+
+	return true;
+}
+
+#if XASH_WIN32 == 1
+bool MOTD_OpenInBrowser( const char *target );
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize );
+#endif
+
+static bool IsBlank( char c )
+{
+	return (unsigned char)c <= ' ';
+}
+
+static const char *FindNoCase( const char *s, const char *what )
+{
+	for( ; *s; s++ )
+		if( StartsWithNoCase( s, what ))
+			return s;
+
+	return NULL;
+}
+
+// Finds the first <iframe ... src="http(s)://..."> in HTML and copies its address to out.
+// Returns false if there is no such iframe or the address looks wrong.
+static bool ExtractIframeSrc( const char *html, char *out, size_t outSize )
+{
+	const char *tag = html;
+
+	while(( tag = FindNoCase( tag, "<iframe" )) != NULL )
+	{
+		const char *p = tag + 7;
+		tag = p; // continue the search after this tag if it does not fit
+
+		if( !IsBlank( *p ) && *p != '/' ) // not "<iframe", e.g. "<iframes"
+			continue;
+
+		const char *tagEnd = strchr( p, '>' );
+
+		if( !tagEnd )
+			tagEnd = p + strlen( p );
+
+		for( const char *a = p; a < tagEnd; a++ )
+		{
+			// attribute name begins after a blank, so "data-src" and "srcdoc" do not match
+			if( !IsBlank( a[-1] ) || !StartsWithNoCase( a, "src" ))
+				continue;
+
+			const char *q = a + 3;
+
+			while( q < tagEnd && IsBlank( *q )) q++;
+
+			if( q >= tagEnd || *q != '=' )
+				continue;
+
+			q++;
+			while( q < tagEnd && IsBlank( *q )) q++;
+
+			char quote = 0;
+
+			if( *q == '"' || *q == '\'' )
+				quote = *q++;
+
+			size_t len = 0;
+			bool ok = true;
+
+			for( ; *q; q++ )
+			{
+				if( quote ? ( *q == quote ) : ( IsBlank( *q ) || *q == '>' ))
+					break;
+
+				if( IsBlank( *q )) // an address never contains blanks or control characters
+				{
+					ok = false;
+					break;
+				}
+
+				if( !strncmp( q, "&amp;", 5 )) // HTML escaping of '&'
+				{
+					if( len + 1 >= outSize ) { ok = false; break; }
+					out[len++] = '&';
+					q += 4;
+					continue;
+				}
+
+				if( len + 1 >= outSize )
+				{
+					ok = false;
+					break;
+				}
+
+				out[len++] = *q;
+			}
+
+			// a tag that is not closed is dropped by browsers as well
+			if( ok && !*q )
+				ok = false;
+
+			if( ok )
+			{
+				out[len] = 0;
+
+				// only http(s) addresses are opened
+				if( StartsWithNoCase( out, "http://" ) || StartsWithNoCase( out, "https://" ))
+					return true;
+			}
+
+			break; // look at the next iframe
+		}
+	}
+
+	return false;
+}
+
+// MOTD HTML is given to the embedded browser as a data: address
+static bool MakeHtmlDataUrl( const char *html, int len, char *out, size_t outSize )
+{
+	static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	static const char prefix[] = "data:text/html;charset=utf-8;base64,";
+	size_t need = sizeof( prefix ) - 1 + (( (size_t)len + 2 ) / 3 ) * 4 + 1;
+
+	if( len <= 0 || need > outSize )
+		return false;
+
+	memcpy( out, prefix, sizeof( prefix ) - 1 );
+	char *o = out + sizeof( prefix ) - 1;
+
+	for( int i = 0; i < len; i += 3 )
+	{
+		unsigned int v = (unsigned char)html[i] << 16;
+		int n = len - i;
+
+		if( n > 1 ) v |= (unsigned char)html[i + 1] << 8;
+		if( n > 2 ) v |= (unsigned char)html[i + 2];
+
+		*o++ = b64[( v >> 18 ) & 63];
+		*o++ = b64[( v >> 12 ) & 63];
+		*o++ = ( n > 1 ) ? b64[( v >> 6 ) & 63] : '=';
+		*o++ = ( n > 2 ) ? b64[v & 63] : '=';
+	}
+
+	*o = 0;
+	return true;
+}
+
+void CHudMOTD :: ResetBrowserState( void )
+{
+	m_bMotdStarted = false;
+	m_iBrowserMode = BROWSER_NONE;
+	m_iBrowserLen = 0;
+	m_szBrowserMOTD[0] = 0;
+}
+
+// Returns true if this MOTD chunk was consumed and must not be shown in game.
+// MOTD comes in chunks, so we decide what to do at the first chunk:
+//  - text starting with http:// or https:// is opened in the browser as a link
+//  - text starting with '<' is HTML, it is saved to a file and opened in the browser
+//  - anything else is shown in game as usual
+bool CHudMOTD :: HandleBrowserMOTD( const char *chunk, bool finished )
+{
+#if XASH_WIN32 == 1
+	int mode = (int)cl_motd_browser->value;
+
+	if( mode < 1 )
+	{
+		m_bMotdStarted = false;
+		return false;
+	}
+
+	if( !m_bMotdStarted )
+	{
+		const char *p = chunk;
+
+		ResetBrowserState();
+		m_bMotdStarted = true;
+
+		while( *p && (unsigned char)*p <= ' ' )
+			p++;
+
+		if( StartsWithNoCase( p, "http://" ) || StartsWithNoCase( p, "https://" ))
+			m_iBrowserMode = BROWSER_URL;
+		else if( mode >= 2 && *p == '<' )
+			m_iBrowserMode = BROWSER_HTML;
+	}
+
+	if( m_iBrowserMode == BROWSER_NONE )
+	{
+		if( finished )
+			m_bMotdStarted = false;
+
+		return false; // usual text MOTD, show it in game
+	}
+
+	// accumulate
+	int chunkLen = (int)strlen( chunk );
+	int room = (int)sizeof( m_szBrowserMOTD ) - 1 - m_iBrowserLen;
+
+	if( chunkLen > room )
+		chunkLen = room;
+
+	if( chunkLen > 0 )
+	{
+		memcpy( m_szBrowserMOTD + m_iBrowserLen, chunk, chunkLen );
+		m_iBrowserLen += chunkLen;
+		m_szBrowserMOTD[m_iBrowserLen] = 0;
+	}
+
+	if( !finished )
+		return true;
+
+	// whole MOTD received
+	// mode 3: the page is shown in the game by the built-in browser (falls back to the system browser if it is not available)
+	const bool cef = mode >= 3;
+
+	if( m_iBrowserMode == BROWSER_URL )
+	{
+		char *url = m_szBrowserMOTD;
+		char *end;
+
+		while( *url && (unsigned char)*url <= ' ' )
+			url++;
+
+		// URL ends on the first whitespace
+		for( end = url; *end && (unsigned char)*end > ' '; end++ );
+		*end = 0;
+
+		// only http(s) links, never pass anything else from the server to the system
+		if( StartsWithNoCase( url, "http://" ) || StartsWithNoCase( url, "https://" ))
+		{
+			if( cef && Chrome::ShowMotd( url ))
+			{
+				gEngfuncs.Con_Printf( "Showing MOTD in the game browser: %s\n", url );
+			}
+			else
+			{
+				gEngfuncs.Con_Printf( "Opening MOTD in browser: %s\n", url );
+				MOTD_OpenInBrowser( url );
+			}
+		}
+	}
+	else if( m_iBrowserMode == BROWSER_HTML )
+	{
+		char iframeUrl[2048];
+		char path[512];
+		static char dataUrl[22528]; // enough for the base64 form of the whole MOTD buffer
+
+		if( cef && MakeHtmlDataUrl( m_szBrowserMOTD, m_iBrowserLen, dataUrl, sizeof( dataUrl )) && Chrome::ShowMotd( dataUrl ))
+		{
+			// the whole page is shown, like the original embedded browser does
+			gEngfuncs.Con_Printf( "Showing MOTD in the game browser\n" );
+		}
+		else if( cl_motd_browser_iframe->value != 0 && ExtractIframeSrc( m_szBrowserMOTD, iframeUrl, sizeof( iframeUrl )))
+		{
+			// the page is only a wrapper around an iframe, open the iframe address directly
+			gEngfuncs.Con_Printf( "Opening MOTD iframe in browser: %s\n", iframeUrl );
+			MOTD_OpenInBrowser( iframeUrl );
+		}
+		else if( MOTD_SaveTempHtml( m_szBrowserMOTD, m_iBrowserLen, path, sizeof( path )))
+		{
+			gEngfuncs.Con_Printf( "Opening MOTD in browser: %s\n", path );
+			MOTD_OpenInBrowser( path );
+		}
+		else gEngfuncs.Con_Printf( "Can't save MOTD to a temporary file\n" );
+	}
+
+	ResetBrowserState();
+	return true;
+#else
+	(void)chunk; (void)finished;
+	return false;
+#endif
+}
