+void CClientWindow::SetButtonShown( CMenuAction *button, int key, bool shown )
+{
+	if( !button || key <= 0 || key >= 256 )
+		return;
+
+	if( shown )
+	{
+		keys[key] = button->onPressed;
+		keyButtons[key] = button;
+		button->Show();
+	}
+	else
+	{
+		keys[key].Reset();
+		keyButtons[key] = NULL;
+		button->Hide();
+	}
+}
