+
+		char name[32], cmd[64];
+		snprintf( name, sizeof( name ), "_spec_pl_%d", i );
+		snprintf( cmd, sizeof( cmd ), "_spec_follow_item %d", i );
+		AddTouch( name, cmd, it );
