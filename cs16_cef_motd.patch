+	virtual void HandleInput( const InputEvent& event ) = 0;
+	virtual void Tick() = 0;
+};
+
+std::unique_ptr<ChromeBackend> CreateChromeBackend();
+
+void SetChromeZoom( double scale );
+void SetChromeFrameRate( int frames_per_second );
