new file mode 100644
index 0000000..fd998fc
--- /dev/null
+++ b/cl_dll/hud/glyph_atlas.cpp
@@ -0,0 +1,306 @@
+//
+// glyph_atlas.cpp
+//
+
+#include "hud.h"
+#include "cl_util.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <memory>
+
+#include "glyph_atlas.h"
+#include "glyph_gdi.h"
+#include "client_texture.h"
+
+namespace {
+
+std::vector<std::unique_ptr<CGlyphFont>> g_fonts;
+int g_pageCounter = 0;
+
+// the letters drawn when a font is made: ASCII, Latin-1, Cyrillic, the usual signs
+void InitialChars( std::vector<char32_t> &out )
+{
+	for( char32_t c = 0x20; c < 0x7F; ++c )
+		out.push_back( c );
+	for( char32_t c = 0xA0; c <= 0xFF; ++c )
+		out.push_back( c );
+	for( char32_t c = 0x400; c <= 0x45F; ++c )
+		out.push_back( c );
+	static const char32_t signs[] = { 0x2013, 0x2014, 0x2018, 0x2019, 0x201C, 0x201D, 0x201E, 0x2022, 0x2026,
+		0x2116, 0x20AC, 0x2122 };
+	for( char32_t c : signs )
+		out.push_back( c );
+}
+
+} // namespace
+
+std::u32string GlyphText_Decode( const std::string &utf8 )
+{
+	std::u32string out;
+	out.reserve( utf8.size() );
+
+	const unsigned char *p = reinterpret_cast<const unsigned char *>( utf8.c_str() );
+
+	while( *p )
+	{
+		char32_t c = *p;
+		int extra = 0;
+
+		if( c >= 0xF0 && c <= 0xF4 ) { c &= 0x07; extra = 3; }
+		else if( c >= 0xE0 ) { c &= 0x0F; extra = 2; }
+		else if( c >= 0xC2 && c < 0xE0 ) { c &= 0x1F; extra = 1; }
+		else if( c >= 0x80 ) { out.push_back( c ); ++p; continue; } // not UTF-8: as a byte of Windows-1252
+
+		int i = 1;
+		for( ; i <= extra; ++i )
+		{
+			if(( p[i] & 0xC0 ) != 0x80 )
+				break;
+			c = ( c << 6 ) | ( p[i] & 0x3F );
+		}
+
+		if( i <= extra )
+		{
+			out.push_back( *p ); // a broken sequence: the first byte alone
+			++p;
+			continue;
+		}
+
+		out.push_back( c );
+		p += extra + 1;
+	}
+
+	return out;
+}
+
+CGlyphFont *CGlyphFont::Get( const char *face, int emHeight, int weight, bool antialias )
+{
+	if( emHeight < 4 )
+		emHeight = 4;
+
+	char key[128];
+	snprintf( key, sizeof( key ), "%s|%d|%d|%d", face ? face : "", emHeight, weight, antialias ? 1 : 0 );
+
+	for( const auto &f : g_fonts )
+	{
+		if( f->m_key == key )
+			return f->m_font ? f.get() : nullptr;
+	}
+
+	std::unique_ptr<CGlyphFont> font( new CGlyphFont );
+	font->m_key = key;
+
+	GlyphFontInfo info;
+	font->m_font = GlyphGDI_CreateFont( face, emHeight, weight, antialias, info );
+
+	if( font->m_font )
+	{
+		font->m_iHeight = info.height;
+		font->m_iAscent = info.ascent;
+		font->m_iAveCharWidth = info.aveCharWidth;
+
+		std::vector<char32_t> chars;
+		InitialChars( chars );
+		font->AddGlyphs( chars );
+	}
+
+	CGlyphFont *result = font->m_font ? font.get() : nullptr;
+	g_fonts.push_back( std::move( font )); // also remembers that it did not work
+	return result;
+}
+
+void CGlyphFont::Prepare( const std::u32string &text )
+{
+	std::vector<char32_t> chars;
+
+	for( char32_t c : text )
+	{
+		if( c == '\n' || c == '\r' || c == '\t' )
+			continue;
+		if( m_glyphs.count( c ) || m_missing.count( c ))
+			continue;
+
+		bool seen = false;
+		for( char32_t d : chars )
+			seen = seen || d == c;
+		if( !seen )
+			chars.push_back( c );
+	}
+
+	if( !chars.empty() )
+		AddGlyphs( chars );
+}
+
+const CGlyphFont::Glyph *CGlyphFont::Find( char32_t ch ) const
+{
+	auto it = m_glyphs.find( ch );
+	return it != m_glyphs.end() ? &it->second : nullptr;
+}
+
+// The letters are drawn and packed into a new page in rows of the height of the font, a pixel apart
+void CGlyphFont::AddGlyphs( const std::vector<char32_t> &chars )
+{
+	if( !m_font || chars.empty() )
+		return;
+
+	struct Item { char32_t ch; GlyphImage img; };
+	std::vector<Item> items;
+	items.reserve( chars.size() );
+
+	for( char32_t c : chars )
+	{
+		Item it;
+		it.ch = c;
+		if( !GlyphGDI_Render( m_font, (unsigned int)c, it.img ))
+		{
+			m_missing[c] = true;
+			continue;
+		}
+		items.push_back( std::move( it ));
+	}
+
+	if( items.empty() )
+		return;
+
+	const int pageW = m_iHeight >= 40 ? 1024 : 512;
+	const int maxPageH = 2048;
+	const int rowH = m_iHeight + 1;
+
+	size_t first = 0;
+
+	while( first < items.size() )
+	{
+		// how many letters fit into one page
+		int x = 0, y = 0;
+		size_t last = first;
+
+		for( ; last < items.size(); ++last )
+		{
+			const GlyphImage &img = items[last].img;
+			int w = img.w > 0 ? img.w : 0;
+			if( w > pageW )
+				w = pageW;
+
+			if( x + w > pageW )
+			{
+				x = 0;
+				y += rowH;
+			}
+			if( y + rowH > maxPageH )
+				break;
+			x += w + 1;
+		}
+
+		if( last == first )
+			break; // a letter higher than a page: not possible with the sizes of the HUD
+
+		int pageH = 16;
+		while( pageH < y + rowH )
+			pageH *= 2;
+
+		Page page;
+		page.w = pageW;
+		page.h = pageH;
+		page.alpha.assign( (size_t)pageW * pageH, 0 );
+
+		const int pageIndex = (int)m_pages.size();
+		x = 0;
+		y = 0;
+
+		for( size_t i = first; i < last; ++i )
+		{
+			const GlyphImage &img = items[i].img;
+			int w = img.w > 0 ? img.w : 0;
+			if( w > pageW )
+				w = pageW;
+
+			if( x + w > pageW )
+			{
+				x = 0;
+				y += rowH;
+			}
+
+			Glyph g;
+			g.left = img.left;
+			g.advance = img.advance;
+
+			bool empty = true;
+			for( unsigned char a : img.alpha )
+				empty = empty && a == 0;
+
+			if( !empty && w > 0 )
+			{
+				g.page = pageIndex;
+				g.x = x;
+				g.y = y;
+				g.w = w;
+				g.h = img.h < m_iHeight ? img.h : m_iHeight;
+
+				for( int row = 0; row < g.h; ++row )
+					memcpy( &page.alpha[(size_t)( y + row ) * pageW + x], &img.alpha[(size_t)row * img.w], (size_t)w );
+
+				x += w + 1;
+			}
+
+			m_glyphs[items[i].ch] = g;
+		}
+
+		m_pages.push_back( std::move( page ));
+		UploadPage( m_pages.back() );
+		first = last;
+	}
+}
+
+bool CGlyphFont::UploadPage( Page &page )
+{
+	if( !gRenderAPI.GL_CreateTexture )
+		return false;
+
+	// white pixels, the letters are in the alpha channel (the colour is set when the text is drawn)
+	std::vector<unsigned char> rgba( (size_t)page.w * page.h * 4, 255 );
+	for( size_t i = 0, n = (size_t)page.w * page.h; i < n; ++i )
+		rgba[i * 4 + 3] = page.alpha[i];
+
+	// every page has its own name: the engine gives back the old texture for a name it already has
+	char name[48];
+	snprintf( name, sizeof( name ), "%s%d", TexturePrefix(), ++g_pageCounter );
+
+	const int tex = gRenderAPI.GL_CreateTexture( name, page.w, page.h, rgba.data(),
+		static_cast<texFlags_t>( TF_NOMIPMAP | TF_CLAMP | TF_HAS_ALPHA | TF_NEAREST ));
+
+	if( tex <= 0 )
+	{
+		page.tex = 0;
+		page.name.clear();
+		return false;
+	}
+
+	page.tex = tex;
+	page.name = name;
+	ClientTexture::Note( "create", tex, name );
+	return true;
+}
+
+int CGlyphFont::PageTexture( int index )
+{
+	if( index < 0 || index >= (int)m_pages.size() )
+		return 0;
+
+	Page &page = m_pages[index];
+
+	if( page.tex > 0 && ClientTexture::Owned( page.tex, page.name.c_str() ))
+		return page.tex;
+
+	// the engine has freed it (or it was never made): made again from the pixels kept
+	if( page.tex > 0 )
+		ClientTexture::ReportLost( page.name.c_str() );
+
+	static float lastTry = -1000.0f;
+	const float now = gEngfuncs.GetClientTime();
+	if( page.tex <= 0 && page.name.empty() && now - lastTry < 1.0f && now >= lastTry )
+		return 0; // it did not work a moment ago: not every frame
+
+	lastTry = now;
+	return UploadPage( page ) ? page.tex : 0;
+}
diff --git a/cl_dll/hud/glyph_atlas.h b/cl_dll/hud/glyph_atlas.h
new file mode 100644
index 0000000..c319e09
--- /dev/null
+++ b/cl_dll/hud/glyph_atlas.h
@@ -0,0 +1,72 @@
+//
+// glyph_atlas.h
+//
+// The fonts of Windows as atlases: the letters of a font are drawn once (glyph_gdi.cpp) into one texture and the
+// texts are put together from them, as the VGUI2 fonts of the Steam version do. A new text costs nothing (no new
+// texture), only letters that are not there yet are added (a new page of the atlas, rarely: the Latin, Latin-1
+// and Cyrillic letters and the usual signs are drawn at once).
+//
+// No dependencies on the engine besides the textures (gRenderAPI) and the triangles (pTriAPI) of the drawing.
+//
+
+#pragma once
+
+#include <string>
+#include <vector>
+#include <unordered_map>
+
+class CGlyphFont
+{
+public:
+	struct Glyph
+	{
+		int page = -1;           // -1: an empty letter (a space), nothing to draw
+		int x = 0, y = 0, w = 0, h = 0; // the picture in its page
+		int left = 0;            // where the picture starts from the pen
+		int advance = 0;         // how far the pen moves
+	};
+
+	// the font (made once and kept); nullptr if there are no fonts of Windows (the other systems)
+	static CGlyphFont *Get( const char *face, int emHeight, int weight, bool antialias );
+
+	int Height() const { return m_iHeight; }
+	int Ascent() const { return m_iAscent; }
+	int TabWidth() const { return m_iAveCharWidth * 8 > 0 ? m_iAveCharWidth * 8 : 8; } // as DrawText
+
+	// adds the letters of the text that are not in the atlas yet (one new page for all of them)
+	void Prepare( const std::u32string &text );
+
+	// a letter of the atlas (Prepare has been called for it); nullptr if the font has no such letter
+	const Glyph *Find( char32_t ch ) const;
+
+	// the texture of a page, made again if the engine has freed it; 0 if it cannot be made
+	int PageTexture( int page );
+	int PageWidth( int page ) const { return page >= 0 && page < (int)m_pages.size() ? m_pages[page].w : 1; }
+	int PageHeight( int page ) const { return page >= 0 && page < (int)m_pages.size() ? m_pages[page].h : 1; }
+
+	// the texture names of the atlases start with this (cl_textures_check counts them)
+	static const char *TexturePrefix() { return "*glyphs_"; }
+
+private:
+	struct Page
+	{
+		int w = 0, h = 0;
+		std::vector<unsigned char> alpha; // kept: the texture is made again from it if the engine frees it
+		int tex = 0;
+		std::string name;
+	};
+
+	CGlyphFont() = default;
+	void AddGlyphs( const std::vector<char32_t> &chars );
+	bool UploadPage( Page &page );
+
+	std::string m_key;
+	void *m_font = nullptr; // glyph_gdi.h
+	int m_iHeight = 0, m_iAscent = 0, m_iAveCharWidth = 0;
+	std::unordered_map<char32_t, Glyph> m_glyphs;
+	std::unordered_map<char32_t, bool> m_missing; // the letters the font could not draw
+	std::vector<Page> m_pages;
+};
+
+// UTF-8 to code points (a wrong byte is taken as a Windows-1252 character)
+std::u32string GlyphText_Decode( const std::string &utf8 );
diff --git a/cl_dll/hud/glyph_gdi.cpp b/cl_dll/hud/glyph_gdi.cpp
new file mode 100644
index 0000000..31018eb
--- /dev/null
+++ b/cl_dll/hud/glyph_gdi.cpp
@@ -0,0 +1,239 @@
+//
+// glyph_gdi.cpp
+//
+// The letters of a Windows font for the atlas (see glyph_gdi.h)
+//
+
+#include <string.h>
+#include <string>
+#include <vector>
+
+#include "glyph_gdi.h"
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <wchar.h>
+
+namespace {
+
+// the light pixels of the antialiasing outside the ABC box of a letter are kept: its picture is this much wider
+// on both sides
+const int GLYPH_PAD = 2;
+
+struct GdiFont
+{
+	HFONT font = nullptr;
+	int height = 0;
+	int maxWidth = 0;
+};
+
+HDC SharedDC( void )
+{
+	// one memory DC for everything (GetDC of the screen is slow while the game is shown: it waits for the desktop)
+	static HDC dc = nullptr;
+	if( !dc )
+		dc = CreateCompatibleDC( nullptr );
+	return dc;
+}
+
+std::wstring Utf8ToWide( const char *utf8 )
+{
+	const int n = MultiByteToWideChar( CP_UTF8, 0, utf8, -1, nullptr, 0 );
+
+	if( n <= 1 )
+		return std::wstring();
+
+	std::wstring w( (size_t)n, L'\0' );
+	MultiByteToWideChar( CP_UTF8, 0, utf8, -1, &w[0], n );
+	w.resize( (size_t)n - 1 );
+	return w;
+}
+
+// The font asked for, if the system has it; otherwise the next one of the list that it has
+HFONT CreateFontFromList( HDC dc, const char *wanted, int emHeight, int weight, bool antialias )
+{
+	const std::wstring first = Utf8ToWide( wanted ? wanted : "" );
+	const wchar_t *fallbacks[] = { L"Tahoma", L"Verdana", L"Segoe UI", L"Arial" };
+	const DWORD quality = antialias ? ANTIALIASED_QUALITY : NONANTIALIASED_QUALITY;
+
+	for( int i = -1; i < (int)( sizeof( fallbacks ) / sizeof( fallbacks[0] )); ++i )
+	{
+		const wchar_t *face = i < 0 ? first.c_str() : fallbacks[i];
+
+		if( !face[0] || wcslen( face ) >= LF_FACESIZE )
+			continue;
+
+		// a negative height is the height of the letters (em)
+		HFONT font = CreateFontW( -emHeight, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
+			OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, quality, DEFAULT_PITCH | FF_SWISS, face );
+
+		if( !font )
+			continue;
+
+		HGDIOBJ old = SelectObject( dc, font );
+		wchar_t actual[LF_FACESIZE] = {};
+		GetTextFaceW( dc, LF_FACESIZE, actual );
+		SelectObject( dc, old );
+
+		if( _wcsicmp( actual, face ) == 0 )
+			return font;
+
+		DeleteObject( font ); // the system gave another font instead
+	}
+
+	return CreateFontW( -emHeight, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
+		OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, quality, DEFAULT_PITCH | FF_SWISS, L"Arial" );
+}
+
+} // namespace
+
+void *GlyphGDI_CreateFont( const char *face, int emHeight, int weight, bool antialias, GlyphFontInfo &info )
+{
+	HDC dc = SharedDC();
+	if( !dc || emHeight < 4 )
+		return nullptr;
+
+	HFONT font = CreateFontFromList( dc, face, emHeight, weight, antialias );
+	if( !font )
+		return nullptr;
+
+	HGDIOBJ old = SelectObject( dc, font );
+	TEXTMETRICW tm = {};
+	const bool ok = GetTextMetricsW( dc, &tm ) != 0;
+	SelectObject( dc, old );
+
+	if( !ok || tm.tmHeight <= 0 )
+	{
+		DeleteObject( font );
+		return nullptr;
+	}
+
+	GdiFont *f = new GdiFont;
+	f->font = font;
+	f->height = tm.tmHeight;
+	f->maxWidth = tm.tmMaxCharWidth + tm.tmOverhang;
+
+	info.height = tm.tmHeight;
+	info.ascent = tm.tmAscent;
+	info.aveCharWidth = tm.tmAveCharWidth > 0 ? tm.tmAveCharWidth : emHeight / 2;
+	return f;
+}
+
+bool GlyphGDI_Render( void *handle, unsigned int ch, GlyphImage &out )
+{
+	GdiFont *f = static_cast<GdiFont *>( handle );
+	HDC dc = SharedDC();
+
+	if( !f || !dc || ch > 0xFFFF )
+		return false;
+
+	HGDIOBJ oldFont = SelectObject( dc, f->font );
+
+	// the metrics GDI moves the pen by in a string
+	ABC abc = {};
+	if( !GetCharABCWidthsW( dc, ch, ch, &abc ))
+	{
+		INT width = 0;
+		if( !GetCharWidth32W( dc, ch, ch, &width ))
+		{
+			SelectObject( dc, oldFont );
+			return false;
+		}
+		abc.abcA = 0;
+		abc.abcB = (UINT)width;
+		abc.abcC = 0;
+	}
+
+	out.advance = abc.abcA + (int)abc.abcB + abc.abcC;
+	out.left = abc.abcA - GLYPH_PAD;
+	out.w = (int)abc.abcB + GLYPH_PAD * 2;
+	out.h = f->height;
+	out.alpha.assign( (size_t)( out.w > 0 ? out.w : 0 ) * out.h, 0 );
+
+	bool ok = true;
+
+	if( out.w > 0 && out.h > 0 && ch != ' ' && ch != '\t' )
+	{
+		BITMAPINFO bi = {};
+		bi.bmiHeader.biSize = sizeof( BITMAPINFOHEADER );
+		bi.bmiHeader.biWidth = out.w;
+		bi.bmiHeader.biHeight = -out.h; // from the top to the bottom
+		bi.bmiHeader.biPlanes = 1;
+		bi.bmiHeader.biBitCount = 32;
+		bi.bmiHeader.biCompression = BI_RGB;
+
+		void *bits = nullptr;
+		HBITMAP bitmap = CreateDIBSection( dc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0 );
+
+		if( bitmap && bits )
+		{
+			HGDIOBJ oldBitmap = SelectObject( dc, bitmap );
+
+			memset( bits, 0, (size_t)out.w * out.h * 4 );
+			SetTextAlign( dc, TA_LEFT | TA_TOP | TA_NOUPDATECP );
+			SetBkColor( dc, RGB( 0, 0, 0 ));
+			SetTextColor( dc, RGB( 255, 255, 255 ));
+			SetBkMode( dc, TRANSPARENT );
+
+			// the pen GLYPH_PAD pixels before "A": the letter lands where it would be in a string
+			const wchar_t wch = (wchar_t)ch;
+			ExtTextOutW( dc, GLYPH_PAD - abc.abcA, 0, 0, nullptr, &wch, 1, nullptr );
+			GdiFlush();
+
+			// white text on black: the brightness of a pixel is how much of it the letter covers
+			const unsigned char *p = static_cast<const unsigned char *>( bits );
+
+			for( size_t i = 0, n = (size_t)out.w * out.h; i < n; ++i, p += 4 )
+			{
+				unsigned char m = p[0] > p[1] ? p[0] : p[1];
+				out.alpha[i] = m > p[2] ? m : p[2];
+			}
+
+			SelectObject( dc, oldBitmap );
+		}
+		else
+		{
+			ok = false;
+		}
+
+		if( bitmap )
+			DeleteObject( bitmap );
+	}
+
+	SelectObject( dc, oldFont );
+	return ok;
+}
+
+void GlyphGDI_FreeFont( void *handle )
+{
+	GdiFont *f = static_cast<GdiFont *>( handle );
+	if( !f )
+		return;
+
+	if( f->font )
+		DeleteObject( f->font );
+	delete f;
+}
+
+#else // no fonts of Windows on the other systems: the font of the HUD is used there
+
+void *GlyphGDI_CreateFont( const char *, int, int, bool, GlyphFontInfo & )
+{
+	return nullptr;
+}
+
+bool GlyphGDI_Render( void *, unsigned int, GlyphImage & )
+{
+	return false;
+}
+
+void GlyphGDI_FreeFont( void * )
+{
+}
+
+#endif
diff --git a/cl_dll/hud/glyph_gdi.h b/cl_dll/hud/glyph_gdi.h
new file mode 100644
index 0000000..5cad6f0
--- /dev/null
+++ b/cl_dll/hud/glyph_gdi.h
@@ -0,0 +1,37 @@
+//
+// glyph_gdi.h
+//
+// The letters of a Windows font, one at a time (glyph_gdi.cpp), for the atlas of glyph_atlas.h. Every letter is
+// drawn by ExtTextOut as Windows draws it in a string (the same antialiasing) and comes with the metrics GDI moves
+// the pen by (ABC widths), so a text put together from the atlas looks like the same text drawn by DrawText.
+// Kept apart because <windows.h> conflicts with the headers of the engine. No fonts of Windows on the other
+// systems: GlyphGDI_CreateFont returns nullptr there and the client uses the font of the HUD.
+//
+
+#pragma once
+
+#include <vector>
+
+struct GlyphFontInfo
+{
+	int height = 0;       // the height of a line (the cell of the font: ascent + descent)
+	int ascent = 0;       // from the top of the cell to the baseline
+	int aveCharWidth = 0; // for the tab stops (every 8 average characters, as DrawText)
+};
+
+struct GlyphImage
+{
+	int left = 0;    // where the picture starts from the pen (may be negative)
+	int advance = 0; // how far the pen moves
+	int w = 0, h = 0;
+	std::vector<unsigned char> alpha; // w * h: how much of every pixel the letter covers
+};
+
+// a font of Windows: the one asked for if the system has it, else Tahoma, Verdana, Segoe UI, Arial;
+// emHeight - the height of the letters (em) in pixels; nullptr if there are no fonts of Windows
+void *GlyphGDI_CreateFont( const char *face, int emHeight, int weight, bool antialias, GlyphFontInfo &info );
+
+// one letter (a UTF-16 code unit: the letters beyond U+FFFF are not drawn)
+bool GlyphGDI_Render( void *font, unsigned int ch, GlyphImage &out );
+
+void GlyphGDI_FreeFont( void *font );
diff --git a/cl_dll/hud/motd_util.h b/cl_dll/hud/motd_util.h
new file mode 100644
index 0000000..53fcfae
--- /dev/null
+++ b/cl_dll/hud/motd_util.h
@@ -0,0 +1,308 @@
+//
+// motd_util.h
+//
+// Helpers of the server MOTD: recognising HTML, finding the address of an iframe, making an address
+// safe to give to the system. No dependencies on the engine, so the same file is used by every build
+// of the client and can be tested alone.
+//
+
+#pragma once
+
+#include <stddef.h>
+#include <string.h>
+
+namespace MotdUtil {
+
+inline char LowerAscii( char c )
+{
+	return ( c >= 'A' && c <= 'Z' ) ? (char)( c + 'a' - 'A' ) : c;
+}
+
+// prefix must be in lower case
+inline bool StartsWithNoCase( const char *s, const char *prefix )
+{
+	while( *prefix )
+	{
+		if( LowerAscii( *s++ ) != *prefix++ )
+			return false;
+	}
+
+	return true;
+}
+
+inline bool IsBlank( char c )
+{
+	return (unsigned char)c <= ' ';
+}
+
+inline bool IsAsciiLetter( char c )
+{
+	return ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' );
+}
+
+inline bool IsHttpUrl( const char *s )
+{
+	return StartsWithNoCase( s, "http://" ) || StartsWithNoCase( s, "https://" );
+}
+
+// The text of a MOTD is HTML if it starts with a tag: "<html", "<!DOCTYPE", "<b>", "</p>"...
+// A text like "<<< Welcome >>>" or "<-- rules" is not HTML and is shown in the game.
+inline bool LooksLikeHtml( const char *s )
+{
+	while( *s && IsBlank( *s ))
+		s++;
+
+	if( s[0] != '<' )
+		return false;
+
+	if( IsAsciiLetter( s[1] ) || s[1] == '!' || s[1] == '?' )
+		return true;
+
+	return s[1] == '/' && IsAsciiLetter( s[2] );
+}
+
+// the tag <name ...> starts at s ('<' included); name in lower case
+inline bool IsTagStart( const char *s, const char *name )
+{
+	if( s[0] != '<' || !StartsWithNoCase( s + 1, name ))
+		return false;
+
+	const char after = s[1 + strlen( name )];
+	return IsBlank( after ) || after == '>' || after == '/';
+}
+
+// first occurrence of what (lower case) in s, ignoring the case; NULL if there is none
+inline const char *FindNoCase( const char *s, const char *what )
+{
+	for( ; *s; s++ )
+		if( StartsWithNoCase( s, what ))
+			return s;
+
+	return NULL;
+}
+
+// Reads the attributes of a tag that starts at p (right after its name), the way a browser does:
+// with quotes or without, '>' can be inside quotes, the first src counts.
+// Returns: 1 - an http(s) src was found and copied to out, 0 - the tag has no usable src (end is set
+// to the end of the tag), -1 - the tag is not closed (the rest of the page is swallowed by it).
+inline int ReadIframeSrc( const char *p, char *out, size_t outSize, const char **end )
+{
+	for( ;; )
+	{
+		while( *p && ( IsBlank( *p ) || *p == '/' ))
+			p++;
+
+		if( !*p )
+			return -1;
+
+		if( *p == '>' )
+		{
+			*end = p + 1;
+			return 0;
+		}
+
+		// name of the attribute
+		const char *name = p;
+
+		while( *p && !IsBlank( *p ) && *p != '=' && *p != '>' && *p != '/' )
+			p++;
+
+		const size_t nameLen = (size_t)( p - name );
+
+		while( *p && IsBlank( *p ))
+			p++;
+
+		if( *p != '=' )
+			continue; // an attribute without a value
+
+		p++;
+
+		while( *p && IsBlank( *p ))
+			p++;
+
+		// the value
+		char quote = 0;
+
+		if( *p == '"' || *p == '\'' )
+			quote = *p++;
+
+		const char *value = p;
+
+		while( *p && ( quote ? ( *p != quote ) : ( !IsBlank( *p ) && *p != '>' )))
+			p++;
+
+		if( !*p )
+			return -1;
+
+		const char *valueEnd = p;
+
+		if( quote )
+			p++; // the closing quote
+
+		if( nameLen != 3 || !StartsWithNoCase( name, "src" ))
+			continue;
+
+		// blanks around the address are not a part of it
+		while( value < valueEnd && IsBlank( *value ))
+			value++;
+
+		while( valueEnd > value && IsBlank( valueEnd[-1] ))
+			valueEnd--;
+
+		size_t len = 0;
+		bool ok = true;
+
+		for( const char *q = value; q < valueEnd; q++ )
+		{
+			if( IsBlank( *q )) // an address never contains blanks or control characters
+			{
+				ok = false;
+				break;
+			}
+
+			char c = *q;
+
+			if( valueEnd - q >= 5 && !strncmp( q, "&amp;", 5 )) // HTML escaping of '&'
+			{
+				c = '&';
+				q += 4;
+			}
+
+			if( len + 1 >= outSize )
+			{
+				ok = false;
+				break;
+			}
+
+			out[len++] = c;
+		}
+
+		if( ok )
+		{
+			out[len] = 0;
+
+			if( IsHttpUrl( out ))
+				return 1;
+		}
+
+		// the first src of a tag decides: skip the rest of this tag
+		for( ;; )
+		{
+			while( *p && *p != '>' && *p != '"' && *p != '\'' )
+				p++;
+
+			if( !*p )
+				return -1;
+
+			if( *p == '>' )
+			{
+				*end = p + 1;
+				return 0;
+			}
+
+			const char *closing = strchr( p + 1, *p );
+
+			if( !closing )
+				return -1;
+
+			p = closing + 1;
+		}
+	}
+}
+
+// Finds the first <iframe ... src="http(s)://..."> of a page and copies its address to out.
+// Comments (<!-- -->), scripts and styles are skipped: an iframe written there is not on the page.
+// Returns false if there is no such iframe.
+inline bool ExtractIframeSrc( const char *html, char *out, size_t outSize )
+{
+	if( !html || !out || outSize == 0 )
+		return false;
+
+	const char *p = html;
+
+	while(( p = strchr( p, '<' )) != NULL )
+	{
+		if( !strncmp( p, "<!--", 4 ))
+		{
+			const char *close = strstr( p + 4, "-->" );
+
+			if( !close )
+				return false; // the rest of the page is a comment
+			p = close + 3;
+			continue;
+		}
+
+		if( IsTagStart( p, "script" ) || IsTagStart( p, "style" ))
+		{
+			const char *close = FindNoCase( p + 1, IsTagStart( p, "script" ) ? "</script" : "</style" );
+
+			if( !close )
+				return false; // the rest of the page is a script
+			p = close + 2;
+			continue;
+		}
+
+		if( IsTagStart( p, "iframe" ))
+		{
+			const char *end = NULL;
+			const int r = ReadIframeSrc( p + 7, out, outSize, &end );
+
+			if( r == 1 )
+				return true;
+			if( r < 0 )
+				return false;
+
+			p = end;
+			continue;
+		}
+
+		p++;
+	}
+
+	return false;
+}
+
+// Makes an http(s) address of a server safe to give to the system browser: everything that is not
+// a plain character of an address (quotes, '<', '>', '\', '^', '`', '{', '|', '}', letters that are
+// not ASCII) is written as %XX, so the address cannot break out of the command line of the browser.
+// Returns false if it is not an http(s) address, has control characters or does not fit into out.
+inline bool MakeSafeUrl( const char *in, char *out, size_t outSize )
+{
+	static const char hex[] = "0123456789ABCDEF";
+
+	if( !in || !out || outSize == 0 || !IsHttpUrl( in ))
+		return false;
+
+	size_t len = 0;
+
+	for( const unsigned char *p = (const unsigned char *)in; *p; p++ )
+	{
+		const unsigned char c = *p;
+
+		if( c <= ' ' || c == 0x7F )
+			return false;
+
+		const bool plain = ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' ) || ( c >= '0' && c <= '9' )
+			|| ( c < 0x80 && strchr( "-._~:/?#[]@!$&'()*+,;=%", (char)c ));
+
+		if( plain )
+		{
+			if( len + 1 >= outSize )
+				return false;
+			out[len++] = (char)c;
+		}
+		else
+		{
+			if( len + 3 >= outSize )
+				return false;
+			out[len++] = '%';
+			out[len++] = hex[c >> 4];
+			out[len++] = hex[c & 15];
+		}
+	}
+
+	out[len] = 0;
+	return true;
+}
+
+} // namespace MotdUtil
