+}
+
+void CClientWindow::DrawFrame( int x, int y, int w, int h, unsigned int color )
+{
+	if( w <= 0 || h <= 0 )
+		return;
+
+	UI_FillRect( x, y, w, 1, color );
+	if( h > 1 )
+		UI_FillRect( x, y + h - 1, w, 1, color );
+	if( h > 2 )
+	{
+		UI_FillRect( x, y + 1, 1, h - 2, color );
+		if( w > 1 )
+			UI_FillRect( x + w - 1, y + 1, 1, h - 2, color );
+	}
