+	const int lowerY = l.cutY + l.cutH;
+	FillRoundedRect( l.panelX, l.panelY, l.panelW, l.cutY - l.panelY, l.radius, true, false, bg );
+	FillRoundedRect( l.panelX, lowerY, l.panelW, l.panelY + l.panelH - lowerY, l.radius, false, true, bg );
