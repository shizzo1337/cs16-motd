+//
+// MOTD_browser.cpp
+//
+// OS specific helpers for opening server MOTD in the system web browser.
+// Kept in a separate file because <windows.h> conflicts with engine headers.
+//
+
+#include <stddef.h>
+
+bool MOTD_OpenInBrowser( const char *target );
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize );
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <shellapi.h>
+#include <stdio.h>
+
+bool MOTD_OpenInBrowser( const char *target )
+{
+	HINSTANCE result = ShellExecuteA( NULL, "open", target, NULL, NULL, SW_SHOWNORMAL );
+
+	return (INT_PTR)result > 32;
+}
+
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	char dir[MAX_PATH];
+	DWORD n = GetTempPathA( sizeof( dir ), dir );
+
+	if( n == 0 || n >= sizeof( dir ))
+		return false;
+
+	if( snprintf( outPath, outSize, "%scs16_motd.html", dir ) <= 0 )
+		return false;
+
+	FILE *f = fopen( outPath, "wb" );
+
+	if( !f )
+		return false;
+
+	size_t written = fwrite( html, 1, len, f );
+	fclose( f );
+
+	return written == len;
+}
+
+#else // not implemented on other platforms yet
+
+bool MOTD_OpenInBrowser( const char *target )
+{
+	(void)target;
+	return false;
+}
+
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	(void)html; (void)len; (void)outPath; (void)outSize;
+	return false;
+}
+
+#endif
