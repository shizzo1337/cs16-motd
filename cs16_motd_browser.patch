index 0000000..f093e19
--- /dev/null
+++ b/cl_dll/hud/MOTD_browser.cpp
@@ -0,0 +1,102 @@
+//
+// MOTD_browser.cpp
+//
+// OS specific helpers for opening server MOTD in the system web browser.
+// Kept in a separate file because <windows.h> conflicts with engine headers.
+//
+
+#include <stddef.h>
+
+bool MOTD_OpenInBrowser( const char *target, bool keepGameWindow );
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize );
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <shellapi.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+// By default SDL minimizes a fullscreen game window when it loses focus,
+// and the browser takes focus as soon as it is opened.
+// Tell SDL not to do that. SDL is already loaded by the engine, so
+// take its function from the loaded module instead of linking to it.
+static void MOTD_DisableMinimizeOnFocusLoss( void )
+{
+	typedef int ( __cdecl *pfnSDL_SetHint )( const char *name, const char *value );
+	static const char *modules[] = { "SDL2.dll", "SDL3.dll" };
+	static const char *hint = "SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS";
+	bool done = false;
+
+	for( int i = 0; i < 2; i++ )
+	{
+		HMODULE sdl = GetModuleHandleA( modules[i] );
+
+		if( !sdl )
+			continue;
+
+		pfnSDL_SetHint setHint = (pfnSDL_SetHint)GetProcAddress( sdl, "SDL_SetHint" );
+
+		if( setHint )
+		{
+			setHint( hint, "0" );
+			done = true;
+		}
+	}
+
+	if( !done ) // SDL not found, SDL also reads this setting from the environment
+	{
+		SetEnvironmentVariableA( hint, "0" );
+		_putenv( "SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0" );
+	}
+}
+
+bool MOTD_OpenInBrowser( const char *target, bool keepGameWindow )
+{
+	if( keepGameWindow )
+		MOTD_DisableMinimizeOnFocusLoss();
+
+	HINSTANCE result = ShellExecuteA( NULL, "open", target, NULL, NULL, SW_SHOWNORMAL );
+
+	return (INT_PTR)result > 32;
+}
+
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	char dir[MAX_PATH];
+	DWORD n = GetTempPathA( sizeof( dir ), dir );
+
+	if( n == 0 || n >= sizeof( dir ))
+		return false;
+
+	if( snprintf( outPath, outSize, "%scs16_motd.html", dir ) <= 0 )
+		return false;
+
+	FILE *f = fopen( outPath, "wb" );
+
+	if( !f )
+		return false;
+
+	size_t written = fwrite( html, 1, len, f );
+	fclose( f );
+
+	return written == len;
+}
+
+#else // not implemented on other platforms yet
+
+bool MOTD_OpenInBrowser( const char *target, bool keepGameWindow )
+{
+	(void)target; (void)keepGameWindow;
+	return false;
+}
+
+bool MOTD_SaveTempHtml( const char *html, size_t len, char *outPath, size_t outSize )
+{
+	(void)html; (void)len; (void)outPath; (void)outSize;
+	return false;
+}
+
+#endif
