+//
+// spectator_layout.h
+//
+// The upper bar of the spectator mode as in the Steam version of CS 1.6, measured on its screenshots
+// (1920x1080 and 1600x900). Its sizes are in units of 1/480 of the screen height ("proportional" sizes
+// of VGUI2) and the elements are placed from the right edge of the screen:
+//
+//   Counter-Terrorists :  0  |  $800
+//          Terrorists :  0  |  (timer) 1:45
+//
+// No dependencies on the engine, so it can be tested alone.
+//
+
+#pragma once
+
+namespace SpecBar {
+
+// One unit in pixels
+inline float Unit( int screenH )
+{
+	return screenH / 480.0f;
+}
+
+// Height of the black bars (64 units, 144 pixels at 1080)
+inline int BarHeight( int screenH )
+{
+	return int( screenH * 64 / 480 );
+}
+
+// The font of the bar is "Default" of resource/ClientScheme.res (Verdana, weight 600): its size depends
+// on the height of the screen; the Steam version draws a "tall" of the scheme with letters of tall * 3 / 4 pixels
+// (rounded down): 20 -> 15 at 1080 (capitals of 11 pixels, small letters of 8), 14 -> 10 for the tutor
+struct Font
+{
+	int tall;
+	bool antialias;
+};
+
+inline Font FontFor( int screenH )
+{
+	if( screenH < 600 )  return { 12, false };
+	if( screenH < 768 )  return { 13, false };
+	if( screenH < 1024 ) return { 14, true };
+	if( screenH < 1200 ) return { 20, true };
+	return { 24, true };
+}
+
+inline int FontEm( int tall )
+{
+	const int em = tall * 3 / 4;
+	return em < 4 ? 4 : em;
+}
+
+// The top of the capitals of the two rows (38 and 65 of 1080) and their distance from the top of the cell
+// of the font (the ascent of Verdana is 1.005 em, its capitals are 0.727 em high)
+inline float Row1CapTop( int screenH ) { return 16.9f * Unit( screenH ); }
+inline float Row2CapTop( int screenH ) { return 28.9f * Unit( screenH ); }
+inline int CellTopFromCapTop( float capTop, int em ) { return int( capTop - 0.278f * em + 0.5f ); }
+
+struct Layout
+{
+	int teamLabelRight;  // right edge of "Counter-Terrorists :" and "Terrorists :" (right aligned)
+	int teamValueX;      // left edge of the scores
+	int dividerX, dividerY, dividerW, dividerH; // the vertical line
+	int infoX;           // left edge of the money (or the map name) in the first row
+	int timerIconX, timerIconY, timerIconSize;
+	int timerTextX;      // left edge of the time in the second row
+};
+
+inline Layout Compute( int screenW, int screenH )
+{
+	const float u = Unit( screenH );
+	auto fromRight = [screenW, u]( float units ) { return int( screenW - units * u + 0.5f ); };
+
+	Layout l;
+	l.teamLabelRight = fromRight( 83.1f );  // ':' ends at 1729 of 1920
+	l.teamValueX = fromRight( 80.0f );      // "0" at 1741
+	l.dividerX = fromRight( 64.0f );        // 1776..1777
+	l.dividerW = int( u + 0.5f ) > 0 ? int( u + 0.5f ) : 1;
+	l.dividerY = int( 12.0f * u + 0.5f );   // 27..93
+	l.dividerH = int( 30.0f * u + 0.5f ) - 1;
+	l.infoX = fromRight( 56.0f );           // "$" at 1795
+	l.timerIconX = fromRight( 56.0f );      // the picture of the icon is seen at 1798..1814 x 59..81
+	l.timerIconY = int( 25.3f * u + 0.5f );
+	l.timerIconSize = int( 12.4f * u + 0.5f );
+	l.timerTextX = fromRight( 41.7f );      // 1826: "0:00" is seen at 1827..1865 (1 pixel of bearing)
+	return l;
+}
+
+} // namespace SpecBar
diff --git a/cl_dll/hud/text_gdi.cpp b/cl_dll/hud/text_gdi.cpp
new file mode 100644
index 0000000..d28491e
--- /dev/null
+++ b/cl_dll/hud/text_gdi.cpp
@@ -0,0 +1,173 @@
+//
+// text_gdi.cpp
+//
+// A block of text drawn by the fonts of Windows (GDI), in lines that are not wrapped:
+// the picture is the coverage of the glyphs that the client shows as a texture, one pixel on one pixel.
+// Used by the tutor messages. Kept in a separate file because <windows.h> conflicts with engine headers.
+//
+
+#include <string.h>
+#include <string>
+#include <vector>
+
+#include "text_gdi.h"
+
+#if defined( _WIN32 )
+
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <wchar.h>
+
+static std::wstring Utf8ToWide( const char *utf8 )
+{
+	const int n = MultiByteToWideChar( CP_UTF8, 0, utf8, -1, nullptr, 0 );
+
+	if( n <= 1 )
+		return std::wstring();
+
+	std::wstring w( (size_t)n, L'\0' );
+	MultiByteToWideChar( CP_UTF8, 0, utf8, -1, &w[0], n );
+	w.resize( (size_t)n - 1 );
+	return w;
+}
+
+// The font asked for, if the system has it; otherwise the next one of the list that it has
+static HFONT CreateFontFromList( HDC dc, const char *wanted, int emHeight, int weight, bool antialias )
+{
+	const std::wstring first = Utf8ToWide( wanted ? wanted : "" );
+	const wchar_t *fallbacks[] = { L"Tahoma", L"Verdana", L"Segoe UI", L"Arial" };
+	const DWORD quality = antialias ? ANTIALIASED_QUALITY : NONANTIALIASED_QUALITY;
+
+	for( int i = -1; i < (int)( sizeof( fallbacks ) / sizeof( fallbacks[0] )); ++i )
+	{
+		const wchar_t *face = i < 0 ? first.c_str() : fallbacks[i];
+
+		if( !face[0] || wcslen( face ) >= LF_FACESIZE )
+			continue;
+
+		// a negative height is the height of the letters (em)
+		HFONT font = CreateFontW( -emHeight, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
+			OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, quality, DEFAULT_PITCH | FF_SWISS, face );
+
+		if( !font )
+			continue;
+
+		HGDIOBJ old = SelectObject( dc, font );
+		wchar_t actual[LF_FACESIZE] = {};
+		GetTextFaceW( dc, LF_FACESIZE, actual );
+		SelectObject( dc, old );
+
+		if( _wcsicmp( actual, face ) == 0 )
+			return font;
+
+		DeleteObject( font ); // the system gave another font instead
+	}
+
+	return CreateFontW( -emHeight, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
+		OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, quality, DEFAULT_PITCH | FF_SWISS, L"Arial" );
+}
+
+bool GDI_RenderTextBlock( const char *utf8, const char *fontName, int emHeight, int weight, bool antialias,
+						  int maxWidth, std::vector<unsigned char> &alpha, int &width, int &height )
+{
+	if( !utf8 || !utf8[0] || emHeight < 4 || maxWidth < 8 )
+		return false;
+
+	const std::wstring text = Utf8ToWide( utf8 );
+
+	if( text.empty() )
+		return false;
+
+	HDC screen = GetDC( nullptr );
+	HDC dc = CreateCompatibleDC( screen );
+	ReleaseDC( nullptr, screen );
+
+	if( !dc )
+		return false;
+
+	bool ok = false;
+	HFONT font = CreateFontFromList( dc, fontName, emHeight, weight, antialias );
+	HGDIOBJ oldFont = font ? SelectObject( dc, font ) : nullptr;
+	// no wrapping (as the Steam version): every line of the text is one line on the screen
+	const UINT format = DT_LEFT | DT_TOP | DT_NOPREFIX | DT_EXPANDTABS | DT_NOCLIP;
+
+	// the size of the block
+	RECT rc = { 0, 0, 0, 0 };
+
+	if( font && DrawTextW( dc, text.c_str(), (int)text.size(), &rc, format | DT_CALCRECT ) > 0 )
+	{
+		int w = rc.right - rc.left;
+		int h = rc.bottom - rc.top;
+
+		// a line wider than the screen is cut at the limit
+		if( w > maxWidth )
+			w = maxWidth;
+		if( h > 2048 )
+			h = 2048;
+
+		BITMAPINFO bi = {};
+		bi.bmiHeader.biSize = sizeof( BITMAPINFOHEADER );
+		bi.bmiHeader.biWidth = w;
+		bi.bmiHeader.biHeight = -h; // from the top to the bottom
+		bi.bmiHeader.biPlanes = 1;
+		bi.bmiHeader.biBitCount = 32;
+		bi.bmiHeader.biCompression = BI_RGB;
+
+		void *bits = nullptr;
+		HBITMAP bitmap = ( w > 0 && h > 0 ) ? CreateDIBSection( dc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0 ) : nullptr;
+
+		if( bitmap && bits )
+		{
+			HGDIOBJ oldBitmap = SelectObject( dc, bitmap );
+
+			memset( bits, 0, (size_t)w * h * 4 );
+			SetBkColor( dc, RGB( 0, 0, 0 ));
+			SetTextColor( dc, RGB( 255, 255, 255 ));
+			SetBkMode( dc, OPAQUE );
+
+			RECT draw = { 0, 0, w, h };
+			DrawTextW( dc, text.c_str(), (int)text.size(), &draw, format );
+			GdiFlush();
+
+			// white text on black: the brightness of a pixel is how much of it the glyph covers
+			alpha.resize( (size_t)w * h );
+
+			const unsigned char *p = static_cast<const unsigned char *>( bits );
+
+			for( size_t i = 0, n = (size_t)w * h; i < n; ++i, p += 4 )
+			{
+				unsigned char m = p[0] > p[1] ? p[0] : p[1];
+				alpha[i] = m > p[2] ? m : p[2];
+			}
+
+			width = w;
+			height = h;
+			ok = true;
+
+			SelectObject( dc, oldBitmap );
+		}
+
+		if( bitmap )
+			DeleteObject( bitmap );
+	}
+
+	if( oldFont )
+		SelectObject( dc, oldFont );
+	if( font )
+		DeleteObject( font );
+
+	DeleteDC( dc );
+	return ok;
+}
+
+#else // not implemented on other platforms: the font of the HUD is used there
+
+bool GDI_RenderTextBlock( const char *, const char *, int, int, bool, int, std::vector<unsigned char> &, int &, int & )
+{
+	return false;
+}
+
+#endif
