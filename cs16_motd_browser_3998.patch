@@ -0,0 +1,11 @@
+#pragma once
+
+#include <vector>
+
+// A block of UTF-8 text drawn by a font of Windows, without wrapping (line ends in the text start new lines);
+// lines wider than maxWidth are cut. The result is width * height bytes of the coverage of the glyphs.
+// fontName - the font that is wanted (Tahoma, Verdana, Segoe UI, Arial are tried if the system has no such font),
+// emHeight - the height of the letters (em) in pixels.
+// Returns false where the fonts of Windows are not available (the caller uses the font of the HUD).
+bool GDI_RenderTextBlock( const char *utf8, const char *fontName, int emHeight, int weight, bool antialias,
+						  int maxWidth, std::vector<unsigned char> &alpha, int &width, int &height );
diff --git a/cl_dll/hud/text_texture.cpp b/cl_dll/hud/text_texture.cpp
new file mode 100644
index 0000000..700f2d8
--- /dev/null
+++ b/cl_dll/hud/text_texture.cpp
@@ -0,0 +1,89 @@
+//
+// text_texture.cpp
+//
+
+#include "hud.h"
+#include "cl_util.h"
+#include "triangleapi.h"
+#include "draw_util.h"
+
+#include <stdio.h>
+#include <vector>
+
+#include "text_texture.h"
+#include "text_gdi.h"
+
+static int s_textTextureCounter = 0;
+
+void CTextTexture::Free()
+{
+	if( m_iTex > 0 && gRenderAPI.GL_FreeTexture )
+		gRenderAPI.GL_FreeTexture( m_iTex );
+
+	m_iTex = 0;
+	m_iWidth = m_iHeight = 0;
+	m_bFailed = false;
+	m_key.clear();
+}
+
+bool CTextTexture::Update( const std::string &utf8, const char *fontName, int emHeight, int weight, bool antialias )
+{
+	char extra[96];
+	snprintf( extra, sizeof( extra ), "|%s|%d|%d|%d", fontName ? fontName : "", emHeight, weight, antialias ? 1 : 0 );
+	const std::string key = utf8 + extra;
+
+	if( key == m_key )
+		return m_iTex > 0 || ( utf8.empty() && !m_bFailed ); // also remembers that it did not work
+
+	Free();
+	m_key = key;
+
+	if( utf8.empty() )
+		return true; // nothing to draw
+
+	std::vector<unsigned char> alpha;
+	int w = 0, h = 0;
+
+	if( !gRenderAPI.GL_CreateTexture
+		|| !GDI_RenderTextBlock( utf8.c_str(), fontName, emHeight, weight, antialias, 4096, alpha, w, h ))
+	{
+		m_bFailed = true;
+		return false;
+	}
+
+	// white pixels, the glyphs are in the alpha channel (the colour is set when the text is drawn)
+	std::vector<unsigned char> rgba( (size_t)w * h * 4, 255 );
+
+	for( size_t i = 0, n = (size_t)w * h; i < n; ++i )
+		rgba[i * 4 + 3] = alpha[i];
+
+	// every picture has its own name: the engine gives back the old texture for a name it already has
+	char name[48];
+	snprintf( name, sizeof( name ), "*text_%d", ++s_textTextureCounter );
+
+	m_iTex = gRenderAPI.GL_CreateTexture( name, w, h, rgba.data(), static_cast<texFlags_t>( TF_NOMIPMAP | TF_CLAMP | TF_HAS_ALPHA | TF_NEAREST ));
+
+	if( m_iTex <= 0 )
+	{
+		m_iTex = 0;
+		m_bFailed = true;
+		return false;
+	}
+
+	m_iWidth = w;
+	m_iHeight = h;
+	return true;
+}
+
+void CTextTexture::Draw( float x, float y, int r, int g, int b, int a ) const
+{
+	if( m_iTex <= 0 )
+		return;
+
+	gRenderAPI.GL_SelectTexture( 0 );
+	gRenderAPI.GL_Bind( 0, m_iTex );
+	gEngfuncs.pTriAPI->RenderMode( kRenderTransAlpha );
+	gEngfuncs.pTriAPI->Color4f( r / 255.0f, g / 255.0f, b / 255.0f, a / 255.0f );
+	DrawUtils::Draw2DQuad( x, y, x + m_iWidth, y + m_iHeight );
+	gEngfuncs.pTriAPI->RenderMode( kRenderNormal );
+}
diff --git a/cl_dll/hud/text_texture.h b/cl_dll/hud/text_texture.h
